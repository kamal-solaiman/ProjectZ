<Application x:Class="ProjectZ.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:ProjectZ.Services"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProjectZ;component/Resources/ThemePalette.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ProjectZ;component/Resources/ThemeAliases.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ProjectZ;component/Resources/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ProjectZ;component/Resources/PosStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ProjectZ;component/Resources/ThemeControls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ProjectZ;component/Resources/ThemeBackdrop.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Live store identity and the device-local theme runtime are available before the first window. -->
            <services:StoreIdentity x:Key="StoreIdentity" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
