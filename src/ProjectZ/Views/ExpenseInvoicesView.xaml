<UserControl x:Class="ProjectZ.Views.ExpenseInvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Language="ar-EG">

    <UserControl.Resources>
        <!-- Preset pills: the active preset is filled, the rest stay on the soft surface. -->
        <Style x:Key="ExpInvPresetStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.E2E8F0.Input}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.334155.Text}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExpInvFilterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.64748B.Muted}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="ExpInvHeaderCellStyle" TargetType="TextBlock">
            <Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
        </Style>

        <Style x:Key="ExpInvCellStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.172B41.Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ExpInvNumberCellStyle" TargetType="TextBlock" BasedOn="{StaticResource ExpInvCellStyle}">
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.102E48.Heading}" />
        </Style>

        <Style x:Key="ExpInvAmountCellStyle" TargetType="TextBlock" BasedOn="{StaticResource ExpInvCellStyle}">
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
        </Style>

        <Style x:Key="ExpInvSummaryCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FFFFFF.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.E2E8F0.Border}" />
        </Style>

        <Style x:Key="ExpInvSummaryLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.64748B.Muted}" />
        </Style>

        <Style x:Key="ExpInvSummaryValueStyle" TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.102E48.Heading}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PrintArea"
          Margin="18,14"
          FlowDirection="LeftToRight"
          Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: title, data-source badge and the screen actions -->
        <Grid Grid.Row="0" Margin="0,0,0,11" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                <Button Content="تسجيل مصروف جديد"
                        Style="{StaticResource PosPrimaryCompactButtonStyle}"
                        Padding="13,7"
                        FontSize="12"
                        Command="{Binding OpenAddExpenseCommand}" />
                <Button Content="تحديث"
                        Margin="6,0,0,0"
                        Style="{StaticResource PosOutlineTealButtonStyle}"
                        Padding="11,7"
                        FontSize="12"
                        Command="{Binding RefreshCommand}" />
                <Button Content="تصدير CSV"
                        Margin="6,0,0,0"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Padding="11,7"
                        FontSize="12"
                        Click="ExportCsv_Click" />
                <Button Content="طباعة"
                        Margin="6,0,0,0"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Padding="11,7"
                        FontSize="12"
                        Click="Print_Click" />
                <Button Content="إلغاء كل الفلاتر"
                        Margin="6,0,0,0"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Padding="11,7"
                        FontSize="12"
                        Command="{Binding ClearFiltersCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft">
                <TextBlock Text="فواتير المصروفات"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Legacy.102E48.Heading}"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}"
                        BorderBrush="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        ToolTip="{Binding HistorySourceLabel}">
                    <TextBlock Text="{Binding DataSourceLabel}"
                               Style="{StaticResource PosCenterTextStyle}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.15803D.SuccessInk}" />
                </Border>
                <TextBlock Text="سجل كامل لكل مصروف محفوظ وتوزيعه على الحسابات المالية"
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="10,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="360" />
            </StackPanel>
        </Grid>

        <!-- ROW 1: filters -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12,10"
                CornerRadius="12"
                Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <StackPanel>
                <!-- Line 1: date presets, custom dates and the free-text search -->
                <Grid Margin="0,0,0,9" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                        <TextBlock Text="الفترة:"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />

                        <Button Content="الكل" Command="{Binding SelectDatePresetCommand}" CommandParameter="الكل">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExpInvPresetStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllDatePreset}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.102E48.Navigation}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="اليوم" Command="{Binding SelectDatePresetCommand}" CommandParameter="اليوم">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExpInvPresetStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTodayPreset}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.0F766E.Success}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="آخر 7 أيام" Command="{Binding SelectDatePresetCommand}" CommandParameter="آخر 7 أيام">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExpInvPresetStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLast7DaysPreset}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.0F766E.Success}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="هذا الشهر" Command="{Binding SelectDatePresetCommand}" CommandParameter="هذا الشهر">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExpInvPresetStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsThisMonthPreset}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.0F766E.Success}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="الشهر الماضي" Command="{Binding SelectDatePresetCommand}" CommandParameter="الشهر الماضي">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExpInvPresetStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLastMonthPreset}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.147D92.Accent}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Column="2" FlowDirection="RightToLeft">
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 MinHeight="33"
                                 Padding="12,5"
                                 FontSize="12.5"
                                 FlowDirection="RightToLeft"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="ابحث برقم المصروف أو البيان أو التصنيف أو اسم المستخدم أو الحساب المالي..."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="12,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                    </Grid>
                </Grid>

                <!-- Line 2: section, account, user, payment count and sort -->
                <Grid FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="تصنيف المصروف" Style="{StaticResource ExpInvFilterLabelStyle}" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  ItemsSource="{Binding CategoryFilters}"
                                  SelectedItem="{Binding SelectedCategoryFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="الحساب المالي" Style="{StaticResource ExpInvFilterLabelStyle}" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  ItemsSource="{Binding AccountFilters}"
                                  SelectedItem="{Binding SelectedAccountFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="المستخدم" Style="{StaticResource ExpInvFilterLabelStyle}" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  ItemsSource="{Binding UserFilters}"
                                  SelectedItem="{Binding SelectedUserFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="وسائل الدفع" Style="{StaticResource ExpInvFilterLabelStyle}" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  ItemsSource="{Binding PaymentFilters}"
                                  SelectedItem="{Binding SelectedPaymentFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="8">
                        <TextBlock Text="الترتيب" Style="{StaticResource ExpInvFilterLabelStyle}" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort}" />
                    </StackPanel>
                </Grid>

                <!-- Line 3: custom dates, amount range and the live filter state -->
                <Grid Margin="0,9,0,0" FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="من تاريخ" Style="{StaticResource ExpInvFilterLabelStyle}" />
                        <DatePicker SelectedDate="{Binding FromDate}" FlowDirection="LeftToRight" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="إلى تاريخ" Style="{StaticResource ExpInvFilterLabelStyle}" />
                        <DatePicker SelectedDate="{Binding ToDate}" FlowDirection="LeftToRight" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="المبلغ من" Style="{StaticResource ExpInvFilterLabelStyle}" />
                        <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                 Text="{Binding MinimumAmountText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="المبلغ إلى" Style="{StaticResource ExpInvFilterLabelStyle}" />
                        <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                 Text="{Binding MaximumAmountText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="7"
                                Margin="10,0,0,0"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                FlowDirection="RightToLeft">
                        <Border Padding="9,4"
                                CornerRadius="9"
                                Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}"
                                BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding ShownCountDisplay}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                        </Border>
                        <Border Margin="6,0,0,0"
                                Padding="9,4"
                                CornerRadius="9"
                                Background="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}"
                                BorderBrush="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding ShownTotalDisplay}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Legacy.15803D.SuccessInk}" />
                        </Border>
                        <TextBlock Text="الفترة غير صحيحة: تاريخ البداية بعد تاريخ النهاية."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}"
                                   Visibility="{Binding HasInvalidDateRange, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="نطاق المبلغ معكوس: الحد الأدنى أكبر من الأعلى."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}"
                                   Visibility="{Binding HasInvalidAmountRange, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ROW 2: totals for the current filter -->
        <UniformGrid Grid.Row="2" Columns="5" Margin="0,0,0,10">
            <Border Style="{StaticResource ExpInvSummaryCardStyle}" Background="{DynamicResource Theme.Legacy.EFF6FF.InfoSoft}">
                <StackPanel FlowDirection="RightToLeft">
                    <TextBlock Text="المصروفات المعروضة" Style="{StaticResource ExpInvSummaryLabelStyle}" />
                    <TextBlock Text="{Binding ShownCountDisplay}" Style="{StaticResource ExpInvSummaryValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ExpInvSummaryCardStyle}" Background="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}">
                <StackPanel FlowDirection="RightToLeft">
                    <TextBlock Text="إجمالي المصروفات" Style="{StaticResource ExpInvSummaryLabelStyle}" />
                    <TextBlock Text="{Binding ShownTotalDisplay}" Style="{StaticResource ExpInvSummaryValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ExpInvSummaryCardStyle}">
                <StackPanel FlowDirection="RightToLeft">
                    <TextBlock Text="المتوسط لكل مصروف" Style="{StaticResource ExpInvSummaryLabelStyle}" />
                    <TextBlock Text="{Binding ShownAverageDisplay}" Style="{StaticResource ExpInvSummaryValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ExpInvSummaryCardStyle}" Background="{DynamicResource Theme.Legacy.EDE9FE.InfoSoft}">
                <StackPanel FlowDirection="RightToLeft">
                    <TextBlock Text="وسائل الدفع المستخدمة" Style="{StaticResource ExpInvSummaryLabelStyle}" />
                    <TextBlock Text="{Binding SplitCountDisplay}" Style="{StaticResource ExpInvSummaryValueStyle}" FontSize="13" />
                    <TextBlock Text="{Binding SingleAccountCountDisplay}"
                               Style="{StaticResource ExpInvSummaryLabelStyle}"
                               Margin="0,1,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ExpInvSummaryCardStyle}" Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}">
                <StackPanel FlowDirection="RightToLeft">
                    <TextBlock Text="أكبر تصنيف" Style="{StaticResource ExpInvSummaryLabelStyle}" />
                    <TextBlock Text="{Binding TopCategoryDisplay}" Style="{StaticResource ExpInvSummaryValueStyle}" FontSize="12.5" />
                    <TextBlock Text="{Binding AccountsUsedDisplay}"
                               Style="{StaticResource ExpInvSummaryLabelStyle}"
                               Margin="0,1,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ROW 3: the register table -->
        <Border Grid.Row="3"
                Padding="0"
                CornerRadius="12"
                Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="12,8"
                        CornerRadius="12,12,0,0"
                        Background="{DynamicResource Theme.Legacy.102E48.Navigation}">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="115" />
                            <ColumnDefinition Width="1.7*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="رقم المصروف" Style="{StaticResource ExpInvHeaderCellStyle}" />
                        <TextBlock Grid.Column="1" Text="التاريخ" Style="{StaticResource ExpInvHeaderCellStyle}" />
                        <TextBlock Grid.Column="2" Text="التصنيف" Style="{StaticResource ExpInvHeaderCellStyle}" />
                        <TextBlock Grid.Column="3" Text="البيان" Style="{StaticResource ExpInvHeaderCellStyle}" />
                        <TextBlock Grid.Column="4" Text="المبلغ" Style="{StaticResource ExpInvHeaderCellStyle}" />
                        <TextBlock Grid.Column="5" Text="توزيع وسائل الدفع" Style="{StaticResource ExpInvHeaderCellStyle}" />
                        <TextBlock Grid.Column="6" Text="المستخدم" Style="{StaticResource ExpInvHeaderCellStyle}" />
                        <TextBlock Grid.Column="7" Text="التفاصيل" Style="{StaticResource ExpInvHeaderCellStyle}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilteredInvoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="58"
                                            Padding="12,7"
                                            BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                                            BorderThickness="0,0,0,1"
                                            Cursor="Hand"
                                            ToolTip="{Binding PaymentBreakdown}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FFFFFF.Surface}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Theme.Legacy.EFF6FF.InfoSoft}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid FlowDirection="RightToLeft">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="115" />
                                                <ColumnDefinition Width="1.7*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="86" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ExpenseNumber}"
                                                       Style="{StaticResource ExpInvNumberCellStyle}"
                                                       FontSize="12" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DateDisplay}"
                                                           Style="{StaticResource ExpInvCellStyle}"
                                                           HorizontalAlignment="Center"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Theme.Legacy.334155.Text}" />
                                                <TextBlock Text="{Binding CreatedAtDisplay}"
                                                           Style="{StaticResource ExpInvCellStyle}"
                                                           HorizontalAlignment="Center"
                                                           Margin="5,1,5,0"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Margin="4,0" Padding="4,3" VerticalAlignment="Center"
                                                    Style="{StaticResource PosOutlineTealButtonStyle}" ToolTip="فتح تقرير التصنيف لشهر هذا المصروف"
                                                    Command="{Binding DataContext.AnalyzeCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                            </Button>

                                            <StackPanel Grid.Column="3" Margin="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DescriptionDisplay}"
                                                           Style="{StaticResource ExpInvCellStyle}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding AmountDisplay}"
                                                       Style="{StaticResource ExpInvAmountCellStyle}" />

                                            <StackPanel Grid.Column="5" Margin="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PaymentMethodsDisplay}"
                                                           Style="{StaticResource ExpInvCellStyle}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                                <TextBlock Text="{Binding PaymentBreakdown}"
                                                           Style="{StaticResource ExpInvCellStyle}"
                                                           Margin="5,1,5,0"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding ActorUserName}"
                                                       Style="{StaticResource ExpInvCellStyle}"
                                                       HorizontalAlignment="Center"
                                                       FontFamily="Consolas, Segoe UI"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />

                                            <Button Grid.Column="7"
                                                    Content="تفاصيل"
                                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                                    Padding="8,3"
                                                    Margin="4,0"
                                                    MinHeight="26"
                                                    FontSize="10.5"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty states: nothing stored yet, or nothing matches the filters -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                FlowDirection="RightToLeft"
                                Visibility="{Binding HasNoFilteredInvoices, Converter={StaticResource BoolToVis}}">
                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Theme.Legacy.E0F2FE.InfoSoft}">
                            <TextBlock Text="💸"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding EmptyStateText}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,10,0,0"
                                   MaxWidth="520"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ROW 4: status -->
        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource PosRtlTextStyle}"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
        </Border>
    </Grid>
</UserControl>
