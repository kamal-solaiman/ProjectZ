<Window x:Class="ProjectZ.Views.MaintenanceInvoiceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | تفاصيل فاتورة الصيانة الشاملة'}"
        Width="1120"
        Height="780"
        MinWidth="920"
        MinHeight="640"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="MntDetailsToolbarBtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid FlowDirection="LeftToRight">
        <ContentControl Style="{StaticResource ThemeBackdropStyle}" />
    <Grid Margin="16" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Navy Header + Quick Actions -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="16,12"
                CornerRadius="14"
                Background="{DynamicResource Theme.Legacy.102E48.Navigation}">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Action Controls -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <Button Content="معاينة وطباعة"
                            Style="{StaticResource MntDetailsToolbarBtnStyle}"
                            Background="{DynamicResource Theme.Legacy.0F766E.Success}"
                            BorderBrush="{DynamicResource Theme.Legacy.14B8A6.Accent}"
                            Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnSuccess}"
                            Command="{Binding PrintPreviewCommand}" />

                    <Button Content="تسليم وتحصيل نهائي"
                            Style="{StaticResource MntDetailsToolbarBtnStyle}"
                            Background="{DynamicResource Theme.Legacy.047857.Success}"
                            BorderBrush="{DynamicResource Theme.Legacy.34D399.SuccessBorder}"
                            Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnSuccess}"
                            Visibility="{Binding Order.IsActiveOrder, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DeliverAndCollectCommand}" />

                    <Button Content="فتح في إجراءات الصيانة"
                            Style="{StaticResource MntDetailsToolbarBtnStyle}"
                            Background="{DynamicResource Theme.Legacy.1D4ED8.Info}"
                            BorderBrush="{DynamicResource Theme.Legacy.60A5FA.InfoBorder}"
                            Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnInfo}"
                            Command="{Binding OpenInActionsCommand}" />
                </WrapPanel>

                <!-- Order Info -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                        <TextBlock Text="{Binding Order.OrderNumber}"
                                   Style="{StaticResource PosLtrTextStyle}"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}"
                                   VerticalAlignment="Center" />

                        <Border Margin="10,0,0,0" Padding="10,4" CornerRadius="10" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.0284C7.Info}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Order.IsDiagnosing}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.7C3AED.Violet}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Order.IsWaitingParts}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.D97706.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Order.IsReadyForPickup}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.059669.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Order.IsDelivered}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.475569.NavigationRaised}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Order.IsCancelled}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.B42318.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Order.StatusTitle}"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        </Border>

                        <Border Margin="6,0,0,0"
                                Padding="8,3"
                                CornerRadius="8"
                                Background="{DynamicResource Theme.Legacy.FEE2E2.DangerSoft}"
                                VerticalAlignment="Center"
                                Visibility="{Binding Order.IsUrgent, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="مستعجل" Style="{StaticResource PosCenterTextStyle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                        </Border>

                        <Border Margin="6,0,0,0"
                                Padding="8,3"
                                CornerRadius="8"
                                Background="{DynamicResource Theme.Legacy.E0E7FF.InfoSoft}"
                                VerticalAlignment="Center"
                                Visibility="{Binding Order.IsWarranty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ضمان / إعادة فحص" Style="{StaticResource PosCenterTextStyle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.3730A3.InfoInk}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Order.ReceivedFullDisplay, StringFormat='استلام: {0}'}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Theme.Legacy.CBD5E1.NavigationMuted}" />
                        <TextBlock Text=" · " Style="{StaticResource PosCenterTextStyle}" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" />
                        <TextBlock Text="{Binding Order.ReceivedByName, StringFormat='المستلم: {0}'}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Theme.Legacy.CBD5E1.NavigationMuted}" />
                        <TextBlock Text=" · " Style="{StaticResource PosCenterTextStyle}" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" />
                        <TextBlock Text="{Binding Order.AssignedTechnicianDisplay, StringFormat='الفني: {0}'}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Legacy.BAE6FD.NavigationInk}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: Delivery / Warranty / Cancellation Context Banner -->
        <StackPanel Grid.Row="1">
            <Border Margin="0,0,0,10"
                    Padding="12,8"
                    CornerRadius="10"
                    Background="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}"
                    BorderBrush="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}"
                    BorderThickness="1"
                    Visibility="{Binding Order.IsDelivered, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="{Binding Order.DeliveredAtDisplay, StringFormat='تم التسليم بتاريخ: {0}'}"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Legacy.065F46.SuccessInk}" />
                    <TextBlock Text=" · " Style="{StaticResource PosCenterTextStyle}" Foreground="{DynamicResource Theme.Legacy.10B981.SuccessInk}" />
                    <TextBlock Text="{Binding Order.WarrantySummaryDisplay}"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.047857.SuccessInk}" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,10"
                    Padding="12,8"
                    CornerRadius="10"
                    Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}"
                    BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}"
                    BorderThickness="1"
                    Visibility="{Binding Order.IsCancelled, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Order.CancellationReason, StringFormat='أمر صيانة ملغى — سبب الإلغاء: {0}'}"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- ROW 2: Main Scrollable Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Customer/Device Card + Full Financial Breakdown Card -->
                <Grid Margin="0,0,0,12" FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.25*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Customer, Device & Workshop Report -->
                    <Border Grid.Column="0"
                            Padding="14"
                            CornerRadius="12"
                            Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                            BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="بيانات العميل والجهاز والتشخيص"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="{Binding Order.CustomerName}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />

                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,4,0,0">
                                <TextBlock Text="الهاتف: " Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                <TextBlock Text="{Binding Order.CustomerPhoneDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.172B41.Text}" />
                            </StackPanel>

                            <TextBlock Text="{Binding Order.CustomerAddress, StringFormat='العنوان: {0}'}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,2,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Theme.Legacy.475569.Muted}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Order.CustomerAddress, Converter={StaticResource StringNotEmptyToVis}}" />

                            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="9" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Order.DeviceFullTitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                    <TextBlock Style="{StaticResource PosRtlTextStyle}" Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.475569.Muted}">
                                        <Run Text="النوع: " />
                                        <Run Text="{Binding Order.DeviceType, Mode=OneWay}" />
                                        <Run Text=" · السيريال/IMEI: " />
                                        <Run Text="{Binding Order.SerialOrImeiDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}">
                                        <Run Text="القفل: " />
                                        <Run Text="{Binding Order.PasscodeDisplay, Mode=OneWay}" />
                                        <Run Text=" · الملحقات: " />
                                        <Run Text="{Binding Order.AccessoriesDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Order.PhysicalConditionDisplay, StringFormat='الحالة عند الاستلام: {0}'}"
                                               Style="{StaticResource PosRtlTextStyle}"
                                               Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding Order.ReportedFault, StringFormat='العطل المسجل: {0}'}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,8,0,0"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Legacy.1E293B.Text}"
                                       TextWrapping="Wrap" />

                            <Border Margin="0,6,0,0"
                                    Padding="8,6"
                                    CornerRadius="8"
                                    Background="{DynamicResource Theme.Legacy.EFF6FF.InfoSoft}"
                                    BorderBrush="{DynamicResource Theme.Legacy.BFDBFE.InfoBorder}"
                                    BorderThickness="1"
                                    Visibility="{Binding Order.HasDiagnosisNotes, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Order.DiagnosisNotes, StringFormat='تقرير الفحص الفني: {0}'}"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Theme.Legacy.1E40AF.InfoInk}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding Order.IntakeNotes, StringFormat='ملاحظات الاستلام: {0}'}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,6,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Order.HasIntakeNotes, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding Order.DeliveryNotes, StringFormat='ملاحظات التسليم: {0}'}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Legacy.047857.SuccessInk}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Order.DeliveryNotes, Converter={StaticResource StringNotEmptyToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Financial Totals, Profit & Payment Breakdown -->
                    <Border Grid.Column="2"
                            Padding="14"
                            CornerRadius="12"
                            Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}"
                            BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}"
                            BorderThickness="1">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Service Pricing & Profit -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الحساب المالي وربحية الفاتورة"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                                           Margin="0,0,0,8" />

                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="قطع الغيار (سعر البيع):" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Order.PartsTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="أجرة الصيانة والمصنعية:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Order.LaborCostDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,4,0,0" Visibility="{Binding Order.HasDiscount, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الخصم الممنوح:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.B45309.WarningInk}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Order.DiscountAmountDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B45309.WarningInk}" />
                                </Grid>

                                <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="8" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="إجمالي الفاتورة الفعّال:" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.EstimatedCostDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,8,0,0" Padding="8,7" CornerRadius="8" Background="{DynamicResource Theme.Legacy.EFF6FF.InfoSoft}" BorderBrush="{DynamicResource Theme.Legacy.BFDBFE.InfoBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="تكلفة قطع الغيار:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Order.PartsCostTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                        </Grid>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="صافي ربح الصيانة:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.1D4ED8.InfoInk}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Order.EstimatedProfitDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.1D4ED8.InfoInk}" />
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="نسبة الهامش:" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="{DynamicResource Theme.Legacy.2563EB.InfoInk}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ProfitMarginDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.2563EB.InfoInk}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Deposit, Final Settlement & Channels -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تجزئة العربون والتحصيل النهائي"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="العربون / الدفعات تحت الحساب:" Style="{StaticResource PosRtlTextStyle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                <Grid Margin="0,2,0,0" Visibility="{Binding Order.HasDepositCash, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="عربون كاش:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Order.DepositCashPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                </Grid>

                                <Grid Margin="0,2,0,0" Visibility="{Binding Order.HasDepositVodafone, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="عربون فودافون كاش:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.C8102E.DangerInk}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Order.DepositVodafonePaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.C8102E.DangerInk}" />
                                </Grid>

                                <Grid Margin="0,2,0,0" Visibility="{Binding Order.HasDepositInstaPay, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="عربون إنستاباي:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Order.DepositInstaPayPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                </Grid>

                                <TextBlock Text="التحصيل النهائي عند التسليم:" Style="{StaticResource PosRtlTextStyle}" Margin="0,6,0,0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                           Visibility="{Binding Order.HasFinalPayment, Converter={StaticResource BoolToVis}}" />

                                <Grid Margin="0,2,0,0" Visibility="{Binding Order.HasFinalPaymentCash, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="نهائي كاش:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Order.FinalPaymentCashPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                </Grid>

                                <Grid Margin="0,2,0,0" Visibility="{Binding Order.HasFinalPaymentVodafone, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="نهائي فودافون كاش:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.C8102E.DangerInk}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Order.FinalPaymentVodafonePaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.C8102E.DangerInk}" />
                                </Grid>

                                <Grid Margin="0,2,0,0" Visibility="{Binding Order.HasFinalPaymentInstaPay, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="نهائي إنستاباي:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Order.FinalPaymentInstaPayPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                </Grid>

                                <Grid Margin="0,6,0,0" Visibility="{Binding Order.HasRefundedDeposit, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="مرتجع / رد عربون للعميل:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Order.RefundedDepositAmountDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                </Grid>

                                <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="8" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="صافي المحصّل الفعلي:" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.TotalCollectedAllDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,6,0,0"
                                        Padding="8,5"
                                        CornerRadius="8"
                                        Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}"
                                        BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}"
                                        BorderThickness="1"
                                        Visibility="{Binding Order.HasEstimatedRemaining, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="المتبقي للتحصيل:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.EstimatedRemainingDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,10,0,0"
                                        Padding="8,6"
                                        CornerRadius="8"
                                        Background="{DynamicResource Theme.Legacy.FFFBEB.WarningSoft}"
                                        BorderBrush="{DynamicResource Theme.Legacy.FDE68A.WarningBorder}"
                                        BorderThickness="1"
                                        Visibility="{Binding CanCollectPayment, Converter={StaticResource BoolToVis}}">
                                    <StackPanel FlowDirection="RightToLeft">
                                        <TextBlock Text="تحصيل دفعة من الفاتورة"
                                                   Style="{StaticResource PosRtlTextStyle}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Theme.Legacy.92400E.WarningInk}"
                                                   Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding CollectPaymentAmountText, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12"
                                                     Padding="6,3"
                                                     Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                                                     BorderBrush="{DynamicResource Theme.Legacy.F59E0B.WarningBorder}" />
                                            <Button Grid.Column="1"
                                                    Content="كاش"
                                                    Style="{StaticResource MntDetailsToolbarBtnStyle}"
                                                    Background="{DynamicResource Theme.Legacy.059669.Success}"
                                                    BorderBrush="{DynamicResource Theme.Legacy.34D399.SuccessBorder}"
                                                    Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnSuccess}"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding CollectCashCommand}" />
                                            <Button Grid.Column="2"
                                                    Content="فودافون"
                                                    Style="{StaticResource MntDetailsToolbarBtnStyle}"
                                                    Background="{DynamicResource Theme.Legacy.C8102E.Danger}"
                                                    BorderBrush="{DynamicResource Theme.Legacy.F87171.DangerBorder}"
                                                    Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnDanger}"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding CollectVodafoneCommand}" />
                                            <Button Grid.Column="3"
                                                    Content="إنستاباي"
                                                    Style="{StaticResource MntDetailsToolbarBtnStyle}"
                                                    Background="{DynamicResource Theme.Legacy.6D28D9.Violet}"
                                                    BorderBrush="{DynamicResource Theme.Legacy.A78BFA.VioletBorder}"
                                                    Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnViolet}"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding CollectInstaPayCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Used Spare Parts Section -->
                <Grid Margin="0,0,0,6" FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="قطع الغيار والمستلزمات المصروفة على الفاتورة"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding PartsTotalUnitsSummary}"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                </Grid>

                <Border Padding="12,8" Background="{DynamicResource Theme.Legacy.102E48.Navigation}" CornerRadius="10,10,0,0">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="115" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="الصنف والباركود" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        <TextBlock Grid.Column="1" Text="المصدر" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        <TextBlock Grid.Column="2" Text="الكمية" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        <TextBlock Grid.Column="3" Text="سعر الوحدة" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        <TextBlock Grid.Column="4" Text="الإجمالي" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
                    </Grid>
                </Border>

                <Border Margin="0,0,0,14" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Order.UsedParts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,9" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="0,0,0,1">
                                        <Grid FlowDirection="RightToLeft">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="105" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="105" />
                                                <ColumnDefinition Width="115" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Barcode}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="7,3" CornerRadius="6" Background="{DynamicResource Theme.Legacy.F1F5F9.Surface}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceBadgeText}" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.334155.Text}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding QuantityDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="{Binding UnitSellPriceDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12" />
                                            <TextBlock Grid.Column="4" Text="{Binding LineTotalDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="لم يتم صرف قطع غيار على هذه التذكرة."
                                   Style="{StaticResource PosCenterTextStyle}"
                                   Padding="12"
                                   FontSize="12"
                                   Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                   Visibility="{Binding Order.HasUsedParts, Converter={StaticResource InverseBoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Payment History (dbo.MaintenancePayments rows, append-only in SQL) -->
                <Grid Margin="0,0,0,6" FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="حركات التحصيل والاسترداد المسجلة على الفاتورة"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding PaymentsCountSummary}"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                </Grid>

                <Border Padding="12,8" Background="{DynamicResource Theme.Legacy.102E48.Navigation}" CornerRadius="10,10,0,0">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="215" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="التاريخ والوقت" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        <TextBlock Grid.Column="1" Text="نوع الحركة والوسيلة" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        <TextBlock Grid.Column="2" Text="الملاحظة والمنفذ" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        <TextBlock Grid.Column="3" Text="المبلغ" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
                    </Grid>
                </Border>

                <Border Margin="0,0,0,14" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Order.PaymentHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,9" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="0,0,0,1">
                                        <Grid FlowDirection="RightToLeft">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="215" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimestampDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI" FontSize="11" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ActorDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.334155.Text}" TextTrimming="CharacterEllipsis" Margin="6,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding SignedAmountDisplay}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRefund}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="لا توجد حركات مالية مسجلة على هذه الفاتورة."
                                   Style="{StaticResource PosCenterTextStyle}"
                                   Padding="12"
                                   FontSize="12"
                                   Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                   Visibility="{Binding Order.HasPaymentHistory, Converter={StaticResource InverseBoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Activity Log -->
                <TextBlock Text="السجل الزمني الكامل لحركات التذكرة والمدفوعات"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                           Margin="0,0,0,6" />

                <Border Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1" CornerRadius="10" Padding="10">
                    <ItemsControl ItemsSource="{Binding Order.ActivityLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="8" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1">
                                    <Grid FlowDirection="RightToLeft">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="185" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimestampDisplay}" Style="{StaticResource PosLtrTextStyle}" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActionTitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                            <TextBlock Text="{Binding ActorName}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Details}" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Legacy.334155.Text}" TextWrapping="Wrap" Margin="6,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding AmountDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ROW 3: In-Modal Status Feedback -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="11,8"
                CornerRadius="8"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.065F46.SuccessInk}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- ROW 4: Footer -->
        <Grid Grid.Row="4" Margin="0,12,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="إغلاق النافذة"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="130"
                    Padding="18,9"
                    IsCancel="True"
                    Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
