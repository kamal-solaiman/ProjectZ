<Window x:Class="ProjectZ.Views.MaintenanceInvoiceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectZ | تفاصيل فاتورة الصيانة الشاملة"
        Width="1120"
        Height="780"
        MinWidth="920"
        MinHeight="640"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="MntDetailsToolbarBtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Navy Header + Quick Actions -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="16,12"
                CornerRadius="14"
                Background="#102E48">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Action Controls -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <Button Content="معاينة وطباعة"
                            Style="{StaticResource MntDetailsToolbarBtnStyle}"
                            Background="#0F766E"
                            BorderBrush="#14B8A6"
                            Foreground="White"
                            Command="{Binding PrintPreviewCommand}" />

                    <Button Content="تسليم وتحصيل نهائي"
                            Style="{StaticResource MntDetailsToolbarBtnStyle}"
                            Background="#047857"
                            BorderBrush="#34D399"
                            Foreground="White"
                            Visibility="{Binding Order.IsActiveOrder, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DeliverAndCollectCommand}" />

                    <Button Content="فتح في إجراءات الصيانة"
                            Style="{StaticResource MntDetailsToolbarBtnStyle}"
                            Background="#1D4ED8"
                            BorderBrush="#60A5FA"
                            Foreground="White"
                            Command="{Binding OpenInActionsCommand}" />
                </WrapPanel>

                <!-- Order Info -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                        <TextBlock Text="{Binding Order.OrderNumber}"
                                   Style="{StaticResource PosLtrTextStyle}"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#6EE7D8"
                                   VerticalAlignment="Center" />

                        <Border Margin="10,0,0,0" Padding="10,4" CornerRadius="10" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#0284C7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Order.IsDiagnosing}" Value="True">
                                            <Setter Property="Background" Value="#7C3AED" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Order.IsWaitingParts}" Value="True">
                                            <Setter Property="Background" Value="#D97706" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Order.IsReadyForPickup}" Value="True">
                                            <Setter Property="Background" Value="#059669" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Order.IsDelivered}" Value="True">
                                            <Setter Property="Background" Value="#475569" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Order.IsCancelled}" Value="True">
                                            <Setter Property="Background" Value="#B42318" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Order.StatusTitle}"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="White" />
                        </Border>

                        <Border Margin="6,0,0,0"
                                Padding="8,3"
                                CornerRadius="8"
                                Background="#FEE2E2"
                                VerticalAlignment="Center"
                                Visibility="{Binding Order.IsUrgent, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="مستعجل" Style="{StaticResource PosCenterTextStyle}" FontSize="11" FontWeight="Bold" Foreground="#B42318" />
                        </Border>

                        <Border Margin="6,0,0,0"
                                Padding="8,3"
                                CornerRadius="8"
                                Background="#E0E7FF"
                                VerticalAlignment="Center"
                                Visibility="{Binding Order.IsWarranty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ضمان / إعادة فحص" Style="{StaticResource PosCenterTextStyle}" FontSize="11" FontWeight="Bold" Foreground="#3730A3" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Order.ReceivedFullDisplay, StringFormat='استلام: {0}'}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11.5"
                                   Foreground="#CBD5E1" />
                        <TextBlock Text=" · " Style="{StaticResource PosCenterTextStyle}" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding Order.ReceivedByName, StringFormat='المستلم: {0}'}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11.5"
                                   Foreground="#CBD5E1" />
                        <TextBlock Text=" · " Style="{StaticResource PosCenterTextStyle}" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding Order.AssignedTechnicianDisplay, StringFormat='الفني: {0}'}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#BAE6FD" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: Delivery / Warranty / Cancellation Context Banner -->
        <StackPanel Grid.Row="1">
            <Border Margin="0,0,0,10"
                    Padding="12,8"
                    CornerRadius="10"
                    Background="#ECFDF5"
                    BorderBrush="#A7F3D0"
                    BorderThickness="1"
                    Visibility="{Binding Order.IsDelivered, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="{Binding Order.DeliveredAtDisplay, StringFormat='تم التسليم بتاريخ: {0}'}"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#065F46" />
                    <TextBlock Text=" · " Style="{StaticResource PosCenterTextStyle}" Foreground="#10B981" />
                    <TextBlock Text="{Binding Order.WarrantySummaryDisplay}"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#047857" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,10"
                    Padding="12,8"
                    CornerRadius="10"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    Visibility="{Binding Order.IsCancelled, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Order.CancellationReason, StringFormat='أمر صيانة ملغى — سبب الإلغاء: {0}'}"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#B42318"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- ROW 2: Main Scrollable Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Customer/Device Card + Full Financial Breakdown Card -->
                <Grid Margin="0,0,0,12" FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.25*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Customer, Device & Workshop Report -->
                    <Border Grid.Column="0"
                            Padding="14"
                            CornerRadius="12"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="بيانات العميل والجهاز والتشخيص"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="#102E48"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="{Binding Order.CustomerName}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#0F766E" />

                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,4,0,0">
                                <TextBlock Text="الهاتف: " Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#64748B" />
                                <TextBlock Text="{Binding Order.CustomerPhoneDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" Foreground="#172B41" />
                            </StackPanel>

                            <TextBlock Text="{Binding Order.CustomerAddress, StringFormat='العنوان: {0}'}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,2,0,0"
                                       FontSize="11.5"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Order.CustomerAddress, Converter={StaticResource StringNotEmptyToVis}}" />

                            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="9" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Order.DeviceFullTitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="Bold" Foreground="#102E48" />
                                    <TextBlock Style="{StaticResource PosRtlTextStyle}" Margin="0,3,0,0" FontSize="11.5" Foreground="#475569">
                                        <Run Text="النوع: " />
                                        <Run Text="{Binding Order.DeviceType, Mode=OneWay}" />
                                        <Run Text=" · السيريال/IMEI: " />
                                        <Run Text="{Binding Order.SerialOrImeiDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="11" Foreground="#64748B">
                                        <Run Text="القفل: " />
                                        <Run Text="{Binding Order.PasscodeDisplay, Mode=OneWay}" />
                                        <Run Text=" · الملحقات: " />
                                        <Run Text="{Binding Order.AccessoriesDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Order.PhysicalConditionDisplay, StringFormat='الحالة عند الاستلام: {0}'}"
                                               Style="{StaticResource PosRtlTextStyle}"
                                               Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding Order.ReportedFault, StringFormat='العطل المسجل: {0}'}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,8,0,0"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"
                                       TextWrapping="Wrap" />

                            <Border Margin="0,6,0,0"
                                    Padding="8,6"
                                    CornerRadius="8"
                                    Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    Visibility="{Binding Order.HasDiagnosisNotes, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Order.DiagnosisNotes, StringFormat='تقرير الفحص الفني: {0}'}"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="11.5"
                                           Foreground="#1E40AF"
                                           TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding Order.IntakeNotes, StringFormat='ملاحظات الاستلام: {0}'}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,6,0,0"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Order.HasIntakeNotes, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding Order.DeliveryNotes, StringFormat='ملاحظات التسليم: {0}'}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#047857"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Order.DeliveryNotes, Converter={StaticResource StringNotEmptyToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Financial Totals, Profit & Payment Breakdown -->
                    <Border Grid.Column="2"
                            Padding="14"
                            CornerRadius="12"
                            Background="#F0FDFA"
                            BorderBrush="#99F6E4"
                            BorderThickness="1">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Service Pricing & Profit -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الحساب المالي وربحية الفاتورة"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="#102E48"
                                           Margin="0,0,0,8" />

                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="قطع الغيار (سعر البيع):" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#475569" />
                                    <TextBlock Grid.Column="1" Text="{Binding Order.PartsTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="أجرة الصيانة والمصنعية:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#475569" />
                                    <TextBlock Grid.Column="1" Text="{Binding Order.LaborCostDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,4,0,0" Visibility="{Binding Order.HasDiscount, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الخصم الممنوح:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#B45309" />
                                    <TextBlock Grid.Column="1" Text="{Binding Order.DiscountAmountDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#B45309" />
                                </Grid>

                                <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="8" Background="White" BorderBrush="#99F6E4" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="إجمالي الفاتورة الفعّال:" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="#102E48" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.EstimatedCostDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="13.5" FontWeight="Bold" Foreground="#102E48" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,8,0,0" Padding="8,7" CornerRadius="8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="تكلفة قطع الغيار:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="#475569" />
                                            <TextBlock Grid.Column="1" Text="{Binding Order.PartsCostTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" />
                                        </Grid>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="صافي ربح الصيانة:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" />
                                            <TextBlock Grid.Column="1" Text="{Binding Order.EstimatedProfitDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="#1D4ED8" />
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="نسبة الهامش:" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#2563EB" />
                                            <TextBlock Grid.Column="1" Text="{Binding ProfitMarginDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11" FontWeight="Bold" Foreground="#2563EB" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Deposit, Final Settlement & Channels -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تجزئة العربون والتحصيل النهائي"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="#102E48"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="العربون / الدفعات تحت الحساب:" Style="{StaticResource PosRtlTextStyle}" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                <Grid Margin="0,2,0,0" Visibility="{Binding Order.HasDepositCash, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="عربون كاش:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="#0F766E" />
                                    <TextBlock Grid.Column="1" Text="{Binding Order.DepositCashPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#0F766E" />
                                </Grid>

                                <Grid Margin="0,2,0,0" Visibility="{Binding Order.HasDepositVodafone, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="عربون فودافون كاش:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="#C8102E" />
                                        <TextBlock Text="{Binding Order.DepositVodafoneReference}" Style="{StaticResource PosLtrTextStyle}" FontSize="9.5" Foreground="#64748B" Visibility="{Binding Order.DepositVodafoneReference, Converter={StaticResource StringNotEmptyToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Order.DepositVodafonePaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#C8102E" />
                                </Grid>

                                <Grid Margin="0,2,0,0" Visibility="{Binding Order.HasDepositInstaPay, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="عربون إنستاباي:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="#6D28D9" />
                                        <TextBlock Text="{Binding Order.DepositInstaPayReference}" Style="{StaticResource PosLtrTextStyle}" FontSize="9.5" Foreground="#64748B" Visibility="{Binding Order.DepositInstaPayReference, Converter={StaticResource StringNotEmptyToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Order.DepositInstaPayPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#6D28D9" />
                                </Grid>

                                <TextBlock Text="التحصيل النهائي عند التسليم:" Style="{StaticResource PosRtlTextStyle}" Margin="0,6,0,0" FontSize="11" FontWeight="Bold" Foreground="#64748B"
                                           Visibility="{Binding Order.HasFinalPayment, Converter={StaticResource BoolToVis}}" />

                                <Grid Margin="0,2,0,0" Visibility="{Binding Order.HasFinalPaymentCash, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="نهائي كاش:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="#0F766E" />
                                    <TextBlock Grid.Column="1" Text="{Binding Order.FinalPaymentCashPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#0F766E" />
                                </Grid>

                                <Grid Margin="0,2,0,0" Visibility="{Binding Order.HasFinalPaymentVodafone, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="نهائي فودافون كاش:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="#C8102E" />
                                        <TextBlock Text="{Binding Order.FinalPaymentVodafoneReference}" Style="{StaticResource PosLtrTextStyle}" FontSize="9.5" Foreground="#64748B" Visibility="{Binding Order.FinalPaymentVodafoneReference, Converter={StaticResource StringNotEmptyToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Order.FinalPaymentVodafonePaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#C8102E" />
                                </Grid>

                                <Grid Margin="0,2,0,0" Visibility="{Binding Order.HasFinalPaymentInstaPay, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="نهائي إنستاباي:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="#6D28D9" />
                                        <TextBlock Text="{Binding Order.FinalPaymentInstaPayReference}" Style="{StaticResource PosLtrTextStyle}" FontSize="9.5" Foreground="#64748B" Visibility="{Binding Order.FinalPaymentInstaPayReference, Converter={StaticResource StringNotEmptyToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Order.FinalPaymentInstaPayPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#6D28D9" />
                                </Grid>

                                <Grid Margin="0,6,0,0" Visibility="{Binding Order.HasRefundedDeposit, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="مرتجع / رد عربون للعميل:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#6D28D9" />
                                    <TextBlock Grid.Column="1" Text="{Binding Order.RefundedDepositAmountDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#6D28D9" />
                                </Grid>

                                <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="8" Background="White" BorderBrush="#99F6E4" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="صافي المحصّل الفعلي:" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="#0F766E" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.TotalCollectedAllDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="13" FontWeight="Bold" Foreground="#0F766E" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,6,0,0"
                                        Padding="8,5"
                                        CornerRadius="8"
                                        Background="#FEF2F2"
                                        BorderBrush="#FECACA"
                                        BorderThickness="1"
                                        Visibility="{Binding Order.HasEstimatedRemaining, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="المتبقي للتحصيل:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#B42318" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.EstimatedRemainingDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="#B42318" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Used Spare Parts Section -->
                <Grid Margin="0,0,0,6" FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="قطع الغيار والمستلزمات المصروفة على الفاتورة"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#102E48" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding PartsTotalUnitsSummary}"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#0F766E" />
                </Grid>

                <Border Padding="12,8" Background="#102E48" CornerRadius="10,10,0,0">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="115" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="الصنف والباركود" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                        <TextBlock Grid.Column="1" Text="المصدر" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                        <TextBlock Grid.Column="2" Text="الكمية" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                        <TextBlock Grid.Column="3" Text="سعر الوحدة" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                        <TextBlock Grid.Column="4" Text="الإجمالي" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#6EE7D8" />
                    </Grid>
                </Border>

                <Border Margin="0,0,0,14" Background="White" BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Order.UsedParts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                        <Grid FlowDirection="RightToLeft">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="105" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="105" />
                                                <ColumnDefinition Width="115" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Barcode}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="10.5" Foreground="#64748B" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="7,3" CornerRadius="6" Background="#F1F5F9" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceBadgeText}" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding QuantityDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="{Binding UnitSellPriceDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12" />
                                            <TextBlock Grid.Column="4" Text="{Binding LineTotalDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="#0F766E" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="لم يتم صرف قطع غيار على هذه التذكرة."
                                   Style="{StaticResource PosCenterTextStyle}"
                                   Padding="12"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Visibility="{Binding Order.HasUsedParts, Converter={StaticResource InverseBoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Activity Log -->
                <TextBlock Text="السجل الزمني الكامل لحركات التذكرة والمدفوعات"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#102E48"
                           Margin="0,0,0,6" />

                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10">
                    <ItemsControl ItemsSource="{Binding Order.ActivityLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid FlowDirection="RightToLeft">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="185" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimestampDisplay}" Style="{StaticResource PosLtrTextStyle}" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI" FontSize="11.5" Foreground="#64748B" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActionTitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#102E48" />
                                            <TextBlock Text="{Binding ActorName}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#64748B" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Details}" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" FontSize="12" Foreground="#334155" TextWrapping="Wrap" Margin="6,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding AmountDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#0F766E" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ROW 3: In-Modal Status Feedback -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="11,8"
                CornerRadius="8"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="#065F46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="#B42318" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- ROW 4: Footer -->
        <Grid Grid.Row="4" Margin="0,12,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="إغلاق النافذة"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="130"
                    Padding="18,9"
                    IsCancel="True"
                    Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
</Window>
