<Window x:Class="ProjectZ.Views.PurchaseInvoiceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | تفاصيل فاتورة المشتريات والتحكم الكامل'}"
        Width="1120"
        Height="780"
        MinWidth="920"
        MinHeight="640"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="DetailsToolbarBtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid FlowDirection="LeftToRight">
        <ContentControl Style="{StaticResource ThemeBackdropStyle}" />
    <Grid Margin="16" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Navy Banner + Full Control Action Bar -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="16,12"
                CornerRadius="14"
                Background="{DynamicResource Theme.Legacy.102E48.Navigation}">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Action Controls -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <Button Content="معاينة وطباعة"
                            Style="{StaticResource DetailsToolbarBtnStyle}"
                            Background="{DynamicResource Theme.Legacy.0F766E.Success}"
                            BorderBrush="{DynamicResource Theme.Legacy.14B8A6.Accent}"
                            Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnSuccess}"
                            Command="{Binding PrintPreviewCommand}" />

                    <Button Content="سداد دفعة آجل"
                            Style="{StaticResource DetailsToolbarBtnStyle}"
                            Background="{DynamicResource Theme.Legacy.D97706.Warning}"
                            BorderBrush="{DynamicResource Theme.Legacy.F59E0B.WarningBorder}"
                            Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnWarning}"
                            Visibility="{Binding Invoice.CanPayRemaining, Converter={StaticResource BoolToVis}}"
                            Command="{Binding PayRemainingCommand}" />

                    <Button Content="تعديل الفاتورة"
                            Style="{StaticResource DetailsToolbarBtnStyle}"
                            Background="{DynamicResource Theme.Legacy.1D4ED8.Info}"
                            BorderBrush="{DynamicResource Theme.Legacy.60A5FA.InfoBorder}"
                            Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnInfo}"
                            IsEnabled="{Binding Invoice.CanEdit}"
                            Command="{Binding EditInvoiceCommand}" />

                    <Button Content="مرتجع للمورد"
                            Style="{StaticResource DetailsToolbarBtnStyle}"
                            Background="{DynamicResource Theme.Legacy.6D28D9.Violet}"
                            BorderBrush="{DynamicResource Theme.Legacy.A78BFA.VioletBorder}"
                            Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnViolet}"
                            IsEnabled="{Binding Invoice.CanReturn}"
                            Command="{Binding ReturnToSupplierCommand}" />

                    <Button Content="إلغاء الفاتورة"
                            Style="{StaticResource DetailsToolbarBtnStyle}"
                            Background="{DynamicResource Theme.Legacy.334155.NavigationRaised}"
                            BorderBrush="{DynamicResource Theme.Legacy.64748B.Border}"
                            Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}"
                            IsEnabled="{Binding Invoice.CanCancel}"
                            Command="{Binding CancelInvoiceCommand}" />

                    <Button Content="حذف نهائي"
                            Style="{StaticResource DetailsToolbarBtnStyle}"
                            Background="{DynamicResource Theme.Legacy.B42318.Danger}"
                            BorderBrush="{DynamicResource Theme.Legacy.EF4444.DangerBorder}"
                            Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnDanger}"
                            Command="{Binding DeleteInvoiceCommand}" />
                </WrapPanel>

                <!-- Invoice Number, Status & Dates -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                        <TextBlock Text="{Binding Invoice.InvoiceNumber}"
                                   Style="{StaticResource PosLtrTextStyle}"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}"
                                   VerticalAlignment="Center" />

                        <Border Margin="10,0,0,0" Padding="10,4" CornerRadius="10" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.0F766E.Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Invoice.IsPartialCredit}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.D97706.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Invoice.IsFullCredit}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.B42318.Danger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Invoice.IsPartiallyReturned}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.6D28D9.Violet}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Invoice.IsFullyReturned}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.5B21B6.Violet}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Invoice.IsCancelled}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.475569.NavigationRaised}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Invoice.StatusTitle}"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Invoice.IssuedFullDisplay, StringFormat='التاريخ: {0}'}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Theme.Legacy.CBD5E1.NavigationMuted}" />
                        <TextBlock Text=" · " Style="{StaticResource PosCenterTextStyle}" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" />
                        <TextBlock Text="{Binding Invoice.BuyerName, StringFormat='بواسطة: {0}'}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Theme.Legacy.CBD5E1.NavigationMuted}" />
                        <TextBlock Text=" · " Style="{StaticResource PosCenterTextStyle}" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" Visibility="{Binding Invoice.HasSupplierInvoiceNumber, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Invoice.SupplierInvoiceNumberDisplay, StringFormat='مرجع المورد: {0}'}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Legacy.BAE6FD.NavigationInk}"
                                   Visibility="{Binding Invoice.HasSupplierInvoiceNumber, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: Sold Units Protection Notice (only if any unit from invoice was sold) -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12,8"
                CornerRadius="10"
                Background="{DynamicResource Theme.Legacy.FFFBEB.WarningSoft}"
                BorderBrush="{DynamicResource Theme.Legacy.FCD34D.WarningBorder}"
                BorderThickness="1"
                Visibility="{Binding HasSoldUnits, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding SoldProtectionBannerText}"
                       Style="{StaticResource PosRtlTextStyle}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.Legacy.92400E.WarningInk}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- ROW 2: Scrollable Details Body -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Supplier & Financial Summary Cards -->
                <Grid Margin="0,0,0,12" FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.25*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Supplier Info & Notes -->
                    <Border Grid.Column="0"
                            Padding="14"
                            CornerRadius="12"
                            Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                            BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="بيانات المورد والفاتورة"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="{Binding Invoice.SupplierName}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                            <TextBlock Text="{Binding Invoice.SupplierCompanyDisplay}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />

                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,6,0,0">
                                <TextBlock Text="الهاتف: " Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                <TextBlock Text="{Binding Invoice.SupplierPhoneDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.172B41.Text}" />
                            </StackPanel>

                            <TextBlock Text="{Binding Invoice.SupplierAddressDisplay, StringFormat='العنوان: {0}'}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.Legacy.475569.Muted}"
                                       TextWrapping="Wrap" />

                            <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="8" Background="{DynamicResource Theme.Legacy.EFF6FF.InfoSoft}" BorderBrush="{DynamicResource Theme.Legacy.BFDBFE.InfoBorder}" BorderThickness="1">
                                <Grid FlowDirection="RightToLeft">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="إجمالي الآجل الحالي على المورد:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.1E40AF.InfoInk}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SupplierOutstandingDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.1D4ED8.InfoInk}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,8,0,0"
                                    Padding="8,6"
                                    CornerRadius="8"
                                    Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                                    BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                                    BorderThickness="1"
                                    Visibility="{Binding Invoice.HasNotes, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Invoice.Notes, StringFormat='ملاحظات: {0}'}"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Theme.Legacy.334155.Text}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Full Financial & Payment Breakdown -->
                    <Border Grid.Column="2"
                            Padding="14"
                            CornerRadius="12"
                            Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}"
                            BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}"
                            BorderThickness="1">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Invoice Totals -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الحسابات المالية"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                                           Margin="0,0,0,8" />

                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="إجمالي الأصناف:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Invoice.SubtotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,4,0,0" Visibility="{Binding Invoice.HasReturnedGoods, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="خصم المرتجعات للمورد:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Invoice.ReturnedGoodsTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                </Grid>

                                <Grid Margin="0,4,0,0" Visibility="{Binding Invoice.HasDiscount, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الخصم المكتسب:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Invoice.EffectiveDiscountDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                </Grid>

                                <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="8" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="الصافي المستحق للمورد:" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Invoice.NetTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Payment Channels -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تجزئة الدفع والمسترد والآجل"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                                           Margin="0,0,0,8" />

                                <Grid Margin="0,2,0,0" Visibility="{Binding Invoice.HasCashPaid, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="نقدي (كاش):" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Invoice.CashPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                </Grid>

                                <Grid Margin="0,4,0,0" Visibility="{Binding Invoice.HasVodafoneCash, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="فودافون كاش:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.C8102E.DangerInk}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Invoice.VodafoneCashPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.C8102E.DangerInk}" />
                                </Grid>

                                <Grid Margin="0,4,0,0" Visibility="{Binding Invoice.HasInstaPay, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="إنستاباي (InstaPay):" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Invoice.InstaPayPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="إجمالي المدفوع للمورد:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Invoice.TotalPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                </Grid>

                                <Grid Margin="0,4,0,0" Visibility="{Binding Invoice.HasSupplierRefundReceived, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="مسترد من المورد:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Invoice.SupplierRefundReceivedDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                </Grid>

                                <Border Margin="0,6,0,0"
                                        Padding="8,5"
                                        CornerRadius="8"
                                        Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}"
                                        BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}"
                                        BorderThickness="1"
                                        Visibility="{Binding Invoice.HasRemainingPayable, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="المتبقي آجل للمورد:" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Invoice.RemainingPayableDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Line Items Section -->
                <TextBlock Text="محتويات وبنود فاتورة الشراء وحالة القطع بالمخزون"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                           Margin="0,0,0,6" />

                <Border Padding="12,8" Background="{DynamicResource Theme.Legacy.102E48.Navigation}" CornerRadius="10,10,0,0">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="105" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.BAE6FD.NavigationInk}" />
                        <TextBlock Grid.Column="1" Text="الصنف والباركود / السيريالات" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        <TextBlock Grid.Column="2" Text="المشتراة" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        <TextBlock Grid.Column="3" Text="المرتجع" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.DDD6FE.NavigationInk}" />
                        <TextBlock Grid.Column="4" Text="الفعلي" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
                        <TextBlock Grid.Column="5" Text="حالة المخزون حاليًا" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        <TextBlock Grid.Column="6" Text="سعر الشراء" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        <TextBlock Grid.Column="7" Text="الإجمالي الصافي" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
                    </Grid>
                </Border>

                <Border Margin="0,0,0,14" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10">
                    <ItemsControl ItemsSource="{Binding LineRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,9" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="0,0,0,1">
                                    <Grid FlowDirection="RightToLeft">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="175" />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding LineNumber}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding ProductName}" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Barcode, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding SerialSummary, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding QuantityDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="{Binding ReturnedQuantityDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                        <TextBlock Grid.Column="4" Text="{Binding RemainingQuantityDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />

                                        <Border Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="8,4" CornerRadius="6" Background="{DynamicResource Theme.Legacy.F1F5F9.Surface}">
                                            <TextBlock Text="{Binding StockStatusSummary}" Style="{StaticResource PosCenterTextStyle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.334155.Text}" />
                                        </Border>

                                        <TextBlock Grid.Column="6" Text="{Binding UnitPurchaseCostDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12" />
                                        <TextBlock Grid.Column="7" Text="{Binding NetActiveLineTotalDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Activity Audit Log -->
                <TextBlock Text="سجل الحركات والتعديلات والمرتجعات على الفاتورة"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                           Margin="0,0,0,6" />

                <Border Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1" CornerRadius="10" Padding="10">
                    <ItemsControl ItemsSource="{Binding Invoice.ActivityLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="8" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1">
                                    <Grid FlowDirection="RightToLeft">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="185" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimestampDisplay}" Style="{StaticResource PosLtrTextStyle}" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActionTitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                            <TextBlock Text="{Binding ActorName}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Details}" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Legacy.334155.Text}" TextWrapping="Wrap" Margin="6,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding AmountDisplay}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ROW 3: In-Modal Status Feedback -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="11,8"
                CornerRadius="8"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.065F46.SuccessInk}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- ROW 4: Footer -->
        <Grid Grid.Row="4" Margin="0,12,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="إغلاق النافذة"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="130"
                    Padding="18,9"
                    IsCancel="True"
                    Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
