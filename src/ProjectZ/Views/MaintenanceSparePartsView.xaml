<UserControl x:Class="ProjectZ.Views.MaintenanceSparePartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProjectZ.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MaintenanceSparePartsViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PosStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SpareSectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="SpareKpiCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,11" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid FlowDirection="LeftToRight" Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════ ROW 0: HEADER ══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="الذهاب إلى إجراءات الصيانة"
                        Style="{StaticResource PosOutlineTealButtonStyle}"
                        Command="{Binding GoToActionsCommand}"
                        Margin="0,0,8,0" />
                <Button Content="تفريغ الحقول"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Command="{Binding ResetFormCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="قطع الغيار — تسجيل وإدارة قطع غيار الصيانة فقط"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#102E48" />
                    <Border Margin="10,0,0,0"
                            Padding="10,4"
                            CornerRadius="8"
                            Background="#E0F2FE"
                            BorderBrush="#7DD3FC"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="مخزون صيانة مستقل · تصميم الواجهة"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#0369A1" />
                    </Border>
                </StackPanel>
                <TextBlock Text="سجّل قطع الغيار المخصصة لورشة الصيانة وحدّث الكميات وأسعار التكلفة والتركيب؛ تُصرف هذه القطع وتُعاد تلقائيًا عبر شاشة إجراءات الصيانة فقط."
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="12.5"
                           Foreground="#64748B"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <!-- ══════════ ROW 1: WORKSPACE (TABLE LEFT + FORM RIGHT) ══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: SPARE PARTS TABLE + SEARCH & CATEGORY FILTER -->
            <Border Grid.Column="0" Style="{StaticResource SpareSectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Title + Search + Filter -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="205" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="إلغاء الفلاتر"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                Padding="12,7"
                                Command="{Binding ClearFiltersCommand}" />

                        <ComboBox Grid.Column="2"
                                  Style="{StaticResource PosComboBoxStyle}"
                                  ItemsSource="{Binding CategoryFilterOptions}"
                                  SelectedItem="{Binding SelectedCategoryFilter}"
                                  FlowDirection="RightToLeft" />

                        <Grid Grid.Column="4">
                            <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                     FlowDirection="RightToLeft"
                                     TextAlignment="Left"
                                     Padding="34,7,12,7"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="ابحث باسم قطعة الغيار أو الفئة أو الكود..."
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="12,0,34,0"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="#94A3B8"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                            <Button Content="×"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="6,0,0,0"
                                    Width="24"
                                    Height="24"
                                    Style="{StaticResource PosDangerIconButtonStyle}"
                                    ToolTip="مسح البحث"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}" />
                        </Grid>
                    </Grid>

                    <!-- Table Header (RTL columns inside LTR Grid: Actions on far left, Code on far right) -->
                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="10,9"
                            Margin="0,0,0,6">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="2.1*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="132" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="الكود" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="1" Text="اسم قطعة الغيار" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="2" Text="الفئة" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="3" Text="الكمية" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="4" Text="سعر التكلفة" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="5" Text="سعر التركيب" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                            <TextBlock Grid.Column="6" Text="الإجراءات" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                        </Grid>
                    </Border>

                    <!-- Spare Parts Rows -->
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredSpareParts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,9" CornerRadius="10" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8FAFC" />
                                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#ECFEFF" />
                                                            <Setter Property="BorderBrush" Value="#147D92" />
                                                            <Setter Property="BorderThickness" Value="1.5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="2.1*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="95" />
                                                    <ColumnDefinition Width="105" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="132" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding CodeDisplay}"
                                                           Style="{StaticResource PosLtrTextStyle}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#147D92" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource PosRtlTextStyle}"
                                                               FontSize="13.5"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding UnitProfitDisplay, StringFormat='هامش الربح المتوقع للوحدة: {0}'}"
                                                               Style="{StaticResource PosRtlTextStyle}"
                                                               FontSize="11"
                                                               Foreground="#64748B" />
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Padding="8,3"
                                                        CornerRadius="6"
                                                        Background="#F1F5F9">
                                                    <TextBlock Text="{Binding Category}"
                                                               Style="{StaticResource PosRtlTextStyle}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#334155" />
                                                </Border>

                                                <Border Grid.Column="3"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Padding="9,4"
                                                        CornerRadius="7">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#DCFCE7" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding QuantityDisplay}" FontSize="12" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                                <Setter Property="Foreground" Value="#166534" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                        <Setter Property="Foreground" Value="#B45309" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                        <Setter Property="Foreground" Value="#B42318" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding CostPriceDisplay}"
                                                           Style="{StaticResource PosLtrTextStyle}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#475569" />

                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding SellPriceDisplay}"
                                                           Style="{StaticResource PosLtrTextStyle}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#0F766E" />

                                                <StackPanel Grid.Column="6"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Button Content="تعديل"
                                                            Style="{StaticResource PosOutlineTealButtonStyle}"
                                                            Padding="10,4"
                                                            FontSize="11.5"
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="حذف"
                                                            Style="{StaticResource PosDangerButtonStyle}"
                                                            Padding="10,4"
                                                            FontSize="11.5"
                                                            Command="{Binding DataContext.DeletePartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <Border Visibility="{Binding HasNoFilteredSpareParts, Converter={StaticResource BoolToVis}}"
                                Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="26"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="لا توجد قطع غيار مطابقة للبحث أو الفلتر الحالي"
                                           Style="{StaticResource PosCenterTextStyle}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#102E48" />
                                <TextBlock Text="جرّب تغيير كلمة البحث أو إعادة تعيين الفلتر أو تسجيل قطعة غيار جديدة من النموذج المجاور."
                                           Style="{StaticResource PosCenterTextStyle}"
                                           FontSize="12.5"
                                           Foreground="#64748B"
                                           Margin="0,6,0,12" />
                                <Button Content="عرض جميع قطع الغيار"
                                        Style="{StaticResource PosPrimaryCompactButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Command="{Binding ClearFiltersCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT: SIMPLIFIED SPARE PART REGISTRATION / EDIT FORM -->
            <Border Grid.Column="2" Style="{StaticResource SpareSectionCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Form Header -->
                        <Border Padding="11,9"
                                CornerRadius="10"
                                Margin="0,0,0,14"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F0FDFA" />
                                    <Setter Property="BorderBrush" Value="#99F6E4" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Background" Value="#FEF3C7" />
                                            <Setter Property="BorderBrush" Value="#FCD34D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding FormHeaderTitle}"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#102E48" />
                                <TextBlock Text="أدخل بيانات قطعة الغيار الأساسية ليتم حفظها في مخزون الصيانة فقط."
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="11.5"
                                           Foreground="#475569"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Part Name -->
                        <TextBlock Text="اسم قطعة الغيار *"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5" />
                        <Grid Margin="0,0,0,12">
                            <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                     FlowDirection="RightToLeft"
                                     TextAlignment="Left"
                                     Text="{Binding PartName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="مثال: شاشة iPhone 13 Pro Max أصلية"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="10,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding PartName, Converter={StaticResource StringEmptyToVis}}" />
                        </Grid>

                        <!-- Category -->
                        <TextBlock Text="الفئة *"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  ItemsSource="{Binding CategoryOptions}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  FlowDirection="RightToLeft"
                                  Margin="0,0,0,12" />

                        <!-- Optional Custom Category when 'أخرى' is chosen -->
                        <StackPanel Visibility="{Binding IsCustomCategorySelected, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,12">
                            <TextBlock Text="اسم الفئة المخصصة *"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5" />
                            <Grid>
                                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                         FlowDirection="RightToLeft"
                                         TextAlignment="Left"
                                         Text="{Binding CustomCategoryName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="أدخل اسم الفئة الجديدة..."
                                           Style="{StaticResource PosRtlTextStyle}"
                                           Margin="10,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding CustomCategoryName, Converter={StaticResource StringEmptyToVis}}" />
                            </Grid>
                        </StackPanel>

                        <!-- Quantity -->
                        <TextBlock Text="الكمية المتوفرة *"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5" />
                        <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                 Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" />

                        <!-- Cost Price & Sell Price -->
                        <Grid FlowDirection="RightToLeft" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="سعر التكلفة *"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                         Text="{Binding CostPriceText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="سعر التركيب / البيع *"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                         Text="{Binding SellPriceText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <!-- Expected Unit Profit Preview -->
                        <Border Padding="11,9"
                                CornerRadius="9"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                Margin="0,0,0,14">
                            <Grid FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="ربح القطعة المتوقع (سعر التركيب - التكلفة)"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="#475569" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PreviewProfitDisplay}"
                                           Style="{StaticResource PosLtrTextStyle}"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#0F766E" />
                            </Grid>
                        </Border>

                        <!-- Primary Action Buttons -->
                        <Button Content="{Binding SaveButtonText}"
                                Style="{StaticResource PosPrimaryCompactButtonStyle}"
                                MinHeight="42"
                                FontSize="14"
                                Command="{Binding SavePartCommand}" />

                        <Button Content="إلغاء التعديل"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                MinHeight="38"
                                Margin="0,8,0,0"
                                Command="{Binding CancelEditCommand}"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" />

                        <!-- Informational Note -->
                        <Border Margin="0,14,0,0"
                                Padding="10,9"
                                CornerRadius="9"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">
                            <TextBlock Text="ملاحظة: عند صرف أي قطعة غيار من هذا المخزون في شاشة «إجراءات الصيانة» يتم خصم الكمية تلقائيًا، وتُعاد للرصيد عند حذف البند أو إلغاء التذكرة."
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="11.5"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══════════ ROW 2: STATUS BAR ══════════ -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12,9"
                CornerRadius="10"
                BorderThickness="1"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="#065F46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="#991B1B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
