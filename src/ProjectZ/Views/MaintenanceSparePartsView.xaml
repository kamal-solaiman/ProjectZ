                                               Style="{StaticResource PosCenterTextStyle}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

