                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding SupplierDisplay}"
                                                                       Style="{StaticResource PosRtlTextStyle}"
                                                                       FontSize="8.5"
                                                                       Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip="{Binding SupplierDisplay}" />
                                                            <Button Grid.Column="1"
