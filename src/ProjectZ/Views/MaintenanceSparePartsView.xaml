                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Theme.Legacy.334155.Text}" />


                                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="2,0">
                                                        <Grid Visibility="{Binding HasSupplier, Converter={StaticResource BoolToVis}}">
