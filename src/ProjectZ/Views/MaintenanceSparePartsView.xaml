                                                                        <DataTrigger Binding="{Binding Kind}" Value="Issue"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.DangerInk}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="AdjustmentIncrease"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.WarningInk}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="AdjustmentDecrease"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.DangerInk}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
