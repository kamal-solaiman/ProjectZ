                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding OrderDisplay}"
                                                                       Style="{StaticResource PosLtrTextStyle}"
                                                                       FontSize="8.5"
                                                                       Foreground="{DynamicResource Theme.Legacy.147D92.AccentInk}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Button Grid.Column="1"
                                                                    Content="الأمر"
                                                                    Style="{StaticResource PosOutlineTealButtonStyle}"
