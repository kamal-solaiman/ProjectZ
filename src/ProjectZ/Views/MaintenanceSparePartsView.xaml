                                                                    Visibility="{Binding HasOrder, Converter={StaticResource BoolToVis}}"
                                                                    Command="{Binding DataContext.OpenOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                        <Grid Margin="0,1,0,0" Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVis}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding CustomerDisplay}"
                                                                       Style="{StaticResource PosRtlTextStyle}"
                                                                       FontSize="8.5"
                                                                       Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Button Grid.Column="1"
                                                                    Content="العميل"
                                                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                                                    Padding="3,1"
                                                                    FontSize="8"
                                                                    Margin="3,0,0,0"
                                                                    Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVis}}"
                                                                    Command="{Binding DataContext.OpenCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding NoteWithReferenceDisplay}"
                                                                   Style="{StaticResource PosRtlTextStyle}"
                                                                   FontSize="8"
                                                                   Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,1,0,0"
                                                                   ToolTip="{Binding NoteWithReferenceDisplay}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Visibility="{Binding HasNoFilteredMovements, Converter={StaticResource BoolToVis}}"
