                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding BalanceDisplay}"
                                                               Style="{StaticResource PosLtrTextStyle}"
