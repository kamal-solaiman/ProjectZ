                                                                    <DataTrigger Binding="{Binding Kind}" Value="Return"><Setter Property="Background" Value="{DynamicResource Theme.Brush.AccentSoft}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Issue"><Setter Property="Background" Value="{DynamicResource Theme.Brush.DangerSoft}" /></DataTrigger>
