<UserControl x:Class="ProjectZ.Views.MaintenanceSparePartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProjectZ.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MaintenanceSparePartsViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PosStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SpareSectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FFFFFF.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.E2E8F0.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="SpareTabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.F1F5F9.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.334155.Text}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid FlowDirection="LeftToRight" Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════ ROW 0: HEADER ══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="إجراءات الصيانة"
                        Style="{StaticResource PosOutlineTealButtonStyle}"
                        Command="{Binding GoToActionsCommand}"
                        Margin="0,0,7,0" />
                <Button Content="تحديث من SQL"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Command="{Binding RefreshDataCommand}"
                        Margin="0,0,7,0" />
                <Button Content="تفريغ الحقول"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Command="{Binding ResetFormCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="قطع الغيار — مخزون الصيانة"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                    <Border Margin="10,0,0,0"
                            Padding="9,4"
                            CornerRadius="8"
                            Background="{DynamicResource Theme.Legacy.E0F2FE.InfoSoft}"
                            BorderBrush="{DynamicResource Theme.Legacy.7DD3FC.InfoBorder}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTip="{Binding ConnectionBadgeDetail}">
                        <TextBlock Text="{Binding ConnectionBadgeText}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Legacy.0369A1.InfoInk}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="سجّل قطع الغيار وحدّد المورد والباركود وحد إعادة الطلب؛ التوريد والصرف والإرجاع تُسجَّل تلقائيًا في سجل الحركات وتظهر في الموردين والعملاء."
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="12"
                           Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- ══════════ ROW 1: COMPACT SUMMARY STRIP (no KPI cards) ══════════ -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12,8"
                CornerRadius="10"
                Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1">
            <Grid FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding InventorySummaryText}"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MovementsSummaryText}"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="11"
                               Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}"
                               Margin="0,0,12,0" />
                    <TextBlock Text="آخر تحديث: "
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="10.5"
                               Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" />
                    <TextBlock Text="{Binding LastRefreshDisplay}"
                               Style="{StaticResource PosLtrTextStyle}"
                               FontSize="10.5"
                               Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ ROW 2: WORKSPACE ══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: INVENTORY + MOVEMENT LEDGER -->
            <Border Grid.Column="0" Style="{StaticResource SpareSectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filters: search on its own row, then the three pickers, so the table keeps
                         its columns on a narrow window instead of squeezing the search box. -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                         FlowDirection="RightToLeft"
                                         TextAlignment="Left"
                                         Padding="34,7,12,7"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="ابحث بالاسم أو الباركود أو المورد أو الكود..."
                                           Style="{StaticResource PosRtlTextStyle}"
                                           Margin="12,0,34,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                                <Button Content="×"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="6,0,0,0"
                                        Width="24"
                                        Height="24"
                                        Style="{StaticResource PosDangerIconButtonStyle}"
                                        ToolTip="مسح البحث"
                                        Command="{Binding ClearSearchCommand}"
                                        Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}" />
                            </Grid>

                            <Button Grid.Column="2"
                                    Content="إلغاء الفلاتر"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Padding="10,7"
                                    Command="{Binding ClearFiltersCommand}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      Style="{StaticResource PosComboBoxStyle}"
                                      ItemsSource="{Binding CategoryFilterOptions}"
                                      SelectedItem="{Binding SelectedCategoryFilter}"
                                      FlowDirection="RightToLeft"
                                      ToolTip="فلتر الفئة" />

                            <ComboBox Grid.Column="2"
                                      Style="{StaticResource PosComboBoxStyle}"
                                      ItemsSource="{Binding SupplierFilterOptions}"
                                      SelectedItem="{Binding SelectedSupplierFilter}"
                                      FlowDirection="RightToLeft"
                                      ToolTip="فلتر المورد" />

                            <ComboBox Grid.Column="4"
                                      Style="{StaticResource PosComboBoxStyle}"
                                      ItemsSource="{Binding StockFilterOptions}"
                                      SelectedItem="{Binding SelectedStockFilter}"
                                      FlowDirection="RightToLeft"
                                      ToolTip="فلتر حالة الرصيد" />
                        </Grid>
                    </Grid>

                    <!-- Workspace tabs -->
                    <Grid Grid.Row="1" FlowDirection="RightToLeft" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="{Binding InventoryTabTitle}"
                                Command="{Binding SelectWorkspaceTabCommand}"
                                CommandParameter="0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SpareTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInventoryTabSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.147D92.Accent}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.147D92.Accent}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="2"
                                Content="{Binding MovementsTabTitle}"
                                Command="{Binding SelectWorkspaceTabCommand}"
                                CommandParameter="1">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SpareTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMovementsTabSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.102E48.Navigation}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.102E48.Border}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- INVENTORY TAB -->
                    <Grid Grid.Row="2" Visibility="{Binding IsInventoryTabSelected, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="9,8"
                                Margin="0,0,0,6">
                            <Grid FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="الكود" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                <TextBlock Grid.Column="1" Text="القطعة" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                <TextBlock Grid.Column="2" Text="المورد" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                <TextBlock Grid.Column="3" Text="الرصيد" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                <TextBlock Grid.Column="4" Text="الأسعار" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                <TextBlock Grid.Column="5" Text="الإجراءات" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding FilteredSpareParts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="9,8" CornerRadius="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FFFFFF.Surface}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.E2E8F0.Border}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.F8FAFC.Surface}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFEFF.AccentSoft}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.147D92.Accent}" />
                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid FlowDirection="RightToLeft">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="110" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding CodeDisplay}"
                                                               Style="{StaticResource PosLtrTextStyle}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Theme.Legacy.147D92.AccentInk}" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{StaticResource PosRtlTextStyle}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}" />
                                                        <TextBlock Text="{Binding BarcodeDisplay}"
                                                                   Style="{StaticResource PosLtrTextStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                                                   Margin="0,1,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CategoryUnitDisplay}"
                                                                   Style="{StaticResource PosRtlTextStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                                                   Margin="0,1,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>


                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SupplierDisplay}"
                                                                   Style="{StaticResource PosRtlTextStyle}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding SupplierDisplay}" />
                                                        <TextBlock Text="{Binding StorageDisplay}"
                                                                   Style="{StaticResource PosRtlTextStyle}"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding StorageDisplay}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                        <Border HorizontalAlignment="Center" Padding="8,3" CornerRadius="7">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.DCFCE7.SuccessSoft}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEF3C7.WarningSoft}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEE2E2.DangerSoft}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding QuantityDisplay}" FontSize="10.5" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.166534.SuccessInk}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B45309.WarningInk}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Text="{Binding StockAlertDisplay}"
                                                                   Style="{StaticResource PosCenterTextStyle}"
                                                                   FontSize="8.5"
                                                                   Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CostPriceDisplay}"
                                                                   Style="{StaticResource PosLtrTextStyle}"
                                                                   HorizontalAlignment="Center"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                                                   ToolTip="سعر التكلفة"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SellPriceDisplay}"
                                                                   Style="{StaticResource PosLtrTextStyle}"
                                                                   HorizontalAlignment="Center"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}"
                                                                   ToolTip="سعر التركيب للعميل"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding UnitProfitDisplay}"
                                                                   HorizontalAlignment="Center"
                                                                   FontSize="8"
                                                                   ToolTip="هامش الربح للوحدة (سالب = خسارة)"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PosLtrTextStyle}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.94A3B8.Muted}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="5"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <Button Content="تعديل"
                                                                Style="{StaticResource PosOutlineTealButtonStyle}"
                                                                Padding="3,3"
                                                                FontSize="8.5"
                                                                Margin="0,0,2,0"
                                                                Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="توريد"
                                                                Style="{StaticResource PosPrimaryCompactButtonStyle}"
                                                                Padding="3,3"
                                                                FontSize="8.5"
                                                                Margin="0,0,2,0"
                                                                ToolTip="إضافة رصيد من مورد وتسجيل حركة توريد"
                                                                Command="{Binding DataContext.RestockPartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="حذف"
                                                                Style="{StaticResource PosDangerButtonStyle}"
                                                                Padding="3,3"
                                                                FontSize="8.5"
                                                                Command="{Binding DataContext.DeletePartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Visibility="{Binding HasNoFilteredSpareParts, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                                    BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="24"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="لا توجد قطع غيار مطابقة للبحث أو الفلتر الحالي"
                                               Style="{StaticResource PosCenterTextStyle}"
                                               FontSize="14.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                    <TextBlock Text="جرّب تغيير البحث أو إعادة ضبط الفلاتر أو تسجيل قطعة غيار جديدة من النموذج المجاور."
                                               Style="{StaticResource PosCenterTextStyle}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                               Margin="0,6,0,12" />
                                    <Button Content="عرض جميع قطع الغيار"
                                            Style="{StaticResource PosPrimaryCompactButtonStyle}"
                                            HorizontalAlignment="Center"
                                            Command="{Binding ClearFiltersCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- MOVEMENTS TAB -->
                    <Grid Grid.Row="2" Visibility="{Binding IsMovementsTabSelected, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      Style="{StaticResource PosComboBoxStyle}"
                                      ItemsSource="{Binding MovementKindFilterOptions}"
                                      SelectedItem="{Binding SelectedMovementKindFilter}"
                                      FlowDirection="RightToLeft" />

                            <Grid Grid.Column="2">
                                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                         FlowDirection="RightToLeft"
                                         TextAlignment="Left"
                                         Padding="34,7,12,7"
                                         Text="{Binding MovementSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="ابحث بالقطعة أو المورد أو العميل أو رقم الأمر..."
                                           Style="{StaticResource PosRtlTextStyle}"
                                           Margin="12,0,34,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding MovementSearchText, Converter={StaticResource StringEmptyToVis}}" />
