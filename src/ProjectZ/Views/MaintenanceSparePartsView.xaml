                                                                    Visibility="{Binding HasSupplier, Converter={StaticResource BoolToVis}}"
                                                                    Command="{Binding DataContext.OpenSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                        <Grid Margin="0,1,0,0" Visibility="{Binding HasOrder, Converter={StaticResource BoolToVis}}">
