<UserControl x:Class="ProjectZ.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Language="ar-EG">

    <UserControl.Resources>
        <Style x:Key="CatActionBtnBaseStyle" TargetType="Button">
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header Strip -->
        <Grid Grid.Row="0" Margin="0,0,0,12" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="الانتقال لإضافة منتج"
                    Style="{StaticResource PosOutlineTealButtonStyle}"
                    Padding="12,7"
                    FontSize="12.5"
                    VerticalAlignment="Center"
                    Command="{Binding GoToAddProductCommand}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft">
                <TextBlock Text="التصنيفات"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#102E48"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        Background="#DCFCE7"
                        BorderBrush="#BBF7D0"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="متصل بقاعدة البيانات"
                               Style="{StaticResource PosCenterTextStyle}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#15803D" />
                </Border>
                <Button Margin="10,0,0,0"
                        Content="تحديث التصنيفات"
                        Style="{StaticResource PosOutlineTealButtonStyle}"
                        Padding="12,7"
                        FontSize="12.5"
                        VerticalAlignment="Center"
                        Command="{Binding RefreshCategoriesCommand}" />
            </StackPanel>
        </Grid>

        <!-- ROW 1: Add New Category + Search & Count Card -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="14"
                CornerRadius="14"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Count Badges: total, used, unused -->
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Orientation="Horizontal" FlowDirection="LeftToRight">
                    <Border Padding="12,8"
                            CornerRadius="9"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1">
                        <TextBlock Text="{Binding TotalCountDisplay}"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#1D4ED8" />
                    </Border>
                    <Border Margin="6,0,0,0"
                            Padding="12,8"
                            CornerRadius="9"
                            Background="#ECFDF5"
                            BorderBrush="#A7F3D0"
                            BorderThickness="1">
                        <TextBlock Text="{Binding UsedCategoriesDisplay}"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#047857" />
                    </Border>
                    <Border Margin="6,0,0,0"
                            Padding="12,8"
                            CornerRadius="9"
                            Background="#FFF7ED"
                            BorderBrush="#FED7AA"
                            BorderThickness="1">
                        <TextBlock Text="{Binding EmptyCategoriesDisplay}"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#C2410C" />
                    </Border>
                    <Button Margin="6,0,0,0"
                            Content="المستخدمة فقط"
                            Style="{StaticResource CatActionBtnBaseStyle}"
                            Background="#F8FAFC"
                            Foreground="#475569"
                            BorderBrush="#C7D2DE"
                            Command="{Binding ToggleOnlyUsedCommand}"
                            ToolTip="إظهار التصنيفات المستخدمة في أصناف فقط، واضغط مرة أخرى لإلغاء الفلتر" />
                </StackPanel>

                <!-- Search Categories Box -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="بحث في التصنيفات"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,5"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#475569" />
                    <Grid>
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 Padding="10,7,30,7"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="ابحث باسم التصنيف..."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="30,0,10,0"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="#94A3B8"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                        <Button Content="×"
                                Width="22"
                                Height="22"
                                Margin="6,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource PosDangerIconButtonStyle}"
                                Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}"
                                Command="{Binding ClearSearchCommand}" />
                    </Grid>
                </StackPanel>

                <!-- Add New Category Input & Button -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="إضافة تصنيف جديد (يُدرج في قائمة التصنيف بشاشة إضافة منتج)"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,5"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#102E48" />
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="+ إضافة تصنيف"
                                Style="{StaticResource PosPrimaryCompactButtonStyle}"
                                Padding="18,8"
                                MinHeight="36"
                                Command="{Binding AddCategoryCommand}" />

                        <Grid Grid.Column="2">
                            <TextBox x:Name="NewCategoryInput"
                                     Style="{StaticResource PosCompactTextBoxStyle}"
                                     FlowDirection="RightToLeft"
                                     TextAlignment="Left"
                                     MaxLength="80"
                                     Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddCategoryCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="أدخل اسم التصنيف الجديد، مثال: ساعات ذكية..."
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="12,0,12,0"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="#94A3B8"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding NewCategoryName, Converter={StaticResource StringEmptyToVis}}" />
                        </Grid>
                    </Grid>
                    <Grid Margin="0,6,0,0" FlowDirection="LeftToRight">
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 MaxLength="500"
                                 MinHeight="32"
                                 Text="{Binding NewCategoryDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="وصف اختياري للتصنيف (يظهر في الشاشة فقط)..."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="12,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding NewCategoryDescription, Converter={StaticResource StringEmptyToVis}}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: Categories Names Table -->
        <Border Grid.Row="2"
                CornerRadius="14"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0"
                        Background="#102E48"
                        CornerRadius="13,13,0,0"
                        Padding="14,11"
                        FlowDirection="LeftToRight">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="م"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#B7CFDD" />
                        <TextBlock Grid.Column="1"
                                   Text="اسم التصنيف والوصف"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="8,0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Grid.Column="2"
                                   Text="عدد الأصناف"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#B7CFDD" />
                        <TextBlock Grid.Column="3"
                                   Text="التحكم"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#6EE7D8" />
                    </Grid>
                </Border>

                <!-- Table Rows -->
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  FlowDirection="LeftToRight">
                        <ItemsControl ItemsSource="{Binding FilteredCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,10"
                                            BorderBrush="#F1F5F9"
                                            BorderThickness="0,0,0,1"
                                            Background="White">
                                        <Grid FlowDirection="RightToLeft">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Order Badge -->
                                            <Border Grid.Column="0"
                                                    MinWidth="34"
                                                    Padding="8,4"
                                                    CornerRadius="8"
                                                    Background="#F1F5F9"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OrderDisplay}"
                                                           Style="{StaticResource PosCenterTextStyle}"
                                                           FontSize="12.5"
                                                           FontWeight="Bold"
                                                           Foreground="#334155" />
                                            </Border>

                                            <!-- Category Name + Description / Inline Edit Boxes -->
                                            <Grid Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                <StackPanel Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource PosRtlTextStyle}"
                                                               FontSize="14.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#172B41"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DescriptionDisplay}"
                                                               Style="{StaticResource PosRtlTextStyle}"
                                                               Margin="0,2,0,0"
                                                               FontSize="11.5"
                                                               Foreground="#64748B"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                                             MinHeight="34"
                                                             Padding="10,5"
                                                             FlowDirection="RightToLeft"
                                                             TextAlignment="Left"
                                                             MaxLength="200"
                                                             Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                             IsVisibleChanged="InlineEditBox_IsVisibleChanged">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Return" Command="{Binding SaveEditCommand}" />
                                                            <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                                             Margin="0,5,0,0"
                                                             MinHeight="30"
                                                             Padding="10,4"
                                                             FlowDirection="RightToLeft"
                                                             TextAlignment="Left"
                                                             MaxLength="500"
                                                             FontSize="11.5"
                                                             Text="{Binding EditingDescription, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Products Count -->
                                            <Border Grid.Column="2"
                                                    Padding="10,5"
                                                    CornerRadius="8"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="#F1F5F9"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding ProductsCountDisplay}"
                                                           Style="{StaticResource PosCenterTextStyle}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334155" />
                                            </Border>

                                            <!-- Action Buttons (Normal vs Edit Mode) -->
                                            <Grid Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Normal Mode: Edit + Delete -->
                                                <StackPanel Orientation="Horizontal"
                                                            FlowDirection="RightToLeft"
                                                            Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="تعديل"
                                                            Style="{StaticResource CatActionBtnBaseStyle}"
                                                            Background="#EFF6FF"
                                                            Foreground="#1D4ED8"
                                                            BorderBrush="#BFDBFE"
                                                            Command="{Binding BeginEditCommand}" />
                                                    <Button Content="حذف"
                                                            Style="{StaticResource CatActionBtnBaseStyle}"
                                                            Background="#FEF2F2"
                                                            Foreground="#B42318"
                                                            BorderBrush="#FECACA"
                                                            IsEnabled="{Binding CanDelete}"
                                                            ToolTip="الحذف متاح فقط لتصنيف غير مستخدم في أي صنف"
                                                            Command="{Binding DeleteCommand}" />
                                                </StackPanel>

                                                <!-- Edit Mode: Save + Cancel -->
                                                <StackPanel Orientation="Horizontal"
                                                            FlowDirection="RightToLeft"
                                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="حفظ"
                                                            Style="{StaticResource CatActionBtnBaseStyle}"
                                                            Background="#0F766E"
                                                            Foreground="White"
                                                            BorderBrush="#0F766E"
                                                            Command="{Binding SaveEditCommand}" />
                                                    <Button Content="إلغاء"
                                                            Style="{StaticResource CatActionBtnBaseStyle}"
                                                            Background="#F1F5F9"
                                                            Foreground="#334155"
                                                            BorderBrush="#CBD5E1"
                                                            Command="{Binding CancelEditCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding EmptyStateText}"
                               Style="{StaticResource PosCenterTextStyle}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="#94A3B8"
                               Visibility="{Binding HasNoCategories, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ROW 3: Status Strip -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                FlowDirection="LeftToRight"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="#065F46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="#B42318" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
