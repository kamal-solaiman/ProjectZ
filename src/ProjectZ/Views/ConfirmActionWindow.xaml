<Window x:Class="ProjectZ.Views.ConfirmActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | تأكيد الإجراء'}"
        Width="460"
        Height="290"
        MinWidth="400"
        MinHeight="250"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid FlowDirection="LeftToRight">
        <ContentControl Style="{StaticResource ThemeBackdropStyle}" />
    <Grid Margin="20" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="16,12"
                CornerRadius="14"
                Background="{DynamicResource Theme.Legacy.7F1D1D.Danger}"
                FlowDirection="LeftToRight">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnDanger}" />
                <TextBlock Text="{Binding Subtitle}"
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="0,3,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Theme.Legacy.FECACA.DangerInk}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="16"
                CornerRadius="12"
                Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <TextBlock Text="{Binding Message}"
                       Style="{StaticResource PosRtlTextStyle}"
                       VerticalAlignment="Center"
                       FontSize="13.5"
                       Foreground="{DynamicResource Theme.Legacy.172B41.Text}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إلغاء"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="105"
                    Padding="16,9"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="2"
                    Content="{Binding ConfirmButtonText}"
                    Style="{StaticResource PosDangerButtonStyle}"
                    MinWidth="150"
                    Padding="18,9"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
