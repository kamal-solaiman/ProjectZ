<Window x:Class="ProjectZ.Views.ProductRegistrationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectZ | قائمة تسجيلات المنتج والموردين"
        Width="960"
        Height="650"
        MinWidth="760"
        MinHeight="480"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navy Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16,13"
                CornerRadius="14"
                Background="#102E48"
                FlowDirection="LeftToRight">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Quick Stats Badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <Border Padding="10,4" CornerRadius="8" Background="#0F766E">
                        <TextBlock Text="{Binding AvailableFilterLabel}" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <Border Margin="6,0,0,0" Padding="10,4" CornerRadius="8" Background="#334155">
                        <TextBlock Text="{Binding SoldFilterLabel}" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0" />
                    </Border>
                    <Border Margin="6,0,0,0" Padding="10,4" CornerRadius="8" Background="#B42318">
                        <TextBlock Text="{Binding DamagedFilterLabel}" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>

                <!-- Product Title & Barcode -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Product.Name}"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="0,3,0,0">
                        <TextBlock Text="قائمة جميع التسجيلات والقطع · باركود:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#B7CFDD" />
                        <TextBlock Text="{Binding Product.Barcode}" Style="{StaticResource PosLtrTextStyle}" Margin="6,0,0,0" FontSize="12" FontFamily="Consolas, Segoe UI" FontWeight="Bold" Foreground="#6EE7D8" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Supplier Breakdown Chips -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="10,8"
                CornerRadius="10"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                FlowDirection="RightToLeft">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="توزيع الكميات حسب المورد:"
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="0,0,0,5"
                           FontSize="11.5"
                           FontWeight="Bold"
                           Foreground="#475569" />
                <ItemsControl ItemsSource="{Binding SupplierSummaries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2,6,2"
                                    Padding="10,4"
                                    CornerRadius="8"
                                    Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding SummaryText}"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#102E48" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Filter & Quick Damage Reason Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,10" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Search by ID / Supplier / Invoice -->
            <Grid Grid.Column="0">
                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                         Padding="10,6,30,6"
                         FlowDirection="RightToLeft"
                         TextAlignment="Left"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="بحث برقم ID أو المورد أو الفاتورة..."
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="28,0,10,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#94A3B8"
                           IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                <Button Content="×"
                        Width="22"
                        Height="22"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource PosDangerIconButtonStyle}"
                        Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}"
                        Command="{Binding ClearSearchCommand}" />
            </Grid>

            <!-- Status Filter Pills -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                <Button Content="{Binding AllFilterLabel}" Command="{Binding SelectAllFilterCommand}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="FontSize" Value="12" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                    <Setter Property="Background" Value="#102E48" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding AvailableFilterLabel}" Command="{Binding SelectAvailableFilterCommand}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="FontSize" Value="12" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailableSelected}" Value="True">
                                    <Setter Property="Background" Value="#0F766E" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding SoldFilterLabel}" Command="{Binding SelectSoldFilterCommand}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="FontSize" Value="12" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSoldSelected}" Value="True">
                                    <Setter Property="Background" Value="#475569" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding DamagedFilterLabel}" Command="{Binding SelectDamagedFilterCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="FontSize" Value="12" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDamagedSelected}" Value="True">
                                    <Setter Property="Background" Value="#B42318" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Registrations Table Card -->
        <Border Grid.Row="3"
                CornerRadius="12"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Headers (RTL: ID | الاسم | سعر الشراء | اسم المورد | تاريخ التسجيل | الحالة | ID الفاتورة | إجراء) -->
                <Border Grid.Row="0"
                        Padding="12,9,24,9"
                        CornerRadius="11,11,0,0"
                        Background="#F1F5F9"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,0,0,1">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="94" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                        <TextBlock Grid.Column="1" Text="الاسم" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                        <TextBlock Grid.Column="2" Text="سعر الشراء" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                        <TextBlock Grid.Column="3" Text="اسم المورد" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                        <TextBlock Grid.Column="4" Text="تاريخ التسجيل" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                        <TextBlock Grid.Column="5" Text="الحالة" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                        <TextBlock Grid.Column="6" Text="ID الفاتورة" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                        <TextBlock Grid.Column="7" Text="إجراء" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                    </Grid>
                </Border>

                <!-- Rows -->
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  FlowDirection="LeftToRight">
                        <ItemsControl ItemsSource="{Binding FilteredRegistrations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8"
                                            Background="White"
                                            BorderBrush="#F1F5F9"
                                            BorderThickness="0,0,0,1">
                                        <Grid FlowDirection="RightToLeft">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="125" />
                                                <ColumnDefinition Width="94" />
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="96" />
                                            </Grid.ColumnDefinitions>

                                            <!-- ID -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding IdDisplay}"
                                                       Style="{StaticResource PosCenterTextStyle}"
                                                       FlowDirection="LeftToRight"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Consolas, Segoe UI"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#102E48" />

                                            <!-- Product Name and serial persistence -->
                                            <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}"
                                                           Style="{StaticResource PosRtlTextStyle}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,5,0,0"
                                                            Visibility="{Binding DataContext.Product.TrackSerialNumber, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource PosCompactTextBoxStyle}"
                                                             Width="145"
                                                             MinHeight="28"
                                                             Padding="5,2"
                                                             FontSize="11"
                                                             ToolTip="أدخل السيريال ثم اضغط حفظ"
                                                             IsEnabled="{Binding IsAvailable}" />
                                                    <Button Content="حفظ السيريال"
                                                            Margin="5,0,0,0"
                                                            Padding="6,2"
                                                            FontSize="10.5"
                                                            Style="{StaticResource PosOutlineTealButtonStyle}"
                                                            IsEnabled="{Binding IsAvailable}"
                                                            Command="{Binding DataContext.SaveSerialCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Purchase Price -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding PurchasePriceDisplay}"
                                                       Style="{StaticResource PosCenterTextStyle}"
                                                       FlowDirection="LeftToRight"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#334155" />

                                            <!-- Supplier Name -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding SupplierName}"
                                                       Style="{StaticResource PosRtlTextStyle}"
                                                       Margin="4,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0369A1"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Registration Date -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding RegisteredAtDisplay}"
                                                       Style="{StaticResource PosCenterTextStyle}"
                                                       FlowDirection="LeftToRight"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="#64748B" />

                                            <!-- Status Badge -->
                                            <Border Grid.Column="5"
                                                    Padding="6,3"
                                                    CornerRadius="6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#CCFBF1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSold}" Value="True">
                                                                <Setter Property="Background" Value="#E2E8F0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDamaged}" Value="True">
                                                                <Setter Property="Background" Value="#FEE2E2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusTitle}" FontSize="11.5" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                            <Setter Property="Foreground" Value="#0F766E" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSold}" Value="True">
                                                                    <Setter Property="Foreground" Value="#475569" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDamaged}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B42318" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Invoice ID -->
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding PurchaseInvoiceId}"
                                                       Style="{StaticResource PosCenterTextStyle}"
                                                       FlowDirection="LeftToRight"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Consolas, Segoe UI"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#475569" />

                                            <!-- Action -->
                                            <Grid Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="حركات"
                                                        Padding="6,4"
                                                        Margin="0,0,0,3"
                                                        FontSize="10.5"
                                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                                        Foreground="#4338CA"
                                                        BorderBrush="#C7D2FE"
                                                        Background="#EEF2FF"
                                                        ToolTip="سجل حركات هذه الوحدة من dbo.StockMovements"
                                                        Command="{Binding DataContext.ShowUnitMovementsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />

                                                <Button Content="تسجيل هالك"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                                        Foreground="#B42318"
                                                        BorderBrush="#FECACA"
                                                        Background="#FEF2F2"
                                                        Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.MarkUnitDamagedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />

                                                <Button Content="استرجاع للمتاح"
                                                        Padding="6,4"
                                                        FontSize="10.5"
                                                        Style="{StaticResource PosOutlineTealButtonStyle}"
                                                        Visibility="{Binding IsDamaged, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.RestoreUnitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />

                                                <TextBlock Text="—"
                                                           Style="{StaticResource PosCenterTextStyle}"
                                                           FontSize="12"
                                                           Foreground="#94A3B8"
                                                           Visibility="{Binding IsSold, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="لا توجد تسجيلات مطابقة للتصفية الحالية."
                               Style="{StaticResource PosCenterTextStyle}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="#94A3B8"
                               Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Unit movement ledger (dbo.StockMovements filtered by unit) -->
        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="10,8"
                CornerRadius="10"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Visibility="{Binding HasUnitMovements, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding UnitMovementsHeader}"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="12.5"
                           FontWeight="Bold"
                           Foreground="#102E48"
                           Margin="0,0,0,6" />
                <ItemsControl Grid.Row="1" MaxHeight="120" ItemsSource="{Binding UnitMovements}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3" FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding QuantityDisplay}"
                                           Style="{StaticResource PosLtrTextStyle}"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="#B42318"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding MovementTypeDisplay}"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#102E48" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ReasonDisplay}"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="11"
                                           Foreground="#334155"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding OccurredAtDisplay}"
                                           Style="{StaticResource PosLtrTextStyle}"
                                           FontSize="10.5"
                                           Foreground="#64748B" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Footer: Quick Damage Reason + Status + Close -->
        <Grid Grid.Row="5" Margin="0,12,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إغلاق"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    MinWidth="110"
                    Padding="18,9"
                    IsCancel="True"
                    Command="{Binding CloseCommand}" />

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <Grid FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="سبب التحويل السريع للهالك:"
                               Style="{StaticResource PosRtlTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569" />
                    <TextBox Grid.Column="1"
                             Style="{StaticResource PosCompactTextBoxStyle}"
                             MinHeight="30"
                             Padding="8,4"
                             FontSize="12"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             Text="{Binding QuickDamageReason, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusMessage}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#0F766E"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
