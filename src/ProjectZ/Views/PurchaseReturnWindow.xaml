<Window x:Class="ProjectZ.Views.PurchaseReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | مرتجع مشتريات للمورد'}"
        Width="800"
        Height="700"
        MinWidth="660"
        MinHeight="560"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16,12"
                CornerRadius="14"
                Background="#5B21B6">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <Button Content="تحديد كل غير المباع"
                            Style="{StaticResource PosSecondaryButtonStyle}"
                            Padding="11,6"
                            FontSize="12"
                            Command="{Binding SelectAllReturnableCommand}" />
                    <Button Content="تصفير"
                            Margin="6,0,0,0"
                            Style="{StaticResource PosSecondaryButtonStyle}"
                            Padding="10,6"
                            FontSize="12"
                            Command="{Binding ClearAllCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="مرتجع مشتريات للمورد (سحب من المخزون وتسوية الحساب)"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="16.5"
                               FontWeight="Bold"
                               Foreground="White" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Invoice.InvoiceNumber}" Style="{StaticResource PosLtrTextStyle}" FontFamily="Consolas, Segoe UI" FontSize="12.5" FontWeight="Bold" Foreground="#DDD6FE" />
                        <TextBlock Text=" · " Style="{StaticResource PosCenterTextStyle}" Foreground="#C4B5FD" />
                        <TextBlock Text="{Binding Invoice.SupplierName}" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Return Lines List -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12"
                CornerRadius="12"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Content="الأولوية لسحب القطع الهالكة أولًا عند الإرجاع"
                              Style="{StaticResource PosCheckBoxStyle}"
                              FontSize="12"
                              IsChecked="{Binding PreferDamagedFirst}" />
                    <TextBlock Grid.Column="1"
                               Text="حدد الكمية المراد إرجاعها للمورد من كل بند (القطع المباعة محمية تلقائيًا):"
                               Style="{StaticResource PosRtlTextStyle}"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="#102E48" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="12,10"
                                        CornerRadius="10"
                                        Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1">
                                    <Grid FlowDirection="LeftToRight">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Line Return Value -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="105">
                                            <TextBlock Text="قيمة المرتجع" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" Foreground="#64748B" />
                                            <TextBlock Text="{Binding LineReturnValueDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="13.5" FontWeight="Bold" Foreground="#6D28D9" />
                                        </StackPanel>

                                        <!-- Quantity Stepper + Direct Input -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                                            <Button Content="−" Style="{StaticResource PosStepperButtonStyle}" Command="{Binding DecrementCommand}" IsEnabled="{Binding CanReturnAny}" />
                                            <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                                     Width="52"
                                                     MinHeight="28"
                                                     Padding="4,3"
                                                     Margin="5,0"
                                                     TextAlignment="Center"
                                                     IsEnabled="{Binding CanReturnAny}"
                                                     Text="{Binding ReturnQuantityText, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="+" Style="{StaticResource PosStepperButtonStyle}" Command="{Binding IncrementCommand}" IsEnabled="{Binding CanReturnAny}" />
                                            <Button Content="الكل"
                                                    Margin="6,0,0,0"
                                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                                    Padding="8,3"
                                                    FontSize="11"
                                                    IsEnabled="{Binding CanReturnAny}"
                                                    Command="{Binding ReturnAllLineCommand}" />
                                        </StackPanel>

                                        <!-- Product Details -->
                                        <StackPanel Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Line.ProductName}"
                                                       Style="{StaticResource PosRtlTextStyle}"
                                                       FontSize="13.5"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding MaxReturnableDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F766E" />
                                                <TextBlock Text=" · تكلفة الشراء: " Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="#64748B" />
                                                <TextBlock Text="{Binding Line.UnitPurchaseCostDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" Foreground="#334155" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding StockBreakdownDisplay}"
                                                       Style="{StaticResource PosRtlTextStyle}"
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="#64748B" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Return Reason & Financial Settlement -->
        <Border Grid.Row="2"
                Margin="0,0,0,10"
                Padding="14"
                CornerRadius="12"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="سبب المرتجع للمورد *"
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="0,0,0,6"
                           FontSize="12.5"
                           FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding QuickReasons}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" FlowDirection="RightToLeft" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Margin="0,2,6,2"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Padding="10,4"
                                    FontSize="11"
                                    Command="{Binding DataContext.PickReasonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,0,0,10" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ملاحظة إضافية (اختياري)" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,3" FontSize="11.5" Foreground="#475569" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="السبب المعتمد" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,3" FontSize="11.5" Foreground="#475569" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- Settlement Summary -->
                <Border Padding="12" CornerRadius="10" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1">
                    <StackPanel>
                        <UniformGrid Columns="4" FlowDirection="RightToLeft">
                            <StackPanel>
                                <TextBlock Text="القطع المرتجعة" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#5B21B6" />
                                <TextBlock Text="{Binding TotalReturnUnitsDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="14" FontWeight="Bold" Foreground="#102E48" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="قيمة المرتجع" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#5B21B6" />
                                <TextBlock Text="{Binding TotalReturnValueDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="14" FontWeight="Bold" Foreground="#6D28D9" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="يُخصم من الآجل" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#0F766E" />
                                <TextBlock Text="{Binding AppliedToCreditDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="14" FontWeight="Bold" Foreground="#0F766E" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="الآجل بعد التسوية" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#475569" />
                                <TextBlock Text="{Binding NewRemainingPayableDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="14" FontWeight="Bold" Foreground="#B42318" />
                            </StackPanel>
                        </UniformGrid>

                        <Grid Margin="0,10,0,0"
                              FlowDirection="LeftToRight"
                              Visibility="{Binding NeedsSupplierRefundChoice, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      Style="{StaticResource PosComboBoxStyle}"
                                      ItemsSource="{Binding RefundChannels}"
                                      SelectedItem="{Binding RefundChannel}" />

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#5B21B6">
                                    <Run Text="المبلغ المستحق استرداده من المورد: " />
                                    <Run Text="{Binding ExpectedRefundAboveCreditDisplay, Mode=OneWay}" />
                                    <Run Text=" (سيُسجّل فعليًا: " />
                                    <Run Text="{Binding CashRefundToReceiveDisplay, Mode=OneWay}" />
                                    <Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Error -->
        <Border Grid.Row="3"
                Margin="0,0,0,8"
                Padding="10,7"
                CornerRadius="8"
                Background="#FEF2F2"
                BorderBrush="#FECACA"
                BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="SemiBold" Foreground="#B42318" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إلغاء"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="14,9"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="2"
                    Content="تأكيد المرتجع وسحب المخزون"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    Background="#6D28D9"
                    MinWidth="210"
                    Padding="18,9"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}" />
        </Grid>
    </Grid>
</Window>
