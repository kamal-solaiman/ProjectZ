<Window x:Class="ProjectZ.Views.EditPurchaseInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | تعديل فاتورة شراء شاملة'}"
        Width="1080"
        Height="750"
        MinWidth="880"
        MinHeight="620"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid FlowDirection="LeftToRight">
        <ContentControl Style="{StaticResource ThemeBackdropStyle}" />
    <Grid Margin="16" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16,11"
                CornerRadius="14"
                Background="{DynamicResource Theme.Legacy.102E48.Navigation}">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="12,5" CornerRadius="8" Background="{DynamicResource Theme.Legacy.147D92.Accent}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LinesCountDisplay}"
                               Style="{StaticResource PosCenterTextStyle}"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                </Border>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="تعديل شامل لفاتورة الشراء (البنود والكميات والأسعار والمورد والماليات)"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="16.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Invoice.InvoiceNumber}" Style="{StaticResource PosLtrTextStyle}" FontFamily="Consolas, Segoe UI" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
                        <TextBlock Text=" · تحديث تلقائي لتسجيلات المخزون ورصيد المورد" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.CBD5E1.NavigationMuted}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Left = Metadata & Financials, Right = Add & Edit Lines -->
        <Grid Grid.Row="1" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Supplier, Metadata, Discount & Payment Channels -->
            <Border Grid.Column="0"
                    Padding="12"
                    CornerRadius="12"
                    Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                    BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Supplier Picker Card -->
                        <TextBlock Text="المورد المرتبط بالفاتورة"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                                   Margin="0,0,0,6" />
                        <Border Padding="10,8"
                                CornerRadius="10"
                                Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                                BorderBrush="{DynamicResource Theme.Legacy.147D92.Accent}"
                                BorderThickness="1.2">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="تغيير المورد"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Padding="9,4"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        Command="{Binding ToggleSupplierPickerCommand}" />

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding SelectedSupplier.Name}"
                                               Style="{StaticResource PosRtlTextStyle}"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                    <TextBlock Text="{Binding SelectedSupplier.SearchSubtitle}"
                                               Style="{StaticResource PosRtlTextStyle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Collapsible Supplier Selector -->
                        <Border Margin="0,6,0,0"
                                Padding="8"
                                CornerRadius="9"
                                Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                                BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}"
                                BorderThickness="1"
                                Visibility="{Binding IsSupplierPickerOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                         MinHeight="30"
                                         Padding="8,4"
                                         FontSize="12"
                                         FlowDirection="RightToLeft"
                                         TextAlignment="Left"
                                         Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="ابحث باسم المورد أو الهاتف..." />
                                <ScrollViewer MaxHeight="115" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredSuppliers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Padding="8,5"
                                                        Margin="0,1"
                                                        HorizontalContentAlignment="Stretch"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.SelectSupplierCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="SupItemBg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding SearchSubtitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="SupItemBg" Property="Background" Value="{DynamicResource Theme.Legacy.E0F2FE.InfoSoft}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Metadata -->
                        <Grid Margin="0,10,0,0" FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="135" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="رقم فاتورة المورد" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" Margin="0,0,0,3" />
                                <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                         MinHeight="30"
                                         Padding="8,4"
                                         FontSize="12"
                                         Text="{Binding SupplierInvoiceNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تاريخ التوريد" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" Margin="0,0,0,3" />
                                <DatePicker SelectedDate="{Binding PurchaseDate}" Height="30" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="ملاحظات الفاتورة" Style="{StaticResource PosRtlTextStyle}" Margin="0,8,0,3" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 MinHeight="32"
                                 Padding="8,5"
                                 FontSize="12"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Discount & Totals -->
                        <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6" FlowDirection="RightToLeft">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الخصم من المورد (ج.م)" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                    <TextBox Grid.Column="1" Style="{StaticResource PosNumericTextBoxStyle}" MinHeight="28" Padding="6,3" FontSize="12.5" Text="{Binding DiscountAmountText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid Margin="0,2,0,0" FlowDirection="RightToLeft">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الإجمالي قبل الخصم:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SubtotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,2,0,0" FlowDirection="RightToLeft" Visibility="{Binding HasReturnedGoods, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="مرتجعات سابقة:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.7C3AED.VioletInk}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ReturnedGoodsTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.7C3AED.VioletInk}" />
                                </Grid>

                                <Grid Margin="0,4,0,0" FlowDirection="RightToLeft">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="صافي الفاتورة:" Style="{StaticResource PosRtlTextStyle}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                    <TextBlock Grid.Column="1" Text="{Binding NetTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Payments Adjustment -->
                        <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="تصفير كآجل"
                                            Style="{StaticResource PosSecondaryButtonStyle}"
                                            Padding="7,3"
                                            FontSize="10.5"
                                            Command="{Binding ClearPaymentsToCreditCommand}" />
                                    <TextBlock Grid.Column="1"
                                               Text="تعديل المدفوعات للمورد"
                                               Style="{StaticResource PosRtlTextStyle}"
                                               VerticalAlignment="Center"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                </Grid>

                                <!-- Cash -->
                                <Grid Margin="0,0,0,6" FlowDirection="RightToLeft">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="باقي" Style="{StaticResource PosOutlineTealButtonStyle}" Padding="7,3" FontSize="10.5" Command="{Binding FillRemainingCashCommand}" />
                                    <TextBlock Grid.Column="1" Text="كاش (نقدي)" Style="{StaticResource PosRtlTextStyle}" Margin="6,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource PosNumericTextBoxStyle}" MinHeight="28" Padding="6,3" FontSize="12" Text="{Binding CashAmountText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <!-- Vodafone -->
                                <Grid Margin="0,0,0,6" FlowDirection="RightToLeft">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="84" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="باقي" Style="{StaticResource PosOutlineTealButtonStyle}" Padding="7,3" FontSize="10.5" Command="{Binding FillRemainingVodafoneCommand}" />
                                    <TextBlock Grid.Column="1" Text="فودافون" Style="{StaticResource PosRtlTextStyle}" Margin="6,0" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.C8102E.DangerInk}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource PosNumericTextBoxStyle}" MinHeight="28" Padding="6,3" FontSize="12" Text="{Binding VodafoneCashAmountText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <!-- InstaPay -->
                                <Grid Margin="0,0,0,8" FlowDirection="RightToLeft">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="84" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="باقي" Style="{StaticResource PosOutlineTealButtonStyle}" Padding="7,3" FontSize="10.5" Command="{Binding FillRemainingInstaPayCommand}" />
                                    <TextBlock Grid.Column="1" Text="إنستاباي" Style="{StaticResource PosRtlTextStyle}" Margin="6,0" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource PosNumericTextBoxStyle}" MinHeight="28" Padding="6,3" FontSize="12" Text="{Binding InstaPayAmountText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Border Padding="8" CornerRadius="8" Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}" BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}" BorderThickness="1">
                                    <Grid FlowDirection="RightToLeft">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="إجمالي المدفوع" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                            <TextBlock Text="{Binding TotalPaidDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="المتبقي آجل" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                            <TextBlock Text="{Binding RemainingPayableDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT COLUMN: Quick Add Product & Editable Invoice Lines -->
            <Border Grid.Column="2"
                    Padding="12"
                    CornerRadius="12"
                    Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                    BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}"
                    BorderThickness="1">
                <Grid FlowDirection="LeftToRight">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Add New Product Search Box -->
                    <Grid Grid.Row="0" Margin="0,0,0,8" FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="إضافة صنف جديد للفاتورة:"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource PosCompactTextBoxStyle}"
                                 MinHeight="32"
                                 Padding="10,5"
                                 FontSize="12.5"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="ابحث باسم المنتج أو الباركود واضغط Enter لإضافته فورًا">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ScanOrSearchEnterCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>

                    <!-- Quick Catalog Pills -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding FilteredCatalog}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" FlowDirection="RightToLeft" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,2,6,2"
                                        Padding="9,4"
                                        Style="{StaticResource PosOutlineTealButtonStyle}"
                                        FontSize="11.5"
                                        Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                        <TextBlock Text="+" FontWeight="Bold" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Lines Table Header -->
                    <Border Grid.Row="2" Padding="10,7" CornerRadius="8,8,0,0" Background="{DynamicResource Theme.Legacy.102E48.Navigation}">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="135" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الصنف وحالة القفل بالمخزون" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                            <TextBlock Grid.Column="1" Text="سعر الشراء" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                            <TextBlock Grid.Column="2" Text="الكمية المشتراة" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                            <TextBlock Grid.Column="3" Text="الإجمالي" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
                            <TextBlock Grid.Column="4" Text="حذف" Style="{StaticResource PosCenterTextStyle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.CBD5E1.NavigationMuted}" />
                        </Grid>
                    </Border>

                    <!-- Lines ScrollViewer -->
                    <Border Grid.Row="3" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="0,0,0,1">
                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="105" />
                                                    <ColumnDefinition Width="135" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Product.Name}" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding LockSummary}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                                </StackPanel>

                                                <TextBox Grid.Column="1"
                                                         Style="{StaticResource PosNumericTextBoxStyle}"
                                                         Width="90"
                                                         MinHeight="30"
                                                         Padding="6,4"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding UnitPurchaseCostText, UpdateSourceTrigger=PropertyChanged}" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                                                    <Button Content="−" Style="{StaticResource PosStepperButtonStyle}" Command="{Binding DecrementCommand}" />
                                                    <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                                             Width="48"
                                                             MinHeight="28"
                                                             Padding="3,3"
                                                             Margin="4,0"
                                                             TextAlignment="Center"
                                                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Content="+" Style="{StaticResource PosStepperButtonStyle}" Command="{Binding IncrementCommand}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LineTotalDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                                    <TextBlock Text="{Binding ReturnedSummary}" Style="{StaticResource PosCenterTextStyle}" FontSize="10" Foreground="{DynamicResource Theme.Legacy.7C3AED.VioletInk}" Visibility="{Binding HasReturnedQuantity, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <Button Grid.Column="4"
                                                        Content="✕"
                                                        Style="{StaticResource PosDangerIconButtonStyle}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsEnabled="{Binding CanRemove}"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip="حذف البند من الفاتورة" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Error Banner -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10,7"
                CornerRadius="8"
                Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}"
                BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}"
                BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إلغاء التعديلات"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="125"
                    Padding="14,9"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="2"
                    Content="حفظ كافة التعديلات ومزامنة المخزون"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    MinWidth="240"
                    Padding="20,9"
                    IsDefault="True"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
