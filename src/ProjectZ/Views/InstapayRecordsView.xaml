<UserControl x:Class="ProjectZ.Views.InstapayRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProjectZ.ViewModels" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstapayRecordsViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/PosStyles.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style x:Key="RecordCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.FFFFFF.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.E2E8F0.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /></Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}"><Setter Property="FontSize" Value="10.5" /><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.64748B.Muted}" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
        <Style x:Key="RecordAction" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}"><Setter Property="Padding" Value="11,6" /><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,6,0" /></Style>
        <Style x:Key="RowRecordAction" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}"><Setter Property="Padding" Value="5,2" /><Setter Property="MinHeight" Value="25" /><Setter Property="FontSize" Value="9.5" /><Setter Property="Margin" Value="1" /></Style>
        <Style x:Key="CompactCellText" TargetType="TextBlock"><Setter Property="Margin" Value="5,0" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="FontSize" Value="10.5" /><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.172B41.Text}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
        <Style x:Key="CompactNumberText" TargetType="TextBlock" BasedOn="{StaticResource CompactCellText}"><Setter Property="FlowDirection" Value="LeftToRight" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="CompactHeaderText" TargetType="TextBlock"><Setter Property="FlowDirection" Value="RightToLeft" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" /></Style>
    </ResourceDictionary></UserControl.Resources>
    <Grid x:Name="PrintArea" FlowDirection="RightToLeft" Margin="18,14" Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,11" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <WrapPanel VerticalAlignment="Center"><Button Content="تصدير CSV" Style="{StaticResource RecordAction}" Click="ExportCsv_Click" /><Button Content="طباعة" Style="{StaticResource RecordAction}" Click="Print_Click" /><Button Content="تحديث" Style="{StaticResource RecordAction}" Command="{Binding RefreshCommand}" /></WrapPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="سجلات إنستاباي" Style="{StaticResource PosRtlTextStyle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" /><TextBlock Text="مراجعة تفصيلية وبحث متقدم وتعديل وعكس وحذف العمليات مع تسوية الأرصدة ودفتر الحسابات." Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /></StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <Border Style="{StaticResource RecordCard}" Padding="12" Margin="0,0,0,10"><StackPanel>
                <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="الفلتر المتكامل" Style="{StaticResource PosRtlTextStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" /><Button Grid.Column="1" Content="إلغاء كل الفلاتر" Style="{StaticResource RecordAction}" Command="{Binding ClearFiltersCommand}" /></Grid>
                <Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="7" /><ColumnDefinition Width="125" /><ColumnDefinition Width="7" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="130" /><ColumnDefinition Width="7" /><ColumnDefinition Width="110" /><ColumnDefinition Width="7" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="من تاريخ" Style="{StaticResource FilterLabel}" /><DatePicker SelectedDate="{Binding FromDate}" FlowDirection="LeftToRight" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="إلى تاريخ" Style="{StaticResource FilterLabel}" /><DatePicker SelectedDate="{Binding ToDate}" FlowDirection="LeftToRight" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="خط إنستاباي" Style="{StaticResource FilterLabel}" /><ComboBox Style="{StaticResource PosComboBoxStyle}" ItemsSource="{Binding WalletFilters}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding SelectedWalletId}" /></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Text="نوع العملية" Style="{StaticResource FilterLabel}" /><ComboBox Style="{StaticResource PosComboBoxStyle}" ItemsSource="{Binding KindFilters}" SelectedItem="{Binding SelectedKind}" /></StackPanel>
                    <StackPanel Grid.Column="8"><TextBlock Text="الحالة" Style="{StaticResource FilterLabel}" /><ComboBox Style="{StaticResource PosComboBoxStyle}" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}" /></StackPanel>
                    <StackPanel Grid.Column="10"><TextBlock Text="المستخدم" Style="{StaticResource FilterLabel}" /><TextBox Style="{StaticResource PosCompactTextBoxStyle}" FlowDirection="RightToLeft" Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                </Grid>
                <Grid FlowDirection="RightToLeft" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="رقم العميل" Style="{StaticResource FilterLabel}" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding CustomerFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="المبلغ من" Style="{StaticResource FilterLabel}" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding MinimumAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="المبلغ إلى" Style="{StaticResource FilterLabel}" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding MaximumAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Text="العمولة من" Style="{StaticResource FilterLabel}" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding MinimumCommissionText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Grid.Column="8"><TextBlock Text="العمولة إلى" Style="{StaticResource FilterLabel}" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding MaximumCommissionText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                </Grid>
            </StackPanel></Border>

            <Border Style="{StaticResource RecordCard}" Padding="10" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ResultCountDisplay}" Style="{StaticResource PosRtlTextStyle}" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding FilteredAmountDisplay, StringFormat='إجمالي المبالغ: {0}'}" Style="{StaticResource PosRtlTextStyle}" Margin="15,0" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding FilteredCommissionDisplay, StringFormat='إجمالي العمولات: {0}'}" Style="{StaticResource PosRtlTextStyle}" Foreground="{DynamicResource Theme.Legacy.B45309.WarningInk}" VerticalAlignment="Center" /></Grid></Border>

            <Border Style="{StaticResource RecordCard}" Padding="0" Height="480" FlowDirection="RightToLeft">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Padding="12,8" Background="{DynamicResource Theme.Legacy.102E48.Navigation}" CornerRadius="12,12,0,0"><TextBlock Text="السجلات التفصيلية — عرض أفقي مدمج" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" /></Border>
                    <Grid Grid.Row="1" Margin="8"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel Width="1140" FlowDirection="RightToLeft">
                        <Border Height="34" Background="{DynamicResource Theme.Legacy.1D455F.Navigation}" CornerRadius="7" Margin="0,0,0,5"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="150" /><ColumnDefinition Width="105" /><ColumnDefinition Width="90" /><ColumnDefinition Width="75" /><ColumnDefinition Width="100" /><ColumnDefinition Width="95" /><ColumnDefinition Width="95" /><ColumnDefinition Width="75" /><ColumnDefinition Width="65" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions><TextBlock Text="النوع" Style="{StaticResource CompactHeaderText}" /><TextBlock Grid.Column="1" Text="خط إنستاباي" Style="{StaticResource CompactHeaderText}" /><TextBlock Grid.Column="2" Text="رقم العميل" Style="{StaticResource CompactHeaderText}" /><TextBlock Grid.Column="3" Text="المبلغ" Style="{StaticResource CompactHeaderText}" /><TextBlock Grid.Column="4" Text="العمولة" Style="{StaticResource CompactHeaderText}" /><TextBlock Grid.Column="5" Text="الرصيد بعدها" Style="{StaticResource CompactHeaderText}" /><TextBlock Grid.Column="6" Text="أثر النقدي" Style="{StaticResource CompactHeaderText}" /><TextBlock Grid.Column="7" Text="التاريخ والوقت" Style="{StaticResource CompactHeaderText}" /><TextBlock Grid.Column="8" Text="المستخدم" Style="{StaticResource CompactHeaderText}" /><TextBlock Grid.Column="9" Text="الحالة" Style="{StaticResource CompactHeaderText}" /><TextBlock Grid.Column="10" Text="إجراءات السجل" Style="{StaticResource CompactHeaderText}" /></Grid></Border>
                        <ItemsControl ItemsSource="{Binding FilteredOperations}" FlowDirection="RightToLeft"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border MinHeight="54" Margin="0,0,0,4" Padding="5,3" CornerRadius="7" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1" MouseLeftButtonUp="RecordCard_MouseLeftButtonUp" Cursor="Hand" FlowDirection="RightToLeft">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.FFFFFF.Surface}" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.F0F9FF.InfoSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.7DD3FC.InfoBorder}" /></Trigger><DataTrigger Binding="{Binding IsReversed}" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.FFF7F7.Surface}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <Border.ToolTip><StackPanel FlowDirection="RightToLeft" MaxWidth="380"><TextBlock Text="{Binding DetailsDisplay}" Style="{StaticResource PosRtlTextStyle}" TextWrapping="Wrap" /><TextBlock Text="{Binding Note, StringFormat='ملاحظات: {0}'}" Style="{StaticResource PosRtlTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border.ToolTip>
                                <Grid FlowDirection="RightToLeft" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="150" /><ColumnDefinition Width="105" /><ColumnDefinition Width="90" /><ColumnDefinition Width="75" /><ColumnDefinition Width="100" /><ColumnDefinition Width="95" /><ColumnDefinition Width="95" /><ColumnDefinition Width="75" /><ColumnDefinition Width="65" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
                                    <UniformGrid Grid.Column="10" Rows="1" VerticalAlignment="Center" FlowDirection="RightToLeft"><Button Content="تفاصيل" Style="{StaticResource RowRecordAction}" Command="{Binding DataContext.ShowOperationDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /><Button Content="تعديل" Style="{StaticResource RowRecordAction}" IsEnabled="{Binding CanEditOrDelete}" Command="{Binding DataContext.BeginOperationEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /><Button Content="عكس" Style="{StaticResource RowRecordAction}" Foreground="{DynamicResource Theme.Legacy.B45309.WarningInk}" IsEnabled="{Binding CanEditOrDelete}" Command="{Binding DataContext.ReverseOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /><Button Content="حذف" Style="{StaticResource RowRecordAction}" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" Command="{Binding DataContext.DeleteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></UniformGrid>
                                    <Border Grid.Column="0" Margin="4,0" Padding="5,3" CornerRadius="5" Background="{DynamicResource Theme.Legacy.F5F3FF.InfoSoft}" VerticalAlignment="Center"><TextBlock Text="{Binding OperationTitle}" Style="{StaticResource PosCenterTextStyle}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" TextTrimming="CharacterEllipsis" /></Border>
                                    <StackPanel Grid.Column="1" Margin="5,0" VerticalAlignment="Center"><TextBlock Text="{Binding WalletAlias}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding WalletNumber}" Style="{StaticResource CompactNumberText}" Margin="0" HorizontalAlignment="Right" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /></StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding CustomerNumber}" Style="{StaticResource CompactNumberText}" />
                                    <TextBlock Grid.Column="3" Text="{Binding AmountDisplay}" Style="{StaticResource CompactNumberText}" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                    <TextBlock Grid.Column="4" Text="{Binding CommissionDisplay}" Style="{StaticResource CompactNumberText}" Foreground="{DynamicResource Theme.Legacy.B45309.WarningInk}" />
                                    <TextBlock Grid.Column="5" Text="{Binding WalletBalanceAfterDisplay}" Style="{StaticResource CompactNumberText}" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                    <TextBlock Grid.Column="6" Text="{Binding TotalCashDisplay}" Style="{StaticResource CompactNumberText}" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                    <StackPanel Grid.Column="7" VerticalAlignment="Center"><TextBlock Text="{Binding DateDisplay}" Style="{StaticResource CompactNumberText}" FontSize="9.5" /><TextBlock Text="{Binding TimeDisplay}" Style="{StaticResource CompactNumberText}" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" /></StackPanel>
                                    <TextBlock Grid.Column="8" Text="{Binding ActorName}" Style="{StaticResource CompactCellText}" TextAlignment="Center" />

                                    <Border Grid.Column="9" Margin="4,0" Padding="5,3" CornerRadius="5" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}" /><Style.Triggers><DataTrigger Binding="{Binding IsReversed}" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.F5F3FF.InfoSoft}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StatusTitle}" Style="{StaticResource PosCenterTextStyle}" FontSize="9.5" FontWeight="Bold" /></Border>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></ScrollViewer><TextBlock Text="لا توجد سجلات مطابقة للفلاتر." Style="{StaticResource PosCenterTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" Visibility="{Binding HasNoOperations, Converter={StaticResource BoolToVis}}" /></Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource RecordCard}" Padding="12" Visibility="{Binding HasSelectedOperation, Converter={StaticResource BoolToVis}}"><StackPanel><TextBlock Text="العملية المحددة" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="Bold" Margin="0,0,0,5" /><TextBlock Text="{Binding SelectedOperation.DetailsDisplay}" Style="{StaticResource PosRtlTextStyle}" TextWrapping="Wrap" /></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8" CornerRadius="10" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}" /><Style.Triggers><DataTrigger Binding="{Binding IsErrorStatus}" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.F5F3FF.InfoSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PosRtlTextStyle}" TextWrapping="Wrap" /></Border>
    </Grid>
</UserControl>
