<Window x:Class="ProjectZ.Views.MaintenanceDeliveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | تسليم جهاز الصيانة وتحصيل المتبقي والضمان'}"
        Width="760"
        Height="720"
        MinWidth="640"
        MinHeight="560"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid FlowDirection="LeftToRight">
        <ContentControl Style="{StaticResource ThemeBackdropStyle}" />
    <Grid Margin="18" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="16,12" CornerRadius="14" Background="{DynamicResource Theme.Legacy.102E48.Navigation}">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="12,5" CornerRadius="8" Background="{DynamicResource Theme.Legacy.0F766E.Success}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Order.OrderNumber}"
                               Style="{StaticResource PosCenterTextStyle}"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnSuccess}" />
                </Border>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="تسوية الحساب وتسليم الجهاز للعميل"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                    <TextBlock Text="{Binding Order.DeviceFullTitle, StringFormat='الجهاز: {0}'}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel FlowDirection="RightToLeft">

                <!-- Summary & Final Pricing Adjustments -->
                <Border Margin="0,0,0,10" Padding="14" CornerRadius="12" Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}" BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="1. مراجعة التكلفة النهائية والخصم والعربون"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                                   Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Padding="10,7" CornerRadius="9" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="قطع الغيار المستخدمة" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                    <TextBlock Text="{Binding Order.PartsTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="أجرة الصيانة والمصنعية (ج.م)" Style="{StaticResource PosRtlTextStyle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.334155.Text}" Margin="0,0,0,3" />
                                <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                         MinHeight="34"
                                         Padding="9,5"
                                         FontSize="13"
                                         Text="{Binding LaborCostText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="خصم خاص للعميل (ج.م)" Style="{StaticResource PosRtlTextStyle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.334155.Text}" Margin="0,0,0,3" />
                                <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                         MinHeight="34"
                                         Padding="9,5"
                                         FontSize="13"
                                         Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="3" FlowDirection="RightToLeft">
                            <Border Padding="10,8" CornerRadius="10" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="الإجمالي النهائي للصيانة" Style="{StaticResource PosCenterTextStyle}" FontSize="11" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                    <TextBlock Text="{Binding EffectiveFinalTotalDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,0" Padding="10,8" CornerRadius="10" Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}" BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="المدفوع مقدمًا (عربون)" Style="{StaticResource PosCenterTextStyle}" FontSize="11" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                    <TextBlock Text="{Binding Order.NetDepositRetainedDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,0" Padding="10,8" CornerRadius="10" Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}" BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="المتبقي المطلوب تحصيله" Style="{StaticResource PosCenterTextStyle}" FontSize="11" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                    <TextBlock Text="{Binding RemainingBeforeFinalPaymentDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Excess Deposit Refund Banner (if deposit > final total) -->
                <Border Margin="0,0,0,10"
                        Padding="12"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Legacy.FFFBEB.WarningSoft}"
                        BorderBrush="{DynamicResource Theme.Legacy.FCD34D.WarningBorder}"
                        BorderThickness="1"
                        Visibility="{Binding HasExcessDeposit, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="تنبيه: العربون المدفوع سابقًا أكبر من التكلفة النهائية"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Legacy.92400E.WarningInk}" />
                        <CheckBox Content="رد فرق العربون الزائد للعميل عند التسليم"
                                  Style="{StaticResource PosCheckBoxStyle}"
                                  Margin="0,5,0,2"
                                  FontSize="12.5"
                                  FontWeight="SemiBold"
                                  IsChecked="{Binding RefundExcessDeposit}" />
                        <TextBlock Text="{Binding ExcessDepositSummary}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Theme.Legacy.78350F.WarningInk}" />
                    </StackPanel>
                </Border>

                <!-- Final Payment Collection -->
                <Border Margin="0,0,0,10"
                        Padding="14"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                        BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}"
                        BorderThickness="1"
                        Visibility="{Binding HasRemainingToCollect, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="2. تحصيل المبلغ المتبقي عند التسليم"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                                   Margin="0,0,0,8" />

                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="بدون تحصيل (ترحيل للفاتورة)" Command="{Binding SetNoPaymentModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                        <Setter Property="Padding" Value="10,6" />
                                        <Setter Property="FontSize" Value="11.5" />
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNoFinalPaymentMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.102E48.Navigation}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.102E48.Border}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="نقدي (كاش)" Command="{Binding SetCashModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                        <Setter Property="Padding" Value="10,6" />
                                        <Setter Property="FontSize" Value="11.5" />
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCashMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.0F766E.Success}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.0F766E.SuccessBorder}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="فودافون كاش" Command="{Binding SetVodafoneModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                        <Setter Property="Padding" Value="10,6" />
                                        <Setter Property="FontSize" Value="11.5" />
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVodafoneMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.C8102E.Danger}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.C8102E.DangerBorder}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="إنستاباي" Command="{Binding SetInstaPayModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                        <Setter Property="Padding" Value="10,6" />
                                        <Setter Property="FontSize" Value="11.5" />
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstaPayMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.6D28D9.Violet}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.6D28D9.VioletBorder}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="دفع مقسم" Command="{Binding SetSplitModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                        <Setter Property="Padding" Value="10,6" />
                                        <Setter Property="FontSize" Value="11.5" />
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSplitMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.147D92.Accent}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.147D92.Accent}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>

                        <StackPanel Visibility="{Binding ShowPaymentInputs, Converter={StaticResource BoolToVis}}">
                            <Border Margin="0,4,0,0" Padding="10,7" CornerRadius="8" Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}" BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}" BorderThickness="1"
                                    Visibility="{Binding ShowCashInput, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="المبلغ كاش:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource PosNumericTextBoxStyle}" MinHeight="30" Padding="8,4" Text="{Binding CashAmountText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,6,0,0" Padding="10,7" CornerRadius="8" Background="{DynamicResource Theme.Legacy.FFF5F5.Surface}" BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" BorderThickness="1"
                                    Visibility="{Binding ShowVodafoneInput, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="فودافون كاش:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.C8102E.DangerInk}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource PosNumericTextBoxStyle}" MinHeight="30" Padding="8,4" Text="{Binding VodafoneAmountText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,6,0,0" Padding="10,7" CornerRadius="8" Background="{DynamicResource Theme.Legacy.F5F3FF.InfoSoft}" BorderBrush="{DynamicResource Theme.Legacy.DDD6FE.InfoBorder}" BorderThickness="1"
                                    Visibility="{Binding ShowInstaPayInput, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="إنستاباي:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource PosNumericTextBoxStyle}" MinHeight="30" Padding="8,4" Text="{Binding InstaPayAmountText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding CurrentFinalCollectedDisplay, StringFormat='المحصل الآن: {0}'}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                <TextBlock Text=" · " Style="{StaticResource PosCenterTextStyle}" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" />
                                <TextBlock Text="{Binding StillUnpaidAfterInputDisplay, StringFormat='المتبقي المرحل: {0}'}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Warranty & Delivery Notes -->
                <Border Padding="14" CornerRadius="12" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="3. مدة الضمان بعد الصيانة وملاحظات التسليم"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                                   Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ItemsControl ItemsSource="{Binding WarrantyPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding StringFormat='{}{0} يوم'}"
                                                Style="{StaticResource PosSecondaryButtonStyle}"
                                                Padding="10,5"
                                                Margin="0,0,6,0"
                                                FontSize="11.5"
                                                Command="{Binding DataContext.SelectWarrantyDaysCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="أو أدخل الأيام:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="6,0,6,0" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                            <TextBox Style="{StaticResource PosNumericTextBoxStyle}" Width="68" MinHeight="30" Padding="6,4" Text="{Binding CustomWarrantyDaysText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Border Padding="9,6" CornerRadius="8" Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}" BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}" BorderThickness="1" Margin="0,0,0,8">
                            <TextBlock Text="{Binding WarrantyPreviewText}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                        </Border>

                        <TextBlock Text="ملاحظات التسليم والتوصية للعميل (اختياري)" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" Margin="0,0,0,3" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="9,5"
                                 FontSize="12"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 TextWrapping="Wrap"
                                 Text="{Binding DeliveryNotes, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Error Message -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10,7"
                CornerRadius="8"
                Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}"
                BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}"
                BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إلغاء"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="95"
                    Padding="14,9"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="2"
                    Content="تأكيد التسليم وإغلاق التذكرة"
                    Style="{StaticResource PosOutlineTealButtonStyle}"
                    MinWidth="190"
                    Padding="14,9"
                    Command="{Binding ConfirmDeliveryCommand}" />

            <Button Grid.Column="4"
                    Content="تأكيد التسليم + طباعة إيصال الضمان"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    MinWidth="220"
                    Padding="16,9"
                    IsDefault="True"
                    Command="{Binding ConfirmAndPrintCommand}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
