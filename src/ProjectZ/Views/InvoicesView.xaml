<UserControl x:Class="ProjectZ.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Language="ar-EG">

    <UserControl.Resources>
        <Style x:Key="InvDatePillBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvRowQuickBtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvHeaderActionBtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header Strip -->
        <Grid Grid.Row="0" Margin="0,0,0,10" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                <Button Content="+ فاتورة جديدة (نقطة البيع)"
                        Style="{StaticResource PosPrimaryCompactButtonStyle}"
                        Padding="14,7"
                        FontSize="12.5"
                        Command="{Binding GoToPosCommand}" />
                <Button Content="إعادة ضبط الفلاتر"
                        Margin="8,0,0,0"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Padding="12,7"
                        FontSize="12"
                        Command="{Binding ClearFiltersCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft">
                <TextBlock Text="الفواتير — سجل المبيعات والمراجعة الكاملة"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="20.5"
                           FontWeight="Bold"
                           Foreground="#102E48"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        Background="#E0F2FE"
                        BorderBrush="#BAE6FD"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="تصميم الواجهة — بدون Backend"
                               Style="{StaticResource PosCenterTextStyle}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#0369A1" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ROW 1: 5 KPI Summary Cards -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10" FlowDirection="RightToLeft">
            <!-- KPI 1: Invoices Count -->
            <Border Margin="0,0,0,0" Padding="11,9" CornerRadius="11" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="عدد الفواتير" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock Text="{Binding InvoicesCountDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="17" FontWeight="Bold" Foreground="#102E48" />
                    <TextBlock Text="{Binding InvoicesBreakdownSummary}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- KPI 2: Net Sales -->
            <Border Margin="0,0,8,0" Padding="11,9" CornerRadius="11" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="صافي المبيعات" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F766E" />
                    <TextBlock Text="{Binding TotalNetSalesDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="17" FontWeight="Bold" Foreground="#0F766E" />
                    <TextBlock Text="{Binding TotalDiscountsSubtext}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10.5" Foreground="#0D9488" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- KPI 3: Cost & Net Profit -->
            <Border Margin="0,0,8,0" Padding="11,9" CornerRadius="11" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="صافي الربح" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D4ED8" />
                    <TextBlock Text="{Binding TotalProfitDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="17" FontWeight="Bold" Foreground="#1E40AF" />
                    <TextBlock Text="{Binding TotalCostAndMarginDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10.5" Foreground="#2563EB" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- KPI 4: Payment Channels Collection -->
            <Border Margin="0,0,8,0" Padding="11,9" CornerRadius="11" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي التحصيلات" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#6D28D9" />
                    <TextBlock Text="{Binding TotalCollectedAllDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="17" FontWeight="Bold" Foreground="#5B21B6" />
                    <TextBlock Text="{Binding ChannelsBreakdownDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10" Foreground="#7C3AED" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- KPI 5: Credit Remaining & Returns (Clickable Quick Filter) -->
            <Button Margin="0,0,8,0"
                    Cursor="Hand"
                    Command="{Binding FilterCreditOnlyCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="11,9" CornerRadius="11" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="المتبقي الآجل (اضغط للتصفية)" Style="{StaticResource PosRtlTextStyle}" FontSize="11" FontWeight="SemiBold" Foreground="#B45309" />
                                <TextBlock Text="{Binding TotalRemainingDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="17" FontWeight="Bold" Foreground="#B42318" />
                                <TextBlock Text="{Binding TotalReturnedSubtext}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10.5" Foreground="#92400E" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </UniformGrid>

        <!-- ROW 2: Search & Multi-Filters Bar -->
        <Border Grid.Row="2"
                Margin="0,0,0,10"
                Padding="11,9"
                CornerRadius="12"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <StackPanel>
                <!-- Filter Line 1: Search + Date Presets + Optional Custom Range -->
                <Grid Margin="0,0,0,7" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Date Presets & Custom Range -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                        <TextBlock Text="الفترة:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                        <Button Content="الكل" Command="{Binding SelectDatePresetCommand}" CommandParameter="الكل">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource InvDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllDatePreset}" Value="True">
                                            <Setter Property="Background" Value="#102E48" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="اليوم" Command="{Binding SelectDatePresetCommand}" CommandParameter="اليوم">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource InvDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTodayPreset}" Value="True">
                                            <Setter Property="Background" Value="#0F766E" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="آخر 7 أيام" Command="{Binding SelectDatePresetCommand}" CommandParameter="آخر 7 أيام">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource InvDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLast7DaysPreset}" Value="True">
                                            <Setter Property="Background" Value="#0F766E" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="هذا الشهر" Command="{Binding SelectDatePresetCommand}" CommandParameter="هذا الشهر">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource InvDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsThisMonthPreset}" Value="True">
                                            <Setter Property="Background" Value="#0F766E" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="فترة مخصصة" Command="{Binding SelectDatePresetCommand}" CommandParameter="فترة مخصصة">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource InvDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomDatePreset}" Value="True">
                                            <Setter Property="Background" Value="#0F766E" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Global Invoice Search -->
                    <Grid Grid.Column="2">
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 MinHeight="34"
                                 Padding="10,5,30,5"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="ابحث برقم الفاتورة، اسم/هاتف العميل، الصنف، الباركود، السيريال IMEI..."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="30,0,10,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                        <Button Content="×"
                                Width="22"
                                Height="22"
                                Margin="6,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource PosDangerIconButtonStyle}"
                                Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}"
                                Command="{Binding ClearSearchCommand}" />
                    </Grid>
                </Grid>

                <!-- Filter Line 2: Payment, Status, Cashier + Custom Date Pickers -->
                <Grid FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Combo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="الحالة:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  Width="140"
                                  MinHeight="32"
                                  ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Payment Method Combo -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="طريقة الدفع:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  Width="145"
                                  MinHeight="32"
                                  ItemsSource="{Binding PaymentFilters}"
                                  SelectedItem="{Binding SelectedPaymentFilter, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Cashier Combo -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="الكاشير:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  Width="140"
                                  MinHeight="32"
                                  ItemsSource="{Binding CashierFilters}"
                                  SelectedItem="{Binding SelectedCashierFilter, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Custom Date Range Inputs -->
                    <StackPanel Grid.Column="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsCustomDatePreset, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="من:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" FontWeight="SemiBold" />
                        <DatePicker Width="125" SelectedDate="{Binding CustomFromDate, Mode=TwoWay}" />
                        <TextBlock Text="إلى:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="12" FontWeight="SemiBold" />
                        <DatePicker Width="125" SelectedDate="{Binding CustomToDate, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ROW 3: Master-Detail Split View -->
        <Grid Grid.Row="3" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="485" MinWidth="390" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- PHYSICAL LEFT COLUMN: Full Invoice Review & Control Panel (Detail) -->
            <Border Grid.Column="0"
                    CornerRadius="14"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    FlowDirection="LeftToRight">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Detail Panel Header & Action Controls -->
                    <Border Grid.Row="0"
                            Padding="13,11"
                            CornerRadius="13,13,0,0"
                            Background="#102E48"
                            Visibility="{Binding HasSelectedInvoice, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Status Badge -->
                                <Border Grid.Column="0" Padding="9,4" CornerRadius="8" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#0F766E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedInvoice.IsPartialCredit}" Value="True">
                                                    <Setter Property="Background" Value="#D97706" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedInvoice.IsPartiallyReturned}" Value="True">
                                                    <Setter Property="Background" Value="#9A3412" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedInvoice.IsFullyReturned}" Value="True">
                                                    <Setter Property="Background" Value="#B42318" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedInvoice.IsCancelled}" Value="True">
                                                    <Setter Property="Background" Value="#475569" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedInvoice.IsExchanged}" Value="True">
                                                    <Setter Property="Background" Value="#4F46E5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedInvoice.StatusTitle}"
                                               Style="{StaticResource PosCenterTextStyle}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="White" />
                                </Border>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                                        <TextBlock Text="مراجعة الفاتورة:" Style="{StaticResource PosRtlTextStyle}" FontSize="13.5" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="{Binding SelectedInvoice.InvoiceNumber}" Style="{StaticResource PosLtrTextStyle}" Margin="6,0,0,0" FontFamily="Consolas, Segoe UI" FontSize="14" FontWeight="Bold" Foreground="#6EE7D8" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedInvoice.IssuedFullDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" Margin="0,2,0,0" FontSize="11" Foreground="#B7CFDD" />
                                </StackPanel>
                            </Grid>

                            <!-- Action Buttons Bar -->
                            <WrapPanel Margin="0,9,0,0" Orientation="Horizontal" FlowDirection="RightToLeft">
                                <Button Content="معاينة وطباعة"
                                        Style="{StaticResource InvHeaderActionBtnStyle}"
                                        Background="#0F766E"
                                        Foreground="White"
                                        BorderBrush="#14B8A6"
                                        Command="{Binding OpenPrintPreviewCommand}"
                                        CommandParameter="{Binding SelectedInvoice}" />
                                <Button Content="مرتجع / استبدال"
                                        Style="{StaticResource InvHeaderActionBtnStyle}"
                                        Background="#FFF7ED"
                                        Foreground="#9A3412"
                                        BorderBrush="#FDBA74"
                                        IsEnabled="{Binding SelectedInvoice.CanReturn}"
                                        Command="{Binding OpenReturnDialogCommand}"
                                        CommandParameter="{Binding SelectedInvoice}" />
                                <Button Content="تحصيل متبقي"
                                        Style="{StaticResource InvHeaderActionBtnStyle}"
                                        Background="#ECFDF5"
                                        Foreground="#065F46"
                                        BorderBrush="#6EE7B7"
                                        Visibility="{Binding SelectedInvoice.CanCollectRemaining, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding OpenCollectPaymentCommand}"
                                        CommandParameter="{Binding SelectedInvoice}" />
                                <Button Content="إلغاء الفاتورة"
                                        Style="{StaticResource InvHeaderActionBtnStyle}"
                                        Background="#FEF2F2"
                                        Foreground="#B42318"
                                        BorderBrush="#FECACA"
                                        IsEnabled="{Binding SelectedInvoice.CanCancel}"
                                        Command="{Binding CancelInvoiceCommand}"
                                        CommandParameter="{Binding SelectedInvoice}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Full Scrollable Invoice Details -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="11"
                                  Visibility="{Binding HasSelectedInvoice, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- Card 1: Customer, Cashier & Notes -->
                            <Border Margin="0,0,0,9" Padding="11" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="بيانات العميل والفاتورة" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,6" FontSize="13" FontWeight="Bold" Foreground="#102E48" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding SelectedInvoice.CustomerName, StringFormat=العميل: {0}}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" />
                                            <TextBlock Text="{Binding SelectedInvoice.CustomerPhoneDisplay, StringFormat=الهاتف: {0}}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="11.5" Foreground="#475569" />
                                            <TextBlock Text="{Binding SelectedInvoice.CustomerAddressDisplay, StringFormat=العنوان: {0}}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding SelectedInvoice.CashierName, StringFormat=الكاشير: {0}}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedInvoice.DefaultPriceTierTitle, StringFormat=فئة التسعير: {0}}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="11.5" Foreground="#0369A1" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedInvoice.ItemsAndUnitsSummary, StringFormat=الأصناف: {0}}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="11.5" Foreground="#475569" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Editable Notes -->
                                    <TextBlock Text="ملاحظات المراجعة:" Style="{StaticResource PosRtlTextStyle}" Margin="0,8,0,4" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" />
                                    <Grid FlowDirection="LeftToRight">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="حفظ"
                                                Style="{StaticResource PosSecondaryButtonStyle}"
                                                Padding="10,4"
                                                FontSize="11.5"
                                                Command="{Binding SaveNotesCommand}" />
                                        <TextBox Grid.Column="2"
                                                 Style="{StaticResource PosCompactTextBoxStyle}"
                                                 MinHeight="30"
                                                 Padding="8,4"
                                                 FontSize="12"
                                                 FlowDirection="RightToLeft"
                                                 TextAlignment="Left"
                                                 Text="{Binding EditableNotes, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Detailed Line Items + Serials + Item Cost/Profit -->
                            <Border Margin="0,0,0,9" Padding="11" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="تفصيل بنود الفاتورة والسيريالات والربحية" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,7" FontSize="13" FontWeight="Bold" Foreground="#102E48" />
                                    <ItemsControl ItemsSource="{Binding SelectedInvoice.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Padding="9,7" CornerRadius="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <StackPanel>
                                                        <Grid FlowDirection="RightToLeft">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding ProductName}"
                                                                       Style="{StaticResource PosRtlTextStyle}"
                                                                       FontSize="12.5"
                                                                       FontWeight="Bold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding LineNetTotalDisplay}"
                                                                       Style="{StaticResource PosLtrTextStyle}"
                                                                       Margin="0,0,8,0"
                                                                       FontSize="12.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="#0F766E" />
                                                        </Grid>

                                                        <WrapPanel Orientation="Horizontal" Margin="0,3,0,0" FlowDirection="RightToLeft">
                                                            <TextBlock Text="{Binding Barcode}" Style="{StaticResource PosLtrTextStyle}" FontFamily="Consolas, Segoe UI" FontSize="10.5" Foreground="#64748B" />
                                                            <TextBlock Text=" · " Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" Foreground="#94A3B8" />
                                                            <Border Padding="5,1" CornerRadius="4" Background="#E0F2FE">
                                                                <TextBlock Text="{Binding PriceTierTitle}" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="#0369A1" />
                                                            </Border>
                                                            <TextBlock Text=" · الكمية: " Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#475569" />
                                                            <TextBlock Text="{Binding QuantityDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="11" FontWeight="Bold" />
                                                            <TextBlock Text=" × " Style="{StaticResource PosCenterTextStyle}" FontSize="11" Foreground="#64748B" />
                                                            <TextBlock Text="{Binding UnitPriceDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11" Foreground="#334155" />
                                                            <Border Margin="6,0,0,0"
                                                                    Padding="5,1"
                                                                    CornerRadius="4"
                                                                    Background="#FEF2F2"
                                                                    Visibility="{Binding HasReturned, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding ReturnedSummaryDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="#B42318" />
                                                            </Border>
                                                            <Border Margin="6,0,0,0"
                                                                    Padding="5,1"
                                                                    CornerRadius="4"
                                                                    Background="#EEF2FF"
                                                                    Visibility="{Binding IsExchangeReplacement, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="بديل استبدال" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="#4F46E5" />
                                                            </Border>
                                                        </WrapPanel>

                                                        <Grid Margin="0,4,0,0" FlowDirection="RightToLeft">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding SerialSummary}"
                                                                       Style="{StaticResource PosRtlTextStyle}"
                                                                       FontSize="10.5"
                                                                       Foreground="#475569"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <TextBlock Text="التكلفة: " Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#64748B" />
                                                                <TextBlock Text="{Binding LineCostTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="10.5" Foreground="#475569" />
                                                                <TextBlock Text=" · الربح: " Style="{StaticResource PosRtlTextStyle}" Margin="4,0,0,0" FontSize="10.5" Foreground="#1D4ED8" />
                                                                <TextBlock Text="{Binding LineProfitDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Financial Totals & Profit Breakdown -->
                            <Border Margin="0,0,0,9" Padding="11" CornerRadius="10" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="الملخص المالي والربحية" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,6" FontSize="13" FontWeight="Bold" Foreground="#0F766E" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="الإجمالي قبل الخصم:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInvoice.SubtotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Margin="0,3,0,0" Visibility="{Binding SelectedInvoice.HasDiscount, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="الخصم الممنوح:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#B42318" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInvoice.EffectiveDiscountDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#B42318" />
                                    </Grid>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="صافي الفاتورة عند الإصدار:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInvoice.NetTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" />
                                    </Grid>
                                    <Grid Margin="0,3,0,0" Visibility="{Binding SelectedInvoice.HasReturnedAmount, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="قيمة المرتجعات:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#9A3412" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInvoice.ReturnedTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#9A3412" />
                                    </Grid>
                                    <Border Margin="0,5,0,5" Height="1" Background="#99F6E4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="صافي البيع الفعلي:" Style="{StaticResource PosRtlTextStyle}" FontSize="13.5" FontWeight="Bold" Foreground="#0F766E" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInvoice.EffectiveNetSalesDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="14" FontWeight="Bold" Foreground="#0F766E" />
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="تكلفة البضاعة / صافي الربح:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#1E40AF" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft">
                                            <TextBlock Text="{Binding SelectedInvoice.TotalCostDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" Foreground="#475569" />
                                            <TextBlock Text="  |  ربح: " Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8" />
                                            <TextBlock Text="{Binding SelectedInvoice.NetProfitDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="#1D4ED8" />
                                            <TextBlock Text="{Binding SelectedInvoice.ProfitMarginDisplay, StringFormat=' ({0})'}" Style="{StaticResource PosLtrTextStyle}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Payment Channels & References Breakdown -->
                            <Border Margin="0,0,0,9" Padding="11" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="تفصيل السداد والتحصيل والمراجع" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,6" FontSize="13" FontWeight="Bold" Foreground="#102E48" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="كاش (نقدي):" Style="{StaticResource PosRtlTextStyle}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInvoice.CashPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Margin="0,3,0,0" Visibility="{Binding SelectedInvoice.HasVodafoneCash, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="فودافون كاش:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#C8102E" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInvoice.VodafoneCashPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#C8102E" />
                                    </Grid>
                                    <Grid Margin="0,3,0,0" Visibility="{Binding SelectedInvoice.HasInstaPay, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="إنستاباي:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#6D28D9" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInvoice.InstaPayPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#6D28D9" />
                                    </Grid>
                                    <Grid Margin="0,3,0,0" Visibility="{Binding SelectedInvoice.HasRefundedAmount, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="مبالغ مستردة للعميل:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#B42318" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInvoice.RefundedAmountDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#B42318" />
                                    </Grid>
                                    <Border Margin="0,5,0,5" Height="1" Background="#E2E8F0" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="صافي المبلغ المحصل:" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInvoice.NetCollectedDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="13" FontWeight="Bold" Foreground="#0F766E" />
                                    </Grid>
                                    <Grid Margin="0,3,0,0" Visibility="{Binding SelectedInvoice.HasRemaining, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="المتبقي على العميل (آجل):" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="#B42318" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInvoice.RemainingAmountDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="13" FontWeight="Bold" Foreground="#B42318" />
                                    </Grid>
                                    <Grid Margin="0,3,0,0" Visibility="{Binding SelectedInvoice.HasChange, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="الباقي المردود للعميل:" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#475569" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInvoice.ChangeAmountDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 5: Audit & Activity History Log -->
                            <Border Padding="11" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="سجل المراجعة والحركات على الفاتورة" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,6" FontSize="13" FontWeight="Bold" Foreground="#102E48" />
                                    <ItemsControl ItemsSource="{Binding SelectedInvoice.ActivityLog}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,5" Padding="8,6" CornerRadius="7" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <StackPanel>
                                                        <Grid FlowDirection="RightToLeft">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ActionTitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#102E48" />
                                                            <TextBlock Grid.Column="1" Text="{Binding TimestampDisplay}" Style="{StaticResource PosLtrTextStyle}" FontFamily="Consolas, Segoe UI" FontSize="10.5" Foreground="#64748B" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="11" Foreground="#334155" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding ActorName, StringFormat=بواسطة: {0}}" Style="{StaticResource PosRtlTextStyle}" FontSize="10" Foreground="#64748B" />
                                                            <TextBlock Text="{Binding AmountDisplay, StringFormat=' · القيمة: {0}'}" Style="{StaticResource PosRtlTextStyle}" FontSize="10" FontWeight="Bold" Foreground="#0F766E" Visibility="{Binding HasAmount, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Empty Detail Selection -->
                    <TextBlock Grid.Row="1"
                               Text="اختر فاتورة من القائمة لعرض كافة تفاصيلها وسجلها المالي."
                               Style="{StaticResource PosCenterTextStyle}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="13.5"
                               Foreground="#94A3B8"
                               Visibility="{Binding HasSelectedInvoice, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </Border>

            <!-- Draggable Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE" />

            <!-- PHYSICAL RIGHT COLUMN: Master Invoices Table -->
            <Border Grid.Column="2"
                    CornerRadius="14"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    FlowDirection="LeftToRight">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              FlowDirection="LeftToRight">
                    <Grid MinWidth="1040">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Table Header -->
                        <Border Grid.Row="0"
                                Background="#102E48"
                                CornerRadius="13,13,0,0"
                                Padding="10,10">
                            <Grid FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="116" />
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="رقم الفاتورة" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#6EE7D8" />
                                <TextBlock Grid.Column="1" Text="التاريخ والوقت" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                                <TextBlock Grid.Column="2" Text="العميل" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="White" />
                                <TextBlock Grid.Column="3" Text="الكاشير" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                                <TextBlock Grid.Column="4" Text="الأصناف / القطع" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                                <TextBlock Grid.Column="5" Text="الإجمالي" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                                <TextBlock Grid.Column="6" Text="الخصم" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#FCA5A5" />
                                <TextBlock Grid.Column="7" Text="الصافي" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#6EE7D8" />
                                <TextBlock Grid.Column="8" Text="طريقة الدفع" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                                <TextBlock Grid.Column="9" Text="الحالة" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                                <TextBlock Grid.Column="10" Text="تحكم" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#BAE6FD" />
                            </Grid>
                        </Border>

                        <!-- Table Rows -->
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          FlowDirection="LeftToRight">
                                <ItemsControl ItemsSource="{Binding FilteredInvoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Padding="0"
                                                    Margin="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.SelectInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="RowCard"
                                                                Padding="10,9"
                                                                Background="White"
                                                                BorderBrush="#F1F5F9"
                                                                BorderThickness="0,0,0,1">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowCard" Property="Background" Value="#F8FAFC" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="RowCard" Property="Background" Value="#F0FDFA" />
                                                                <Setter TargetName="RowCard" Property="BorderBrush" Value="#147D92" />
                                                                <Setter TargetName="RowCard" Property="BorderThickness" Value="0,1,0,1.5" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>

                                                <Grid FlowDirection="RightToLeft">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="116" />
                                                        <ColumnDefinition Width="105" />
                                                        <ColumnDefinition Width="135" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="115" />
                                                        <ColumnDefinition Width="74" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="140" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Invoice Number -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding InvoiceNumber}"
                                                               Style="{StaticResource PosLtrTextStyle}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Consolas, Segoe UI"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="#102E48" />

                                                    <!-- Date & Time -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IssuedDateDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                                                        <TextBlock Text="{Binding IssuedTimeDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="10" Foreground="#64748B" />
                                                    </StackPanel>

                                                    <!-- Customer -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0">
                                                        <TextBlock Text="{Binding CustomerName}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CustomerPhoneDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="10" Foreground="#64748B" />
                                                    </StackPanel>

                                                    <!-- Cashier -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding CashierName}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               VerticalAlignment="Center"
                                                               FontSize="11.5"
                                                               Foreground="#475569"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <!-- Items Summary -->
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding ItemsAndUnitsSummary}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               VerticalAlignment="Center"
                                                               FontSize="10.5"
                                                               Foreground="#334155"
                                                               TextWrapping="Wrap" />

                                                    <!-- Subtotal -->
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding SubtotalDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="#475569" />

                                                    <!-- Discount -->
                                                    <TextBlock Grid.Column="6"
                                                               Text="{Binding EffectiveDiscountDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="#B42318" />

                                                    <!-- Effective Net Total -->
                                                    <TextBlock Grid.Column="7"
                                                               Text="{Binding EffectiveNetSalesDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="#0F766E" />

                                                    <!-- Payment Method -->
                                                    <TextBlock Grid.Column="8"
                                                               Text="{Binding PaymentMethodSummary}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               VerticalAlignment="Center"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#334155"
                                                               TextWrapping="Wrap" />

                                                    <!-- Status Pill -->
                                                    <Border Grid.Column="9"
                                                            Padding="6,3"
                                                            CornerRadius="6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#ECFDF5" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPartialCredit}" Value="True">
                                                                        <Setter Property="Background" Value="#FEF3C7" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPartiallyReturned}" Value="True">
                                                                        <Setter Property="Background" Value="#FFEDD5" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFullyReturned}" Value="True">
                                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                                        <Setter Property="Background" Value="#E2E8F0" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsExchanged}" Value="True">
                                                                        <Setter Property="Background" Value="#EEF2FF" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatusTitle}" FontSize="10.5" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                                    <Setter Property="Foreground" Value="#0F766E" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPartialCredit}" Value="True">
                                                                            <Setter Property="Foreground" Value="#B45309" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsPartiallyReturned}" Value="True">
                                                                            <Setter Property="Foreground" Value="#9A3412" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsFullyReturned}" Value="True">
                                                                            <Setter Property="Foreground" Value="#B42318" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                                            <Setter Property="Foreground" Value="#475569" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsExchanged}" Value="True">
                                                                            <Setter Property="Foreground" Value="#4F46E5" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- Row Quick Control Buttons -->
                                                    <StackPanel Grid.Column="10"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FlowDirection="RightToLeft">
                                                        <Button Content="طباعة"
                                                                Style="{StaticResource InvRowQuickBtnStyle}"
                                                                Background="#F0FDFA"
                                                                Foreground="#0F766E"
                                                                BorderBrush="#99F6E4"
                                                                Command="{Binding DataContext.OpenPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="مرتجع"
                                                                Style="{StaticResource InvRowQuickBtnStyle}"
                                                                Background="#FFF7ED"
                                                                Foreground="#9A3412"
                                                                BorderBrush="#FDBA74"
                                                                IsEnabled="{Binding CanReturn}"
                                                                Command="{Binding DataContext.OpenReturnDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="لا توجد فواتير مطابقة لخيارات البحث أو التصفية الحالية."
                                       Style="{StaticResource PosCenterTextStyle}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#94A3B8"
                                       Visibility="{Binding HasNoFilteredInvoices, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ROW 4: Status Strip -->
        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                FlowDirection="LeftToRight"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="#065F46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="#B42318" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
