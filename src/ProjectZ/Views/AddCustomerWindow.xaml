<Window x:Class="ProjectZ.Views.AddCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        Width="540"
        Height="640"
        MinWidth="460"
        MinHeight="520"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Title>
        <MultiBinding StringFormat="{}{0} — {1}">
            <Binding Path="Name" Source="{StaticResource StoreIdentity}" Mode="OneWay" />
            <Binding Path="WindowTitle" Mode="OneWay" />
        </MultiBinding>
    </Window.Title>

    <Grid FlowDirection="LeftToRight">
        <ContentControl Style="{StaticResource ThemeBackdropStyle}" />
    <Grid Margin="20" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navy Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="18,14"
                CornerRadius="16"
                Background="{DynamicResource Theme.Legacy.102E48.Navigation}"
                FlowDirection="LeftToRight">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        FlowDirection="RightToLeft">
                <Border Width="44"
                        Height="44"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Legacy.1D455F.Navigation}">
                    <Path Data="M15,14 C17.67,14 23,15.34 23,18 L23,20 L7,20 L7,18 C7,15.34 12.33,14 15,14 Z M15,12 C12.79,12 11,10.21 11,8 C11,5.79 12.79,4 15,4 C17.21,4 19,5.79 19,8 C19,10.21 17.21,12 15,12 Z M5,10 L5,7 L3,7 L3,10 L0,10 L0,12 L3,12 L3,15 L5,15 L5,12 L8,12 L8,10 Z"
                          Fill="{DynamicResource Theme.Legacy.6EE7D8.Highlight}"
                          Stretch="Uniform"
                          Width="22"
                          Height="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                    <TextBlock Text="{Binding HeaderSubtitle}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Theme.Legacy.B7CFDD.Text}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Card -->
        <Border Grid.Row="1"
                Padding="20"
                CornerRadius="16"
                Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          FlowDirection="LeftToRight">
                <StackPanel Margin="0,0,4,0" FlowDirection="LeftToRight">
                    <Border Margin="0,0,0,14"
                            Padding="10,8"
                            CornerRadius="8"
                            Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}"
                            BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding BannerHintText}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Name -->
                    <TextBlock Text="اسم العميل *"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,6"
                               FontSize="13.5"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="CustomerNameInput"
                             Style="{StaticResource PosCompactTextBoxStyle}"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="120" />

                    <!-- Phones Row -->
                    <Grid Margin="0,12,0,0" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="هاتف بديل / واتساب"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,0,0,6"
                                       FontSize="13.5"
                                       FontWeight="SemiBold" />
                            <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                     Text="{Binding SecondaryPhone, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="25" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="رقم الهاتف *"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,0,0,6"
                                       FontSize="13.5"
                                       FontWeight="SemiBold" />
                            <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="25" />
                        </StackPanel>
                    </Grid>

                    <!-- Default Price Tier -->
                    <TextBlock Text="الفئة السعرية الافتراضية للعميل"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,12,0,6"
                               FontSize="13.5"
                               FontWeight="SemiBold" />
                    <ComboBox Style="{StaticResource PosComboBoxStyle}"
                              MinHeight="38"
                              ItemsSource="{Binding PriceTierOptions}"
                              DisplayMemberPath="Title"
                              SelectedValuePath="Tier"
                              SelectedValue="{Binding DefaultPriceTier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Address -->
                    <TextBlock Text="العنوان"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,12,0,6"
                               FontSize="13.5"
                               FontWeight="SemiBold" />
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="200" />

                    <!-- Notes -->
                    <TextBlock Text="ملاحظات"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,12,0,6"
                               FontSize="13.5"
                               FontWeight="SemiBold" />
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Height="66"
                             MaxLength="300" />

                    <!-- Inline Error -->
                    <TextBlock Text="{Binding Error}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,10,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}"
                               TextWrapping="Wrap"
                               Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Actions Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إلغاء"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="18,10"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="2"
                    Content="{Binding SaveButtonText}"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    MinWidth="190"
                    Padding="20,10"
                    IsDefault="True"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
