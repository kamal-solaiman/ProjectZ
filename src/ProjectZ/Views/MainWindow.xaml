<Window x:Class="ProjectZ.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProjectZ.Views"
        Title="ProjectZ"
        Width="1320"
        Height="760"
        MinWidth="960"
        MinHeight="560"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SidebarBaseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DCE8EE" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- Keep layout coordinates physical LTR; Arabic TextBlocks opt into RTL. -->
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1D455F" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6EE7D8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarCategoryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarBaseButtonStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Background" Value="#1D455F" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarMenuButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarBaseButtonStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#B7CFDD" />
            <!-- Indent submenu labels on the right so they line up under the category title (after the icon). -->
            <Setter Property="Padding" Value="12,9,50,9" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarToggleButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarBaseButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="طي القائمة" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="ToolTip" Value="توسيع القائمة" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Labels that only make sense in the expanded sidebar; hidden in the icon rail. -->
        <Style x:Key="SidebarExpandedOnlyTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Use fixed physical columns; each Arabic content region sets RTL itself. -->
    <Grid Margin="24" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26*"/>
            <ColumnDefinition Width="41*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,18"
                Padding="16,12"
                CornerRadius="16"
                Background="#102E48" Grid.ColumnSpan="2">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="تسجيل الخروج"
                        Command="{Binding LogoutCommand}"
                        MinWidth="150"
                        HorizontalAlignment="Left"
                        FlowDirection="RightToLeft" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            FlowDirection="RightToLeft">
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Welcome}"
                                   FontSize="16"
                                   Foreground="#DCE8EE"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Username}"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="#DCE8EE"
                                   FlowDirection="LeftToRight" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" FlowDirection="LeftToRight" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,18,0"
                    CornerRadius="18"
                    Background="White"
                    FlowDirection="RightToLeft">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Padding" Value="40" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsImplementedScreenSelected}" Value="True">
                                <Setter Property="Padding" Value="16" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImplementedScreenSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding SelectedCategoryTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock Text="{Binding SelectedPageTitle}"
                                   Margin="0,12,0,12"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedPageDescription}"
                                   MaxWidth="560"
                                   Foreground="#64748B"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPosSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:PosView DataContext="{Binding Pos}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAddProductSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:AddProductView DataContext="{Binding AddProduct}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInventorySelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:InventoryView DataContext="{Binding Inventory}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCategoriesSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:CategoriesView DataContext="{Binding ProductCategories}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInvoicesSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:InvoicesView DataContext="{Binding Invoices}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReturnExchangeSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:ReturnExchangeView DataContext="{Binding ReturnExchange}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPurchaseEntrySelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:PurchaseEntryView DataContext="{Binding PurchaseEntry}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPurchaseInvoicesSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:PurchaseInvoicesView DataContext="{Binding PurchaseInvoices}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMaintenanceIntakeSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:MaintenanceIntakeView DataContext="{Binding MaintenanceIntake}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMaintenanceInvoicesSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:MaintenanceInvoicesView DataContext="{Binding MaintenanceInvoices}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMaintenanceActionsSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:MaintenanceActionsView DataContext="{Binding MaintenanceActions}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMaintenanceSparePartsSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:MaintenanceSparePartsView DataContext="{Binding MaintenanceSpareParts}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustomersSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:CustomersView DataContext="{Binding Customers}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuppliersSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:SuppliersView DataContext="{Binding Suppliers}" />
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMyAccountsSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:MyAccountsView DataContext="{Binding MyAccounts}" />
                    </Grid>
                    <Grid Visibility="{Binding IsVodafoneTransferSelected, Converter={StaticResource BoolToVis}}">
                        <views:VodafoneTransferView DataContext="{Binding VodafoneTransfer}" />
                    </Grid>
                    <Grid Visibility="{Binding IsInstapayTransferSelected, Converter={StaticResource BoolToVis}}">
                        <views:InstapayTransferView DataContext="{Binding InstapayTransfer}" />
                    </Grid>
                    <Grid Visibility="{Binding IsVodafoneRecordsSelected, Converter={StaticResource BoolToVis}}">
                        <views:VodafoneRecordsView DataContext="{Binding VodafoneRecords}" />
                    </Grid>
                </Grid>
            </Border>

            <!--
              Sidebar on the physical right. Width is animated (expanded <-> icon rail), so the
              right edge stays anchored and the content area grows toward the right when collapsed.
              Arabic labels are content-sized and HorizontalAlignment="Right": inside an RTL TextBlock
              TextAlignment is flow-relative, so TextAlignment="Right" would land on the physical LEFT.
            -->
            <Border Grid.Column="1"
                    CornerRadius="18"
                    Background="#102E48"
                    ClipToBounds="True"
                    FlowDirection="LeftToRight">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="340" />
                        <Setter Property="Padding" Value="16" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="88"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="340"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,6,0,14"
                          FlowDirection="LeftToRight">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- RTL order: first child (the toggle) sits on the far right. -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    FlowDirection="RightToLeft">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Command="{Binding ToggleSidebarCommand}"
                                    AutomationProperties.Name="طي أو توسيع القائمة الجانبية"
                                    Style="{StaticResource SidebarToggleButtonStyle}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="18" Height="2" CornerRadius="1" Background="#DCE8EE" />
                                    <Border Width="18" Height="2" CornerRadius="1" Margin="0,4" Background="#DCE8EE" />
                                    <Border Width="18" Height="2" CornerRadius="1" Background="#DCE8EE" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="ProjectZ"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FlowDirection="LeftToRight"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Style="{StaticResource SidebarExpandedOnlyTextStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="القائمة الرئيسية"
                                   Margin="0,8,12,0"
                                   HorizontalAlignment="Right"
                                   FlowDirection="RightToLeft"
                                   FontSize="13"
                                   Foreground="#B7CFDD"
                                   Style="{StaticResource SidebarExpandedOnlyTextStyle}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  FlowDirection="LeftToRight"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                <Style.Triggers>
                                    <!-- No scrollbar in the narrow rail (wheel scrolling still works). -->
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding Categories}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      FlowDirection="LeftToRight">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,5"
                                                HorizontalAlignment="Stretch"
                                                FlowDirection="LeftToRight">
                                        <Button x:Name="CategoryButton"
                                                Tag="{Binding}"
                                                HorizontalAlignment="Stretch"
                                                Click="CategoryHeader_Click"
                                                Style="{StaticResource SidebarCategoryButtonStyle}">
                                            <!-- RTL stack: icon on the far right, then the title, then the chevron. -->
                                            <StackPanel x:Name="CategoryContent"
                                                        Orientation="Horizontal"
                                                        FlowDirection="RightToLeft">
                                                <TextBlock x:Name="CategoryIcon"
                                                           Text="{Binding Icon}"
                                                           Width="26"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                                           FontSize="17"
                                                           TextAlignment="Center" />
                                                <TextBlock x:Name="CategoryTitle"
                                                           Text="{Binding Title}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FlowDirection="RightToLeft" />
                                                <TextBlock x:Name="CategoryChevron"
                                                           Text="{Binding Chevron}"
                                                           MinWidth="20"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="17"
                                                           FlowDirection="LeftToRight"
                                                           Foreground="#85AABC"
                                                           TextAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      FlowDirection="LeftToRight">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <!-- Submenus show only for the open category AND an expanded sidebar. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding}"
                                                            HorizontalAlignment="Stretch"
                                                            Click="MenuItem_Click"
                                                            Style="{StaticResource SidebarMenuButtonStyle}">
                                                        <TextBlock Text="{Binding Title}"
                                                                   HorizontalAlignment="Right"
                                                                   FlowDirection="RightToLeft" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <!-- Icon rail: icon only, centered, with the full name as a tooltip. -->
                                        <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="CategoryTitle" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="CategoryChevron" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="CategoryContent" Property="HorizontalAlignment" Value="Center" />
                                            <Setter TargetName="CategoryButton" Property="ToolTip" Value="{Binding Title}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Margin="0,12,12,2"
                               HorizontalAlignment="Right"
                               FlowDirection="RightToLeft"
                               Text="إدارة النظام"
                               FontSize="12"
                               Foreground="#85AABC"
                               Style="{StaticResource SidebarExpandedOnlyTextStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
