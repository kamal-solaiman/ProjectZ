<Window x:Class="ProjectZ.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectZ"
        Width="1200"
        Height="720"
        MinWidth="960"
        MinHeight="560"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SidebarBaseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DCE8EE" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1D455F" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6EE7D8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarCategoryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarBaseButtonStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Background" Value="#1D455F" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarMenuButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarBaseButtonStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#B7CFDD" />
            <!-- Add submenu indentation on the right, where Arabic labels align. -->
            <Setter Property="Padding" Value="12,9,30,9" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Use fixed physical columns; each Arabic content region sets RTL itself. -->
    <Grid Margin="24" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,18"
                Padding="16,12"
                CornerRadius="16"
                Background="White">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="تسجيل الخروج"
                        Command="{Binding LogoutCommand}"
                        MinWidth="150"
                        HorizontalAlignment="Left"
                        FlowDirection="RightToLeft" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            FlowDirection="RightToLeft">
                    <TextBlock Text="ProjectZ"
                               FlowDirection="LeftToRight"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center" />
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Welcome}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Username}"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   FlowDirection="LeftToRight" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,18,0"
                    Padding="40"
                    CornerRadius="18"
                    Background="White"
                    FlowDirection="RightToLeft">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCategoryTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding SelectedPageTitle}"
                               Margin="0,12,0,12"
                               FontSize="32"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedPageDescription}"
                               MaxWidth="560"
                               Foreground="#64748B"
                               FontSize="16"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Padding="16"
                    CornerRadius="18"
                    Background="#102E48"
                    FlowDirection="RightToLeft">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="8,6,8,14"
                                HorizontalAlignment="Stretch"
                                FlowDirection="RightToLeft">
                        <TextBlock Text="ProjectZ"
                                   HorizontalAlignment="Stretch"
                                   FlowDirection="LeftToRight"
                                   TextAlignment="Right"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="القائمة الرئيسية"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Stretch"
                                   FlowDirection="RightToLeft"
                                   TextAlignment="Right"
                                   FontSize="13"
                                   Foreground="#B7CFDD" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  FlowDirection="RightToLeft"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <ItemsControl ItemsSource="{Binding Categories}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      FlowDirection="RightToLeft">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,5"
                                                HorizontalAlignment="Stretch"
                                                FlowDirection="RightToLeft">
                                        <Button Tag="{Binding}"
                                                HorizontalAlignment="Stretch"
                                                Click="CategoryHeader_Click"
                                                Style="{StaticResource SidebarCategoryButtonStyle}">
                                            <Grid HorizontalAlignment="Stretch" FlowDirection="LeftToRight">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Chevron}"
                                                           MinWidth="20"
                                                           FontSize="17"
                                                           FlowDirection="LeftToRight"
                                                           Foreground="#85AABC"
                                                           TextAlignment="Center" />
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Title}"
                                                           HorizontalAlignment="Stretch"
                                                           FlowDirection="RightToLeft"
                                                           TextAlignment="Right" />
                                            </Grid>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      FlowDirection="RightToLeft">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding}"
                                                            HorizontalAlignment="Stretch"
                                                            Click="MenuItem_Click"
                                                            Style="{StaticResource SidebarMenuButtonStyle}">
                                                        <TextBlock Text="{Binding Title}"
                                                                   HorizontalAlignment="Stretch"
                                                                   FlowDirection="RightToLeft"
                                                                   TextAlignment="Right" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Margin="8,12,8,2"
                               HorizontalAlignment="Stretch"
                               FlowDirection="RightToLeft"
                               Text="إدارة النظام"
                               FontSize="12"
                               Foreground="#85AABC"
                               TextAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
