<UserControl x:Class="ProjectZ.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProjectZ.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CustomersViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PosStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CustCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="CustKpiCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,11" />
            </Style>

            <Style x:Key="CustTabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#F1F5F9" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Body"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Body" Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CustHeaderChipBtnStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Margin" Value="0,4,6,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Body"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Body" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Body" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid FlowDirection="LeftToRight" Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════ ROW 0: HEADER ══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ إضافة عميل جديد"
                        Style="{StaticResource PosPrimaryCompactButtonStyle}"
                        Command="{Binding AddCustomerCommand}"
                        Margin="0,0,8,0" />
                <Button Content="تحديث البيانات"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Command="{Binding RefreshDataCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="العملاء — إدارة الحسابات وسجل المعاملات"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#102E48" />
                    <Border Margin="10,0,0,0"
                            Padding="10,4"
                            CornerRadius="8"
                            Background="#E0F2FE"
                            BorderBrush="#7DD3FC"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="عملاء المبيعات والصيانة · تصميم الواجهة"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#0369A1" />
                    </Border>
                </StackPanel>
                <TextBlock Text="دليل عملاء موحد بين نقطة البيع والصيانة: متابعة فواتير المبيعات وتذاكر الصيانة، الأرصدة المتبقية، والتحصيل المباشر."
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="12.5"
                           Foreground="#64748B"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- ══════════ ROW 1: SEARCH & FILTERS BAR ══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CustCardStyle}" Padding="12,10" Margin="0,0,0,12">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="إلغاء الفلاتر"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Padding="12,7"
                        Command="{Binding ClearFiltersCommand}" />

                <ComboBox Grid.Column="2"
                          Style="{StaticResource PosComboBoxStyle}"
                          MinHeight="34"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption}"
                          FlowDirection="RightToLeft"
                          ToolTip="ترتيب العملاء" />

                <ComboBox Grid.Column="4"
                          Style="{StaticResource PosComboBoxStyle}"
                          MinHeight="34"
                          ItemsSource="{Binding BalanceFilterOptions}"
                          SelectedItem="{Binding SelectedBalanceFilter}"
                          FlowDirection="RightToLeft"
                          ToolTip="حالة الرصيد والمعاملات" />

                <ComboBox Grid.Column="6"
                          Style="{StaticResource PosComboBoxStyle}"
                          MinHeight="34"
                          ItemsSource="{Binding TierFilterOptions}"
                          SelectedItem="{Binding SelectedTierFilter}"
                          FlowDirection="RightToLeft"
                          ToolTip="فئة السعر الافتراضية" />

                <Grid Grid.Column="8">
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                             MinHeight="34"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             Padding="32,6,12,6"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="ابحث باسم العميل، رقم الهاتف، العنوان، الكود، أو رقم فاتورة / تذكرة صيانة..."
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="12,0,32,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#94A3B8"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                    <Button Content="×"
                            Width="22"
                            Height="22"
                            Margin="6,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource PosDangerIconButtonStyle}"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════ ROW 2: MASTER-DETAIL WORKSPACE ══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="470" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="480" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: CUSTOMERS TABLE -->
            <Border Grid.Column="0" Style="{StaticResource CustCardStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Dark Navy Table Header -->
                    <Border Grid.Row="0"
                            Padding="10,9"
                            CornerRadius="10"
                            Background="#102E48"
                            Margin="0,0,0,6">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="1.9*" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="115" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="الكود" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#6EE7D8" />
                                <TextBlock Grid.Column="1" Text="العميل والهاتف" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                                <TextBlock Grid.Column="2" Text="التسعير" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                                <TextBlock Grid.Column="3" Text="المعاملات" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                                <TextBlock Grid.Column="4" Text="إجمالي التعامل" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#6EE7D8" />
                                <TextBlock Grid.Column="5" Text="المتبقي / الحالة" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#FDE68A" />
                            </Grid>

                            <TextBlock Grid.Column="1" Text="تحكم" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#BAE6FD" />
                        </Grid>
                    </Border>

                    <!-- Customer Rows -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      FlowDirection="LeftToRight">
                            <ItemsControl ItemsSource="{Binding FilteredCustomers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,5" CornerRadius="10" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8FAFC" />
                                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#ECFEFF" />
                                                            <Setter Property="BorderBrush" Value="#147D92" />
                                                            <Setter Property="BorderThickness" Value="1.5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid FlowDirection="RightToLeft" Margin="6,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Clickable Row Info Area -->
                                                <Button Grid.Column="0"
                                                        Padding="4,3"
                                                        HorizontalContentAlignment="Stretch"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="74" />
                                                            <ColumnDefinition Width="1.9*" />
                                                            <ColumnDefinition Width="82" />
                                                            <ColumnDefinition Width="125" />
                                                            <ColumnDefinition Width="105" />
                                                            <ColumnDefinition Width="115" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Code -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Customer.CustomerCodeDisplay}"
                                                                   Style="{StaticResource PosLtrTextStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Consolas, Segoe UI"
                                                                   FontSize="11.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="#147D92" />

                                                        <!-- Name + Phone + Address -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                                            <TextBlock Text="{Binding Customer.Name}"
                                                                       Style="{StaticResource PosRtlTextStyle}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Customer.DisplayPhone}"
                                                                       Style="{StaticResource PosLtrTextStyle}"
                                                                       HorizontalAlignment="Right"
                                                                       FontSize="11"
                                                                       Foreground="#475569" />
                                                            <TextBlock Text="{Binding Customer.Address}"
                                                                       Style="{StaticResource PosRtlTextStyle}"
                                                                       FontSize="10.5"
                                                                       Foreground="#94A3B8"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding Customer.HasAddress, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>

                                                        <!-- Default Price Tier Badge -->
                                                        <Border Grid.Column="2"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Padding="8,3"
                                                                CornerRadius="6"
                                                                Background="#E0F2FE">
                                                            <TextBlock Text="{Binding Customer.DefaultPriceTierShortTitle}"
                                                                       Style="{StaticResource PosCenterTextStyle}"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="#0369A1" />
                                                        </Border>

                                                        <!-- Transactions Count -->
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TransactionsSummaryText}"
                                                                       Style="{StaticResource PosCenterTextStyle}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#334155" />
                                                            <TextBlock Text="{Binding LastActivityDisplay, StringFormat='آخر نشاط: {0}'}"
                                                                       Style="{StaticResource PosCenterTextStyle}"
                                                                       FontSize="10"
                                                                       Foreground="#64748B" />
                                                        </StackPanel>

                                                        <!-- Total Business Value -->
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding TotalBusinessValueDisplay}"
                                                                   Style="{StaticResource PosLtrTextStyle}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="#102E48" />

                                                        <!-- Remaining Balance Badge -->
                                                        <Border Grid.Column="5"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Padding="8,4"
                                                                CornerRadius="7">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#ECFDF5" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasRemaining}" Value="True">
                                                                            <Setter Property="Background" Value="#FEE2E2" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding BalanceStatusTitle}" FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                                        <Setter Property="Foreground" Value="#047857" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasRemaining}" Value="True">
                                                                                <Setter Property="Foreground" Value="#B42318" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Button>

                                                <!-- Standalone Edit Button on Row -->
                                                <Button Grid.Column="1"
                                                        Content="تعديل"
                                                        Style="{StaticResource PosOutlineTealButtonStyle}"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding Customer.CanEditOrDelete, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.EditCustomerRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty Customers List -->
                        <Border Visibility="{Binding HasNoFilteredCustomers, Converter={StaticResource BoolToVis}}"
                                Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="لا يوجد عملاء مطابقون لمعايير البحث الحالية"
                                           Style="{StaticResource PosCenterTextStyle}"
                                           FontSize="14.5"
                                           FontWeight="Bold"
                                           Foreground="#102E48" />
                                <TextBlock Text="يمكنك إعادة ضبط الفلاتر أو تسجيل عميل جديد الآن."
                                           Style="{StaticResource PosCenterTextStyle}"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           Margin="0,5,0,12" />
                                <Button Content="عرض جميع العملاء"
                                        Style="{StaticResource PosPrimaryCompactButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Command="{Binding ClearFiltersCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: SELECTED CUSTOMER 360° PROFILE & TRANSACTIONS -->
            <Border Grid.Column="2" Style="{StaticResource CustCardStyle}" Background="#F8FAFC" Padding="12">
                <Grid FlowDirection="LeftToRight">
                    <TextBlock Text="اختر عميلًا من القائمة لعرض ملفه الكامل وفواتير المبيعات وتذاكر الصيانة."
                               Style="{StaticResource PosCenterTextStyle}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="13.5"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSelectedCustomer, Converter={StaticResource InverseBoolToVis}}" />

                    <Grid Visibility="{Binding HasSelectedCustomer, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- A. Selected Customer Header Banner -->
                        <Border Grid.Row="0" Padding="13" CornerRadius="12" Background="#102E48" Margin="0,0,0,10">
                            <StackPanel FlowDirection="RightToLeft">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="42"
                                            Height="42"
                                            CornerRadius="11"
                                            Background="#147D92"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SelectedCustomerEntry.Customer.InitialBadgeText}"
                                                   Style="{StaticResource PosCenterTextStyle}"
                                                   VerticalAlignment="Center"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SelectedCustomerEntry.Customer.Name}"
                                                       Style="{StaticResource PosRtlTextStyle}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="White" />
                                            <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="6" Background="#1D455F" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedCustomerEntry.Customer.CustomerCodeDisplay}"
                                                           Style="{StaticResource PosLtrTextStyle}"
                                                           FontFamily="Consolas, Segoe UI"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#6EE7D8" />
                                            </Border>
                                        </StackPanel>

                                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding SelectedCustomerEntry.Customer.DisplayPhone}"
                                                       Style="{StaticResource PosLtrTextStyle}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#99F6E4" />
                                            <TextBlock Text=" · "
                                                       Style="{StaticResource PosCenterTextStyle}"
                                                       Foreground="#64748B"
                                                       Visibility="{Binding SelectedCustomerEntry.Customer.HasSecondaryPhone, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding SelectedCustomerEntry.Customer.SecondaryPhone}"
                                                       Style="{StaticResource PosLtrTextStyle}"
                                                       FontSize="11.5"
                                                       Foreground="#CBD5E1"
                                                       Visibility="{Binding SelectedCustomerEntry.Customer.HasSecondaryPhone, Converter={StaticResource BoolToVis}}" />
                                            <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="5" Background="#0F766E">
                                                <TextBlock Text="{Binding SelectedCustomerEntry.Customer.DefaultPriceTierTitle}"
                                                           Style="{StaticResource PosCenterTextStyle}"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"
                                                           Foreground="White" />
                                            </Border>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding SelectedCustomerEntry.Customer.AddressDisplay, StringFormat='العنوان: {0}'}"
                                                   Style="{StaticResource PosRtlTextStyle}"
                                                   Margin="0,4,0,0"
                                                   FontSize="11.5"
                                                   Foreground="#CBD5E1"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding SelectedCustomerEntry.Customer.Notes, StringFormat='ملاحظات: {0}'}"
                                                   Style="{StaticResource PosRtlTextStyle}"
                                                   Margin="0,3,0,0"
                                                   FontSize="11"
                                                   Foreground="#FDE68A"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding SelectedCustomerEntry.Customer.HasNotes, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Quick Action Chips -->
                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="+ فاتورة بيع جديدة"
                                            Style="{StaticResource CustHeaderChipBtnStyle}"
                                            Background="#0F766E"
                                            BorderBrush="#14B8A6"
                                            Foreground="White"
                                            Command="{Binding StartSaleForCustomerCommand}" />
                                    <Button Content="+ أمر صيانة جديد"
                                            Style="{StaticResource CustHeaderChipBtnStyle}"
                                            Background="#1D4ED8"
                                            BorderBrush="#60A5FA"
                                            Foreground="White"
                                            Command="{Binding StartMaintenanceForCustomerCommand}" />
                                    <Button Content="تعديل البيانات"
                                            Style="{StaticResource CustHeaderChipBtnStyle}"
                                            Background="#F8FAFC"
                                            BorderBrush="#CBD5E1"
                                            Foreground="#102E48"
                                            Visibility="{Binding SelectedCustomerEntry.Customer.CanEditOrDelete, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding EditSelectedCustomerCommand}" />
                                    <Button Content="حذف"
                                            Style="{StaticResource CustHeaderChipBtnStyle}"
                                            Background="#FEF2F2"
                                            BorderBrush="#FECACA"
                                            Foreground="#B42318"
                                            Visibility="{Binding SelectedCustomerEntry.Customer.CanEditOrDelete, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DeleteSelectedCustomerCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- B. Selected Customer Financial Summary (4 mini cards) -->
                        <Grid Grid.Row="1" FlowDirection="RightToLeft" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Padding="8,7" CornerRadius="9" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="المبيعات" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedCustomerEntry.TotalSalesNetDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#102E48" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Padding="8,7" CornerRadius="9" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="الصيانة" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedCustomerEntry.TotalMaintenanceValueDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#0369A1" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Padding="8,7" CornerRadius="9" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="المسدّد" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedCustomerEntry.TotalPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#0F766E" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="6" Padding="8,7" CornerRadius="9" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#ECFDF5" />
                                        <Setter Property="BorderBrush" Value="#A7F3D0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCustomerEntry.HasRemaining}" Value="True">
                                                <Setter Property="Background" Value="#FEF2F2" />
                                                <Setter Property="BorderBrush" Value="#FECACA" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="المتبقي عليه" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#475569" />
                                    <TextBlock Text="{Binding SelectedCustomerEntry.TotalRemainingDisplay}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PosLtrTextStyle}">
                                                <Setter Property="Foreground" Value="#047857" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCustomerEntry.HasRemaining}" Value="True">
                                                        <Setter Property="Foreground" Value="#B42318" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- C. Transactions Tabs Switcher -->
                        <Grid Grid.Row="2" FlowDirection="RightToLeft" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="{Binding SelectedSalesTabTitle}"
                                    Command="{Binding SelectDetailTabCommand}"
                                    CommandParameter="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CustTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSalesTabSelected}" Value="True">
                                                <Setter Property="Background" Value="#147D92" />
                                                <Setter Property="BorderBrush" Value="#147D92" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Grid.Column="2"
                                    Content="{Binding SelectedMaintenanceTabTitle}"
                                    Command="{Binding SelectDetailTabCommand}"
                                    CommandParameter="1">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CustTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMaintenanceTabSelected}" Value="True">
                                                <Setter Property="Background" Value="#102E48" />
                                                <Setter Property="BorderBrush" Value="#102E48" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- D. Tab Content: Sales Invoices OR Maintenance Orders -->
                        <Grid Grid.Row="3">
                            <!-- TAB 0: SALES INVOICES -->
                            <Grid Visibility="{Binding IsSalesTabSelected, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SelectedCustomerSalesInvoices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,7" Padding="10,9" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <StackPanel FlowDirection="RightToLeft">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding InvoiceNumber}" Style="{StaticResource PosLtrTextStyle}" FontFamily="Consolas, Segoe UI" FontSize="12.5" FontWeight="Bold" Foreground="#102E48" />
                                                                <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="5" Background="#F1F5F9">
                                                                    <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" FontWeight="Bold" Foreground="#334155" />
                                                                </Border>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="1" Text="{Binding IssuedFullDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
                                                        </Grid>

                                                        <TextBlock Text="{Binding ItemsAndUnitsSummary}" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="#475569" Margin="0,4,0,0" />

                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="الصافي: " Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#64748B" />
                                                                <TextBlock Text="{Binding EffectiveNetSalesDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#102E48" />
                                                                <TextBlock Text=" · المتبقي: " Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#64748B" Visibility="{Binding HasRemaining, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Text="{Binding RemainingAmountDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#B42318" Visibility="{Binding HasRemaining, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <Button Content="تحصيل"
                                                                        Style="{StaticResource PosPrimaryCompactButtonStyle}"
                                                                        Padding="10,4"
                                                                        FontSize="11"
                                                                        Margin="0,0,6,0"
                                                                        Visibility="{Binding CanCollectRemaining, Converter={StaticResource BoolToVis}}"
                                                                        Command="{Binding DataContext.CollectSalesInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="معاينة / طباعة"
                                                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                                                        Padding="9,4"
                                                                        FontSize="11"
                                                                        Command="{Binding DataContext.PrintSalesInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="لا توجد فواتير مبيعات مسجلة لهذا العميل حتى الآن."
                                           Style="{StaticResource PosCenterTextStyle}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="#94A3B8"
                                           Visibility="{Binding HasNoSelectedCustomerSales, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <!-- TAB 1: MAINTENANCE ORDERS -->
                            <Grid Visibility="{Binding IsMaintenanceTabSelected, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SelectedCustomerMaintenanceOrders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,7" Padding="10,9" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <StackPanel FlowDirection="RightToLeft">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding OrderNumber}" Style="{StaticResource PosLtrTextStyle}" FontFamily="Consolas, Segoe UI" FontSize="12.5" FontWeight="Bold" Foreground="#147D92" />
                                                                <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="5" Background="#E0F2FE">
                                                                    <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" FontWeight="Bold" Foreground="#0369A1" />
                                                                </Border>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="1" Text="{Binding ReceivedFullDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
                                                        </Grid>

                                                        <TextBlock Text="{Binding DeviceFullTitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding ReportedFault}" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />

                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="الإجمالي: " Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#64748B" />
                                                                <TextBlock Text="{Binding EstimatedCostDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#102E48" />
                                                                <TextBlock Text=" · المتبقي: " Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#64748B" Visibility="{Binding HasEstimatedRemaining, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Text="{Binding EstimatedRemainingDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#B42318" Visibility="{Binding HasEstimatedRemaining, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <Button Content="تحصيل وتسليم"
                                                                        Style="{StaticResource PosPrimaryCompactButtonStyle}"
                                                                        Padding="9,4"
                                                                        FontSize="10.5"
                                                                        Margin="0,0,5,0"
                                                                        Visibility="{Binding IsActiveOrder, Converter={StaticResource BoolToVis}}"
                                                                        Command="{Binding DataContext.DeliverAndCollectMaintenanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="تفاصيل"
                                                                        Style="{StaticResource PosOutlineTealButtonStyle}"
                                                                        Padding="8,4"
                                                                        FontSize="10.5"
                                                                        Margin="0,0,5,0"
                                                                        Command="{Binding DataContext.OpenMaintenanceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="الإجراءات"
                                                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                                                        Padding="8,4"
                                                                        FontSize="10.5"
                                                                        Command="{Binding DataContext.OpenMaintenanceInActionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="لا توجد تذاكر صيانة مسجلة لهذا العميل حتى الآن."
                                           Style="{StaticResource PosCenterTextStyle}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="#94A3B8"
                                           Visibility="{Binding HasNoSelectedCustomerMaintenance, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════ ROW 3: STATUS BAR ══════════ -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                BorderThickness="1"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="#065F46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="#991B1B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
