<UserControl x:Class="ProjectZ.Views.VodafoneRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProjectZ.ViewModels" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VodafoneRecordsViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/PosStyles.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style x:Key="RecordCard" TargetType="Border"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E2E8F0" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /></Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}"><Setter Property="FontSize" Value="10.5" /><Setter Property="Foreground" Value="#64748B" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
        <Style x:Key="RecordAction" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}"><Setter Property="Padding" Value="11,6" /><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,6,0" /></Style>
    </ResourceDictionary></UserControl.Resources>
    <Grid x:Name="PrintArea" FlowDirection="LeftToRight" Margin="18,14" Background="#F8FAFC"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <WrapPanel VerticalAlignment="Center"><Button Content="تفاصيل" Style="{StaticResource RecordAction}" Command="{Binding ShowDetailsCommand}" /><Button Content="تعديل" Style="{StaticResource RecordAction}" Command="{Binding BeginEditCommand}" /><Button Content="عكس العملية" Style="{StaticResource RecordAction}" Foreground="#B45309" Command="{Binding ReverseCommand}" /><Button Content="حذف السجل" Style="{StaticResource RecordAction}" Foreground="#B42318" Command="{Binding DeleteCommand}" /><Button Content="نسخ المرجع" Style="{StaticResource RecordAction}" Click="CopyReference_Click" /><Button Content="تصدير CSV" Style="{StaticResource RecordAction}" Click="ExportCsv_Click" /><Button Content="طباعة" Style="{StaticResource RecordAction}" Click="Print_Click" /><Button Content="تحديث" Style="{StaticResource RecordAction}" Command="{Binding RefreshCommand}" /></WrapPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="سجلات فودافون كاش" Style="{StaticResource PosRtlTextStyle}" FontSize="22" FontWeight="Bold" Foreground="#102E48" /><TextBlock Text="مراجعة تفصيلية وبحث متقدم وتعديل وعكس وحذف العمليات مع تسوية الأرصدة ودفتر الحسابات." Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#64748B" /></StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <Border Style="{StaticResource RecordCard}" Padding="12" Margin="0,0,0,10"><StackPanel>
                <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="الفلتر المتكامل" Style="{StaticResource PosRtlTextStyle}" FontSize="15" FontWeight="Bold" Foreground="#102E48" /><Button Grid.Column="1" Content="إلغاء كل الفلاتر" Style="{StaticResource RecordAction}" Command="{Binding ClearFiltersCommand}" /></Grid>
                <Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="7" /><ColumnDefinition Width="125" /><ColumnDefinition Width="7" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="130" /><ColumnDefinition Width="7" /><ColumnDefinition Width="110" /><ColumnDefinition Width="7" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="من تاريخ" Style="{StaticResource FilterLabel}" /><DatePicker SelectedDate="{Binding FromDate}" FlowDirection="LeftToRight" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="إلى تاريخ" Style="{StaticResource FilterLabel}" /><DatePicker SelectedDate="{Binding ToDate}" FlowDirection="LeftToRight" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="خط فودافون" Style="{StaticResource FilterLabel}" /><ComboBox Style="{StaticResource PosComboBoxStyle}" ItemsSource="{Binding WalletFilters}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding SelectedWalletId}" /></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Text="نوع العملية" Style="{StaticResource FilterLabel}" /><ComboBox Style="{StaticResource PosComboBoxStyle}" ItemsSource="{Binding KindFilters}" SelectedItem="{Binding SelectedKind}" /></StackPanel>
                    <StackPanel Grid.Column="8"><TextBlock Text="الحالة" Style="{StaticResource FilterLabel}" /><ComboBox Style="{StaticResource PosComboBoxStyle}" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}" /></StackPanel>
                    <StackPanel Grid.Column="10"><TextBlock Text="المستخدم" Style="{StaticResource FilterLabel}" /><TextBox Style="{StaticResource PosCompactTextBoxStyle}" FlowDirection="RightToLeft" Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                </Grid>
                <Grid FlowDirection="RightToLeft" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="رقم العميل" Style="{StaticResource FilterLabel}" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding CustomerFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="المرجع" Style="{StaticResource FilterLabel}" /><TextBox Style="{StaticResource PosCompactTextBoxStyle}" FlowDirection="LeftToRight" Text="{Binding ReferenceFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="المبلغ من" Style="{StaticResource FilterLabel}" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding MinimumAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Text="المبلغ إلى" Style="{StaticResource FilterLabel}" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding MaximumAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Grid.Column="8"><TextBlock Text="العمولة من" Style="{StaticResource FilterLabel}" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding MinimumCommissionText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Grid.Column="10"><TextBlock Text="العمولة إلى" Style="{StaticResource FilterLabel}" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding MaximumCommissionText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                </Grid>
            </StackPanel></Border>

            <Border Style="{StaticResource RecordCard}" Padding="10" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ResultCountDisplay}" Style="{StaticResource PosRtlTextStyle}" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding FilteredAmountDisplay, StringFormat='إجمالي المبالغ: {0}'}" Style="{StaticResource PosRtlTextStyle}" Margin="15,0" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding FilteredCommissionDisplay, StringFormat='إجمالي العمولات: {0}'}" Style="{StaticResource PosRtlTextStyle}" Foreground="#B45309" VerticalAlignment="Center" /></Grid></Border>

            <Border Style="{StaticResource RecordCard}" Padding="0" Height="430"><Grid><DataGrid ItemsSource="{Binding FilteredOperations}" SelectedItem="{Binding SelectedOperation}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="48" ColumnHeaderHeight="38" FlowDirection="RightToLeft" MouseDoubleClick="Records_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="التفاصيل" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="عرض" Style="{StaticResource RecordAction}" Margin="0" Padding="7,3" Command="{Binding DataContext.ShowOperationDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding DateDisplay}" Width="88" /><DataGridTextColumn Header="الوقت" Binding="{Binding TimeDisplay}" Width="55" />
                    <DataGridTextColumn Header="الخط" Binding="{Binding WalletAlias}" Width="160" /><DataGridTextColumn Header="النوع" Binding="{Binding OperationTitle}" Width="95" />
                    <DataGridTextColumn Header="رقم العميل" Binding="{Binding CustomerNumber}" Width="105" /><DataGridTextColumn Header="المبلغ" Binding="{Binding AmountDisplay}" Width="95" />
                    <DataGridTextColumn Header="العمولة" Binding="{Binding CommissionDisplay}" Width="80" /><DataGridTextColumn Header="الرصيد بعدها" Binding="{Binding WalletBalanceAfterDisplay}" Width="100" />
                    <DataGridTextColumn Header="المستخدم" Binding="{Binding ActorName}" Width="85" /><DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="120" /><DataGridTextColumn Header="الحالة" Binding="{Binding StatusTitle}" Width="70" />
                </DataGrid.Columns>
            </DataGrid><TextBlock Text="لا توجد سجلات مطابقة للفلاتر." Style="{StaticResource PosCenterTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" Visibility="{Binding HasNoOperations, Converter={StaticResource BoolToVis}}" /></Grid></Border>

            <Border Style="{StaticResource RecordCard}" Padding="12" Visibility="{Binding HasSelectedOperation, Converter={StaticResource BoolToVis}}"><StackPanel><TextBlock Text="العملية المحددة" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="Bold" Margin="0,0,0,5" /><TextBlock Text="{Binding SelectedOperation.DetailsDisplay}" Style="{StaticResource PosRtlTextStyle}" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedOperation.ReversalReference, StringFormat='مرجع العكس: {0}'}" Style="{StaticResource PosRtlTextStyle}" Foreground="#B45309" Margin="0,4,0,0" /></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8" CornerRadius="10" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#ECFDF5" /><Setter Property="BorderBrush" Value="#A7F3D0" /><Style.Triggers><DataTrigger Binding="{Binding IsErrorStatus}" Value="True"><Setter Property="Background" Value="#FEF2F2" /><Setter Property="BorderBrush" Value="#FECACA" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PosRtlTextStyle}" TextWrapping="Wrap" /></Border>
    </Grid>
</UserControl>
