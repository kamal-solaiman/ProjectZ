<Window x:Class="ProjectZ.Views.AccountTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Width="560" Height="650" MinWidth="480" MinHeight="570"
        FlowDirection="LeftToRight" Language="ar-EG" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Title>
        <MultiBinding StringFormat="{}{0} — {1}">
            <Binding Path="Name" Source="{StaticResource StoreIdentity}" Mode="OneWay" />
            <Binding Path="WindowTitle" Mode="OneWay" />
        </MultiBinding>
    </Window.Title>
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="18,14" CornerRadius="16" Background="#102E48"><StackPanel FlowDirection="RightToLeft">
            <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="20" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="{Binding AccountSummary}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#99F6E4" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel></Border>
        <Border Grid.Row="1" Padding="20" CornerRadius="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,14"><StackPanel>
            <TextBlock Text="نوع الحركة *" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox Style="{StaticResource PosComboBoxStyle}" ItemsSource="{Binding MovementOptions}" SelectedItem="{Binding SelectedMovement}" FlowDirection="RightToLeft" />
            <Border Padding="10,8" CornerRadius="8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,12"><TextBlock Text="الإيداع والسحب يخضعان لحدود المحفظة. التسويات لتصحيح الرصيد ولا تُحسب ضمن الحدود، وتظل مسجلة في السجل." Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="#1E40AF" TextWrapping="Wrap" /></Border>
            <TextBlock Text="المبلغ *" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="AmountInput" Style="{StaticResource PosNumericTextBoxStyle}" FontSize="18" FontWeight="Bold" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="الطرف الآخر / الجهة" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,6" />
            <TextBox Style="{StaticResource PosCompactTextBoxStyle}" FlowDirection="RightToLeft" Text="{Binding Counterparty, UpdateSourceTrigger=PropertyChanged}" MaxLength="140" />
            <TextBlock Text="ملاحظات" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,6" />
            <TextBox Style="{StaticResource PosCompactTextBoxStyle}" FlowDirection="RightToLeft" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="300" />
            <TextBlock Text="{Binding Error}" Style="{StaticResource PosRtlTextStyle}" Foreground="#B42318" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVis}}" />
        </StackPanel></Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Content="إلغاء" Style="{StaticResource PosSecondaryButtonStyle}" MinWidth="110" Padding="18,10" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Content="تسجيل الحركة" Style="{StaticResource PosPrimaryCompactButtonStyle}" MinWidth="170" Padding="20,10" IsDefault="True" Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</Window>
