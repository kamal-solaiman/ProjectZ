<Window x:Class="ProjectZ.Views.DamageEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectZ | تعديل بيانات الهالك"
        Width="520"
        Height="480"
        MinWidth="460"
        MinHeight="420"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="16,13"
                CornerRadius="14"
                Background="#7F1D1D"
                FlowDirection="LeftToRight">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="تعديل بيانات الهالك"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="#FECACA"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1"
                Padding="16"
                CornerRadius="14"
                Background="#FEF2F2"
                BorderBrush="#FECACA"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="حالة التسوية"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#7F1D1D" />
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                             Margin="0,4,0,0"
                             MinHeight="32"
                             Padding="8,5"
                             FlowDirection="RightToLeft"
                             MaxLength="50"
                             Text="{Binding SettlementText, UpdateSourceTrigger=PropertyChanged}" />

                    <ItemsControl ItemsSource="{Binding SettlementOptions}" FlowDirection="RightToLeft" Margin="0,8,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Margin="0,2,6,2"
                                        Padding="10,4"
                                        FontSize="11.5"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Command="{Binding DataContext.PickSettlementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="سبب الهالك"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#7F1D1D" />
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                             Margin="0,4,0,0"
                             MinHeight="60"
                             Padding="8,5"
                             FlowDirection="RightToLeft"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MaxLength="1000"
                             Text="{Binding ReasonText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="أسباب شائعة:"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,8,0,4"
                               FontSize="11.5"
                               Foreground="#64748B" />
                    <ItemsControl ItemsSource="{Binding QuickReasons}" FlowDirection="RightToLeft">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Margin="0,2,6,2"
                                        Padding="10,4"
                                        FontSize="11.5"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Command="{Binding DataContext.PickReasonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Error}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,10,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#B42318"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="حفظ في قاعدة البيانات"
                        Style="{StaticResource PosPrimaryCompactButtonStyle}"
                        MinWidth="180"
                        Padding="16,9"
                        Command="{Binding ConfirmCommand}" />
                <Button Content="إلغاء"
                        Margin="8,0,0,0"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        MinWidth="100"
                        Padding="16,9"
                        IsCancel="True"
                        Command="{Binding CancelCommand}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="التعديل يُحفظ في dbo.InventoryUnits ويُسجَّل في سجل الحركات والتدقيق"
                       Style="{StaticResource PosRtlTextStyle}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="10.5"
                       Foreground="#94A3B8" />
        </Grid>
    </Grid>
</Window>
