<Window x:Class="ProjectZ.Views.MaintenanceCancelOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | إلغاء أمر صيانة / عدم إمكانية الإصلاح'}"
        Width="600"
        Height="560"
        MinWidth="520"
        MinHeight="460"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,11" CornerRadius="12" Background="#991B1B">
            <StackPanel FlowDirection="RightToLeft">
                <TextBlock Text="إلغاء أمر الصيانة / تعذر الإصلاح"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="16.5"
                           FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="{Binding Order.OrderNumber, StringFormat='أمر رقم: {0}'}"
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="0,2,0,0"
                           FontSize="12"
                           Foreground="#FECACA" />
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel FlowDirection="RightToLeft">
                <Border Margin="0,0,0,10" Padding="12" CornerRadius="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="سبب الإلغاء / رفض الإصلاح *" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="Bold" Foreground="#102E48" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Style="{StaticResource PosSecondaryButtonStyle}"
                                            Padding="10,5"
                                            Margin="0,2,6,4"
                                            FontSize="11.5"
                                            Command="{Binding DataContext.SelectQuickReasonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="السبب المحدد:" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#475569" Margin="0,0,0,2" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 MinHeight="32"
                                 Padding="9,5"
                                 FontSize="12.5"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 Text="{Binding SelectedReason, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="ملاحظات وتفاصيل إضافية (اختياري):" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#475569" Margin="0,8,0,2" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 MinHeight="46"
                                 Padding="9,5"
                                 FontSize="12"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 TextWrapping="Wrap"
                                 Text="{Binding CustomReasonNotes, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!-- Parts Return -->
                <Border Margin="0,0,0,10"
                        Padding="12"
                        CornerRadius="10"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        Visibility="{Binding HasUsedParts, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <CheckBox Content="إرجاع قطع الغيار المصروفة من المخزون تلقائيًا"
                                  Style="{StaticResource PosCheckBoxStyle}"
                                  FontSize="12.5"
                                  FontWeight="Bold"
                                  IsChecked="{Binding ReturnUsedPartsToInventory}" />
                        <TextBlock Text="{Binding UsedPartsCount, StringFormat='عدد القطع المسجلة على التذكرة: {0} قطعة'}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,4,0,0"
                                   FontSize="11.5"
                                   Foreground="#1D4ED8" />
                    </StackPanel>
                </Border>

                <!-- Deposit Refund -->
                <Border Padding="12"
                        CornerRadius="10"
                        Background="#FFFBEB"
                        BorderBrush="#FCD34D"
                        BorderThickness="1"
                        Visibility="{Binding HasRetainedDeposit, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding RetainedDepositDisplay, StringFormat='يوجد عربون / رسوم مسددة بقيمة: {0}'}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#92400E" />
                        <CheckBox Content="تسجيل استرداد العربون للعميل"
                                  Style="{StaticResource PosCheckBoxStyle}"
                                  Margin="0,6,0,4"
                                  FontSize="12.5"
                                  FontWeight="SemiBold"
                                  IsChecked="{Binding RefundDeposit}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding RefundDeposit, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="مبلغ الاسترداد للعميل (ج.م):" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#78350F" />
                            <TextBox Style="{StaticResource PosNumericTextBoxStyle}" Width="120" MinHeight="30" Padding="8,4" Text="{Binding RefundAmountText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Error -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10,7"
                CornerRadius="8"
                Background="#FEF2F2"
                BorderBrush="#FECACA"
                BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="SemiBold" Foreground="#B42318" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="تراجع"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="14,9"
                    IsCancel="True"
                    Command="{Binding AbortCommand}" />

            <Button Grid.Column="2"
                    Content="تأكيد إلغاء أمر الصيانة"
                    Style="{StaticResource PosDangerButtonStyle}"
                    MinWidth="190"
                    Padding="16,9"
                    Command="{Binding ConfirmCancelCommand}" />
        </Grid>
    </Grid>
</Window>
