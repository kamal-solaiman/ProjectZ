<Window x:Class="ProjectZ.Views.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        Width="540"
        Height="620"
        MinWidth="470"
        MinHeight="540"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Title>
        <MultiBinding StringFormat="{}{0} — {1}">
            <Binding Path="Name" Source="{StaticResource StoreIdentity}" Mode="OneWay" />
            <Binding Path="WindowTitle" Mode="OneWay" />
        </MultiBinding>
    </Window.Title>

    <Grid FlowDirection="LeftToRight">
        <ContentControl Style="{StaticResource ThemeBackdropStyle}" />
    <Grid Margin="20" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navy header -->
        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="18,14"
                CornerRadius="16"
                Background="{DynamicResource Theme.Legacy.102E48.Navigation}"
                FlowDirection="LeftToRight">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        FlowDirection="RightToLeft">
                <Border Width="44"
                        Height="44"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Legacy.1D455F.Navigation}">
                    <Path Data="M15,14 C17.67,14 23,15.34 23,18 L23,20 L7,20 L7,18 C7,15.34 12.33,14 15,14 Z M15,12 C12.79,12 11,10.21 11,8 C11,5.79 12.79,4 15,4 C17.21,4 19,5.79 19,8 C19,10.21 17.21,12 15,12 Z"
                          Fill="{DynamicResource Theme.Legacy.6EE7D8.Highlight}"
                          Stretch="Uniform"
                          Width="22"
                          Height="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                    <TextBlock Text="{Binding HeaderSubtitle}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Theme.Legacy.B7CFDD.Text}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form card -->
        <Border Grid.Row="1"
                Padding="20"
                CornerRadius="16"
                Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          FlowDirection="LeftToRight">
                <StackPanel Margin="0,0,4,0" FlowDirection="LeftToRight">
                    <Border Margin="0,0,0,14"
                            Padding="10,8"
                            CornerRadius="8"
                            Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}"
                            BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding BannerHintText}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Username -->
                    <StackPanel Visibility="{Binding ShowIdentityFields, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="اسم الدخول (Username) *"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,0,0,6"
                                   FontSize="13.5"
                                   FontWeight="SemiBold" />
                        <!-- Account names are identifiers: LTR input inside an RTL form. -->
                        <TextBox x:Name="UsernameInput"
                                 Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Left"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="100"
                                 AutomationProperties.Name="اسم الدخول" />
                        <TextBlock Text="حروف وأرقام بدون مسافات، مثال: ahmed.ali"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,4,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />

                        <!-- Display name -->
                        <TextBlock Text="الاسم الظاهر (يظهر في الترحيب وبجانب عملياته) *"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,12,0,6"
                                   FontSize="13.5"
                                   FontWeight="SemiBold" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="150"
                                 AutomationProperties.Name="الاسم الظاهر" />
                    </StackPanel>

                    <!-- Password (create / reset only) -->
                    <StackPanel Visibility="{Binding ShowPasswordFields, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="كلمة المرور *"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,12,0,6"
                                   FontSize="13.5"
                                   FontWeight="SemiBold" />
                        <PasswordBox x:Name="PasswordInput"
                                     Style="{StaticResource PosCompactPasswordBoxStyle}"
                                     MinHeight="36"
                                     MaxLength="1024"
                                     FlowDirection="LeftToRight"
                                     AutomationProperties.Name="كلمة المرور" />
                        <TextBlock Text="6 أحرف على الأقل. تُحفظ مشفّرة ولا يمكن عرضها بعد ذلك."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,4,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />

                        <TextBlock Text="تأكيد كلمة المرور *"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,12,0,6"
                                   FontSize="13.5"
                                   FontWeight="SemiBold" />
                        <PasswordBox x:Name="PasswordConfirmationInput"
                                     Style="{StaticResource PosCompactPasswordBoxStyle}"
                                     MinHeight="36"
                                     MaxLength="1024"
                                     FlowDirection="LeftToRight"
                                     AutomationProperties.Name="تأكيد كلمة المرور" />
                    </StackPanel>

                    <!-- Active toggle -->
                    <Border Margin="0,14,0,0"
                            Padding="12,10"
                            CornerRadius="10"
                            Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                            BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                            BorderThickness="1"
                            FlowDirection="LeftToRight"
                            Visibility="{Binding ShowActiveField, Converter={StaticResource BoolToVis}}">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" FlowDirection="RightToLeft">
                                <TextBlock Text="الحساب نشط ويمكنه تسجيل الدخول"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.Legacy.172B41.Text}" />
                                <TextBlock Text="عند إلغاء التحديد يبقى الحساب وسجلاته في القاعدة لكن يُرفض دخوله."
                                           Style="{StaticResource PosRtlTextStyle}"
                                           Margin="0,3,0,0"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      Style="{StaticResource PosCheckBoxStyle}"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsActive, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!-- Inline error / success -->
                    <TextBlock Text="{Binding Error}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,10,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}"
                               TextWrapping="Wrap"
                               Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVis}}" />
                    <TextBlock Text="{Binding Success}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,10,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.047857.SuccessInk}"
                               TextWrapping="Wrap"
                               Visibility="{Binding Success, Converter={StaticResource StringNotEmptyToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إلغاء"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="18,10"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="2"
                    Content="{Binding SaveButtonText}"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    MinWidth="180"
                    Padding="18,10"
                    IsDefault="True"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
