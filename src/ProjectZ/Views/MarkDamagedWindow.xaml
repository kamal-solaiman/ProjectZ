<Window x:Class="ProjectZ.Views.MarkDamagedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectZ | تسجيل مخزون هالك"
        Width="530"
        Height="520"
        MinWidth="460"
        MinHeight="450"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="16,13"
                CornerRadius="14"
                Background="#7F1D1D"
                FlowDirection="LeftToRight">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="تسجيل مخزون هالك"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="{Binding Product.Name}"
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="0,4,0,0"
                           FontSize="12.5"
                           Foreground="#FECACA"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1"
                Padding="18"
                CornerRadius="14"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Source Batch / Specific ID Picker -->
                    <TextBlock Text="مصدر الهالك (المورد / رقم التسجيل)"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,5"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <ComboBox Style="{StaticResource PosComboBoxStyle}"
                              MinHeight="38"
                              Margin="0,0,0,12"
                              ItemsSource="{Binding SourceOptions}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedSourceOption, Mode=TwoWay}" />

                    <!-- Quantity -->
                    <TextBlock Text="الكمية الهالكة *"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,5"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="DamagedQtyInput"
                             Style="{StaticResource PosNumericTextBoxStyle}"
                             Margin="0,0,0,12"
                             IsEnabled="{Binding CanEditQuantity}"
                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Damage Reason -->
                    <TextBlock Text="سبب الإهلاك *"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,5"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             Text="{Binding ReasonText, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="160" />

                    <!-- Quick Reason Chips -->
                    <TextBlock Text="أسباب سريعة:"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,8,0,4"
                               FontSize="11.5"
                               Foreground="#64748B" />
                    <ItemsControl ItemsSource="{Binding QuickReasons}" FlowDirection="RightToLeft" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Margin="0,2,6,2"
                                        Padding="10,4"
                                        FontSize="11.5"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Command="{Binding DataContext.PickReasonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Padding="10,8" CornerRadius="8" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1">
                        <TextBlock Text="سيتم خصم الكمية المحددة من المخزون المتاح وإدراجها فورًا في قائمة مخزون الهالك."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#92400E"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="{Binding Error}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,8,0,0"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#B42318"
                               TextWrapping="Wrap"
                               Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إلغاء"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="16,9"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="2"
                    Content="تأكيد تسجيل الهالك"
                    Style="{StaticResource PosDangerButtonStyle}"
                    MinWidth="180"
                    Padding="20,9"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}" />
        </Grid>
    </Grid>
</Window>
