<UserControl x:Class="ProjectZ.Views.PurchaseInvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Language="ar-EG">

    <UserControl.Resources>
        <Style x:Key="PurDatePillBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.E2E8F0.Input}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.334155.Text}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurRowQuickBtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header Strip -->
        <Grid Grid.Row="0" Margin="0,0,0,10" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                <Button Content="+ شراء فاتورة جديدة"
                        Style="{StaticResource PosPrimaryCompactButtonStyle}"
                        Padding="14,7"
                        FontSize="12.5"
                        Command="{Binding GoToPurchaseEntryCommand}" />
                <Button Content="إعادة ضبط الفلاتر"
                        Margin="8,0,0,0"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Padding="12,7"
                        FontSize="12"
                        Command="{Binding ClearFiltersCommand}" />
                <Button Content="تحديث من قاعدة البيانات"
                        Margin="8,0,0,0"
                        Style="{StaticResource PosOutlineTealButtonStyle}"
                        Padding="12,7"
                        FontSize="12"
                        Command="{Binding RefreshFromDatabaseCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft">
                <TextBlock Text="فواتير المشتريات — السجل الكامل والمراجعة والتحكم"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="20.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}"
                        BorderBrush="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        ToolTip="{Binding HistorySourceLabel}">
                    <TextBlock Text="{Binding DataSourceLabel}"
                               Style="{StaticResource PosCenterTextStyle}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ROW 1: Search & Multi-Filters Bar -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="11,9"
                CornerRadius="12"
                Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <StackPanel>
                <!-- Line 1: Date Presets & Smart Search -->
                <Grid Margin="0,0,0,8" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Date Presets -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                        <TextBlock Text="الفترة:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                        <Button Content="الكل" Command="{Binding SelectDatePresetCommand}" CommandParameter="الكل">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PurDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllDatePreset}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.102E48.Navigation}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="اليوم" Command="{Binding SelectDatePresetCommand}" CommandParameter="اليوم">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PurDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTodayPreset}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.0F766E.Success}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="آخر 7 أيام" Command="{Binding SelectDatePresetCommand}" CommandParameter="آخر 7 أيام">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PurDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLast7DaysPreset}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.0F766E.Success}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="هذا الشهر" Command="{Binding SelectDatePresetCommand}" CommandParameter="هذا الشهر">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PurDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsThisMonthPreset}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.0F766E.Success}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="فترة مخصصة" Command="{Binding SelectDatePresetCommand}" CommandParameter="فترة مخصصة">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PurDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomDatePreset}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.147D92.Accent}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Custom Date Pickers -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsCustomDatePreset, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="من:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11.5" />
                            <DatePicker SelectedDate="{Binding CustomFromDate}" Width="118" Height="28" />
                            <TextBlock Text="إلى:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11.5" />
                            <DatePicker SelectedDate="{Binding CustomToDate}" Width="118" Height="28" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Smart Search Input -->
                    <Grid Grid.Column="2" FlowDirection="RightToLeft">
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 MinHeight="34"
                                 Padding="12,5"
                                 FontSize="12.5"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="ابحث برقم الفاتورة أو مرجع المورد أو اسم المورد أو رقم الهاتف أو الصنف..."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="12,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                    </Grid>
                </Grid>

                <!-- Line 2: Supplier, Payment, Status & Sort Combos -->
                <Grid FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="المورد:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}" MinWidth="165" ItemsSource="{Binding SupplierFilters}" SelectedItem="{Binding SelectedSupplierFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="طريقة الدفع:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}" MinWidth="150" ItemsSource="{Binding PaymentFilters}" SelectedItem="{Binding SelectedPaymentFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <TextBlock Text="الحالة:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}" MinWidth="155" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                        <TextBlock Text="الترتيب:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}" MinWidth="150" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ROW 2: Full-Width Purchase Invoices Table -->
        <Border Grid.Row="2"
                CornerRadius="12"
                Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}"
                BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="920">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Padding="14,10" Background="{DynamicResource Theme.Legacy.102E48.Navigation}" CornerRadius="11,11,0,0">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="108" />
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="رقم الفاتورة" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
                            <TextBlock Grid.Column="1" Text="التاريخ والوقت" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                            <TextBlock Grid.Column="2" Text="المورد والهاتف" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                            <TextBlock Grid.Column="3" Text="الأصناف والقطع" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                            <TextBlock Grid.Column="4" Text="الصافي" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
                            <TextBlock Grid.Column="5" Text="المدفوع / الآجل" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                            <TextBlock Grid.Column="6" Text="طريقة الدفع" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                            <TextBlock Grid.Column="7" Text="الحالة" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                            <TextBlock Grid.Column="8" Text="عرض وتحكم سريع" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        </Grid>
                    </Border>

                    <!-- Table Rows -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredInvoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="14,10"
                                                HorizontalContentAlignment="Stretch"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.OpenInvoiceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="اضغط لعرض كافة محتويات الفاتورة والتحكم الكامل">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBg"
                                                            Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                                                            BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource Theme.Legacy.EFF6FF.InfoSoft}" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>

                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="125" />
                                                    <ColumnDefinition Width="108" />
                                                    <ColumnDefinition Width="1.35*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="1.05*" />
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="200" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Invoice # & Supplier Invoice # -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding InvoiceNumber}"
                                                               Style="{StaticResource PosLtrTextStyle}"
                                                               HorizontalAlignment="Right"
                                                               FontFamily="Consolas, Segoe UI"
                                                               FontSize="12.5"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                                    <TextBlock Text="{Binding SupplierInvoiceNumberDisplay, StringFormat='مرجع: {0}'}"
                                                               Style="{StaticResource PosRtlTextStyle}"
                                                               Margin="0,2,0,0"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                                               Visibility="{Binding HasSupplierInvoiceNumber, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- Date & Time -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IssuedDateDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.334155.Text}" />
                                                    <TextBlock Text="{Binding IssuedTimeDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="10" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                                </StackPanel>

                                                <!-- Supplier -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                                                    <TextBlock Text="{Binding SupplierName}" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.172B41.Text}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SupplierPhoneDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,1,0,0" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Items Summary -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding ItemsAndUnitsSummary}"
                                                           Style="{StaticResource PosCenterTextStyle}"
                                                           VerticalAlignment="Center"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Theme.Legacy.334155.Text}"
                                                           TextWrapping="Wrap" />

                                                <!-- Net Total -->
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NetTotalDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                                    <TextBlock Text="{Binding EffectiveDiscountDisplay, StringFormat='خصم: {0}'}" Style="{StaticResource PosCenterTextStyle}" FontSize="9.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- Paid & Remaining Payable -->
                                                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalPaidDisplay, StringFormat='مدفوع: {0}'}" Style="{StaticResource PosCenterTextStyle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                                    <TextBlock Text="{Binding RemainingPayableDisplay, StringFormat='آجل: {0}'}" Style="{StaticResource PosCenterTextStyle}" Margin="0,1,0,0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" Visibility="{Binding HasRemainingPayable, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- Payment Summary -->
                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding PaymentMethodSummary}"
                                                           Style="{StaticResource PosCenterTextStyle}"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Theme.Legacy.334155.Text}"
                                                           TextWrapping="Wrap" />

                                                <!-- Status Pill -->
                                                <Border Grid.Column="7"
                                                        Padding="8,4"
                                                        CornerRadius="7"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPartialCredit}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEF3C7.WarningSoft}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFullCredit}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEE2E2.DangerSoft}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPartiallyReturned}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.F3E8FF.VioletSoft}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFullyReturned}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.EDE9FE.InfoSoft}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.E2E8F0.Input}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusTitle}" FontSize="10.5" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPartialCredit}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B45309.WarningInk}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFullCredit}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPartiallyReturned}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFullyReturned}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.5B21B6.VioletInk}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.475569.Muted}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Quick Row Controls -->
                                                <StackPanel Grid.Column="8"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FlowDirection="RightToLeft">
                                                    <Button Content="تفاصيل"
                                                            Style="{StaticResource PurRowQuickBtnStyle}"
                                                            Background="{DynamicResource Theme.Legacy.E0F2FE.InfoSoft}"
                                                            Foreground="{DynamicResource Theme.Legacy.0369A1.InfoInk}"
                                                            BorderBrush="{DynamicResource Theme.Legacy.7DD3FC.InfoBorder}"
                                                            Command="{Binding DataContext.OpenInvoiceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="تعديل"
                                                            Style="{StaticResource PurRowQuickBtnStyle}"
                                                            Background="{DynamicResource Theme.Legacy.EFF6FF.InfoSoft}"
                                                            Foreground="{DynamicResource Theme.Legacy.1D4ED8.InfoInk}"
                                                            BorderBrush="{DynamicResource Theme.Legacy.BFDBFE.InfoBorder}"
                                                            IsEnabled="{Binding CanEdit}"
                                                            Command="{Binding DataContext.OpenEditInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="مرتجع"
                                                            Style="{StaticResource PurRowQuickBtnStyle}"
                                                            Background="{DynamicResource Theme.Legacy.F5F3FF.InfoSoft}"
                                                            Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}"
                                                            BorderBrush="{DynamicResource Theme.Legacy.DDD6FE.InfoBorder}"
                                                            IsEnabled="{Binding CanReturn}"
                                                            Command="{Binding DataContext.OpenReturnDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="طباعة"
                                                            Style="{StaticResource PurRowQuickBtnStyle}"
                                                            Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}"
                                                            Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}"
                                                            BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}"
                                                            Command="{Binding DataContext.OpenPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasNoFilteredInvoices, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="لا توجد فواتير مشتريات مطابقة لخيارات البحث أو التصفية الحالية."
                                       Style="{StaticResource PosCenterTextStyle}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                            <Button Margin="0,10,0,0"
                                    Content="عرض جميع الفواتير"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Padding="14,7"
                                    Command="{Binding ClearFiltersCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ROW 3: Status Strip -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                FlowDirection="LeftToRight"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.065F46.SuccessInk}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
