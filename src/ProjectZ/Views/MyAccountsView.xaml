<UserControl x:Class="ProjectZ.Views.MyAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProjectZ.ViewModels" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MyAccountsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/PosStyles.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style x:Key="FinCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.FFFFFF.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.E2E8F0.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /></Style>
        <Style x:Key="FinAction" TargetType="Button"><Setter Property="Padding" Value="11,6" /><Setter Property="Margin" Value="0,4,6,0" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".86" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="LimitBar" TargetType="ProgressBar"><Setter Property="Height" Value="6" /><Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" /><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.14B8A6.AccentInk}" /><Setter Property="Background" Value="{DynamicResource Theme.Legacy.E2E8F0.Input}" /><Setter Property="BorderThickness" Value="0" /></Style>
    </ResourceDictionary></UserControl.Resources>

    <Grid FlowDirection="LeftToRight" Margin="18,14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <!-- Header -->
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="+ فودافون كاش" Style="{StaticResource PosPrimaryCompactButtonStyle}" Command="{Binding AddVodafoneWalletCommand}" Margin="0,0,7,0" /><Button Content="+ إنستاباي" Style="{StaticResource PosSecondaryButtonStyle}" Command="{Binding AddInstaPayWalletCommand}" Margin="0,0,7,0" /><Button Content="تحديث" Style="{StaticResource PosSecondaryButtonStyle}" Command="{Binding RefreshCommand}" /></StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><TextBlock Text="حساباتي — مركز إدارة السيولة" Style="{StaticResource PosRtlTextStyle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" /><Border Margin="10,0,0,0" Padding="10,4" CornerRadius="8" Background="{DynamicResource Theme.Legacy.ECFEFF.AccentSoft}" BorderBrush="{DynamicResource Theme.Legacy.67E8F9.Border}" BorderThickness="1"><TextBlock Text="نقدي + محافظ مستقلة" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0E7490.AccentInk}" /></Border></StackPanel><TextBlock Text="إدارة الخزنة النقدية وأرصدة فودافون كاش وإنستاباي، حدود التشغيل، التحويلات والتسويات وسجل الحركات." Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" Margin="0,2,0,0" /></StackPanel>
        </Grid>

        <!-- Scrollable workspace for small laptop screens -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FlowDirection="LeftToRight">
        <Grid MinHeight="620"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <!-- Independent unified cash account -->
            <Border Style="{StaticResource FinCard}" Padding="16" Background="{DynamicResource Theme.Legacy.102E48.Navigation}" BorderBrush="{DynamicResource Theme.Legacy.1D455F.Border}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="20" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="15" Background="{DynamicResource Theme.Legacy.147D92.Accent}" VerticalAlignment="Center"><TextBlock Text="ج.م" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" /></Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><TextBlock Text="النقدي — الخزنة الرئيسية" Style="{StaticResource PosRtlTextStyle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" /><Border Margin="8,0,0,0" Padding="7,2" CornerRadius="5" Background="{DynamicResource Theme.Legacy.0F766E.Success}"><TextBlock Text="حساب موحد" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnSuccess}" /></Border></StackPanel><TextBlock Text="مرتبط بالمبيعات والمشتريات والصيانة والتحصيل والسداد" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="{DynamicResource Theme.Legacy.B7CFDD.Text}" Margin="0,3,0,0" /></StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="الرصيد النقدي الحالي" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="{DynamicResource Theme.Legacy.99F6E4.Highlight}" /><TextBlock Text="{Binding CashAccount.BalanceDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" Margin="0,2,0,0" /></StackPanel>
                <WrapPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Left"><Button Content="إيداع / سحب / تسوية" Style="{StaticResource FinAction}" Background="{DynamicResource Theme.Legacy.0F766E.Success}" BorderBrush="{DynamicResource Theme.Legacy.14B8A6.Accent}" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnSuccess}" Command="{Binding NewCashTransactionCommand}" /><Button Content="تحويل من النقدي" Style="{StaticResource FinAction}" Background="{DynamicResource Theme.Legacy.1D4ED8.Info}" BorderBrush="{DynamicResource Theme.Legacy.60A5FA.InfoBorder}" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnInfo}" Command="{Binding TransferFromCashCommand}" /><Button Content="سجل النقدي" Style="{StaticResource FinAction}" Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}" BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" Command="{Binding SelectCashCommand}" /></WrapPanel>
            </Grid></Border>

            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="500" /><ColumnDefinition Width="12" /><ColumnDefinition Width="480" /></Grid.ColumnDefinitions>
                <!-- Digital wallet directory -->
                <Border Style="{StaticResource FinCard}" Padding="11"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><TextBlock Text="المحافظ الإلكترونية" Style="{StaticResource PosRtlTextStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" /><TextBlock Text="كل رقم برصيد وحدود مستقلة" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel><Button Grid.Column="1" Content="إلغاء الفلاتر" Style="{StaticResource PosSecondaryButtonStyle}" Padding="9,4" FontSize="10.5" Command="{Binding ClearWalletFiltersCommand}" /></Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="7" /><ColumnDefinition Width="155" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource PosComboBoxStyle}" MinHeight="32" ItemsSource="{Binding ProviderFilterOptions}" SelectedItem="{Binding SelectedProviderFilter}" FlowDirection="RightToLeft" /><ComboBox Grid.Column="2" Style="{StaticResource PosComboBoxStyle}" MinHeight="32" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" FlowDirection="RightToLeft" />
                        <Grid Grid.Column="4"><TextBox Style="{StaticResource PosCompactTextBoxStyle}" MinHeight="32" FlowDirection="RightToLeft" Text="{Binding WalletSearchText, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="اسم المحفظة أو الرقم..." Style="{StaticResource PosRtlTextStyle}" Margin="10,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" IsHitTestVisible="False" Visibility="{Binding WalletSearchText, Converter={StaticResource StringEmptyToVis}}" /></Grid>
                    </Grid>
                    <Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding FilteredWallets}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Margin="0,0,0,8" CornerRadius="12" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.FFFFFF.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.E2E8F0.Border}" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.94A3B8.BorderStrong}" /></Trigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFEFF.AccentSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.147D92.Accent}" /><Setter Property="BorderThickness" Value="1.5" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <Button Padding="12" HorizontalContentAlignment="Stretch" Cursor="Hand" Command="{Binding DataContext.SelectAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter /></Border></ControlTemplate></Button.Template>
                                <StackPanel FlowDirection="RightToLeft"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource Theme.Legacy.102E48.Navigation}"><TextBlock Text="{Binding ProviderShortTitle}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" /></Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Alias}" Style="{StaticResource PosRtlTextStyle}" FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" /><Border Margin="7,0,0,0" Padding="6,2" CornerRadius="5" Background="{DynamicResource Theme.Legacy.E0F2FE.InfoSoft}" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"><TextBlock Text="افتراضية" Style="{StaticResource PosCenterTextStyle}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0369A1.InfoInk}" /></Border><Border Margin="5,0,0,0" Padding="6,2" CornerRadius="5" Background="{DynamicResource Theme.Legacy.FEE2E2.DangerSoft}" Visibility="{Binding HasLimitWarning, Converter={StaticResource BoolToVis}}"><TextBlock Text="تنبيه حد" Style="{StaticResource PosCenterTextStyle}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" /></Border></StackPanel><TextBlock Text="{Binding DisplayIdentifier}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" Margin="0,2,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Left"><TextBlock Text="{Binding BalanceDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" /><TextBlock Text="{Binding StatusTitle}" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" /></StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="إيداع اليوم" Style="{StaticResource PosRtlTextStyle}" FontSize="9.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /><TextBlock Grid.Column="1" Text="{Binding DailyDepositUsagePercent, StringFormat='{}{0:N0}%'}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Left" Margin="8,0,0,0" FontSize="9.5" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" /></Grid><ProgressBar Style="{StaticResource LimitBar}" Value="{Binding DailyDepositUsagePercent, Mode=OneWay}" Margin="0,3,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="2"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="سحب اليوم" Style="{StaticResource PosRtlTextStyle}" FontSize="9.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /><TextBlock Grid.Column="1" Text="{Binding DailyWithdrawalUsagePercent, StringFormat='{}{0:N0}%'}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Left" Margin="8,0,0,0" FontSize="9.5" Foreground="{DynamicResource Theme.Legacy.B45309.WarningInk}" /></Grid><ProgressBar Style="{StaticResource LimitBar}" Value="{Binding DailyWithdrawalUsagePercent, Mode=OneWay}" Foreground="{DynamicResource Theme.Legacy.F59E0B.WarningInk}" Margin="0,3,0,0" /></StackPanel>
                                </Grid></StackPanel>
                            </Button>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="لا توجد محافظ مطابقة للفلاتر الحالية." Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" Visibility="{Binding HasNoFilteredWallets, Converter={StaticResource BoolToVis}}" /></Grid>
                </Grid></Border>

                <!-- Selected account 360 + ledger -->
                <Border Grid.Column="2" Style="{StaticResource FinCard}" Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}" Padding="11"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Padding="12" CornerRadius="11" Background="{DynamicResource Theme.Legacy.102E48.Navigation}"><StackPanel FlowDirection="RightToLeft"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedAccount.DisplayName}" Style="{StaticResource PosRtlTextStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" /><TextBlock Text="{Binding SelectedAccount.DisplayIdentifier}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Theme.Legacy.99F6E4.Highlight}" Margin="0,2,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding SelectedAccount.BalanceDisplay}" Style="{StaticResource PosLtrTextStyle}" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" /></Grid><WrapPanel Margin="0,8,0,0"><Button Content="+ حركة" Style="{StaticResource FinAction}" Background="{DynamicResource Theme.Legacy.0F766E.Success}" BorderBrush="{DynamicResource Theme.Legacy.14B8A6.Accent}" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnSuccess}" Command="{Binding NewSelectedTransactionCommand}" /><Button Content="تحويل" Style="{StaticResource FinAction}" Background="{DynamicResource Theme.Legacy.1D4ED8.Info}" BorderBrush="{DynamicResource Theme.Legacy.60A5FA.InfoBorder}" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnInfo}" Command="{Binding TransferFromSelectedCommand}" /><Button Content="تعديل وحدود" Style="{StaticResource FinAction}" Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}" BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" Command="{Binding EditSelectedAccountCommand}" Visibility="{Binding IsCashSelected, Converter={StaticResource InverseBoolToVis}}" /><Button Content="تعيين افتراضية" Style="{StaticResource FinAction}" Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}" BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" Command="{Binding SetSelectedAsDefaultCommand}" Visibility="{Binding IsCashSelected, Converter={StaticResource InverseBoolToVis}}" /><Button Content="تفعيل / إيقاف" Style="{StaticResource FinAction}" Background="{DynamicResource Theme.Legacy.FFFBEB.WarningSoft}" BorderBrush="{DynamicResource Theme.Legacy.FCD34D.WarningBorder}" Foreground="{DynamicResource Theme.Legacy.92400E.WarningInk}" Command="{Binding ToggleSelectedAccountCommand}" Visibility="{Binding IsCashSelected, Converter={StaticResource InverseBoolToVis}}" /><Button Content="حذف" Style="{StaticResource FinAction}" Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}" BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" Command="{Binding DeleteSelectedAccountCommand}" Visibility="{Binding IsCashSelected, Converter={StaticResource InverseBoolToVis}}" /></WrapPanel></StackPanel></Border>

                    <!-- Four independent limit gauges -->
                    <Grid Grid.Row="1" Margin="0,9" Visibility="{Binding IsCashSelected, Converter={StaticResource InverseBoolToVis}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="7" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Padding="9" CornerRadius="8" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1"><StackPanel><TextBlock Text="إيداع اليوم" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="Bold" /><TextBlock Text="{Binding SelectedAccount.DepositedTodayDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" /><ProgressBar Style="{StaticResource LimitBar}" Value="{Binding SelectedAccount.DailyDepositUsagePercent, Mode=OneWay}" Margin="0,5,0,3" /><TextBlock Text="{Binding SelectedAccount.DailyDepositRemainingDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="9.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /></StackPanel></Border>
                        <Border Grid.Column="2" Padding="9" CornerRadius="8" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1"><StackPanel><TextBlock Text="سحب اليوم" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="Bold" /><TextBlock Text="{Binding SelectedAccount.WithdrawnTodayDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B45309.WarningInk}" /><ProgressBar Style="{StaticResource LimitBar}" Value="{Binding SelectedAccount.DailyWithdrawalUsagePercent, Mode=OneWay}" Foreground="{DynamicResource Theme.Legacy.F59E0B.WarningInk}" Margin="0,5,0,3" /><TextBlock Text="{Binding SelectedAccount.DailyWithdrawalRemainingDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="9.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /></StackPanel></Border>
                        <Border Grid.Row="2" Padding="9" CornerRadius="8" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1"><StackPanel><TextBlock Text="إيداع الشهر" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="Bold" /><TextBlock Text="{Binding SelectedAccount.DepositedThisMonthDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0369A1.InfoInk}" /><ProgressBar Style="{StaticResource LimitBar}" Value="{Binding SelectedAccount.MonthlyDepositUsagePercent, Mode=OneWay}" Foreground="{DynamicResource Theme.Legacy.0EA5E9.InfoInk}" Margin="0,5,0,3" /><TextBlock Text="{Binding SelectedAccount.MonthlyDepositRemainingDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="9.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /></StackPanel></Border>
                        <Border Grid.Row="2" Grid.Column="2" Padding="9" CornerRadius="8" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1"><StackPanel><TextBlock Text="سحب الشهر" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="Bold" /><TextBlock Text="{Binding SelectedAccount.WithdrawnThisMonthDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" /><ProgressBar Style="{StaticResource LimitBar}" Value="{Binding SelectedAccount.MonthlyWithdrawalUsagePercent, Mode=OneWay}" Foreground="{DynamicResource Theme.Legacy.EF4444.DangerInk}" Margin="0,5,0,3" /><TextBlock Text="{Binding SelectedAccount.MonthlyWithdrawalRemainingDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="9.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="1" Padding="12" CornerRadius="9" Background="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}" BorderBrush="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}" BorderThickness="1" Margin="0,9" Visibility="{Binding IsCashSelected, Converter={StaticResource BoolToVis}}"><TextBlock Text="الحساب النقدي موحد ولا توجد له أرقام متعددة أو حدود محفظة. التحصيل والسداد النقدي من جميع الشاشات يظهر هنا في سجل واحد." Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.065F46.SuccessInk}" TextWrapping="Wrap" /></Border>

                    <!-- Transaction filtering -->
                    <Grid Grid.Row="2" Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox Style="{StaticResource PosComboBoxStyle}" MinHeight="31" ItemsSource="{Binding TransactionTypeOptions}" SelectedItem="{Binding SelectedTransactionType}" FlowDirection="RightToLeft" /><Grid Grid.Column="2"><TextBox Style="{StaticResource PosCompactTextBoxStyle}" MinHeight="31" FlowDirection="RightToLeft" Text="{Binding TransactionSearchText, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="بحث في السجل..." Style="{StaticResource PosRtlTextStyle}" Margin="9,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" IsHitTestVisible="False" Visibility="{Binding TransactionSearchText, Converter={StaticResource StringEmptyToVis}}" /></Grid><Button Grid.Column="3" Content="×" Width="27" Margin="5,0,0,0" Style="{StaticResource PosDangerIconButtonStyle}" Command="{Binding ClearTransactionFiltersCommand}" /></Grid>

                    <!-- Ledger -->
                    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Padding="7,6" CornerRadius="7" Background="{DynamicResource Theme.Legacy.1D455F.Navigation}"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="65" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="85" /><ColumnDefinition Width="83" /></Grid.ColumnDefinitions><TextBlock Text="التاريخ" Style="{StaticResource PosCenterTextStyle}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" /><TextBlock Grid.Column="1" Text="البيان" Style="{StaticResource PosRtlTextStyle}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" /><TextBlock Grid.Column="2" Text="الحركة" Style="{StaticResource PosCenterTextStyle}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" /><TextBlock Grid.Column="3" Text="الرصيد بعدها" Style="{StaticResource PosCenterTextStyle}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" /></Grid></Border>
                        <Grid Grid.Row="1" Margin="0,5,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding SelectedAccountTransactions}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="6,7" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="0,0,0,1"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="65" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="85" /><ColumnDefinition Width="83" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DateDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" /><TextBlock Text="{Binding TimeDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" FontSize="8.5" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" /></StackPanel><StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="{Binding Category}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="Bold" /><TextBlock Text="{Binding DetailsDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="9.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding SignedAmountDisplay}" HorizontalAlignment="Center" FontSize="10.5" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PosLtrTextStyle}"><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" /><Style.Triggers><DataTrigger Binding="{Binding IsIncoming}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding DirectionTitle}" Style="{StaticResource PosCenterTextStyle}" FontSize="9" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /></StackPanel><TextBlock Grid.Column="3" Text="{Binding BalanceAfterDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="لا توجد حركات مطابقة لهذا الحساب." Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" Visibility="{Binding HasNoSelectedTransactions, Converter={StaticResource BoolToVis}}" /></Grid>
                    </Grid>
                </Grid></Border>
            </Grid>
        </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8" CornerRadius="10" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}" /><Style.Triggers><DataTrigger Binding="{Binding IsErrorStatus}" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}"><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.065F46.SuccessInk}" /><Style.Triggers><DataTrigger Binding="{Binding IsErrorStatus}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.991B1B.DangerInk}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
    </Grid>
</UserControl>
