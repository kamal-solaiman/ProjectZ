<UserControl x:Class="ProjectZ.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Language="ar-EG">

    <UserControl.Resources>
        <Style x:Key="BackupCardTitle" TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.102E48.Text}" />
        </Style>
        <Style x:Key="BackupLabel" TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.334155.Text}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="BackupHint" TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.64748B.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="BackupMetricValue" TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <Grid FlowDirection="LeftToRight" Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title and connection state stay right aligned; the refresh action gets its own
             row so it cannot collide with the Arabic title at the 960 px minimum. -->
        <Grid Grid.Row="0" Margin="0,0,0,12" FlowDirection="LeftToRight">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft">
                <TextBlock Text="النسخ الاحتياطي والاسترجاع"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.DCFCE7.SuccessSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.BBF7D0.SuccessBorder}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDatabaseBacked}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEF3C7.WarningSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.FDE68A.WarningBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ConnectionBadgeText}"
                               FontSize="11.5"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.15803D.SuccessInk}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDatabaseBacked}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B45309.WarningInk}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        FlowDirection="LeftToRight">
                <Button Content="تحديث"
                        Style="{StaticResource PosOutlineTealButtonStyle}"
                        Padding="12,7"
                        FontSize="12.5"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsIdle}" />
            </StackPanel>
        </Grid>

        <!-- The whole page scrolls, so 960x560 and 200% DPI never hide the status or restore button. -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      FlowDirection="LeftToRight">
            <StackPanel Margin="0,0,4,0" FlowDirection="LeftToRight">

                <!-- Database facts: label above value, never overlaid in the same grid cell. -->
                <Border Padding="14"
                        CornerRadius="14"
                        Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                        BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                        BorderThickness="1"
                        Visibility="{Binding HasDatabaseInfo, Converter={StaticResource BoolToVis}}">
                    <StackPanel FlowDirection="LeftToRight">
                        <WrapPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                            <Border Width="250" Margin="0,0,0,8" Padding="12,10" CornerRadius="10"
                                    Background="{DynamicResource Theme.Legacy.EFF6FF.InfoSoft}" BorderBrush="{DynamicResource Theme.Legacy.BFDBFE.InfoBorder}" BorderThickness="1">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="حجم قاعدة البيانات" Style="{StaticResource BackupHint}" />
                                    <TextBlock Text="{Binding DatabaseInfo.SizeDisplay}"
                                               Style="{StaticResource BackupMetricValue}"
                                               Foreground="{DynamicResource Theme.Legacy.1D4ED8.InfoInk}" />
                                </StackPanel>
                            </Border>
                            <Border Width="250" Margin="0,0,0,8" Padding="12,10" CornerRadius="10"
                                    Background="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}" BorderBrush="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}" BorderThickness="1">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="آخر نسخة مسجلة في msdb" Style="{StaticResource BackupHint}" />
                                    <TextBlock Text="{Binding DatabaseInfo.LastBackupDisplay}"
                                               Style="{StaticResource BackupMetricValue}"
                                               Foreground="{DynamicResource Theme.Legacy.047857.SuccessInk}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="القيم تُقرأ مباشرة من SQL Server: sys.database_files و msdb.dbo.backupset. توقيت آخر نسخة هو توقيت جهاز SQL Server. إذا ظهر خطأ صلاحية، نفّذ sql/18_EnableBackupRestore.sql بحساب sysadmin."
                                   Style="{StaticResource BackupHint}" />
                    </StackPanel>
                </Border>

                <!-- Backup actions -->
                <Border Margin="0,12,0,0"
                        Padding="16"
                        CornerRadius="14"
                        Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                        BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                        BorderThickness="1"
                        IsEnabled="{Binding IsDatabaseBacked}">
                    <StackPanel FlowDirection="LeftToRight">
                        <TextBlock Text="إنشاء نسخة احتياطية" Style="{StaticResource BackupCardTitle}" />
                        <TextBlock Margin="0,4,0,12"
                                   Text="اكتب مسارًا على جهاز SQL Server أو مشاركة UNC يراه حساب خدمة SQL Server. زر الاستعراض يختار مجلدًا من هذا الجهاز فقط."
                                   Style="{StaticResource BackupHint}" />

                        <TextBlock Text="مجلد الحفظ (على جهاز SQL Server)" Style="{StaticResource BackupLabel}" />
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                         FlowDirection="LeftToRight"
                                         TextAlignment="Left"
                                         Text="{Binding BackupFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsIdle}"
                                         AutomationProperties.Name="مجلد النسخ الاحتياطي" />
                                <TextBlock Text="مثال: C:\ProjectZ\Backups أو \\SERVER\Backups"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding BackupFolderPath, Converter={StaticResource StringEmptyToVis}}" />
                            </Grid>
                            <Button Grid.Column="2"
                                    Content="استعراض"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Padding="12,7"
                                    MinHeight="36"
                                    Command="{Binding BrowseBackupFolderCommand}"
                                    IsEnabled="{Binding IsIdle}" />
                        </Grid>

                        <TextBlock Text="اسم ملف النسخة (.bak)" Style="{StaticResource BackupLabel}" Margin="0,12,0,6" />
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource PosCompactTextBoxStyle}"
                                     FlowDirection="LeftToRight"
                                     TextAlignment="Left"
                                     Text="{Binding BackupFileName, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsIdle}"
                                     AutomationProperties.Name="اسم ملف النسخة الاحتياطية" />
                            <Button Grid.Column="2"
                                    Content="اسم جديد"
                                    Style="{StaticResource PosOutlineTealButtonStyle}"
                                    Padding="10,6"
                                    FontSize="12"
                                    Command="{Binding NewBackupFileNameCommand}"
                                    IsEnabled="{Binding IsIdle}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    FlowDirection="RightToLeft"
                                    Margin="0,14,0,0">
                            <Button Content="أخذ النسخة الاحتياطية"
                                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                                    Padding="18,9"
                                    MinHeight="38"
                                    Command="{Binding BackupCommand}"
                                    IsEnabled="{Binding IsIdle}" />
                            <TextBlock Text="يُستبدل أي ملف موجود بنفس الاسم (WITH INIT, FORMAT)."
                                       Style="{StaticResource BackupHint}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Restore actions -->
                <Border Margin="0,12,0,0"
                        Padding="16"
                        CornerRadius="14"
                        Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}"
                        BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}"
                        BorderThickness="1"
                        IsEnabled="{Binding IsDatabaseBacked}">
                    <StackPanel FlowDirection="LeftToRight">
                        <TextBlock Text="استرجاع نسخة احتياطية" Style="{StaticResource BackupCardTitle}" />
                        <TextBlock Margin="0,4,0,12"
                                   Text="الاسترجاع يستبدل قاعدة البيانات الحالية بالكامل. أغلق بقية الشاشات، وتأكد أن الملف موجود على جهاز SQL Server. ستتم إعادة القاعدة إلى وضع MULTI_USER حتى لو فشلت العملية."
                                   Style="{StaticResource BackupHint}"
                                   Foreground="{DynamicResource Theme.Legacy.991B1B.DangerInk}" />

                        <TextBlock Text="مسار ملف النسخة على جهاز SQL Server" Style="{StaticResource BackupLabel}" />
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                         FlowDirection="LeftToRight"
                                         TextAlignment="Left"
                                         Text="{Binding RestoreFilePath, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsIdle}"
                                         AutomationProperties.Name="مسار ملف الاسترجاع" />
                                <TextBlock Text="مثال: C:\ProjectZ\Backups\ProjectZ_20261114_1200.bak"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding RestoreFilePath, Converter={StaticResource StringEmptyToVis}}" />
                            </Grid>
                            <Button Grid.Column="2"
                                    Content="استعراض"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Padding="12,7"
                                    MinHeight="36"
                                    Command="{Binding BrowseRestoreFileCommand}"
                                    IsEnabled="{Binding IsIdle}" />
                        </Grid>

                        <Button Content="استرجاع النسخة الاحتياطية المحددة"
                                Style="{StaticResource PosDangerButtonStyle}"
                                Margin="0,14,0,0"
                                Padding="18,9"
                                MinHeight="38"
                                HorizontalAlignment="Right"
                                Command="{Binding RestoreCommand}"
                                IsEnabled="{Binding IsIdle}" />
                    </StackPanel>
                </Border>

                <!-- Local .bak discovery is best effort; a server path may not be readable from this client. -->
                <Border Margin="0,12,0,0"
                        Padding="16"
                        CornerRadius="14"
                        Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                        BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                        BorderThickness="1">
                    <StackPanel FlowDirection="LeftToRight">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="نسخ موجودة في المجلد (من جهاز العميل)"
                                       Style="{StaticResource BackupCardTitle}" />
                            <Button Grid.Column="1"
                                    Content="تحديث القائمة"
                                    Style="{StaticResource PosOutlineTealButtonStyle}"
                                    Padding="10,6"
                                    FontSize="12"
                                    Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding IsIdle}" />
                        </Grid>
                        <TextBlock Margin="0,4,0,8"
                                   Text="هذه القائمة للاطلاع فقط؛ ملفات SQL Server قد لا تكون مرئية من هذا الجهاز. استخدم المسار الكامل في بطاقة الاسترجاع."
                                   Style="{StaticResource BackupHint}" />

                        <TextBlock Text="{Binding EmptyBackupsMessage}"
                                   Style="{StaticResource BackupHint}"
                                   Margin="0,4,0,4"
                                   Visibility="{Binding HasAvailableBackups, Converter={StaticResource InverseBoolToVis}}" />

                        <ScrollViewer MaxHeight="190"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasAvailableBackups, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding AvailableBackups}" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,7"
                                                BorderBrush="{DynamicResource Theme.Legacy.F1F5F9.Border}"
                                                BorderThickness="0,0,0,1"
                                                Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}">
                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="130" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           Style="{StaticResource PosRtlTextStyle}"
                                                           VerticalAlignment="Center"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Theme.Legacy.172B41.Text}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LengthDisplay}"
                                                           Style="{StaticResource PosCenterTextStyle}"
                                                           VerticalAlignment="Center"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding LastWriteDisplay}"
                                                           Style="{StaticResource PosCenterTextStyle}"
                                                           VerticalAlignment="Center"
                                                           FontSize="11.5"
                                                           FlowDirection="LeftToRight"
                                                           Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status strip stays outside the scroll area so the result is always visible. -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                FlowDirection="LeftToRight"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.065F46.SuccessInk}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
