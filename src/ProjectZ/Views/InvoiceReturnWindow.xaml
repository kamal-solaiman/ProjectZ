<Window x:Class="ProjectZ.Views.InvoiceReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | مرتجع فاتورة مبيعات'}"
        Width="740"
        Height="640"
        MinWidth="600"
        MinHeight="500"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid FlowDirection="LeftToRight">
        <ContentControl Style="{StaticResource ThemeBackdropStyle}" />
    <Grid Margin="18" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16,12"
                CornerRadius="14"
                Background="{DynamicResource Theme.Legacy.7C2D12.Danger}">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="إرجاع كامل الفاتورة"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Padding="12,6"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Command="{Binding ReturnAllInvoiceCommand}" />

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="مرتجع / استبدال بنود الفاتورة"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnDanger}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Invoice.InvoiceNumber}" Style="{StaticResource PosLtrTextStyle}" FontFamily="Consolas, Segoe UI" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FDBA74.WarningInk}" />
                        <TextBlock Text=" · " Style="{StaticResource PosCenterTextStyle}" Foreground="{DynamicResource Theme.Legacy.FED7AA.WarningInk}" />
                        <TextBlock Text="{Binding Invoice.CustomerName}" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" Foreground="{DynamicResource Theme.Legacy.FFEDD5.WarningInk}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Select Quantities to Return -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="12"
                CornerRadius="12"
                Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="حدد الكمية المراد إرجاعها من كل بند:"
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="0,0,0,8"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ReturnLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="12,10"
                                        CornerRadius="10"
                                        Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                                        BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}"
                                        BorderThickness="1">
                                    <Grid FlowDirection="LeftToRight">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Refund value for this line -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="95">
                                            <TextBlock Text="قيمة المرتجع" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                            <TextBlock Text="{Binding LineRefundAmountDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                        </StackPanel>

                                        <!-- Quantity Stepper -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                                            <Button Content="−" Style="{StaticResource PosStepperButtonStyle}" Command="{Binding DecrementCommand}" />
                                            <TextBlock Text="{Binding ReturnQuantityDisplay}"
                                                       Style="{StaticResource PosCenterTextStyle}"
                                                       MinWidth="34"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="Bold" />
                                            <Button Content="+" Style="{StaticResource PosStepperButtonStyle}" Command="{Binding IncrementCommand}" />
                                            <Button Content="الكل"
                                                    Margin="6,0,0,0"
                                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                                    Padding="8,3"
                                                    FontSize="11"
                                                    Command="{Binding ReturnAllLineCommand}" />
                                        </StackPanel>

                                        <!-- Product Details -->
                                        <StackPanel Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Line.ProductName}"
                                                       Style="{StaticResource PosRtlTextStyle}"
                                                       FontSize="13.5"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding MaxReturnableDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                                <TextBlock Text=" · سعر الوحدة: " Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                                <TextBlock Text="{Binding Line.UnitPriceDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.334155.Text}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Line.SerialSummary}"
                                                       Style="{StaticResource PosRtlTextStyle}"
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Return Reason & Stock / Financial Disposition -->
        <Border Grid.Row="2"
                Margin="0,0,0,10"
                Padding="14"
                CornerRadius="12"
                Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="سبب المرتجع *"
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="0,0,0,6"
                           FontSize="13"
                           FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding SuggestedReasons}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" FlowDirection="RightToLeft" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Margin="0,2,6,2"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Padding="10,4"
                                    FontSize="11.5"
                                    Command="{Binding DataContext.PickReasonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                         Margin="0,0,0,10"
                         FlowDirection="RightToLeft"
                         TextAlignment="Left"
                         Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />

                <Grid FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="مصير القطع في المخزون:" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Margin="0,0,0,5" />
                        <RadioButton Content="إرجاع للمخزون المتاح (سليمة)"
                                     FlowDirection="RightToLeft"
                                     IsChecked="{Binding ReturnAsAvailableStock}"
                                     Margin="0,2"
                                     FontSize="12.5" />
                        <RadioButton Content="تحويل لمخزون الهالك (تالف / عيب)"
                                     FlowDirection="RightToLeft"
                                     IsChecked="{Binding MarkAsDamagedStock}"
                                     Margin="0,2"
                                     FontSize="12.5" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <CheckBox Content="تم رد مبلغ المرتجع للعميل نقدًا / تحويلًا"
                                  Style="{StaticResource PosCheckBoxStyle}"
                                  IsChecked="{Binding RefundCashToCustomer}"
                                  FontSize="12.5"
                                  FontWeight="SemiBold" />
                        <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="8" Background="{DynamicResource Theme.Legacy.FFFBEB.WarningSoft}" BorderBrush="{DynamicResource Theme.Legacy.FDE68A.WarningBorder}" BorderThickness="1">
                            <TextBlock Text="{Binding SummaryDisplay}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.Legacy.92400E.WarningInk}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Error Banner -->
        <Border Grid.Row="3"
                Margin="0,0,0,8"
                Padding="10,7"
                CornerRadius="8"
                Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}"
                BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}"
                BorderThickness="1"
                Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVis}}">
            <TextBlock Text="{Binding Error}"
                       Style="{StaticResource PosRtlTextStyle}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إلغاء"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="16,9"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="2"
                    Content="تأكيد تنفيذ المرتجع"
                    Style="{StaticResource PosDangerButtonStyle}"
                    MinWidth="190"
                    Padding="18,9"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
