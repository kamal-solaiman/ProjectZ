<Window x:Class="ProjectZ.Views.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="600" Height="790" MinWidth="520" MinHeight="650"
        FlowDirection="LeftToRight" Language="ar-EG" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="18,14" CornerRadius="16" Background="#102E48" Margin="0,0,0,14"><StackPanel FlowDirection="RightToLeft">
            <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="20" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#B7CFDD" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel></Border>
        <Border Grid.Row="1" Padding="20" CornerRadius="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <Border Padding="10,8" CornerRadius="8" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" Margin="0,0,0,14"><TextBlock Text="تصميم بدون Backend · اكتب صفرًا في أي حد ليعمل بلا قيود. لا تتغير قيمة الرصيد عند تعديل الحدود." Style="{StaticResource PosRtlTextStyle}" FontSize="12" Foreground="#0F766E" TextWrapping="Wrap" /></Border>
            <StackPanel Visibility="{Binding IsProviderSelectionVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="نوع المحفظة *" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox Style="{StaticResource PosComboBoxStyle}" ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding SelectedProvider}" FlowDirection="RightToLeft" Margin="0,0,0,12" />
            </StackPanel>
            <TextBlock Text="اسم المحفظة / وصفها *" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="AliasInput" Style="{StaticResource PosCompactTextBoxStyle}" FlowDirection="RightToLeft" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
            <TextBlock Text="رقم فودافون كاش / عنوان إنستاباي *" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,6" />
            <TextBox Style="{StaticResource PosCompactTextBoxStyle}" FlowDirection="LeftToRight" Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
            <StackPanel Visibility="{Binding IsProviderSelectionVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="الرصيد الافتتاحي" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,6" />
                <TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding OpeningBalanceText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <Border Margin="0,16,0,0" Padding="12" CornerRadius="10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel>
                <TextBlock Text="حدود الإيداع والسحب" Style="{StaticResource PosRtlTextStyle}" FontSize="14" FontWeight="Bold" Foreground="#102E48" />
                <TextBlock Text="كل محفظة تعمل بحدود مستقلة، ويظهر استهلاكها اليومي والشهري في ملفها." Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,12" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="حد السحب اليومي" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Margin="0,0,0,5" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding DailyWithdrawalLimitText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="حد الإيداع اليومي" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Margin="0,0,0,5" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding DailyDepositLimitText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="حد السحب الشهري" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Margin="0,0,0,5" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding MonthlyWithdrawalLimitText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="حد الإيداع الشهري" Style="{StaticResource PosRtlTextStyle}" FontSize="12" Margin="0,0,0,5" /><TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding MonthlyDepositLimitText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                </Grid>
            </StackPanel></Border>
            <TextBlock Text="ملاحظات" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6" />
            <TextBox Style="{StaticResource PosCompactTextBoxStyle}" FlowDirection="RightToLeft" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="300" />
            <TextBlock Text="{Binding Error}" Style="{StaticResource PosRtlTextStyle}" Foreground="#B42318" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVis}}" />
        </StackPanel></ScrollViewer></Border>
        <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Content="إلغاء" Style="{StaticResource PosSecondaryButtonStyle}" MinWidth="110" Padding="18,10" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Content="{Binding SaveButtonText}" Style="{StaticResource PosPrimaryCompactButtonStyle}" MinWidth="170" Padding="20,10" IsDefault="True" Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</Window>
