<UserControl x:Class="ProjectZ.Views.ExpenseCategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Language="ar-EG">

    <UserControl.Resources>
        <Style x:Key="ExpCatActionBtnBaseStyle" TargetType="Button">
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header strip -->
        <Grid Grid.Row="0" Margin="0,0,0,12" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="تحديث التصنيفات"
                    Style="{StaticResource PosOutlineTealButtonStyle}"
                    Padding="12,7"
                    FontSize="12.5"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCategoriesCommand}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft">
                <TextBlock Text="تصنيفات المصروفات"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Legacy.102E48.Heading}"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Legacy.DCFCE7.SuccessSoft}"
                        BorderBrush="{DynamicResource Theme.Legacy.BBF7D0.SuccessBorder}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="متصل بقاعدة البيانات"
                               Style="{StaticResource PosCenterTextStyle}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.15803D.SuccessInk}" />
                </Border>
                <TextBlock Text="أقسام المصروفات مثل الإيجار والفواتير، تُستخدم في تسجيل المصروفات وتصنيفها عند المقارنة في «تقارير المصروفات»."
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="10,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="460" />
            </StackPanel>
        </Grid>

        <!-- ROW 1: counters + search + add form -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="14"
                CornerRadius="14"
                Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Counters: total, with description, without description -->
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Orientation="Horizontal" FlowDirection="LeftToRight">
                    <Border Padding="12,8"
                            CornerRadius="9"
                            Background="{DynamicResource Theme.Legacy.EFF6FF.InfoSoft}"
                            BorderBrush="{DynamicResource Theme.Legacy.BFDBFE.InfoBorder}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding TotalCountDisplay}"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Legacy.1D4ED8.InfoInk}" />
                    </Border>
                    <Border Margin="6,0,0,0"
                            Padding="12,8"
                            CornerRadius="9"
                            Background="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}"
                            BorderBrush="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding WithDescriptionDisplay}"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Legacy.047857.SuccessInk}" />
                    </Border>
                    <Border Margin="6,0,0,0"
                            Padding="12,8"
                            CornerRadius="9"
                            Background="{DynamicResource Theme.Legacy.FFF7ED.WarningSoft}"
                            BorderBrush="{DynamicResource Theme.Legacy.FED7AA.WarningBorder}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding WithoutDescriptionDisplay}"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Legacy.C2410C.WarningInk}" />
                    </Border>
                </StackPanel>

                <!-- Search -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="بحث في تصنيفات المصروفات"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,5"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                    <Grid>
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 Padding="10,7,30,7"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="ابحث بالاسم أو الوصف..."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="30,0,10,0"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                        <Button Content="×"
                                Width="22"
                                Height="22"
                                Margin="6,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource PosDangerIconButtonStyle}"
                                Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}"
                                Command="{Binding ClearSearchCommand}" />
                    </Grid>
                </StackPanel>

                <!-- Add new expense section -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="إضافة تصنيف مصروف جديد (مثال: إيجار، فواتير، مرتبات)"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,5"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.102E48.Heading}" />
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="+ إضافة تصنيف"
                                Style="{StaticResource PosPrimaryCompactButtonStyle}"
                                Padding="18,8"
                                MinHeight="36"
                                Command="{Binding AddCategoryCommand}" />

                        <Grid Grid.Column="2">
                            <TextBox x:Name="NewExpenseCategoryInput"
                                     Style="{StaticResource PosCompactTextBoxStyle}"
                                     FlowDirection="RightToLeft"
                                     TextAlignment="Left"
                                     MaxLength="200"
                                     Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddCategoryCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="اسم التصنيف، مثال: إيجار المحل..."
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="12,0,12,0"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding NewCategoryName, Converter={StaticResource StringEmptyToVis}}" />
                        </Grid>
                    </Grid>
                    <Grid Margin="0,6,0,0" FlowDirection="LeftToRight">
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 MaxLength="500"
                                 MinHeight="32"
                                 Text="{Binding NewCategoryDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="وصف اختياري للتصنيف (يظهر في الشاشة فقط)..."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="12,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding NewCategoryDescription, Converter={StaticResource StringEmptyToVis}}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: sections table -->
        <Border Grid.Row="2"
                CornerRadius="14"
                Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Theme.Legacy.102E48.Navigation}"
                        CornerRadius="13,13,0,0"
                        Padding="14,11"
                        FlowDirection="LeftToRight">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="م"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Brush.NavigationMuted}" />
                        <TextBlock Grid.Column="1"
                                   Text="اسم تصنيف المصروف والوصف"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="8,0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                        <TextBlock Grid.Column="2"
                                   Text="التحكم"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
                    </Grid>
                </Border>

                <!-- Table rows -->
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  FlowDirection="LeftToRight">
                        <ItemsControl ItemsSource="{Binding FilteredCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,10"
                                            BorderBrush="{DynamicResource Theme.Legacy.F1F5F9.Border}"
                                            BorderThickness="0,0,0,1"
                                            Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}">
                                        <Grid FlowDirection="RightToLeft">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="250" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Order badge -->
                                            <Border Grid.Column="0"
                                                    MinWidth="34"
                                                    Padding="8,4"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource Theme.Legacy.F1F5F9.Surface}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OrderDisplay}"
                                                           Style="{StaticResource PosCenterTextStyle}"
                                                           FontSize="12.5"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource Theme.Legacy.334155.Text}" />
                                            </Border>

                                            <!-- Name + description / inline edit -->
                                            <Grid Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                <StackPanel Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource PosRtlTextStyle}"
                                                               FontSize="14.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Theme.Legacy.172B41.Text}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DescriptionDisplay}"
                                                               Style="{StaticResource PosRtlTextStyle}"
                                                               Margin="0,2,0,0"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                                             MinHeight="34"
                                                             Padding="10,5"
                                                             FlowDirection="RightToLeft"
                                                             TextAlignment="Left"
                                                             MaxLength="200"
                                                             Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                             IsVisibleChanged="InlineEditBox_IsVisibleChanged">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Return" Command="{Binding SaveEditCommand}" />
                                                            <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                                             Margin="0,5,0,0"
                                                             MinHeight="30"
                                                             Padding="10,4"
                                                             FlowDirection="RightToLeft"
                                                             TextAlignment="Left"
                                                             MaxLength="500"
                                                             FontSize="11.5"
                                                             Text="{Binding EditingDescription, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Actions -->
                                            <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"
                                                            FlowDirection="RightToLeft"
                                                            Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="تعديل"
                                                            Style="{StaticResource ExpCatActionBtnBaseStyle}"
                                                            Background="{DynamicResource Theme.Legacy.EFF6FF.InfoSoft}"
                                                            Foreground="{DynamicResource Theme.Legacy.1D4ED8.InfoInk}"
                                                            BorderBrush="{DynamicResource Theme.Legacy.BFDBFE.InfoBorder}"
                                                            Command="{Binding BeginEditCommand}" />
                                                    <Button Content="حذف"
                                                            Style="{StaticResource ExpCatActionBtnBaseStyle}"
                                                            Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}"
                                                            Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}"
                                                            BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}"
                                                            ToolTip="الحذف متاح ما دام التصنيف غير مرتبط بمصروفات مسجلة"
                                                            Command="{Binding DeleteCommand}" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            FlowDirection="RightToLeft"
                                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="حفظ"
                                                            Style="{StaticResource ExpCatActionBtnBaseStyle}"
                                                            Background="{DynamicResource Theme.Legacy.0F766E.Success}"
                                                            Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnSuccess}"
                                                            BorderBrush="{DynamicResource Theme.Legacy.0F766E.SuccessBorder}"
                                                            Command="{Binding SaveEditCommand}" />
                                                    <Button Content="إلغاء"
                                                            Style="{StaticResource ExpCatActionBtnBaseStyle}"
                                                            Background="{DynamicResource Theme.Legacy.F1F5F9.Surface}"
                                                            Foreground="{DynamicResource Theme.Legacy.334155.Text}"
                                                            BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}"
                                                            Command="{Binding CancelEditCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding EmptyStateText}"
                               Style="{StaticResource PosCenterTextStyle}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                               Visibility="{Binding HasNoCategories, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ROW 3: status strip -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                FlowDirection="LeftToRight"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.065F46.SuccessInk}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
