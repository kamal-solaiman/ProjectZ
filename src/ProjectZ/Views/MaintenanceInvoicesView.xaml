<UserControl x:Class="ProjectZ.Views.MaintenanceInvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Language="ar-EG">

    <UserControl.Resources>
        <Style x:Key="MntInvDatePillBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MntInvBasisBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MntInvRowQuickBtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header Strip -->
        <Grid Grid.Row="0" Margin="0,0,0,10" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                <Button Content="+ أمر صيانة جديد"
                        Style="{StaticResource PosPrimaryCompactButtonStyle}"
                        Padding="14,7"
                        FontSize="12.5"
                        Command="{Binding GoToIntakeCommand}" />
                <Button Content="تحديث"
                        Margin="8,0,0,0"
                        Style="{StaticResource PosOutlineTealButtonStyle}"
                        Padding="12,7"
                        FontSize="12"
                        Command="{Binding RefreshDataCommand}" />
                <Button Content="إعادة ضبط الفلاتر"
                        Margin="8,0,0,0"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Padding="12,7"
                        FontSize="12"
                        Command="{Binding ClearFiltersCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft">
                <TextBlock Text="فواتير الصيانة — السجل الشامل والتحليلات والفلاتر"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="20.5"
                           FontWeight="Bold"
                           Foreground="#102E48"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        Background="#E0F2FE"
                        BorderBrush="#BAE6FD"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="تصميم الواجهة — بدون Backend"
                               Style="{StaticResource PosCenterTextStyle}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#0369A1" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ROW 1: 5 Dynamic KPI Cards -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10" FlowDirection="RightToLeft">
            <!-- KPI 1: Count & Breakdown -->
            <Border Padding="11,9" CornerRadius="11" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="عدد فواتير الصيانة" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock Text="{Binding InvoicesCountDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="17" FontWeight="Bold" Foreground="#102E48" />
                    <TextBlock Text="{Binding InvoicesBreakdownSummary}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- KPI 2: Effective Service Revenue -->
            <Border Margin="0,0,8,0" Padding="11,9" CornerRadius="11" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي قيمة الصيانات" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F766E" />
                    <TextBlock Text="{Binding TotalServiceValueDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="17" FontWeight="Bold" Foreground="#0F766E" />
                    <TextBlock Text="{Binding ServiceBreakdownSubtext}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10" Foreground="#0D9488" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- KPI 3: Estimated / Realized Net Profit -->
            <Border Margin="0,0,8,0" Padding="11,9" CornerRadius="11" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="صافي ربح الصيانة" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D4ED8" />
                    <TextBlock Text="{Binding TotalNetProfitDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="17" FontWeight="Bold" Foreground="#1E40AF" />
                    <TextBlock Text="{Binding PartsCostAndMarginSubtext}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10.5" Foreground="#2563EB" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- KPI 4: Collected Payments & Channels -->
            <Border Margin="0,0,8,0" Padding="11,9" CornerRadius="11" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="صافي التحصيلات الفعلية" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#6D28D9" />
                    <TextBlock Text="{Binding TotalCollectedAllDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="17" FontWeight="Bold" Foreground="#5B21B6" />
                    <TextBlock Text="{Binding ChannelsBreakdownDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10" Foreground="#7C3AED" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- KPI 5: Remaining to Collect (Clickable Quick Filter) -->
            <Button Margin="0,0,8,0"
                    Cursor="Hand"
                    Command="{Binding FilterRemainingOnlyCommand}"
                    ToolTip="اضغط لتصفية الفواتير التي بها رصيد متبقٍ للتحصيل">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="11,9" CornerRadius="11" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="المتبقي للتحصيل (اضغط للتصفية)" Style="{StaticResource PosRtlTextStyle}" FontSize="11" FontWeight="SemiBold" Foreground="#B45309" />
                                <TextBlock Text="{Binding TotalRemainingDisplay}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="17" FontWeight="Bold" Foreground="#B42318" />
                                <TextBlock Text="{Binding RemainingCountSubtext}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10" Foreground="#92400E" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </UniformGrid>

        <!-- ROW 2: Multi-Criteria Search & Filter Bar -->
        <Border Grid.Row="2"
                Margin="0,0,0,10"
                Padding="11,9"
                CornerRadius="12"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <StackPanel>
                <!-- Line 1: Date Basis Switch + Date Presets + Custom Pickers + Global Search -->
                <Grid Margin="0,0,0,8" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Date Basis Switch + Date Presets -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                        <Border Padding="4,3"
                                Margin="0,0,8,0"
                                CornerRadius="8"
                                Background="#E2E8F0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تاريخ الاستلام"
                                        Command="{Binding SelectDateBasisCommand}"
                                        CommandParameter="تاريخ الاستلام">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MntInvBasisBtnStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReceivedDateBasis}" Value="True">
                                                    <Setter Property="Background" Value="#102E48" />
                                                    <Setter Property="BorderBrush" Value="#102E48" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="تاريخ التسليم"
                                        Margin="0"
                                        Command="{Binding SelectDateBasisCommand}"
                                        CommandParameter="تاريخ التسليم">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MntInvBasisBtnStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeliveryDateBasis}" Value="True">
                                                    <Setter Property="Background" Value="#0F766E" />
                                                    <Setter Property="BorderBrush" Value="#0F766E" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button Content="الكل" Command="{Binding SelectDatePresetCommand}" CommandParameter="الكل">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MntInvDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllDatePreset}" Value="True">
                                            <Setter Property="Background" Value="#102E48" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="اليوم" Command="{Binding SelectDatePresetCommand}" CommandParameter="اليوم">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MntInvDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTodayPreset}" Value="True">
                                            <Setter Property="Background" Value="#0F766E" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="آخر 7 أيام" Command="{Binding SelectDatePresetCommand}" CommandParameter="آخر 7 أيام">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MntInvDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLast7DaysPreset}" Value="True">
                                            <Setter Property="Background" Value="#0F766E" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="هذا الشهر" Command="{Binding SelectDatePresetCommand}" CommandParameter="هذا الشهر">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MntInvDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsThisMonthPreset}" Value="True">
                                            <Setter Property="Background" Value="#0F766E" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="فترة مخصصة" Command="{Binding SelectDatePresetCommand}" CommandParameter="فترة مخصصة">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MntInvDatePillBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomDatePreset}" Value="True">
                                            <Setter Property="Background" Value="#147D92" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Custom Date Pickers -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsCustomDatePreset, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="من:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11.5" />
                            <DatePicker SelectedDate="{Binding CustomFromDate}" Width="116" Height="28" />
                            <TextBlock Text="إلى:" Style="{StaticResource PosRtlTextStyle}" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11.5" />
                            <DatePicker SelectedDate="{Binding CustomToDate}" Width="116" Height="28" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Smart Global Search -->
                    <Grid Grid.Column="2">
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 MinHeight="34"
                                 Padding="10,5,30,5"
                                 FontSize="12"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="بحث برقم الفاتورة، العميل، الهاتف، الجهاز، السيريال IMEI، العطل، قطعة الغيار..."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="30,0,10,0"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="#94A3B8"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                        <Button Content="×"
                                Width="22"
                                Height="22"
                                Margin="6,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource PosDangerIconButtonStyle}"
                                Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}"
                                Command="{Binding ClearSearchCommand}" />
                    </Grid>
                </Grid>

                <!-- Line 2: 6 Filter Combos -->
                <Grid FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="الحالة" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  FontSize="11.5"
                                  MinHeight="32"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="الأولوية" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  FontSize="11.5"
                                  MinHeight="32"
                                  ItemsSource="{Binding PriorityFilterOptions}"
                                  SelectedItem="{Binding SelectedPriorityFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="الفني المسؤول" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  FontSize="11.5"
                                  MinHeight="32"
                                  ItemsSource="{Binding TechnicianFilterOptions}"
                                  SelectedItem="{Binding SelectedTechnicianFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="طريقة الدفع" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  FontSize="11.5"
                                  MinHeight="32"
                                  ItemsSource="{Binding PaymentFilterOptions}"
                                  SelectedItem="{Binding SelectedPaymentFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="8">
                        <TextBlock Text="التسوية المالية" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  FontSize="11.5"
                                  MinHeight="32"
                                  ItemsSource="{Binding SettlementFilterOptions}"
                                  SelectedItem="{Binding SelectedSettlementFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="10">
                        <TextBlock Text="الترتيب" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2" />
                        <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                  FontSize="11.5"
                                  MinHeight="32"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSortOption}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ROW 3: Full-Width Comprehensive Maintenance Invoices Table -->
        <Border Grid.Row="3"
                CornerRadius="12"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="1040">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Padding="14,10" Background="#102E48" CornerRadius="11,11,0,0">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="122" />
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="1.45*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="126" />
                                <ColumnDefinition Width="115" />
                                <ColumnDefinition Width="108" />
                                <ColumnDefinition Width="210" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="رقم الفاتورة" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#6EE7D8" />
                            <TextBlock Grid.Column="1" Text="الاستلام / التسليم" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                            <TextBlock Grid.Column="2" Text="العميل والهاتف" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                            <TextBlock Grid.Column="3" Text="الجهاز والعطل" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                            <TextBlock Grid.Column="4" Text="الفني المسؤول" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                            <TextBlock Grid.Column="5" Text="الإجمالي / القطع" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#6EE7D8" />
                            <TextBlock Grid.Column="6" Text="المحصّل / المتبقي" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                            <TextBlock Grid.Column="7" Text="وسيلة الدفع" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                            <TextBlock Grid.Column="8" Text="الحالة" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                            <TextBlock Grid.Column="9" Text="عرض وتحكم سريع" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                        </Grid>
                    </Border>

                    <!-- Table Rows -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredOrders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="14,10"
                                                HorizontalContentAlignment="Stretch"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.OpenInvoiceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="اضغط لعرض التفاصيل الكاملة للفاتورة، قطع الغيار، المدفوعات والسجل الزمني">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBg"
                                                            Background="White"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsInvoiceRowSelected}" Value="True">
                                                            <Setter TargetName="RowBg" Property="Background" Value="#EFF6FF" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBg" Property="Background" Value="#F0FDFA" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>

                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="122" />
                                                    <ColumnDefinition Width="125" />
                                                    <ColumnDefinition Width="1.15*" />
                                                    <ColumnDefinition Width="1.45*" />
                                                    <ColumnDefinition Width="1.05*" />
                                                    <ColumnDefinition Width="118" />
                                                    <ColumnDefinition Width="126" />
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="108" />
                                                    <ColumnDefinition Width="210" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Invoice # & Priority -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OrderNumber}"
                                                               Style="{StaticResource PosLtrTextStyle}"
                                                               HorizontalAlignment="Right"
                                                               FontFamily="Consolas, Segoe UI"
                                                               FontSize="12.5"
                                                               FontWeight="Bold"
                                                               Foreground="#102E48" />
                                                    <Border Margin="0,3,0,0"
                                                            Padding="6,1"
                                                            CornerRadius="5"
                                                            Background="#FEE2E2"
                                                            HorizontalAlignment="Right"
                                                            Visibility="{Binding IsUrgent, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="مستعجل" Style="{StaticResource PosCenterTextStyle}" FontSize="9.5" FontWeight="Bold" Foreground="#B42318" />
                                                    </Border>
                                                    <Border Margin="0,3,0,0"
                                                            Padding="6,1"
                                                            CornerRadius="5"
                                                            Background="#E0E7FF"
                                                            HorizontalAlignment="Right"
                                                            Visibility="{Binding IsWarranty, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="ضمان / فحص" Style="{StaticResource PosCenterTextStyle}" FontSize="9.5" FontWeight="Bold" Foreground="#3730A3" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Received & Delivery Dates -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ReceivedFullDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                                                    <TextBlock Text="{Binding DeliveredAtDisplay, StringFormat='تسليم: {0}'}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               Margin="0,2,0,0"
                                                               FontSize="10"
                                                               Foreground="#0F766E"
                                                               Visibility="{Binding IsDelivered, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding ExpectedDeliveryDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               Margin="0,2,0,0"
                                                               FontSize="10"
                                                               Foreground="#64748B"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding IsActiveOrder, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- Customer -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                                                    <TextBlock Text="{Binding CustomerName}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#172B41" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CustomerPhoneDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" Margin="0,2,0,0" FontSize="10.5" Foreground="#64748B" />
                                                </StackPanel>

                                                <!-- Device & Fault -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="6,0">
                                                    <TextBlock Text="{Binding DeviceFullTitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#102E48" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ReportedFault}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Technician -->
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding AssignedTechnicianDisplay}"
                                                           Style="{StaticResource PosCenterTextStyle}"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="#334155"
                                                           TextWrapping="Wrap"
                                                           Margin="4,0" />

                                                <!-- Effective Cost & Parts/Labor -->
                                                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EstimatedCostDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#0F766E" />
                                                    <TextBlock Text="{Binding PartsAndLaborSummaryText}" Style="{StaticResource PosCenterTextStyle}" Margin="0,2,0,0" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Collected & Remaining -->
                                                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalCollectedAllDisplay, StringFormat='محصّل: {0}'}" Style="{StaticResource PosCenterTextStyle}" FontSize="11" FontWeight="SemiBold" Foreground="#0F766E" />
                                                    <TextBlock Text="{Binding EstimatedRemainingDisplay, StringFormat='متبقي: {0}'}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               Margin="0,2,0,0"
                                                               FontSize="10.5"
                                                               FontWeight="Bold"
                                                               Foreground="#B42318"
                                                               Visibility="{Binding HasEstimatedRemaining, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding RefundedDepositAmountDisplay, StringFormat='مرتجع: {0}'}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               Margin="0,2,0,0"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="#6D28D9"
                                                               Visibility="{Binding HasRefundedDeposit, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- Payment Channels -->
                                                <TextBlock Grid.Column="7"
                                                           Text="{Binding PaymentChannelsSummaryText}"
                                                           Style="{StaticResource PosCenterTextStyle}"
                                                           VerticalAlignment="Center"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334155"
                                                           TextWrapping="Wrap" />

                                                <!-- Status Badge -->
                                                <Border Grid.Column="8"
                                                        Padding="8,4"
                                                        CornerRadius="7"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E0F2FE" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDiagnosing}" Value="True">
                                                                    <Setter Property="Background" Value="#F3E8FF" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsWaitingParts}" Value="True">
                                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsReadyForPickup}" Value="True">
                                                                    <Setter Property="Background" Value="#D1FAE5" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDelivered}" Value="True">
                                                                    <Setter Property="Background" Value="#E2E8F0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusTitle}" FontSize="10.5" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                                <Setter Property="Foreground" Value="#0369A1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDiagnosing}" Value="True">
                                                                        <Setter Property="Foreground" Value="#6D28D9" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsWaitingParts}" Value="True">
                                                                        <Setter Property="Foreground" Value="#B45309" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsReadyForPickup}" Value="True">
                                                                        <Setter Property="Foreground" Value="#047857" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDelivered}" Value="True">
                                                                        <Setter Property="Foreground" Value="#334155" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                                        <Setter Property="Foreground" Value="#B42318" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Quick Row Controls -->
                                                <StackPanel Grid.Column="9"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FlowDirection="RightToLeft">
                                                    <Button Content="تفاصيل"
                                                            Style="{StaticResource MntInvRowQuickBtnStyle}"
                                                            Background="#E0F2FE"
                                                            Foreground="#0369A1"
                                                            BorderBrush="#7DD3FC"
                                                            Command="{Binding DataContext.OpenInvoiceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="طباعة"
                                                            Style="{StaticResource MntInvRowQuickBtnStyle}"
                                                            Background="#F0FDFA"
                                                            Foreground="#0F766E"
                                                            BorderBrush="#99F6E4"
                                                            Command="{Binding DataContext.OpenPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="تسليم"
                                                            Style="{StaticResource MntInvRowQuickBtnStyle}"
                                                            Background="#ECFDF5"
                                                            Foreground="#047857"
                                                            BorderBrush="#6EE7B7"
                                                            IsEnabled="{Binding IsActiveOrder}"
                                                            Command="{Binding DataContext.OpenDeliverDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="إجراءات"
                                                            Style="{StaticResource MntInvRowQuickBtnStyle}"
                                                            Background="#EFF6FF"
                                                            Foreground="#1D4ED8"
                                                            BorderBrush="#BFDBFE"
                                                            Command="{Binding DataContext.OpenInMaintenanceActionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasNoFilteredOrders, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="لا توجد فواتير صيانة مطابقة لخيارات البحث أو التصفية الحالية."
                                       Style="{StaticResource PosCenterTextStyle}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B" />
                            <Button Margin="0,10,0,0"
                                    Content="عرض جميع الفواتير"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Padding="14,7"
                                    Command="{Binding ClearFiltersCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ROW 4: Status Banner -->
        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                FlowDirection="LeftToRight"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="#065F46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="#B42318" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
