<UserControl x:Class="ProjectZ.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProjectZ.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SuppliersViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/PosStyles.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="SupCard" TargetType="Border">
                <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" />
            </Style>
            <Style x:Key="SupKpi" TargetType="Border" BasedOn="{StaticResource SupCard}">
                <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="14,11" />
            </Style>
            <Style x:Key="SupTab" TargetType="Button">
                <Setter Property="Background" Value="#F1F5F9" /><Setter Property="Foreground" Value="#334155" />
                <Setter Property="BorderBrush" Value="#CBD5E1" /><Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,7" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".88" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="SupChip" TargetType="Button">
                <Setter Property="Padding" Value="10,6" /><Setter Property="Margin" Value="0,4,6,0" /><Setter Property="FontSize" Value="11.5" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".88" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value=".45" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid FlowDirection="LeftToRight" Margin="18,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ إضافة مورد جديد" Style="{StaticResource PosPrimaryCompactButtonStyle}" Command="{Binding AddSupplierCommand}" Margin="0,0,8,0" />
                <Button Content="تحديث البيانات" Style="{StaticResource PosSecondaryButtonStyle}" Command="{Binding RefreshDataCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="الموردين — الحسابات ودورة التوريد" Style="{StaticResource PosRtlTextStyle}" FontSize="22" FontWeight="Bold" Foreground="#102E48" />
                    <Border Margin="10,0,0,0" Padding="10,4" CornerRadius="8" Background="#ECFEFF" BorderBrush="#67E8F9" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataSourceLabel}" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0E7490" />
                    </Border>
                </StackPanel>
                <TextBlock Text="إدارة بيانات التوريد والتحويل، فواتير المشتريات والمرتجعات، والسداد مع كشف حساب مدين / دائن تراكمي." Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Search and filters -->
        <Border Grid.Row="1" Style="{StaticResource SupCard}" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="155" /><ColumnDefinition Width="8" /><ColumnDefinition Width="165" /><ColumnDefinition Width="8" /><ColumnDefinition Width="145" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Content="إلغاء الفلاتر" Style="{StaticResource PosSecondaryButtonStyle}" Padding="12,7" Command="{Binding ClearFiltersCommand}" />
                <ComboBox Grid.Column="2" Style="{StaticResource PosComboBoxStyle}" MinHeight="34" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" FlowDirection="RightToLeft" ToolTip="ترتيب الموردين" />
                <ComboBox Grid.Column="4" Style="{StaticResource PosComboBoxStyle}" MinHeight="34" ItemsSource="{Binding BalanceFilterOptions}" SelectedItem="{Binding SelectedBalanceFilter}" FlowDirection="RightToLeft" />
                <ComboBox Grid.Column="6" Style="{StaticResource PosComboBoxStyle}" MinHeight="34" ItemsSource="{Binding SpecializationFilterOptions}" SelectedItem="{Binding SelectedSpecializationFilter}" FlowDirection="RightToLeft" />
                <Grid Grid.Column="8">
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}" MinHeight="34" FlowDirection="RightToLeft" Padding="32,6,12,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="ابحث بالاسم، الشركة، الهاتف، التخصص، التحويل أو رقم الفاتورة..." Style="{StaticResource PosRtlTextStyle}" Margin="12,0,32,0" VerticalAlignment="Center" FontSize="12" Foreground="#94A3B8" IsHitTestVisible="False" Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                    <Button Content="×" Width="22" Height="22" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource PosDangerIconButtonStyle}" Command="{Binding ClearSearchCommand}" Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Master / 360 details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="480" /><ColumnDefinition Width="12" /><ColumnDefinition Width="520" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SupCard}" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Padding="10,9" CornerRadius="10" Background="#102E48" Margin="0,0,0,6">
                        <Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="105" /><ColumnDefinition Width="108" /><ColumnDefinition Width="126" /></Grid.ColumnDefinitions>
                                <TextBlock Text="الكود" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#6EE7D8" />
                                <TextBlock Grid.Column="1" Text="المورد وبياناته" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                                <TextBlock Grid.Column="2" Text="التخصص" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                                <TextBlock Grid.Column="3" Text="الفواتير" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                                <TextBlock Grid.Column="4" Text="صافي المشتريات" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#6EE7D8" />
                                <TextBlock Grid.Column="5" Text="المستحق / الحالة" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#FDE68A" />
                            </Grid><TextBlock Grid.Column="1" Text="تحكم" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#BAE6FD" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredSuppliers}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border Margin="0,0,0,5" CornerRadius="10" BorderThickness="1">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E2E8F0" /><Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFC" /><Setter Property="BorderBrush" Value="#CBD5E1" /></Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#ECFEFF" /><Setter Property="BorderBrush" Value="#147D92" /><Setter Property="BorderThickness" Value="1.5" /></DataTrigger>
                                    </Style.Triggers></Style></Border.Style>
                                    <Grid FlowDirection="RightToLeft" Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                        <Button Padding="4,3" HorizontalContentAlignment="Stretch" Cursor="Hand" Command="{Binding DataContext.SelectSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter /></Border></ControlTemplate></Button.Template>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="105" /><ColumnDefinition Width="108" /><ColumnDefinition Width="126" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Supplier.SupplierCodeDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI" FontSize="11.5" FontWeight="Bold" Foreground="#147D92" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                                    <TextBlock Text="{Binding Supplier.Name}" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Supplier.SearchSubtitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="7,3" CornerRadius="6" Background="#E0F2FE"><TextBlock Text="{Binding Supplier.SpecializationDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" FontWeight="Bold" Foreground="#0369A1" TextTrimming="CharacterEllipsis" /></Border>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding InvoicesSummary}" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" FontWeight="SemiBold" /><TextBlock Text="{Binding LastActivityDisplay, StringFormat='آخر نشاط: {0}'}" Style="{StaticResource PosCenterTextStyle}" FontSize="9.5" Foreground="#64748B" /></StackPanel>
                                                <TextBlock Grid.Column="4" Text="{Binding TotalPurchasesDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" FontWeight="Bold" Foreground="#102E48" />
                                                <Border Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="7,4" CornerRadius="7">
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#ECFDF5" /><Style.Triggers><DataTrigger Binding="{Binding HasOutstanding}" Value="True"><Setter Property="Background" Value="#FEE2E2" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <TextBlock Text="{Binding BalanceStatusTitle}" FontSize="10.5" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}"><Setter Property="Foreground" Value="#047857" /><Style.Triggers><DataTrigger Binding="{Binding HasOutstanding}" Value="True"><Setter Property="Foreground" Value="#B42318" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="تعديل" Style="{StaticResource PosOutlineTealButtonStyle}" Padding="8,4" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" Command="{Binding DataContext.EditSupplierRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </ScrollViewer>
                        <Border Visibility="{Binding HasNoFilteredSuppliers, Converter={StaticResource BoolToVis}}" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel>
                            <TextBlock Text="لا يوجد موردون مطابقون للبحث الحالي" Style="{StaticResource PosCenterTextStyle}" FontSize="14.5" FontWeight="Bold" Foreground="#102E48" />
                            <TextBlock Text="أعد ضبط الفلاتر أو سجل موردًا جديدًا." Style="{StaticResource PosCenterTextStyle}" FontSize="12" Foreground="#64748B" Margin="0,5,0,12" />
                            <Button Content="عرض جميع الموردين" Style="{StaticResource PosPrimaryCompactButtonStyle}" HorizontalAlignment="Center" Command="{Binding ClearFiltersCommand}" />
                        </StackPanel></Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Supplier 360 profile -->
            <Border Grid.Column="2" Style="{StaticResource SupCard}" Background="#F8FAFC" Padding="12">
                <Grid>
                    <TextBlock Text="اختر موردًا من القائمة لعرض ملفه وحسابه وفواتير المشتريات." Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13.5" Foreground="#94A3B8" Visibility="{Binding HasSelectedSupplier, Converter={StaticResource InverseBoolToVis}}" />
                    <Grid Visibility="{Binding HasSelectedSupplier, Converter={StaticResource BoolToVis}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="13" CornerRadius="12" Background="#102E48" Margin="0,0,0,10">
                            <StackPanel FlowDirection="RightToLeft">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="11" Background="#147D92" Margin="0,0,10,0" VerticalAlignment="Top"><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.InitialBadgeText}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" /></Border>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.Name}" Style="{StaticResource PosRtlTextStyle}" FontSize="16" FontWeight="Bold" Foreground="White" /><Border Margin="8,0,0,0" Padding="7,2" CornerRadius="6" Background="#1D455F"><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.SupplierCodeDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11" FontWeight="Bold" Foreground="#6EE7D8" /></Border></StackPanel>
                                        <TextBlock Text="{Binding SelectedSupplierEntry.Supplier.DisplayCompany}" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="#CBD5E1" Margin="0,3,0,0" />
                                        <WrapPanel Margin="0,3,0,0"><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.DisplayPhone}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" Foreground="#99F6E4" /><Border Margin="8,0,0,0" Padding="7,2" CornerRadius="5" Background="#0F766E"><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.SpecializationDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" FontWeight="Bold" Foreground="White" /></Border></WrapPanel>
                                        <TextBlock Text="{Binding SelectedSupplierEntry.Supplier.AddressDisplay, StringFormat='العنوان: {0}'}" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#CBD5E1" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="+ فاتورة شراء جديدة للمورد" Style="{StaticResource SupChip}" Background="#0F766E" BorderBrush="#14B8A6" Foreground="White" Command="{Binding StartPurchaseForSupplierCommand}" />
                                    <Button Content="سداد أقدم آجل" Style="{StaticResource SupChip}" Background="#1D4ED8" BorderBrush="#60A5FA" Foreground="White" Command="{Binding PayOldestInvoiceCommand}" />
                                    <Button Content="تعديل البيانات" Style="{StaticResource SupChip}" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#102E48" Command="{Binding EditSelectedSupplierCommand}" />
                                    <Button Content="حذف" Style="{StaticResource SupChip}" Background="#FEF2F2" BorderBrush="#FECACA" Foreground="#B42318" Command="{Binding DeleteSelectedSupplierCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Contact / transfer strip -->
                        <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Padding="9,7" CornerRadius="8" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1"><StackPanel><TextBlock Text="فودافون كاش" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#9A3412" /><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.VodafoneCashDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="#C2410C" /></StackPanel></Border>
                            <Border Grid.Column="2" Padding="9,7" CornerRadius="8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"><StackPanel><TextBlock Text="إنستاباي" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#1E40AF" /><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.InstaPayDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                        </Grid>

                        <!-- Four profile financials -->
                        <Grid Grid.Row="2" FlowDirection="RightToLeft" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Padding="8,7" CornerRadius="9" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><TextBlock Text="المشتريات" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#64748B" /><TextBlock Text="{Binding SelectedSupplierEntry.TotalPurchasesDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" /></StackPanel></Border>
                            <Border Grid.Column="2" Padding="8,7" CornerRadius="9" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><TextBlock Text="المسدد" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#64748B" /><TextBlock Text="{Binding SelectedSupplierEntry.TotalPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#0F766E" /></StackPanel></Border>
                            <Border Grid.Column="4" Padding="8,7" CornerRadius="9" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><TextBlock Text="المرتجعات" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#64748B" /><TextBlock Text="{Binding SelectedSupplierEntry.TotalReturnsDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#0369A1" /></StackPanel></Border>
                            <Border Grid.Column="6" Padding="8,7" CornerRadius="9" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"><StackPanel><TextBlock Text="مستحق للمورد" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#475569" /><TextBlock Text="{Binding SelectedSupplierEntry.OutstandingDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#B42318" /></StackPanel></Border>
                        </Grid>

                        <Grid Grid.Row="3" FlowDirection="RightToLeft" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="{Binding SelectedInvoicesTabTitle}" Command="{Binding SelectDetailTabCommand}" CommandParameter="0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SupTab}"><Style.Triggers><DataTrigger Binding="{Binding IsInvoicesTabSelected}" Value="True"><Setter Property="Background" Value="#147D92" /><Setter Property="BorderBrush" Value="#147D92" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            <Button Grid.Column="2" Content="{Binding SelectedStatementTabTitle}" Command="{Binding SelectDetailTabCommand}" CommandParameter="1"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SupTab}"><Style.Triggers><DataTrigger Binding="{Binding IsStatementTabSelected}" Value="True"><Setter Property="Background" Value="#102E48" /><Setter Property="BorderBrush" Value="#102E48" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                        </Grid>

                        <Grid Grid.Row="4">
                            <!-- Purchase invoices -->
                            <Grid Visibility="{Binding IsInvoicesTabSelected, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding SelectedSupplierInvoices}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Margin="0,0,0,7" Padding="10,9" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel FlowDirection="RightToLeft">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding InvoiceNumber}" Style="{StaticResource PosLtrTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="#102E48" /><Border Margin="8,0,0,0" Padding="7,2" CornerRadius="5" Background="#F1F5F9"><TextBlock Text="{Binding StatusTitle}" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="#334155" /></Border></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding IssuedDateDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding ItemsAndUnitsSummary}" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#475569" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding PaymentMethodSummary}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#0F766E" Margin="0,2,0,0" />
                                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="الصافي: " Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#64748B" /><TextBlock Text="{Binding NetTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" /><TextBlock Text=" · المتبقي: " Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#64748B" Visibility="{Binding HasRemainingPayable, Converter={StaticResource BoolToVis}}" /><TextBlock Text="{Binding RemainingPayableDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#B42318" Visibility="{Binding HasRemainingPayable, Converter={StaticResource BoolToVis}}" /></StackPanel>
                                            <WrapPanel Grid.Column="1" HorizontalAlignment="Left">
                                                <Button Content="سداد" Style="{StaticResource PosPrimaryCompactButtonStyle}" Padding="8,4" FontSize="10.5" Margin="0,0,4,0" Visibility="{Binding CanPayRemaining, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.PayInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Content="مرتجع" Style="{StaticResource PosSecondaryButtonStyle}" Padding="8,4" FontSize="10.5" Margin="0,0,4,0" Visibility="{Binding CanReturn, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.ReturnInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Content="تفاصيل" Style="{StaticResource PosOutlineTealButtonStyle}" Padding="8,4" FontSize="10.5" Margin="0,0,4,0" Command="{Binding DataContext.OpenInvoiceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Content="طباعة" Style="{StaticResource PosSecondaryButtonStyle}" Padding="8,4" FontSize="10.5" Command="{Binding DataContext.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </WrapPanel>
                                        </Grid>
                                    </StackPanel></Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                <TextBlock Text="لا توجد فواتير مشتريات مسجلة لهذا المورد." Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12.5" Foreground="#94A3B8" Visibility="{Binding HasNoSelectedSupplierInvoices, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <!-- Chronological debit / credit statement -->
                            <Grid Visibility="{Binding IsStatementTabSelected, Converter={StaticResource BoolToVis}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Padding="9,7" CornerRadius="8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,0,7"><TextBlock Text="مدين = سداد أو مرتجع يقلل مستحق المورد · دائن = فاتورة شراء تزيد المستحق · الرصيد موجب يعني مستحقًا للمورد." Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#1E40AF" TextWrapping="Wrap" /></Border>
                                <Border Grid.Row="1" Padding="7,6" CornerRadius="7" Background="#102E48"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="التاريخ" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="White" /><TextBlock Grid.Column="1" Text="البيان / المرجع" Style="{StaticResource PosRtlTextStyle}" FontSize="10" FontWeight="Bold" Foreground="White" /><TextBlock Grid.Column="2" Text="مدين" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="#6EE7D8" /><TextBlock Grid.Column="3" Text="دائن" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="#FDE68A" /><TextBlock Grid.Column="4" Text="الرصيد التراكمي" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Grid></Border>
                                <Grid Grid.Row="2" Margin="0,5,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding SelectedSupplierStatement}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,7" Background="White"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding DateDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" FontSize="9.5" Foreground="#475569" /><TextBlock Text="{Binding TimeDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" FontSize="9" Foreground="#94A3B8" /></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="{Binding Description}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Reference}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="9.5" Foreground="#147D92" /></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DebitDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#0F766E" />
                                        <TextBlock Grid.Column="3" Text="{Binding CreditDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#B45309" />
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="{Binding RunningBalanceDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="#102E48" /><TextBlock Text="{Binding RunningBalanceSide}" Style="{StaticResource PosCenterTextStyle}" FontSize="9" Foreground="#64748B" /></StackPanel>
                                    </Grid></Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                    <TextBlock Text="لا توجد حركات حساب لهذا المورد حتى الآن." Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12.5" Foreground="#94A3B8" Visibility="{Binding HasNoSelectedSupplierStatement, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="12,8" CornerRadius="10" BorderThickness="1" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#ECFDF5" /><Setter Property="BorderBrush" Value="#A7F3D0" /><Style.Triggers><DataTrigger Binding="{Binding IsErrorStatus}" Value="True"><Setter Property="Background" Value="#FEF2F2" /><Setter Property="BorderBrush" Value="#FECACA" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}"><Setter Property="Foreground" Value="#065F46" /><Style.Triggers><DataTrigger Binding="{Binding IsErrorStatus}" Value="True"><Setter Property="Foreground" Value="#991B1B" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Border>
    </Grid>
</UserControl>
