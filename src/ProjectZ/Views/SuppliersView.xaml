<UserControl x:Class="ProjectZ.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProjectZ.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SuppliersViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/PosStyles.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="SupCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FFFFFF.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.E2E8F0.Border}" />
                <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" />
            </Style>
            <Style x:Key="SupKpi" TargetType="Border" BasedOn="{StaticResource SupCard}">
                <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="14,11" />
            </Style>
            <Style x:Key="SupTab" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.F1F5F9.Surface}" /><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.334155.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" /><Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,7" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".88" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="SupChip" TargetType="Button">
                <Setter Property="Padding" Value="10,6" /><Setter Property="Margin" Value="0,4,6,0" /><Setter Property="FontSize" Value="11.5" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".88" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value=".45" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid FlowDirection="LeftToRight" Margin="18,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ إضافة مورد جديد" Style="{StaticResource PosPrimaryCompactButtonStyle}" Command="{Binding AddSupplierCommand}" Margin="0,0,8,0" />
                <Button Content="تحديث البيانات" Style="{StaticResource PosSecondaryButtonStyle}" Command="{Binding RefreshDataCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="الموردين — الحسابات ودورة التوريد" Style="{StaticResource PosRtlTextStyle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                    <Border Margin="10,0,0,0" Padding="10,4" CornerRadius="8" Background="{DynamicResource Theme.Legacy.ECFEFF.AccentSoft}" BorderBrush="{DynamicResource Theme.Legacy.67E8F9.Border}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataSourceLabel}" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.0E7490.AccentInk}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="إدارة بيانات التوريد والتحويل، فواتير المشتريات والمرتجعات، والسداد مع كشف حساب مدين / دائن تراكمي." Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Search and filters -->
        <Border Grid.Row="1" Style="{StaticResource SupCard}" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="155" /><ColumnDefinition Width="8" /><ColumnDefinition Width="165" /><ColumnDefinition Width="8" /><ColumnDefinition Width="145" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Content="إلغاء الفلاتر" Style="{StaticResource PosSecondaryButtonStyle}" Padding="12,7" Command="{Binding ClearFiltersCommand}" />
                <ComboBox Grid.Column="2" Style="{StaticResource PosComboBoxStyle}" MinHeight="34" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" FlowDirection="RightToLeft" ToolTip="ترتيب الموردين" />
                <ComboBox Grid.Column="4" Style="{StaticResource PosComboBoxStyle}" MinHeight="34" ItemsSource="{Binding BalanceFilterOptions}" SelectedItem="{Binding SelectedBalanceFilter}" FlowDirection="RightToLeft" />
                <ComboBox Grid.Column="6" Style="{StaticResource PosComboBoxStyle}" MinHeight="34" ItemsSource="{Binding SpecializationFilterOptions}" SelectedItem="{Binding SelectedSpecializationFilter}" FlowDirection="RightToLeft" />
                <Grid Grid.Column="8">
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}" MinHeight="34" FlowDirection="RightToLeft" Padding="32,6,12,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="ابحث بالاسم، الشركة، الهاتف، التخصص، التحويل أو رقم الفاتورة..." Style="{StaticResource PosRtlTextStyle}" Margin="12,0,32,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" IsHitTestVisible="False" Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                    <Button Content="×" Width="22" Height="22" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource PosDangerIconButtonStyle}" Command="{Binding ClearSearchCommand}" Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Master / 360 details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="480" /><ColumnDefinition Width="12" /><ColumnDefinition Width="520" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SupCard}" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Padding="10,9" CornerRadius="10" Background="{DynamicResource Theme.Legacy.102E48.Navigation}" Margin="0,0,0,6">
                        <Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="105" /><ColumnDefinition Width="108" /><ColumnDefinition Width="126" /></Grid.ColumnDefinitions>
                                <TextBlock Text="الكود" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
                                <TextBlock Grid.Column="1" Text="المورد وبياناته" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                                <TextBlock Grid.Column="2" Text="التخصص" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                                <TextBlock Grid.Column="3" Text="الفواتير" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                                <TextBlock Grid.Column="4" Text="صافي المشتريات" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
                                <TextBlock Grid.Column="5" Text="المستحق / الحالة" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FDE68A.NavigationInk}" />
                            </Grid><TextBlock Grid.Column="1" Text="تحكم" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.BAE6FD.NavigationInk}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredSuppliers}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border Margin="0,0,0,5" CornerRadius="10" BorderThickness="1">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.FFFFFF.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.E2E8F0.Border}" /><Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.F8FAFC.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" /></Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFEFF.AccentSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.147D92.Accent}" /><Setter Property="BorderThickness" Value="1.5" /></DataTrigger>
                                    </Style.Triggers></Style></Border.Style>
                                    <Grid FlowDirection="RightToLeft" Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                        <Button Padding="4,3" HorizontalContentAlignment="Stretch" Cursor="Hand" Command="{Binding DataContext.SelectSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter /></Border></ControlTemplate></Button.Template>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="105" /><ColumnDefinition Width="108" /><ColumnDefinition Width="126" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Supplier.SupplierCodeDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.147D92.AccentInk}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                                    <TextBlock Text="{Binding Supplier.Name}" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Supplier.SearchSubtitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="7,3" CornerRadius="6" Background="{DynamicResource Theme.Legacy.E0F2FE.InfoSoft}"><TextBlock Text="{Binding Supplier.SpecializationDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0369A1.InfoInk}" TextTrimming="CharacterEllipsis" /></Border>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding InvoicesSummary}" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" FontWeight="SemiBold" /><TextBlock Text="{Binding LastActivityDisplay, StringFormat='آخر نشاط: {0}'}" Style="{StaticResource PosCenterTextStyle}" FontSize="9.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /></StackPanel>
                                                <TextBlock Grid.Column="4" Text="{Binding TotalPurchasesDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                                <Border Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="7,4" CornerRadius="7">
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}" /><Style.Triggers><DataTrigger Binding="{Binding HasOutstanding}" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEE2E2.DangerSoft}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <TextBlock Text="{Binding BalanceStatusTitle}" FontSize="10.5" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}"><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.047857.SuccessInk}" /><Style.Triggers><DataTrigger Binding="{Binding HasOutstanding}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="تعديل" Style="{StaticResource PosOutlineTealButtonStyle}" Padding="8,4" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" Command="{Binding DataContext.EditSupplierRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </ScrollViewer>
                        <Border Visibility="{Binding HasNoFilteredSuppliers, Converter={StaticResource BoolToVis}}" Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}" BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" BorderThickness="1" CornerRadius="12" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel>
                            <TextBlock Text="لا يوجد موردون مطابقون للبحث الحالي" Style="{StaticResource PosCenterTextStyle}" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                            <TextBlock Text="أعد ضبط الفلاتر أو سجل موردًا جديدًا." Style="{StaticResource PosCenterTextStyle}" FontSize="12" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" Margin="0,5,0,12" />
                            <Button Content="عرض جميع الموردين" Style="{StaticResource PosPrimaryCompactButtonStyle}" HorizontalAlignment="Center" Command="{Binding ClearFiltersCommand}" />
                        </StackPanel></Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Supplier 360 profile -->
            <Border Grid.Column="2" Style="{StaticResource SupCard}" Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}" Padding="12">
                <Grid>
                    <TextBlock Text="اختر موردًا من القائمة لعرض ملفه وحسابه وفواتير المشتريات." Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13.5" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" Visibility="{Binding HasSelectedSupplier, Converter={StaticResource InverseBoolToVis}}" />
                    <Grid Visibility="{Binding HasSelectedSupplier, Converter={StaticResource BoolToVis}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="13" CornerRadius="12" Background="{DynamicResource Theme.Legacy.102E48.Navigation}" Margin="0,0,0,10">
                            <StackPanel FlowDirection="RightToLeft">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource Theme.Legacy.147D92.Accent}" Margin="0,0,10,0" VerticalAlignment="Top"><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.InitialBadgeText}" Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" /></Border>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.Name}" Style="{StaticResource PosRtlTextStyle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" /><Border Margin="8,0,0,0" Padding="7,2" CornerRadius="6" Background="{DynamicResource Theme.Legacy.1D455F.Navigation}"><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.SupplierCodeDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" /></Border></StackPanel>
                                        <TextBlock Text="{Binding SelectedSupplierEntry.Supplier.DisplayCompany}" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.CBD5E1.NavigationMuted}" Margin="0,3,0,0" />
                                        <WrapPanel Margin="0,3,0,0"><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.DisplayPhone}" Style="{StaticResource PosLtrTextStyle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.99F6E4.Highlight}" /><Border Margin="8,0,0,0" Padding="7,2" CornerRadius="5" Background="{DynamicResource Theme.Legacy.0F766E.Success}"><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.SpecializationDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnSuccess}" /></Border></WrapPanel>
                                        <TextBlock Text="{Binding SelectedSupplierEntry.Supplier.AddressDisplay, StringFormat='العنوان: {0}'}" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="{DynamicResource Theme.Legacy.CBD5E1.NavigationMuted}" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding SelectedSupplierEntry.SparePartsSummary}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="+ فاتورة شراء جديدة للمورد" Style="{StaticResource SupChip}" Background="{DynamicResource Theme.Legacy.0F766E.Success}" BorderBrush="{DynamicResource Theme.Legacy.14B8A6.Accent}" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnSuccess}" Command="{Binding StartPurchaseForSupplierCommand}" />
                                    <Button Content="سداد أقدم آجل" Style="{StaticResource SupChip}" Background="{DynamicResource Theme.Legacy.1D4ED8.Info}" BorderBrush="{DynamicResource Theme.Legacy.60A5FA.InfoBorder}" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnInfo}" Command="{Binding PayOldestInvoiceCommand}" />
                                    <Button Content="تعديل البيانات" Style="{StaticResource SupChip}" Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}" BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" Command="{Binding EditSelectedSupplierCommand}" />
                                    <Button Content="حذف" Style="{StaticResource SupChip}" Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}" BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" Command="{Binding DeleteSelectedSupplierCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Contact / transfer strip -->
                        <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Padding="9,7" CornerRadius="8" Background="{DynamicResource Theme.Legacy.FFF7ED.WarningSoft}" BorderBrush="{DynamicResource Theme.Legacy.FED7AA.WarningBorder}" BorderThickness="1"><StackPanel><TextBlock Text="فودافون كاش" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.9A3412.DangerInk}" /><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.VodafoneCashDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.C2410C.WarningInk}" /></StackPanel></Border>
                            <Border Grid.Column="2" Padding="9,7" CornerRadius="8" Background="{DynamicResource Theme.Legacy.EFF6FF.InfoSoft}" BorderBrush="{DynamicResource Theme.Legacy.BFDBFE.InfoBorder}" BorderThickness="1"><StackPanel><TextBlock Text="إنستاباي" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.1E40AF.InfoInk}" /><TextBlock Text="{Binding SelectedSupplierEntry.Supplier.InstaPayDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.1D4ED8.InfoInk}" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                        </Grid>

                        <!-- Four profile financials -->
                        <Grid Grid.Row="2" FlowDirection="RightToLeft" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Padding="8,7" CornerRadius="9" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1"><StackPanel><TextBlock Text="المشتريات" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /><TextBlock Text="{Binding SelectedSupplierEntry.TotalPurchasesDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" /></StackPanel></Border>
                            <Border Grid.Column="2" Padding="8,7" CornerRadius="9" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1"><StackPanel><TextBlock Text="المسدد" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /><TextBlock Text="{Binding SelectedSupplierEntry.TotalPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" /></StackPanel></Border>
                            <Border Grid.Column="4" Padding="8,7" CornerRadius="9" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1"><StackPanel><TextBlock Text="المرتجعات" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /><TextBlock Text="{Binding SelectedSupplierEntry.TotalReturnsDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0369A1.InfoInk}" /></StackPanel></Border>
                            <Border Grid.Column="6" Padding="8,7" CornerRadius="9" Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}" BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" BorderThickness="1"><StackPanel><TextBlock Text="مستحق للمورد" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" /><TextBlock Text="{Binding SelectedSupplierEntry.OutstandingDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" /></StackPanel></Border>
                        </Grid>

                        <Grid Grid.Row="3" FlowDirection="RightToLeft" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="{Binding SelectedInvoicesTabTitle}" Command="{Binding SelectDetailTabCommand}" CommandParameter="0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SupTab}"><Style.Triggers><DataTrigger Binding="{Binding IsInvoicesTabSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.147D92.Accent}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.147D92.Accent}" /><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            <Button Grid.Column="2" Content="{Binding SelectedStatementTabTitle}" Command="{Binding SelectDetailTabCommand}" CommandParameter="1"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SupTab}"><Style.Triggers><DataTrigger Binding="{Binding IsStatementTabSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.102E48.Navigation}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.102E48.Border}" /><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            <Button Grid.Column="4" Content="{Binding SelectedSparePartsTabTitle}" Command="{Binding SelectDetailTabCommand}" CommandParameter="2"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SupTab}"><Style.Triggers><DataTrigger Binding="{Binding IsSparePartsTabSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.0F766E.Success}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.0F766E.SuccessBorder}" /><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                        </Grid>

                        <Grid Grid.Row="4">
                            <!-- Purchase invoices -->
                            <Grid Visibility="{Binding IsInvoicesTabSelected, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding SelectedSupplierInvoices}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Margin="0,0,0,7" Padding="10,9" CornerRadius="10" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1"><StackPanel FlowDirection="RightToLeft">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding InvoiceNumber}" Style="{StaticResource PosLtrTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" /><Border Margin="8,0,0,0" Padding="7,2" CornerRadius="5" Background="{DynamicResource Theme.Legacy.F1F5F9.Surface}"><TextBlock Text="{Binding StatusTitle}" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.334155.Text}" /></Border></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding IssuedDateDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding ItemsAndUnitsSummary}" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding PaymentMethodSummary}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" Margin="0,2,0,0" />
                                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="الصافي: " Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /><TextBlock Text="{Binding NetTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" /><TextBlock Text=" · المتبقي: " Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" Visibility="{Binding HasRemainingPayable, Converter={StaticResource BoolToVis}}" /><TextBlock Text="{Binding RemainingPayableDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" Visibility="{Binding HasRemainingPayable, Converter={StaticResource BoolToVis}}" /></StackPanel>
                                            <WrapPanel Grid.Column="1" HorizontalAlignment="Left">
                                                <Button Content="سداد" Style="{StaticResource PosPrimaryCompactButtonStyle}" Padding="8,4" FontSize="10.5" Margin="0,0,4,0" Visibility="{Binding CanPayRemaining, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.PayInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Content="مرتجع" Style="{StaticResource PosSecondaryButtonStyle}" Padding="8,4" FontSize="10.5" Margin="0,0,4,0" Visibility="{Binding CanReturn, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.ReturnInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Content="تفاصيل" Style="{StaticResource PosOutlineTealButtonStyle}" Padding="8,4" FontSize="10.5" Margin="0,0,4,0" Command="{Binding DataContext.OpenInvoiceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Content="طباعة" Style="{StaticResource PosSecondaryButtonStyle}" Padding="8,4" FontSize="10.5" Command="{Binding DataContext.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </WrapPanel>
                                        </Grid>
                                    </StackPanel></Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                <TextBlock Text="لا توجد فواتير مشتريات مسجلة لهذا المورد." Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" Visibility="{Binding HasNoSelectedSupplierInvoices, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <!-- Chronological debit / credit statement -->
                            <Grid Visibility="{Binding IsStatementTabSelected, Converter={StaticResource BoolToVis}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Padding="9,7" CornerRadius="8" Background="{DynamicResource Theme.Legacy.EFF6FF.InfoSoft}" BorderBrush="{DynamicResource Theme.Legacy.BFDBFE.InfoBorder}" BorderThickness="1" Margin="0,0,0,7"><TextBlock Text="مدين = سداد أو مرتجع يقلل مستحق المورد · دائن = فاتورة شراء تزيد المستحق · الرصيد موجب يعني مستحقًا للمورد." Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.1E40AF.InfoInk}" TextWrapping="Wrap" /></Border>
                                <Border Grid.Row="1" Padding="7,6" CornerRadius="7" Background="{DynamicResource Theme.Legacy.102E48.Navigation}"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="التاريخ" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" /><TextBlock Grid.Column="1" Text="البيان / المرجع" Style="{StaticResource PosRtlTextStyle}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" /><TextBlock Grid.Column="2" Text="مدين" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" /><TextBlock Grid.Column="3" Text="دائن" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FDE68A.NavigationInk}" /><TextBlock Grid.Column="4" Text="الرصيد التراكمي" Style="{StaticResource PosCenterTextStyle}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                                </Grid></Border>
                                <Grid Grid.Row="2" Margin="0,5,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding SelectedSupplierStatement}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="0,0,0,1" Padding="6,7" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding DateDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" FontSize="9.5" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" /><TextBlock Text="{Binding TimeDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" /></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="{Binding Description}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Reference}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Right" FontSize="9.5" Foreground="{DynamicResource Theme.Legacy.147D92.AccentInk}" /></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DebitDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                        <TextBlock Grid.Column="3" Text="{Binding CreditDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B45309.WarningInk}" />
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="{Binding RunningBalanceDisplay}" Style="{StaticResource PosLtrTextStyle}" HorizontalAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" /><TextBlock Text="{Binding RunningBalanceSide}" Style="{StaticResource PosCenterTextStyle}" FontSize="9" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" /></StackPanel>
                                    </Grid></Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                    <TextBlock Text="لا توجد حركات حساب لهذا المورد حتى الآن." Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" Visibility="{Binding HasNoSelectedSupplierStatement, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>

                            <!-- Maintenance spare parts linked to this supplier -->
                            <Grid Visibility="{Binding IsSparePartsTabSelected, Converter={StaticResource BoolToVis}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Padding="9,7" CornerRadius="8" Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}" BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}" BorderThickness="1" Margin="0,0,0,7">
                                    <TextBlock Text="{Binding SelectedSupplierSparePartsSummary}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" TextWrapping="Wrap" />
                                </Border>
                                <Grid Grid.Row="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding SelectedSupplierSpareParts}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Margin="0,0,0,7" Padding="10,9" CornerRadius="10" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1"><StackPanel FlowDirection="RightToLeft">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" TextTrimming="CharacterEllipsis" />
                                                    <Border Margin="7,0,0,0" Padding="6,2" CornerRadius="5" Background="{DynamicResource Theme.Legacy.E0F2FE.InfoSoft}"><TextBlock Text="{Binding CodeDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0369A1.InfoInk}" /></Border>
                                                </StackPanel>
                                                <Border Grid.Column="1" Padding="7,3" CornerRadius="6" Background="{DynamicResource Theme.Legacy.DCFCE7.SuccessSoft}"><TextBlock Text="{Binding QuantityDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.166534.SuccessInk}" /></Border>
                                            </Grid>
                                            <TextBlock Text="{Binding BarcodeDisplay, StringFormat='الباركود: {0}'}" Style="{StaticResource PosRtlTextStyle}" FontSize="10" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" Margin="0,3,0,0" />
                                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="التكلفة: " Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                                    <TextBlock Text="{Binding CostPriceDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                                                    <TextBlock Text=" · التركيب: " Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                                    <TextBlock Text="{Binding SellPriceDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="فتح في قطع الغيار" Style="{StaticResource PosOutlineTealButtonStyle}" Padding="8,4" FontSize="10" Command="{Binding DataContext.OpenSparePartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </StackPanel></Border>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                    <TextBlock Text="لا توجد قطع غيار صيانة مرتبطة بهذا المورد حتى الآن." Style="{StaticResource PosCenterTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}" Visibility="{Binding HasNoSelectedSupplierSpareParts, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="12,8" CornerRadius="10" BorderThickness="1" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.ECFDF5.SuccessSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.A7F3D0.SuccessBorder}" /><Style.Triggers><DataTrigger Binding="{Binding IsErrorStatus}" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}"><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.065F46.SuccessInk}" /><Style.Triggers><DataTrigger Binding="{Binding IsErrorStatus}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.991B1B.DangerInk}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Border>
    </Grid>
</UserControl>
