<UserControl x:Class="ProjectZ.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Language="ar-EG">

    <UserControl.Resources>
        <Style x:Key="InvActionBtnBaseStyle" TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvTabPillBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.475569.Muted}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvProductNameClickStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Keep physical coordinates predictable (LTR); Arabic blocks/rows explicitly use RTL. -->
    <Grid FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header Strip -->
        <Grid Grid.Row="0" Margin="0,0,0,10" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ إضافة منتج جديد"
                        Style="{StaticResource PosPrimaryCompactButtonStyle}"
                        Padding="14,8"
                        FontSize="12.5"
                        VerticalAlignment="Center"
                        Command="{Binding GoToAddProductCommand}" />
                <Button Content="🔄 تحديث المخزون"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        FontSize="12.5"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Background="{DynamicResource Theme.Legacy.0F766E.Success}"
                        Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnSuccess}"
                        BorderThickness="0"
                        ToolTip="إعادة قراءة الأصناف والوحدات والموردين وحركات المخزون من SQL Server"
                        Command="{Binding RefreshInventoryCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft">
                <TextBlock Text="المخزون — إدارة البضاعة والهالك"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Legacy.E0F2FE.InfoSoft}"
                        BorderBrush="{DynamicResource Theme.Legacy.BAE6FD.InfoBorder}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="متصل بقاعدة البيانات — SQL Server"
                               Style="{StaticResource PosCenterTextStyle}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.0369A1.InfoInk}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ROW 1: Tab Switcher (Catalog Stock vs Dedicated Damaged Stock) -->
        <Grid Grid.Row="1" Margin="0,0,0,10" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="ملاحظة: اضغط على اسم أي منتج أو زر «التسجيلات» لعرض جميع أرقام الـ ID والموردين لهذا المنتج."
                       Style="{StaticResource PosRtlTextStyle}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                       Visibility="{Binding IsCatalogTabSelected, Converter={StaticResource BoolToVis}}" />

            <TextBlock Grid.Column="0"
                       Text="قائمة خاصة لمخزون الهالك مع تفاصيل المورد وسبب الإهلاك وإمكانية الاسترجاع أو التسوية."
                       Style="{StaticResource PosRtlTextStyle}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}"
                       Visibility="{Binding IsDamagedTabSelected, Converter={StaticResource BoolToVis}}" />

            <Border Grid.Column="1"
                    Padding="4"
                    CornerRadius="10"
                    Background="{DynamicResource Theme.Legacy.F1F5F9.Surface}"
                    BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <Button Content="{Binding CatalogTabLabel}" Command="{Binding SelectCatalogTabCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InvTabPillBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCatalogTabSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme.Legacy.102E48.Navigation}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{Binding DamagedTabLabel}" Margin="4,0,0,0" Command="{Binding SelectDamagedTabCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InvTabPillBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDamagedTabSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme.Legacy.B42318.Danger}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ROW 2: Active Tab Content -->
        <Grid Grid.Row="2">
            <!-- TAB 1: Registered Products Inventory Table -->
            <Grid Visibility="{Binding IsCatalogTabSelected, Converter={StaticResource BoolToVis}}" FlowDirection="LeftToRight">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search & Filter Bar -->
                <Border Grid.Row="0"
                        Margin="0,0,0,8"
                        Padding="10"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                        BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                        BorderThickness="1">
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="مسح"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                Padding="10,6"
                                FontSize="12"
                                Command="{Binding ClearCatalogFiltersCommand}" />

                        <ToggleButton Grid.Column="2"
                                      IsChecked="{Binding OnlyLowStock, Mode=TwoWay}"
                                      Cursor="Hand"
                                      Padding="10,6">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FFFFFF.Surface}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.92400E.WarningInk}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.FCD34D.WarningBorder}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Box"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <TextBlock x:Name="LowStockText" Text="النواقص فقط" Style="{StaticResource PosCenterTextStyle}" Foreground="{DynamicResource Theme.Legacy.92400E.WarningInk}" FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.Legacy.D97706.Warning}" />
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.Legacy.B45309.WarningBorder}" />
                                                        <Setter TargetName="LowStockText" Property="Foreground" Value="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <ComboBox Grid.Column="4"
                                  Style="{StaticResource PosComboBoxStyle}"
                                  MinHeight="34"
                                  ToolTip="تصفية حسب المورد"
                                  ItemsSource="{Binding SupplierFilters}"
                                  SelectedItem="{Binding SelectedSupplierFilter, Mode=TwoWay}" />

                        <ComboBox Grid.Column="6"
                                  Style="{StaticResource PosComboBoxStyle}"
                                  MinHeight="34"
                                  ToolTip="تصفية حسب التصنيف"
                                  ItemsSource="{Binding CategoryFilters}"
                                  SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}" />

                        <Grid Grid.Column="8">
                            <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                     MinHeight="34"
                                     Padding="10,5,30,5"
                                     FlowDirection="RightToLeft"
                                     TextAlignment="Left"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="ابحث باسم المنتج أو الباركود أو التصنيف..."
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="30,0,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Main Inventory Products Table -->
                <Border Grid.Row="1" CornerRadius="14" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Column Headers: اسم المنتج - باركود - الكمية - سعر القطاعي - سعر الجملة - سعر المميز - الهالك - أزرار التحكمات -->
                        <Border Grid.Row="0"
                                Padding="10,9,24,9"
                                CornerRadius="13,13,0,0"
                                Background="{DynamicResource Theme.Legacy.F1F5F9.Surface}"
                                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                                BorderThickness="0,0,0,1">
                            <Grid FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="145" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="اسم المنتج" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                <TextBlock Grid.Column="1" Text="باركود" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                <TextBlock Grid.Column="2" Text="الكمية" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                <TextBlock Grid.Column="3" Text="سعر القطاعي" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.147D92.AccentInk}" />
                                <TextBlock Grid.Column="4" Text="سعر الجملة" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                                <TextBlock Grid.Column="5" Text="سعر المميز" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                                <TextBlock Grid.Column="6" Text="الهالك" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                <TextBlock Grid.Column="7" Text="أزرار التحكمات" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                            </Grid>
                        </Border>

                        <!-- Rows -->
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          FlowDirection="LeftToRight">
                                <ItemsControl ItemsSource="{Binding FilteredProducts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,7"
                                                    Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                                                    BorderBrush="{DynamicResource Theme.Legacy.F1F5F9.Border}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid FlowDirection="RightToLeft">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="145" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="300" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 1. Product Name (Clickable -> Opens Registrations Modal) -->
                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource InvProductNameClickStyle}"
                                                            VerticalAlignment="Center"
                                                            ToolTip="اضغط لعرض جميع تسجيلات المنتج وأرقام الـ ID والموردين"
                                                            Command="{Binding DataContext.OpenRegistrationsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{StaticResource PosRtlTextStyle}"
                                                                       FontSize="12.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Category}"
                                                                           Style="{StaticResource PosRtlTextStyle}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource Theme.Legacy.147D92.AccentInk}" />
                                                                <TextBlock Text=" · اضغط للتسجيلات"
                                                                           Style="{StaticResource PosRtlTextStyle}"
                                                                           FontSize="10.5"
                                                                           Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- 2. Barcode -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Barcode}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Consolas, Segoe UI"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />

                                                    <!-- 3. Available Quantity -->
                                                    <Border Grid.Column="2"
                                                            Padding="6,3"
                                                            CornerRadius="7"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.CCFBF1.AccentSoft}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEF3C7.WarningSoft}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding AvailableStock}" FontSize="12.5" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B45309.WarningInk}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- 4. Retail Price -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding RetailPriceDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontSize="11.5"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Theme.Legacy.147D92.AccentInk}" />

                                                    <!-- 5. Wholesale Price -->
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding WholesalePriceDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontSize="11.5"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />

                                                    <!-- 6. Special Price -->
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding SpecialPriceDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontSize="11.5"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />

                                                    <!-- 7. Damaged Count -->
                                                    <Border Grid.Column="6"
                                                            Padding="6,3"
                                                            CornerRadius="7"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.F1F5F9.Surface}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasDamaged}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEE2E2.DangerSoft}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding DamagedCountDisplay}" FontSize="12" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasDamaged}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- 8. Control Buttons (Registrations | Supply | Edit | Barcode | Damage | Delete) -->
                                                    <UniformGrid Grid.Column="7"
                                                                 Columns="4"
                                                                 VerticalAlignment="Center"
                                                                 FlowDirection="RightToLeft">
                                                        <Button Content="التسجيلات"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}"
                                                                Foreground="{DynamicResource Theme.Legacy.147D92.AccentInk}"
                                                                BorderBrush="{DynamicResource Theme.Legacy.147D92.Accent}"
                                                                ToolTip="عرض قائمة جميع تسجيلات المنتج وأرقام الـ ID والموردين"
                                                                Command="{Binding DataContext.OpenRegistrationsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="توريد كمية"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="{DynamicResource Theme.Legacy.147D92.Accent}"
                                                                Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnAccent}"
                                                                BorderBrush="{DynamicResource Theme.Legacy.147D92.Accent}"
                                                                ToolTip="إضافة كمية جديدة وتحديد المورد"
                                                                Command="{Binding DataContext.OpenSupplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="تعديل"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                                                                Foreground="{DynamicResource Theme.Legacy.102E48.Text}"
                                                                BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}"
                                                                ToolTip="تعديل بيانات المنتج والأسعار"
                                                                Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="باركود"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="{DynamicResource Theme.Legacy.F1F5F9.Surface}"
                                                                Foreground="{DynamicResource Theme.Legacy.334155.Text}"
                                                                BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}"
                                                                ToolTip="معاينة وطباعة ملصق الباركود"
                                                                Command="{Binding DataContext.OpenBarcodePrintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="هالك"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="{DynamicResource Theme.Legacy.FFFBEB.WarningSoft}"
                                                                Foreground="{DynamicResource Theme.Legacy.B45309.WarningInk}"
                                                                BorderBrush="{DynamicResource Theme.Legacy.FCD34D.WarningBorder}"
                                                                ToolTip="تسجيل كمية تالفة / هالكة"
                                                                Command="{Binding DataContext.OpenMarkDamagedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="حركات"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="{DynamicResource Theme.Legacy.EEF2FF.InfoSoft}"
                                                                Foreground="{DynamicResource Theme.Legacy.4338CA.InfoInk}"
                                                                BorderBrush="{DynamicResource Theme.Legacy.C7D2FE.InfoBorder}"
                                                                ToolTip="عرض سجل حركات هذا الصنف من dbo.StockMovements"
                                                                Command="{Binding DataContext.ShowProductMovementsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="حذف"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}"
                                                                Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}"
                                                                BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}"
                                                                ToolTip="حذف المنتج"
                                                                Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </UniformGrid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="لا توجد أصناف مطابقة للبحث أو التصفية الحالية."
                                       Style="{StaticResource PosCenterTextStyle}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="15"
                                       Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                       Visibility="{Binding HasNoCatalogResults, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 2: Dedicated Damaged Stock List (قائمة مخزون الهالك) -->
            <Grid Visibility="{Binding IsDamagedTabSelected, Converter={StaticResource BoolToVis}}" FlowDirection="LeftToRight">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Damaged Search & Settlement Filter Bar -->
                <Border Grid.Row="0"
                        Margin="0,0,0,8"
                        Padding="10"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}"
                        BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}"
                        BorderThickness="1">
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="مسح التصفية"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Padding="12,6"
                                    FontSize="12"
                                    Command="{Binding ClearDamagedFiltersCommand}" />
                            <Button Content="إرجاع كل الهالك للمورد"
                                    Margin="8,0,0,0"
                                    Padding="12,6"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Background="{DynamicResource Theme.Legacy.E0F2FE.InfoSoft}"
                                    Foreground="{DynamicResource Theme.Legacy.0369A1.InfoInk}"
                                    BorderBrush="{DynamicResource Theme.Legacy.BAE6FD.InfoBorder}"
                                    ToolTip="تسجيل كل وحدات الهالك كمرتجع للمورد في dbo.InventoryUnits"
                                    Command="{Binding MarkAllDamagedReturnedCommand}" />
                        </StackPanel>

                        <ComboBox Grid.Column="2"
                                  Style="{StaticResource PosComboBoxStyle}"
                                  MinHeight="34"
                                  ItemsSource="{Binding SettlementFilters}"
                                  SelectedItem="{Binding SelectedSettlementFilter, Mode=TwoWay}" />

                        <Grid Grid.Column="4">
                            <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                     MinHeight="34"
                                     Padding="10,5,30,5"
                                     FlowDirection="RightToLeft"
                                     TextAlignment="Left"
                                     Text="{Binding DamagedSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="ابحث في مخزون الهالك بالمنتج أو الباركود أو رقم ID أو المورد أو السبب..."
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="30,0,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding DamagedSearchText, Converter={StaticResource StringEmptyToVis}}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Damaged Stock Table -->
                <Border Grid.Row="1" CornerRadius="14" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Column Headers -->
                        <Border Grid.Row="0"
                                Padding="10,9,24,9"
                                CornerRadius="13,13,0,0"
                                Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}"
                                BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}"
                                BorderThickness="0,0,0,1">
                            <Grid FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" MinWidth="140" />
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="195" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.7F1D1D.DangerInk}" />
                                <TextBlock Grid.Column="1" Text="اسم المنتج / الباركود" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.7F1D1D.DangerInk}" />
                                <TextBlock Grid.Column="2" Text="المورد / الفاتورة" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.7F1D1D.DangerInk}" />
                                <TextBlock Grid.Column="3" Text="التكلفة" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.7F1D1D.DangerInk}" />
                                <TextBlock Grid.Column="4" Text="سبب الإهلاك" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.7F1D1D.DangerInk}" />
                                <TextBlock Grid.Column="5" Text="تاريخ الإهلاك" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.7F1D1D.DangerInk}" />
                                <TextBlock Grid.Column="6" Text="التسوية" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.7F1D1D.DangerInk}" />
                                <TextBlock Grid.Column="7" Text="إجراءات الهالك" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.7F1D1D.DangerInk}" />
                            </Grid>
                        </Border>

                        <!-- Rows -->
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          FlowDirection="LeftToRight">
                                <ItemsControl ItemsSource="{Binding FilteredDamagedUnits}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8"
                                                    Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                                                    BorderBrush="{DynamicResource Theme.Legacy.FEE2E2.DangerBorder}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid FlowDirection="RightToLeft">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="*" MinWidth="140" />
                                                        <ColumnDefinition Width="118" />
                                                        <ColumnDefinition Width="82" />
                                                        <ColumnDefinition Width="135" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="195" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding IdDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Consolas, Segoe UI"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Theme.Legacy.991B1B.DangerInk}" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                                        <TextBlock Text="{Binding ProductName}"
                                                                   Style="{StaticResource PosRtlTextStyle}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ProductBarcode}"
                                                                   Style="{StaticResource PosLtrTextStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   FontFamily="Consolas, Segoe UI"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0">
                                                        <TextBlock Text="{Binding SupplierName}"
                                                                   Style="{StaticResource PosRtlTextStyle}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Theme.Legacy.0369A1.InfoInk}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding PurchaseInvoiceId}"
                                                                   Style="{StaticResource PosLtrTextStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   FontFamily="Consolas, Segoe UI"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding PurchasePriceDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold" />

                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding DamageReason}"
                                                               Style="{StaticResource PosRtlTextStyle}"
                                                               Margin="4,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource Theme.Legacy.475569.Muted}"
                                                               TextWrapping="Wrap" />

                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding DamagedAtDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />

                                                    <Border Grid.Column="6"
                                                            Padding="6,3"
                                                            CornerRadius="6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEF3C7.WarningSoft}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsReturnedToSupplier}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Theme.Legacy.E0F2FE.InfoSoft}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding DamageSettlementStatus}" FontSize="11" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.92400E.WarningInk}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsReturnedToSupplier}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.0369A1.InfoInk}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- Damaged Item Controls -->
                                                    <StackPanel Grid.Column="7"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FlowDirection="RightToLeft">
                                                        <Button Content="استرجاع للمتاح"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}"
                                                                Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}"
                                                                BorderBrush="{DynamicResource Theme.Legacy.147D92.Accent}"
                                                                Command="{Binding DataContext.RestoreDamagedUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="مرتجع"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="{DynamicResource Theme.Legacy.E0F2FE.InfoSoft}"
                                                                Foreground="{DynamicResource Theme.Legacy.0369A1.InfoInk}"
                                                                BorderBrush="{DynamicResource Theme.Legacy.BAE6FD.InfoBorder}"
                                                                ToolTip="تسجيل كمرتجع للمورد"
                                                                Visibility="{Binding CanMarkReturnedToSupplier, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.MarkReturnedToSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="تعديل"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="{DynamicResource Theme.Legacy.FFFBEB.WarningSoft}"
                                                                Foreground="{DynamicResource Theme.Legacy.B45309.WarningInk}"
                                                                BorderBrush="{DynamicResource Theme.Legacy.FCD34D.WarningBorder}"
                                                                ToolTip="تعديل سبب الهالك وحالة التسوية في قاعدة البيانات"
                                                                Command="{Binding DataContext.EditDamagedUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="حذف"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}"
                                                                Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}"
                                                                BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}"
                                                                Command="{Binding DataContext.DeleteDamagedUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="لا توجد أصناف في مخزون الهالك حاليًا."
                                       Style="{StaticResource PosCenterTextStyle}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="15"
                                       Foreground="{DynamicResource Theme.Legacy.94A3B8.Muted}"
                                       Visibility="{Binding HasNoDamagedResults, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ROW 3: Stock movement ledger (dbo.StockMovements) -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="10"
                CornerRadius="12"
                Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.CBD5E1.BorderStrong}"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                        <TextBlock Text="{Binding MovementsHeader}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Legacy.0F172A.Text}" />
                        <TextBlock Text="{Binding MovementSummary}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="كل الحركات"
                            Padding="10,5"
                            FontSize="11.5"
                            Cursor="Hand"
                            Background="{DynamicResource Theme.Legacy.E2E8F0.Input}"
                            BorderThickness="0"
                            Command="{Binding RefreshInventoryCommand}" />
                </Grid>

                <ItemsControl Grid.Row="1"
                              MaxHeight="112"
                              ItemsSource="{Binding RecentMovements}"
                              Visibility="{Binding HasMovements, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,3"
                                    Padding="8,4"
                                    CornerRadius="8"
                                    Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                                    BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                                    BorderThickness="1">
                                <Grid FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding QuantityDisplay}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PosLtrTextStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.047857.SuccessInk}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIncrease}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MovementTypeDisplay}"
                                               Style="{StaticResource PosRtlTextStyle}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.Legacy.0F172A.Text}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding UnitCostDisplay, StringFormat='{}{0} ج.م'}"
                                               Style="{StaticResource PosRtlTextStyle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Theme.Legacy.475569.Muted}"
                                               Margin="8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ReasonDisplay}"
                                               Style="{StaticResource PosRtlTextStyle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Theme.Legacy.334155.Text}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding OccurredAtDisplay}"
                                               Style="{StaticResource PosLtrTextStyle}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Theme.Legacy.64748B.Muted}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ROW 4: Status Feedback Strip -->
        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                BorderThickness="1"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.99F6E4.Border}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
