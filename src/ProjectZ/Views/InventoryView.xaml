<UserControl x:Class="ProjectZ.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Language="ar-EG">

    <UserControl.Resources>
        <Style x:Key="InvActionBtnBaseStyle" TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvTabPillBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvProductNameClickStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#F0FDFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Keep physical coordinates predictable (LTR); Arabic blocks/rows explicitly use RTL. -->
    <Grid FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header Strip -->
        <Grid Grid.Row="0" Margin="0,0,0,10" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="+ إضافة منتج جديد"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    Padding="14,8"
                    FontSize="12.5"
                    VerticalAlignment="Center"
                    Command="{Binding GoToAddProductCommand}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft">
                <TextBlock Text="المخزون — إدارة البضاعة والهالك"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#102E48"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        Background="#E0F2FE"
                        BorderBrush="#BAE6FD"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="تصميم الواجهة — بدون Backend"
                               Style="{StaticResource PosCenterTextStyle}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#0369A1" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ROW 1: 4 Summary KPI Cards (RTL visual order: Total Items -> Total Qty -> Low Stock -> Damaged) -->
        <Grid Grid.Row="1" Margin="0,0,0,10" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Damaged Stock KPI (Physical Left — Click jumps to Damaged Tab) -->
            <Button Grid.Column="0"
                    Cursor="Hand"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding SelectDamagedTabCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="12,9" CornerRadius="12" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TotalDamagedCount}" Style="{StaticResource PosLtrTextStyle}" FontSize="20" FontWeight="Bold" Foreground="#B42318" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="مخزون الهالك" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="#991B1B" />
                                    <TextBlock Text="اضغط لعرض القائمة" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#B42318" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Low Stock KPI (Click toggles Low Stock Filter) -->
            <Button Grid.Column="2"
                    Cursor="Hand"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding ToggleLowStockCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="12,9" CornerRadius="12" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LowStockCount}" Style="{StaticResource PosLtrTextStyle}" FontSize="20" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="نواقص / حد التنبيه" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="#92400E" />
                                    <TextBlock Text="اضغط للتصفية" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#B45309" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Total Available Stock KPI -->
            <Border Grid.Column="4" Padding="12,9" CornerRadius="12" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1">
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TotalAvailableStock}" Style="{StaticResource PosLtrTextStyle}" FontSize="20" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="القطع المتاحة" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="#147D92" />
                        <TextBlock Text="جاهزة للبيع" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#0F766E" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Total Registered Products KPI (Physical Right) -->
            <Border Grid.Column="6" Padding="12,9" CornerRadius="12" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TotalProductsCount}" Style="{StaticResource PosLtrTextStyle}" FontSize="20" FontWeight="Bold" Foreground="#102E48" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="إجمالي الأصناف" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="Bold" Foreground="#102E48" />
                        <TextBlock Text="المسجلة بالدليل" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#64748B" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 2: Tab Switcher (Catalog Stock vs Dedicated Damaged Stock) -->
        <Grid Grid.Row="2" Margin="0,0,0,10" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="ملاحظة: اضغط على اسم أي منتج أو زر «التسجيلات» لعرض جميع أرقام الـ ID والموردين لهذا المنتج."
                       Style="{StaticResource PosRtlTextStyle}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="#64748B"
                       Visibility="{Binding IsCatalogTabSelected, Converter={StaticResource BoolToVis}}" />

            <TextBlock Grid.Column="0"
                       Text="قائمة خاصة لمخزون الهالك مع تفاصيل المورد وسبب الإهلاك وإمكانية الاسترجاع أو التسوية."
                       Style="{StaticResource PosRtlTextStyle}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="#B42318"
                       Visibility="{Binding IsDamagedTabSelected, Converter={StaticResource BoolToVis}}" />

            <Border Grid.Column="1"
                    Padding="4"
                    CornerRadius="10"
                    Background="#F1F5F9"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <Button Content="{Binding CatalogTabLabel}" Command="{Binding SelectCatalogTabCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InvTabPillBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCatalogTabSelected}" Value="True">
                                        <Setter Property="Background" Value="#102E48" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{Binding DamagedTabLabel}" Margin="4,0,0,0" Command="{Binding SelectDamagedTabCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InvTabPillBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDamagedTabSelected}" Value="True">
                                        <Setter Property="Background" Value="#B42318" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ROW 3: Active Tab Content -->
        <Grid Grid.Row="3">
            <!-- TAB 1: Registered Products Inventory Table -->
            <Grid Visibility="{Binding IsCatalogTabSelected, Converter={StaticResource BoolToVis}}" FlowDirection="LeftToRight">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search & Filter Bar -->
                <Border Grid.Row="0"
                        Margin="0,0,0,8"
                        Padding="10"
                        CornerRadius="12"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="مسح"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                Padding="10,6"
                                FontSize="12"
                                Command="{Binding ClearCatalogFiltersCommand}" />

                        <ToggleButton Grid.Column="2"
                                      IsChecked="{Binding OnlyLowStock, Mode=TwoWay}"
                                      Cursor="Hand"
                                      Padding="10,6">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="Foreground" Value="#92400E" />
                                    <Setter Property="BorderBrush" Value="#FCD34D" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Box"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <TextBlock x:Name="LowStockText" Text="النواقص فقط" Style="{StaticResource PosCenterTextStyle}" Foreground="#92400E" FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Box" Property="Background" Value="#D97706" />
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="#B45309" />
                                                        <Setter TargetName="LowStockText" Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <ComboBox Grid.Column="4"
                                  Style="{StaticResource PosComboBoxStyle}"
                                  MinHeight="34"
                                  ToolTip="تصفية حسب المورد"
                                  ItemsSource="{Binding SupplierFilters}"
                                  SelectedItem="{Binding SelectedSupplierFilter, Mode=TwoWay}" />

                        <ComboBox Grid.Column="6"
                                  Style="{StaticResource PosComboBoxStyle}"
                                  MinHeight="34"
                                  ToolTip="تصفية حسب التصنيف"
                                  ItemsSource="{Binding CategoryFilters}"
                                  SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}" />

                        <Grid Grid.Column="8">
                            <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                     MinHeight="34"
                                     Padding="10,5,30,5"
                                     FlowDirection="RightToLeft"
                                     TextAlignment="Left"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="ابحث باسم المنتج أو الباركود أو التصنيف..."
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="30,0,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Main Inventory Products Table -->
                <Border Grid.Row="1" CornerRadius="14" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Column Headers: اسم المنتج - باركود - الكمية - سعر القطاعي - سعر الجملة - سعر المميز - الهالك - أزرار التحكمات -->
                        <Border Grid.Row="0"
                                Padding="10,9,24,9"
                                CornerRadius="13,13,0,0"
                                Background="#F1F5F9"
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,0,0,1">
                            <Grid FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="145" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="246" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="اسم المنتج" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#102E48" />
                                <TextBlock Grid.Column="1" Text="باركود" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#102E48" />
                                <TextBlock Grid.Column="2" Text="الكمية" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#102E48" />
                                <TextBlock Grid.Column="3" Text="سعر القطاعي" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#147D92" />
                                <TextBlock Grid.Column="4" Text="سعر الجملة" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#102E48" />
                                <TextBlock Grid.Column="5" Text="سعر المميز" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#6D28D9" />
                                <TextBlock Grid.Column="6" Text="الهالك" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#B42318" />
                                <TextBlock Grid.Column="7" Text="أزرار التحكمات" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#102E48" />
                            </Grid>
                        </Border>

                        <!-- Rows -->
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          FlowDirection="LeftToRight">
                                <ItemsControl ItemsSource="{Binding FilteredProducts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,7"
                                                    Background="White"
                                                    BorderBrush="#F1F5F9"
                                                    BorderThickness="0,0,0,1">
                                                <Grid FlowDirection="RightToLeft">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="145" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="246" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 1. Product Name (Clickable -> Opens Registrations Modal) -->
                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource InvProductNameClickStyle}"
                                                            VerticalAlignment="Center"
                                                            ToolTip="اضغط لعرض جميع تسجيلات المنتج وأرقام الـ ID والموردين"
                                                            Command="{Binding DataContext.OpenRegistrationsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{StaticResource PosRtlTextStyle}"
                                                                       FontSize="12.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="#102E48"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Category}"
                                                                           Style="{StaticResource PosRtlTextStyle}"
                                                                           FontSize="11"
                                                                           Foreground="#147D92" />
                                                                <TextBlock Text=" · اضغط للتسجيلات"
                                                                           Style="{StaticResource PosRtlTextStyle}"
                                                                           FontSize="10.5"
                                                                           Foreground="#64748B" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- 2. Barcode -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Barcode}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Consolas, Segoe UI"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#475569" />

                                                    <!-- 3. Available Quantity -->
                                                    <Border Grid.Column="2"
                                                            Padding="6,3"
                                                            CornerRadius="7"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#CCFBF1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                        <Setter Property="Background" Value="#FEF3C7" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding AvailableStock}" FontSize="12.5" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                                    <Setter Property="Foreground" Value="#0F766E" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                            <Setter Property="Foreground" Value="#B45309" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- 4. Retail Price -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding RetailPriceDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontSize="11.5"
                                                               FontWeight="Bold"
                                                               Foreground="#147D92" />

                                                    <!-- 5. Wholesale Price -->
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding WholesalePriceDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontSize="11.5"
                                                               FontWeight="Bold"
                                                               Foreground="#102E48" />

                                                    <!-- 6. Special Price -->
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding SpecialPriceDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontSize="11.5"
                                                               FontWeight="Bold"
                                                               Foreground="#6D28D9" />

                                                    <!-- 7. Damaged Count -->
                                                    <Border Grid.Column="6"
                                                            Padding="6,3"
                                                            CornerRadius="7"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F1F5F9" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasDamaged}" Value="True">
                                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding DamagedCountDisplay}" FontSize="12" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                                    <Setter Property="Foreground" Value="#64748B" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasDamaged}" Value="True">
                                                                            <Setter Property="Foreground" Value="#B42318" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- 8. Control Buttons (Registrations | Supply | Edit | Barcode | Damage | Delete) -->
                                                    <UniformGrid Grid.Column="7"
                                                                 Columns="3"
                                                                 VerticalAlignment="Center"
                                                                 FlowDirection="RightToLeft">
                                                        <Button Content="التسجيلات"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="#F0FDFA"
                                                                Foreground="#147D92"
                                                                BorderBrush="#147D92"
                                                                ToolTip="عرض قائمة جميع تسجيلات المنتج وأرقام الـ ID والموردين"
                                                                Command="{Binding DataContext.OpenRegistrationsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="توريد كمية"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="#147D92"
                                                                Foreground="White"
                                                                BorderBrush="#147D92"
                                                                ToolTip="إضافة كمية جديدة وتحديد المورد"
                                                                Command="{Binding DataContext.OpenSupplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="تعديل"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="#F8FAFC"
                                                                Foreground="#102E48"
                                                                BorderBrush="#CBD5E1"
                                                                ToolTip="تعديل بيانات المنتج والأسعار"
                                                                Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="باركود"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="#F1F5F9"
                                                                Foreground="#334155"
                                                                BorderBrush="#CBD5E1"
                                                                ToolTip="معاينة وطباعة ملصق الباركود"
                                                                Command="{Binding DataContext.OpenBarcodePrintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="هالك"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="#FFFBEB"
                                                                Foreground="#B45309"
                                                                BorderBrush="#FCD34D"
                                                                ToolTip="تسجيل كمية تالفة / هالكة"
                                                                Command="{Binding DataContext.OpenMarkDamagedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="حذف"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="#FEF2F2"
                                                                Foreground="#B42318"
                                                                BorderBrush="#FECACA"
                                                                ToolTip="حذف المنتج"
                                                                Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </UniformGrid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="لا توجد أصناف مطابقة للبحث أو التصفية الحالية."
                                       Style="{StaticResource PosCenterTextStyle}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="15"
                                       Foreground="#94A3B8"
                                       Visibility="{Binding HasNoCatalogResults, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 2: Dedicated Damaged Stock List (قائمة مخزون الهالك) -->
            <Grid Visibility="{Binding IsDamagedTabSelected, Converter={StaticResource BoolToVis}}" FlowDirection="LeftToRight">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Damaged Search & Settlement Filter Bar -->
                <Border Grid.Row="0"
                        Margin="0,0,0,8"
                        Padding="10"
                        CornerRadius="12"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1">
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="مسح التصفية"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                Padding="12,6"
                                FontSize="12"
                                Command="{Binding ClearDamagedFiltersCommand}" />

                        <ComboBox Grid.Column="2"
                                  Style="{StaticResource PosComboBoxStyle}"
                                  MinHeight="34"
                                  ItemsSource="{Binding SettlementFilters}"
                                  SelectedItem="{Binding SelectedSettlementFilter, Mode=TwoWay}" />

                        <Grid Grid.Column="4">
                            <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                     MinHeight="34"
                                     Padding="10,5,30,5"
                                     FlowDirection="RightToLeft"
                                     TextAlignment="Left"
                                     Text="{Binding DamagedSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="ابحث في مخزون الهالك بالمنتج أو الباركود أو رقم ID أو المورد أو السبب..."
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="30,0,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding DamagedSearchText, Converter={StaticResource StringEmptyToVis}}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Damaged Stock Table -->
                <Border Grid.Row="1" CornerRadius="14" Background="White" BorderBrush="#FECACA" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Column Headers -->
                        <Border Grid.Row="0"
                                Padding="10,9,24,9"
                                CornerRadius="13,13,0,0"
                                Background="#FEF2F2"
                                BorderBrush="#FECACA"
                                BorderThickness="0,0,0,1">
                            <Grid FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" MinWidth="140" />
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="195" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#7F1D1D" />
                                <TextBlock Grid.Column="1" Text="اسم المنتج / الباركود" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#7F1D1D" />
                                <TextBlock Grid.Column="2" Text="المورد / الفاتورة" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#7F1D1D" />
                                <TextBlock Grid.Column="3" Text="التكلفة" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#7F1D1D" />
                                <TextBlock Grid.Column="4" Text="سبب الإهلاك" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#7F1D1D" />
                                <TextBlock Grid.Column="5" Text="تاريخ الإهلاك" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#7F1D1D" />
                                <TextBlock Grid.Column="6" Text="التسوية" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#7F1D1D" />
                                <TextBlock Grid.Column="7" Text="إجراءات الهالك" Style="{StaticResource PosCenterTextStyle}" FontSize="12" FontWeight="Bold" Foreground="#7F1D1D" />
                            </Grid>
                        </Border>

                        <!-- Rows -->
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          FlowDirection="LeftToRight">
                                <ItemsControl ItemsSource="{Binding FilteredDamagedUnits}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8"
                                                    Background="White"
                                                    BorderBrush="#FEE2E2"
                                                    BorderThickness="0,0,0,1">
                                                <Grid FlowDirection="RightToLeft">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="*" MinWidth="140" />
                                                        <ColumnDefinition Width="118" />
                                                        <ColumnDefinition Width="82" />
                                                        <ColumnDefinition Width="135" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="195" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding IdDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Consolas, Segoe UI"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="#991B1B" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                                        <TextBlock Text="{Binding ProductName}"
                                                                   Style="{StaticResource PosRtlTextStyle}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ProductBarcode}"
                                                                   Style="{StaticResource PosLtrTextStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   FontFamily="Consolas, Segoe UI"
                                                                   FontSize="11"
                                                                   Foreground="#64748B" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0">
                                                        <TextBlock Text="{Binding SupplierName}"
                                                                   Style="{StaticResource PosRtlTextStyle}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#0369A1"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding PurchaseInvoiceId}"
                                                                   Style="{StaticResource PosLtrTextStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   FontFamily="Consolas, Segoe UI"
                                                                   FontSize="11"
                                                                   Foreground="#64748B" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding PurchasePriceDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold" />

                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding DamageReason}"
                                                               Style="{StaticResource PosRtlTextStyle}"
                                                               Margin="4,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="#475569"
                                                               TextWrapping="Wrap" />

                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding DamagedAtDisplay}"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FlowDirection="LeftToRight"
                                                               VerticalAlignment="Center"
                                                               FontSize="11.5"
                                                               Foreground="#64748B" />

                                                    <Border Grid.Column="6"
                                                            Padding="6,3"
                                                            CornerRadius="6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#FEF3C7" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsReturnedToSupplier}" Value="True">
                                                                        <Setter Property="Background" Value="#E0F2FE" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding DamageSettlementStatus}" FontSize="11" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                                    <Setter Property="Foreground" Value="#92400E" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsReturnedToSupplier}" Value="True">
                                                                            <Setter Property="Foreground" Value="#0369A1" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- Damaged Item Controls -->
                                                    <StackPanel Grid.Column="7"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FlowDirection="RightToLeft">
                                                        <Button Content="استرجاع للمتاح"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="#F0FDFA"
                                                                Foreground="#0F766E"
                                                                BorderBrush="#147D92"
                                                                Command="{Binding DataContext.RestoreDamagedUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="مرتجع"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="#E0F2FE"
                                                                Foreground="#0369A1"
                                                                BorderBrush="#BAE6FD"
                                                                ToolTip="تسجيل كمرتجع للمورد"
                                                                Visibility="{Binding CanMarkReturnedToSupplier, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.MarkReturnedToSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="حذف"
                                                                Style="{StaticResource InvActionBtnBaseStyle}"
                                                                Background="#FEF2F2"
                                                                Foreground="#B42318"
                                                                BorderBrush="#FECACA"
                                                                Command="{Binding DataContext.DeleteDamagedUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="لا توجد أصناف في مخزون الهالك حاليًا."
                                       Style="{StaticResource PosCenterTextStyle}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="15"
                                       Foreground="#94A3B8"
                                       Visibility="{Binding HasNoDamagedResults, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ROW 4: Status Feedback Strip -->
        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                BorderThickness="1"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F0FDFA" />
                    <Setter Property="BorderBrush" Value="#99F6E4" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="#0F766E" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="#B42318" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
