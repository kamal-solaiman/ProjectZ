<Window x:Class="ProjectZ.Views.InvoicePrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:security="clr-namespace:ProjectZ.Helpers"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | طباعة فاتورة المبيعات'}"
        Width="520"
        Height="760"
        MinWidth="440"
        MinHeight="560"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProjectZ;component/Resources/PrintIsolation.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="16,12" CornerRadius="14" Background="#102E48">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="10,5" CornerRadius="8" Background="#1E3A5F" VerticalAlignment="Center">
                    <TextBlock Text="فاتورة 80 مم" Style="{StaticResource PosCenterTextStyle}"
                               FontSize="12" FontWeight="Bold" Foreground="#BAE6FD" />
                </Border>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="طباعة فاتورة المبيعات"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="16.5" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding InvoiceNumberDisplay}"
                               Style="{StaticResource PosLtrTextStyle}"
                               HorizontalAlignment="Right"
                               Margin="0,3,0,0"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="13" FontWeight="Bold" Foreground="#BAE6FD" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Paper size note -->
        <TextBlock Grid.Row="1"
                   Text="ورق حراري 80 مم · أبيض وأسود · يحتفظ ارتفاع الصفحة بآخر سطر ليقطعها الجهاز عنده"
                   Style="{StaticResource PosRtlTextStyle}"
                   HorizontalAlignment="Right"
                   Margin="2,0,2,8"
                   FontSize="11.5"
                   TextWrapping="Wrap"
                   Foreground="#475569" />

        <!-- Classic paper preview -->
        <Border Grid.Row="2"
                Padding="14"
                CornerRadius="12"
                Background="#E2E8F0"
                BorderBrush="#CBD5E1"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding PaperPreview}" HorizontalAlignment="Center" VerticalAlignment="Top" />
            </ScrollViewer>
        </Border>

        <!-- Copies -->
        <Grid Grid.Row="3" Margin="0,10,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource PosNumericTextBoxStyle}"
                     TextAlignment="Center"
                     Text="{Binding CopiesText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Column="2"
                       Text="عدد النسخ المطلوب طباعتها:"
                       Style="{StaticResource PosRtlTextStyle}"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       FontWeight="SemiBold" />
        </Grid>

        <!-- Status -->
        <Border Grid.Row="4"
                Margin="0,8,0,0"
                Padding="10,7"
                CornerRadius="8"
                BorderThickness="1"
                Background="#ECFDF5"
                BorderBrush="#A7F3D0"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Foreground" Value="#065F46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="#B42318" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="5" Margin="0,10,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إغلاق"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="16,9"
                    IsCancel="True"
                    Command="{Binding CloseCommand}" />

            <Button Grid.Column="2"
                    Content="طباعة الفاتورة"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    MinWidth="180"
                    Padding="18,9"
                    IsDefault="True"
                    Command="{Binding PrintCommand}"  security:PermissionVisibility.Code="SALES_INVOICES.PRINT" />
        </Grid>
    </Grid>
</Window>
