<Window x:Class="ProjectZ.Views.EditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | تعديل بيانات المنتج'}"
        Width="720"
        Height="680"
        MinWidth="600"
        MinHeight="560"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid FlowDirection="LeftToRight">
        <ContentControl Style="{StaticResource ThemeBackdropStyle}" />
    <Grid Margin="20" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navy Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="16,13"
                CornerRadius="14"
                Background="{DynamicResource Theme.Legacy.102E48.Navigation}"
                FlowDirection="LeftToRight">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="تعديل بيانات المنتج والأسعار"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                <TextBlock Text="تعديل سريع متزامن مع المخزون ونقطة البيع"
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="0,3,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
            </StackPanel>
        </Border>

        <!-- Form Card -->
        <Border Grid.Row="1"
                Padding="18"
                CornerRadius="14"
                Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <!-- Product Name -->
                    <TextBlock Text="اسم الصنف / المنتج *"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,5"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="EditNameInput"
                             Style="{StaticResource PosCompactTextBoxStyle}"
                             Margin="0,0,0,10"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="160" />

                    <!-- Barcode + Category + Unit -->
                    <Grid Margin="0,0,0,12" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الوحدة" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,5" FontSize="12.5" FontWeight="SemiBold" />
                            <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                      MinHeight="36"
                                      ItemsSource="{Binding Units}"
                                      SelectedItem="{Binding SelectedUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="التصنيف *" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,5" FontSize="12.5" FontWeight="SemiBold" />
                            <ComboBox Style="{StaticResource PosComboBoxStyle}"
                                      MinHeight="36"
                                      ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="الباركود *" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,5" FontSize="12.5" FontWeight="SemiBold" />
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="توليد"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Padding="10,7"
                                        FontSize="12"
                                        Command="{Binding GenerateBarcodeCommand}" />
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource PosNumericTextBoxStyle}"
                                         MinHeight="36"
                                         FontFamily="Consolas, Segoe UI"
                                         Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="64" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Pricing Section -->
                    <Border Margin="0,0,0,12" Padding="12" CornerRadius="12" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,10" FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="تقدير الجملة والمميز من القطاعي"
                                        Style="{StaticResource PosOutlineTealButtonStyle}"
                                        Padding="10,5"
                                        FontSize="11.5"
                                        Command="{Binding EstimatePricesCommand}" />

                                <TextBlock Grid.Column="1"
                                           Text="الأسعار والتكلفة (قطاعي · جملة · مميز)"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                            </Grid>

                            <Grid Margin="0,0,0,10" FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="حد التنبيه للنقص" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,4" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBox Style="{StaticResource PosNumericTextBoxStyle}" MinHeight="34" Text="{Binding MinStockAlertText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="سعر الشراء / التكلفة (ج.م)" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,4" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBox Style="{StaticResource PosNumericTextBoxStyle}" MinHeight="34" Text="{Binding CostPriceText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <!-- 3 Price Cards (RTL: Retail -> Wholesale -> Special) -->
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Retail (Right) -->
                                <Border Grid.Column="4" Padding="10" CornerRadius="10" Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}" BorderBrush="{DynamicResource Theme.Legacy.147D92.Accent}" BorderThickness="1.5">
                                    <StackPanel>
                                        <TextBlock Text="سعر قطاعي *" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.147D92.AccentInk}" Margin="0,0,0,5" />
                                        <TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding RetailPriceText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding RetailMarginText}" Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold" Visibility="{Binding HasCostPrice, Converter={StaticResource BoolToVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRetailMarginNegative}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Wholesale (Center) -->
                                <Border Grid.Column="2" Padding="10" CornerRadius="10" Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.102E48.Border}" BorderThickness="1.5">
                                    <StackPanel>
                                        <TextBlock Text="سعر جملة *" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" Margin="0,0,0,5" />
                                        <TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding WholesalePriceText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding WholesaleMarginText}" Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold" Visibility="{Binding HasCostPrice, Converter={StaticResource BoolToVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWholesaleMarginNegative}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Special (Left) -->
                                <Border Grid.Column="0" Padding="10" CornerRadius="10" Background="{DynamicResource Theme.Legacy.FAF5FF.Surface}" BorderBrush="{DynamicResource Theme.Legacy.6D28D9.VioletBorder}" BorderThickness="1.5">
                                    <StackPanel>
                                        <TextBlock Text="سعر مميز *" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" Margin="0,0,0,5" />
                                        <TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding SpecialPriceText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding SpecialMarginText}" Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold" Visibility="{Binding HasCostPrice, Converter={StaticResource BoolToVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSpecialMarginNegative}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Margin="0,8,0,0" Padding="8,5" CornerRadius="8" Background="{DynamicResource Theme.Legacy.FFFBEB.WarningSoft}" BorderBrush="{DynamicResource Theme.Legacy.F59E0B.WarningBorder}" BorderThickness="1"
                                    Visibility="{Binding HasPriceOrderWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ملاحظة تسعير: يُفضّل أن يكون سعر القطاعي أكبر من سعر الجملة، والسعر المميز أقل من سعر الجملة."
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.Legacy.92400E.WarningInk}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CheckBoxes & Notes -->
                    <WrapPanel Margin="0,0,0,10" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                        <CheckBox Margin="0,0,18,4" Style="{StaticResource PosCheckBoxStyle}" IsChecked="{Binding IsActiveForSale, Mode=TwoWay}">
                            <TextBlock Text="متاح للبيع في نقطة البيع" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="SemiBold" />
                        </CheckBox>
                        <CheckBox Margin="0,0,0,4" Style="{StaticResource PosCheckBoxStyle}" IsChecked="{Binding TrackSerialNumber, Mode=TwoWay}">
                            <TextBlock Text="تتبع السيريال / IMEI" Style="{StaticResource PosRtlTextStyle}" FontSize="13" FontWeight="SemiBold" />
                        </CheckBox>
                    </WrapPanel>

                    <TextBlock Text="ملاحظات إضافية" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,4" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Height="52"
                             MaxLength="300" />

                    <TextBlock Text="{Binding Error}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,8,0,0"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}"
                               TextWrapping="Wrap"
                               Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Actions Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إلغاء"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="16,9"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="2"
                    Content="حفظ التعديلات"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    MinWidth="180"
                    Padding="20,9"
                    IsDefault="True"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
