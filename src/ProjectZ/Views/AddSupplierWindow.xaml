<Window x:Class="ProjectZ.Views.AddSupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        Width="580"
        Height="790"
        MinWidth="460"
        MinHeight="540"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Title>
        <MultiBinding StringFormat="{}{0} — {1}">
            <Binding Path="Name" Source="{StaticResource StoreIdentity}" Mode="OneWay" />
            <Binding Path="WindowTitle" Mode="OneWay" />
        </MultiBinding>
    </Window.Title>

    <Grid FlowDirection="LeftToRight">
        <ContentControl Style="{StaticResource ThemeBackdropStyle}" />
    <Grid Margin="20" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navy Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="18,14"
                CornerRadius="16"
                Background="{DynamicResource Theme.Legacy.102E48.Navigation}"
                FlowDirection="LeftToRight">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        FlowDirection="RightToLeft">
                <Border Width="44"
                        Height="44"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Legacy.1D455F.Navigation}">
                    <Path Data="M4,6 H20 V8 H4 Z M4,10 H20 L21,15 H19 V20 H5 V15 H3 Z M7,15 V18 H17 V15 Z"
                          Fill="{DynamicResource Theme.Legacy.6EE7D8.Highlight}"
                          Stretch="Uniform"
                          Width="22"
                          Height="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                    <TextBlock Text="{Binding HeaderSubtitle}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Theme.Legacy.B7CFDD.Text}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Card -->
        <Border Grid.Row="1"
                Padding="20"
                CornerRadius="16"
                Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          FlowDirection="LeftToRight">
                <StackPanel Margin="0,0,4,0" FlowDirection="LeftToRight">
                    <Border Margin="0,0,0,14"
                            Padding="10,8"
                            CornerRadius="8"
                            Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}"
                            BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding BannerHintText}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Name -->
                    <TextBlock Text="اسم المورد *"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,6"
                               FontSize="13.5"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="SupplierNameInput"
                             Style="{StaticResource PosCompactTextBoxStyle}"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="120" />

                    <!-- Phones Row -->
                    <Grid Margin="0,12,0,0" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="هاتف بديل / واتساب"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,0,0,6"
                                       FontSize="13.5"
                                       FontWeight="SemiBold" />
                            <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                     Text="{Binding SecondaryPhone, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="25" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="رقم الهاتف *"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,0,0,6"
                                       FontSize="13.5"
                                       FontWeight="SemiBold" />
                            <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="25" />
                        </StackPanel>
                    </Grid>

                    <!-- Company Name -->
                    <TextBlock Text="اسم الشركة / المكتب التجاري"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,12,0,6"
                               FontSize="13.5"
                               FontWeight="SemiBold" />
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="140" />

                    <!-- Specialization -->
                    <TextBlock Text="التخصص / مجال التوريد"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,12,0,6"
                               FontSize="13.5"
                               FontWeight="SemiBold" />
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             ToolTip="مثال: هواتف، إكسسوارات، قطع غيار"
                             Text="{Binding Specialization, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="120" />

                    <!-- Address -->
                    <TextBlock Text="العنوان"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,12,0,6"
                               FontSize="13.5"
                               FontWeight="SemiBold" />
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="200" />

                    <!-- Transfer details -->
                    <Border Margin="0,16,0,0" Padding="12" CornerRadius="10" Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="بيانات التحويل للمورد" Style="{StaticResource PosRtlTextStyle}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                            <TextBlock Text="تظهر هذه البيانات في ملف المورد لتسهيل السداد ومراجعته." Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" Margin="0,2,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="عنوان إنستاباي" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,5" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}" FlowDirection="LeftToRight" Text="{Binding InstaPayAddress, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="رقم فودافون كاش" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,5" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding VodafoneCashNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="25" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <TextBlock Text="ملاحظات وشروط التوريد"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,12,0,6"
                               FontSize="13.5"
                               FontWeight="SemiBold" />
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Height="62"
                             MaxLength="300" />

                    <!-- Inline Error -->
                    <TextBlock Text="{Binding Error}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,10,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}"
                               TextWrapping="Wrap"
                               Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Actions Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إلغاء"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="18,10"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="2"
                    Content="{Binding SaveButtonText}"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    MinWidth="200"
                    Padding="20,10"
                    IsDefault="True"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
