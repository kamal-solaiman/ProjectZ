<Window x:Class="ProjectZ.Views.SupplyStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | توريد كمية للمخزون'}"
        Width="520"
        Height="530"
        MinWidth="450"
        MinHeight="460"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid FlowDirection="LeftToRight">
        <ContentControl Style="{StaticResource ThemeBackdropStyle}" />
    <Grid Margin="20" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navy Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="16,13"
                CornerRadius="14"
                Background="{DynamicResource Theme.Legacy.102E48.Navigation}"
                FlowDirection="LeftToRight">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="توريد كمية جديدة للمخزون"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                <TextBlock Text="{Binding Product.Name}"
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="0,4,0,0"
                           FontSize="12.5"
                           Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Form Card -->
        <Border Grid.Row="1"
                Padding="18"
                CornerRadius="14"
                Background="{DynamicResource Theme.Legacy.FFFFFF.Surface}"
                BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Quantity + Purchase Price -->
                    <Grid Margin="0,0,0,12" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="سعر الشراء للقطعة (ج.م)"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,0,0,5"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                     Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الكمية الموردة *"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,0,0,5"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBox x:Name="QuantityInput"
                                     Style="{StaticResource PosNumericTextBoxStyle}"
                                     Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Supplier Name -->
                    <TextBlock Text="اسم المورد *"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,5"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                             FlowDirection="RightToLeft"
                             TextAlignment="Left"
                             Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="120" />

                    <!-- Quick Supplier Chips -->
                    <TextBlock Text="اختيار سريع للمورد (dbo.Suppliers):"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,8,0,4"
                               FontSize="11.5"
                               Foreground="{DynamicResource Theme.Legacy.64748B.Muted}" />
                    <ItemsControl ItemsSource="{Binding SuggestedSuppliers}" FlowDirection="RightToLeft" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Margin="0,2,6,2"
                                        Padding="10,4"
                                        FontSize="11.5"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Command="{Binding DataContext.PickSupplierCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Purchase Invoice ID -->
                    <TextBlock Text="ID فاتورة الشراء (اختياري)"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,5"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                             FontFamily="Consolas, Segoe UI"
                             Text="{Binding InvoiceId, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="40" />

                    <!-- Preview Summary Box -->
                    <Border Margin="0,12,0,0"
                            Padding="10,8"
                            CornerRadius="8"
                            Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}"
                            BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding PreviewSummary}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Inline Error -->
                    <TextBlock Text="{Binding Error}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,8,0,0"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}"
                               TextWrapping="Wrap"
                               Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Actions Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إلغاء"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="16,9"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="2"
                    Content="تأكيد توريد الكمية"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    MinWidth="180"
                    Padding="20,9"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
