<Window x:Class="ProjectZ.Views.PaySupplierInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | سداد دفعة آجل للمورد'}"
        Width="580"
        Height="590"
        MinWidth="520"
        MinHeight="500"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid FlowDirection="LeftToRight">
        <ContentControl Style="{StaticResource ThemeBackdropStyle}" />
    <Grid Margin="18" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16,12"
                CornerRadius="14"
                Background="{DynamicResource Theme.Legacy.102E48.Navigation}">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="12,6" CornerRadius="8" Background="{DynamicResource Theme.Legacy.B42318.Danger}" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="المتبقي آجل للمورد" Style="{StaticResource PosCenterTextStyle}" FontSize="10.5" Foreground="{DynamicResource Theme.Legacy.FECACA.DangerInk}" />
                        <TextBlock Text="{Binding OriginalRemainingDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnDanger}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="سداد دفعة من الآجل للمورد"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Legacy.FFFFFF.OnNavigation}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Invoice.InvoiceNumber}" Style="{StaticResource PosLtrTextStyle}" FontFamily="Consolas, Segoe UI" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6EE7D8.Highlight}" />
                        <TextBlock Text=" · " Style="{StaticResource PosCenterTextStyle}" Foreground="{DynamicResource Theme.Legacy.B7CFDD.Text}" />
                        <TextBlock Text="{Binding Invoice.SupplierName}" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" Foreground="{DynamicResource Theme.Legacy.DCE8EE.NavigationMuted}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Quick Fill Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            FlowDirection="RightToLeft"
                            Margin="0,0,0,10">
                    <Button Content="سداد كامل كاش"
                            Style="{StaticResource PosSecondaryButtonStyle}"
                            Padding="10,6"
                            FontSize="11.5"
                            Command="{Binding FillCashRemainingCommand}" />
                    <Button Content="سداد كامل فودافون كاش"
                            Margin="6,0,0,0"
                            Style="{StaticResource PosSecondaryButtonStyle}"
                            Padding="10,6"
                            FontSize="11.5"
                            Command="{Binding FillVodafoneRemainingCommand}" />
                    <Button Content="سداد كامل إنستاباي"
                            Margin="6,0,0,0"
                            Style="{StaticResource PosSecondaryButtonStyle}"
                            Padding="10,6"
                            FontSize="11.5"
                            Command="{Binding FillInstaPayRemainingCommand}" />
                </StackPanel>

                <!-- Cash -->
                <Border Margin="0,0,0,8" Padding="12" CornerRadius="10" Background="{DynamicResource Theme.Legacy.F8FAFC.Surface}" BorderBrush="{DynamicResource Theme.Legacy.E2E8F0.Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="المدفوع كاش (نقدي)" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,5" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                        <TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding CashAmountText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!-- Vodafone Cash -->
                <Border Margin="0,0,0,8" Padding="12" CornerRadius="10" Background="{DynamicResource Theme.Legacy.FFF5F5.Surface}" BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}" BorderThickness="1">
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="فودافون كاش" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,5" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.C8102E.DangerInk}" />
                            <TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding VodafoneCashAmountText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- InstaPay -->
                <Border Margin="0,0,0,8" Padding="12" CornerRadius="10" Background="{DynamicResource Theme.Legacy.F5F3FF.InfoSoft}" BorderBrush="{DynamicResource Theme.Legacy.DDD6FE.InfoBorder}" BorderThickness="1">
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="إنستاباي (InstaPay)" Style="{StaticResource PosRtlTextStyle}" Margin="0,0,0,5" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.6D28D9.VioletInk}" />
                            <TextBox Style="{StaticResource PosNumericTextBoxStyle}" Text="{Binding InstaPayAmountText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Note -->
                <TextBlock Text="ملاحظة السداد (اختياري)" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,4" FontSize="12.5" FontWeight="SemiBold" />
                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                         Margin="0,0,0,10"
                         FlowDirection="RightToLeft"
                         TextAlignment="Left"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Summary Box -->
                <Border Padding="12" CornerRadius="10" Background="{DynamicResource Theme.Legacy.F0FDFA.AccentSoft}" BorderBrush="{DynamicResource Theme.Legacy.99F6E4.Border}" BorderThickness="1">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="إجمالي المدفوع الآن" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                            <TextBlock Text="{Binding TotalPayNowDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.0F766E.SuccessInk}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="المتبقي بعد السداد" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" Foreground="{DynamicResource Theme.Legacy.475569.Muted}" />
                            <TextBlock Text="{Binding RemainingAfterPaymentDisplay}" Style="{StaticResource PosRtlTextStyle}" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Legacy.102E48.Text}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Error -->
        <Border Grid.Row="2"
                Margin="0,8,0,8"
                Padding="10,7"
                CornerRadius="8"
                Background="{DynamicResource Theme.Legacy.FEF2F2.DangerSoft}"
                BorderBrush="{DynamicResource Theme.Legacy.FECACA.DangerBorder}"
                BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource PosRtlTextStyle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Legacy.B42318.DangerInk}" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إلغاء"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="14,9"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="2"
                    Content="تأكيد سداد الدفعة للمورد"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    MinWidth="190"
                    Padding="18,9"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
