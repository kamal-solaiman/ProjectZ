<UserControl x:Class="ProjectZ.Views.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Language="ar-EG">

    <UserControl.Resources>
        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#102E48" />
        </Style>
        <Style x:Key="SettingsFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsHint" TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid FlowDirection="LeftToRight" Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: actions on the physical left, Arabic title and state on the right. -->
        <Grid Grid.Row="0" Margin="0,0,0,12" FlowDirection="LeftToRight">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title and state stay on one line; at the 960 px minimum they still fit beside the
                 sidebar. The two actions move to their own row instead of colliding with the badges. -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft">
                <TextBlock Text="اعدادات عامة"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#102E48"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        Background="#FFFBEB"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="تغييرات غير محفوظة"
                               Style="{StaticResource PosCenterTextStyle}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#B45309" />
                </Border>
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#DCFCE7" />
                            <Setter Property="BorderBrush" Value="#BBF7D0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDatabaseBacked}" Value="False">
                                    <Setter Property="Background" Value="#FEF3C7" />
                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ConnectionBadgeText}"
                               FontSize="11.5"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                <Setter Property="Foreground" Value="#15803D" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDatabaseBacked}" Value="False">
                                        <Setter Property="Foreground" Value="#B45309" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        FlowDirection="LeftToRight">
                <Button Content="تحديث من القاعدة"
                        Style="{StaticResource PosOutlineTealButtonStyle}"
                        Padding="12,7"
                        FontSize="12.5"
                        Command="{Binding ReloadCommand}" />
                <Button Content="القيم الافتراضية"
                        Margin="8,0,0,0"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Padding="12,7"
                        FontSize="12.5"
                        Command="{Binding ResetDefaultsCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      FlowDirection="LeftToRight">
            <Grid Margin="0,0,4,0" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <!-- Proportional columns: at the 960 px minimum the form still gets most of the
                         width instead of collapsing behind a fixed 380 px preview. -->
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Form -->
                <Border Grid.Column="0"
                        Padding="18"
                        CornerRadius="14"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        FlowDirection="LeftToRight">
                    <StackPanel FlowDirection="LeftToRight">
                        <TextBlock Text="هوية المحل" Style="{StaticResource SettingsSectionTitle}" />
                        <TextBlock Text="اسم المحل هو اسم البرنامج: عند حفظه يتغير فورًا في القوائم والنوافذ وشاشة الدخول وكل المطبوعات."
                                   Style="{StaticResource SettingsHint}"
                                   Margin="0,4,0,12" />

                        <Border Padding="12,9" CornerRadius="9" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1">
                            <TextBlock Text="{Binding StoreNameHint}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="11.5"
                                       Foreground="#0F766E"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,14,0,0" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اسم المحل / اسم البرنامج *" Style="{StaticResource SettingsFieldLabel}" />
                                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                         FlowDirection="RightToLeft"
                                         MaxLength="60"
                                         Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="اسم المحل" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="وصف مختصر" Style="{StaticResource SettingsFieldLabel}" />
                                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                         FlowDirection="RightToLeft"
                                         MaxLength="80"
                                         Text="{Binding Tagline, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="وصف المحل المختصر" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="العنوان" Style="{StaticResource SettingsFieldLabel}" Margin="0,12,0,6" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="RightToLeft"
                                 MaxLength="200"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="عنوان المحل" />

                        <Grid Margin="0,12,0,0" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="هاتف المحل" Style="{StaticResource SettingsFieldLabel}" />
                                <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                         MinHeight="36"
                                         MaxLength="30"
                                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="هاتف المحل" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="هاتف إضافي" Style="{StaticResource SettingsFieldLabel}" />
                                <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                         MinHeight="36"
                                         MaxLength="30"
                                         Text="{Binding PhoneAlt, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="هاتف إضافي" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="البريد الإلكتروني (اختياري)" Style="{StaticResource SettingsFieldLabel}" Margin="0,12,0,6" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Left"
                                 MaxLength="150"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="البريد الإلكتروني" />

                        <TextBlock Text="اسم قسم الصيانة (في إيصال الاستلام)" Style="{StaticResource SettingsFieldLabel}" Margin="0,12,0,6" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="RightToLeft"
                                 MaxLength="100"
                                 Text="{Binding ServiceCenterName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="اسم قسم الصيانة" />

                        <Border Margin="0,18,0,0" Height="1" Background="#E2E8F0" />
                        <TextBlock Text="الإعدادات العامة" Style="{StaticResource SettingsSectionTitle}" Margin="0,14,0,4" />
                        <TextBlock Text="قيم مشتركة يستخدمها البرنامج في الطباعة وإدخال الأصناف."
                                   Style="{StaticResource SettingsHint}"
                                   Margin="0,0,0,12" />

                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="رمز العملة" Style="{StaticResource SettingsFieldLabel}" />
                                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                         FlowDirection="RightToLeft"
                                         MaxLength="10"
                                         Text="{Binding CurrencyLabel, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="رمز العملة" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="كود العملة (ISO)" Style="{StaticResource SettingsFieldLabel}" />
                                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                         FlowDirection="LeftToRight"
                                         TextAlignment="Left"
                                         MaxLength="10"
                                         Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="كود العملة" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="حد التنبيه الافتراضي للمخزون" Style="{StaticResource SettingsFieldLabel}" Margin="0,12,0,6" />
                        <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                 MinHeight="36"
                                 MaxLength="6"
                                 Text="{Binding LowStockAlertText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="قيمة مبدئية لصنف جديد فقط؛ لا تغيّر حد الأصناف المسجلة بالفعل."
                                 AutomationProperties.Name="حد التنبيه الافتراضي" />

                        <TextBlock Text="عبارة أسفل الفاتورة والإيصال" Style="{StaticResource SettingsFieldLabel}" Margin="0,12,0,6" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="RightToLeft"
                                 MaxLength="200"
                                 Text="{Binding FooterNote, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="عبارة أسفل الفاتورة" />

                        <Button Content="حفظ الإعدادات"
                                Style="{StaticResource PosPrimaryCompactButtonStyle}"
                                Margin="0,18,0,0"
                                Padding="22,10"
                                HorizontalAlignment="Right"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Grid.Column="2"
                        Padding="14"
                        CornerRadius="14"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        VerticalAlignment="Top"
                        FlowDirection="LeftToRight">
                    <StackPanel FlowDirection="LeftToRight">
                        <TextBlock Text="معاينة مباشرة" Style="{StaticResource SettingsSectionTitle}" />
                        <TextBlock Text="الاسم كما سيظهر في شريط القائمة ورأس الفاتورة."
                                   Style="{StaticResource SettingsHint}"
                                   Margin="0,3,0,10" />

                        <Border Padding="11,9" CornerRadius="10" Background="#102E48">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <Border Width="28" Height="28" CornerRadius="7" Background="#1D455F" VerticalAlignment="Center">
                                    <TextBlock Text="&#x1F6D2;"
                                               FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding PreviewTitle}"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12,10"
                                CornerRadius="10"
                                Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1">
                            <StackPanel FlowDirection="RightToLeft">
                                <TextBlock Text="{Binding PreviewHeadline}"
                                           Style="{StaticResource PosCenterTextStyle}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PreviewContactLine}"
                                           Style="{StaticResource PosCenterTextStyle}"
                                           Margin="0,3,0,0"
                                           FontSize="10.5"
                                           Foreground="#475569"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasPreviewContactLine, Converter={StaticResource BoolToVis}}" />
                                <Border Margin="0,7,0,7" Height="1" Background="#E2E8F0" />
                                <Grid FlowDirection="RightToLeft">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="إجمالي الفاتورة"
                                               Style="{StaticResource PosRtlTextStyle}"
                                               FontSize="11"
                                               Foreground="#475569" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PreviewAmount}"
                                               Style="{StaticResource PosLtrTextStyle}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#0F172A" />
                                </Grid>
                                <TextBlock Text="{Binding PreviewServiceCenter}"
                                           Style="{StaticResource PosCenterTextStyle}"
                                           Margin="0,7,0,0"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="#0F766E"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PreviewFooter}"
                                           Style="{StaticResource PosCenterTextStyle}"
                                           Margin="0,4,0,0"
                                           FontSize="10"
                                           Foreground="#64748B"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8"
                                Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1">
                            <TextBlock Text="المظهر والنسخ الاحتياطي شاشتان مستقلتان؛ هذه الشاشة لا تغيّر شكل الواجهة ولا تنفّذ نسخًا."
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="10.5"
                                       Foreground="#B45309"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Status strip -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                FlowDirection="LeftToRight"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="#065F46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="#B42318" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
