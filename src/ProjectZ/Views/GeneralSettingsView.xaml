<UserControl x:Class="ProjectZ.Views.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Language="ar-EG">

    <Grid FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: header -->
        <Grid Grid.Row="0" Margin="0,0,0,12" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                <Button Content="تحديث من القاعدة"
                        Style="{StaticResource PosOutlineTealButtonStyle}"
                        Padding="12,7"
                        FontSize="12.5"
                        Command="{Binding ReloadCommand}" />
                <Button Content="القيم الافتراضية"
                        Margin="8,0,0,0"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Padding="12,7"
                        FontSize="12.5"
                        Command="{Binding ResetDefaultsCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft">
                <TextBlock Text="اعدادات عامة"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#102E48"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        Background="#FFFBEB"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="تغييرات غير محفوظة"
                               Style="{StaticResource PosCenterTextStyle}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#B45309" />
                </Border>
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#DCFCE7" />
                            <Setter Property="BorderBrush" Value="#BBF7D0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDatabaseBacked}" Value="False">
                                    <Setter Property="Background" Value="#FEF3C7" />
                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ConnectionBadgeText}"
                               FontSize="11.5"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                <Setter Property="Foreground" Value="#15803D" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDatabaseBacked}" Value="False">
                                        <Setter Property="Foreground" Value="#B45309" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ROW 1: the form and the live preview -->
        <Grid Grid.Row="1" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Form card -->
            <Border Grid.Column="0"
                    Padding="0"
                    CornerRadius="14"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    FlowDirection="LeftToRight">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              FlowDirection="LeftToRight">
                    <StackPanel Margin="18" FlowDirection="LeftToRight">

                        <!-- Store identity -->
                        <TextBlock Text="بيانات المحل"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#102E48" />
                        <TextBlock Text="اسم المحل هو اسم البرنامج: عند حفظه يتغير فورًا في القوائم والنوافذ وشاشة الدخول وكل المطبوعات."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,4,0,12"
                                   FontSize="11.5"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap" />

                        <Border Padding="12,9"
                                CornerRadius="9"
                                Background="#F0FDFA"
                                BorderBrush="#99F6E4"
                                BorderThickness="1">
                            <TextBlock Text="{Binding StoreNameHint}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="11.5"
                                       Foreground="#0F766E"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,14,0,0" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اسم المحل / اسم البرنامج *"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           Margin="0,0,0,6"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBox x:Name="StoreNameInput"
                                         Style="{StaticResource PosCompactTextBoxStyle}"
                                         FlowDirection="RightToLeft"
                                         TextAlignment="Left"
                                         MaxLength="60"
                                         Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="اسم المحل" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="وصف مختصر (يظهر بجوار الاسم)"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           Margin="0,0,0,6"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                         FlowDirection="RightToLeft"
                                         TextAlignment="Left"
                                         MaxLength="80"
                                         Text="{Binding Tagline, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="العنوان"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,12,0,6"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 MaxLength="200"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,12,0,0" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="هاتف المحل"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           Margin="0,0,0,6"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                         MinHeight="36"
                                         MaxLength="30"
                                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="هاتف إضافي"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           Margin="0,0,0,6"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                         MinHeight="36"
                                         MaxLength="30"
                                         Text="{Binding PhoneAlt, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="البريد الإلكتروني (اختياري)"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,12,0,6"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Left"
                                 MaxLength="150"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="اسم قسم الصيانة (يظهر في إيصال استلام الصيانة)"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,12,0,6"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 MaxLength="100"
                                 Text="{Binding ServiceCenterName, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- General defaults -->
                        <Border Margin="0,18,0,0"
                                Height="1"
                                Background="#E2E8F0" />

                        <TextBlock Text="الإعدادات العامة"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,14,0,4"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#102E48" />
                        <TextBlock Text="قيم مشتركة يستخدمها البرنامج في الطباعة وإدخال الأصناف."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,0,0,12"
                                   FontSize="11.5"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap" />

                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="رمز العملة في الشاشات"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           Margin="0,0,0,6"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                         FlowDirection="RightToLeft"
                                         TextAlignment="Left"
                                         MaxLength="10"
                                         Text="{Binding CurrencyLabel, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="كود العملة (ISO)"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           Margin="0,0,0,6"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                         FlowDirection="LeftToRight"
                                         TextAlignment="Left"
                                         MaxLength="10"
                                         Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="حد التنبيه الافتراضي للمخزون"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           Margin="0,0,0,6"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                                         MinHeight="36"
                                         MaxLength="6"
                                         Text="{Binding LowStockAlertText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="يُستخدم كقيمة مبدئية لصنف جديد؛ لا يغيّر حد الأصناف المسجلة بالفعل" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="عبارة أسفل الفاتورة والإيصال"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="0,12,0,6"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 MaxLength="200"
                                 Text="{Binding FooterNote, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="حفظ الإعدادات"
                                Style="{StaticResource PosPrimaryCompactButtonStyle}"
                                Margin="0,18,0,0"
                                Padding="22,10"
                                HorizontalAlignment="Left"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Live preview: exactly what the receipts will print -->
            <Border Grid.Column="2"
                    Padding="16"
                    CornerRadius="14"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    FlowDirection="LeftToRight"
                    VerticalAlignment="Top">
                <StackPanel FlowDirection="LeftToRight">
                    <TextBlock Text="معاينة مباشرة"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#102E48" />
                    <TextBlock Text="هكذا يظهر الاسم في شريط القائمة الجانبية ورأس الفاتورة."
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,3,0,12"
                               FontSize="11.5"
                               Foreground="#64748B"
                               TextWrapping="Wrap" />

                    <!-- Sidebar strip -->
                    <Border Padding="12,10"
                            CornerRadius="10"
                            Background="#102E48">
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                            <Border Width="30"
                                    Height="30"
                                    CornerRadius="8"
                                    Background="#1D455F"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#x1F6D2;"
                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding PreviewTitle}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FlowDirection="LeftToRight"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="White" />
                        </StackPanel>
                    </Border>

                    <!-- Receipt header -->
                    <Border Margin="0,10,0,0"
                            Padding="14,12"
                            CornerRadius="10"
                            Background="White"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1">
                        <StackPanel FlowDirection="RightToLeft">
                            <TextBlock Text="{Binding PreviewHeadline}"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PreviewContactLine}"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       Margin="0,3,0,0"
                                       FontSize="10.5"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasPreviewContactLine, Converter={StaticResource BoolToVis}}" />
                            <Border Margin="0,8,0,8"
                                    Height="1"
                                    Background="#E2E8F0" />
                            <Grid FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="إجمالي الفاتورة"
                                           Style="{StaticResource PosRtlTextStyle}"
                                           FontSize="11.5"
                                           Foreground="#475569" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PreviewAmount}"
                                           Style="{StaticResource PosLtrTextStyle}"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="#0F172A" />
                            </Grid>
                            <TextBlock Text="{Binding PreviewServiceCenter}"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       Margin="0,8,0,0"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="#0F766E" />
                            <TextBlock Text="{Binding PreviewFooter}"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       Margin="0,4,0,0"
                                       FontSize="10"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="10,8"
                            CornerRadius="8"
                            Background="#FFFBEB"
                            BorderBrush="#FDE68A"
                            BorderThickness="1">
                        <TextBlock Text="المظهر والنسخ الاحتياطي لهما شاشتان مستقلتان؛ لا تُدار من هنا."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   FontSize="11"
                                   Foreground="#B45309"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ROW 2: status strip -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                FlowDirection="LeftToRight"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="#065F46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="#B42318" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
