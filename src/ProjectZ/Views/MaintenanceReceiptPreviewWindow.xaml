<Window x:Class="ProjectZ.Views.MaintenanceReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:security="clr-namespace:ProjectZ.Helpers"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | طباعة مستندات الصيانة'}"
        Width="560"
        Height="780"
        MinWidth="460"
        MinHeight="560"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProjectZ;component/Resources/PrintIsolation.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="16,12" CornerRadius="14" Background="#102E48">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="10,5" CornerRadius="8" Background="#1E3A5F" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentModeLabel}"
                               Style="{StaticResource PosCenterTextStyle}"
                               FontSize="11.5" FontWeight="Bold" Foreground="#BAE6FD" />
                </Border>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="طباعة مستندات أمر الصيانة"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="16.5" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding Order.OrderNumber, StringFormat='أمر الصيانة رقم: {0}'}"
                               Style="{StaticResource PosLtrTextStyle}"
                               HorizontalAlignment="Right"
                               Margin="0,3,0,0"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="12.5" FontWeight="Bold" Foreground="#BAE6FD" />
                    <TextBlock Text="{Binding Order.CustomerName, StringFormat='العميل: {0}'}"
                               Style="{StaticResource PosRtlTextStyle}"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,0"
                               FontSize="11.5" Foreground="#BAE6FD" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mode Selector -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="0,0,0,8">
            <Button Content="إيصال استلام (80 مم)" Command="{Binding SelectCustomerReceiptModeCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                        <Setter Property="Padding" Value="12,6" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustomerReceiptMode}" Value="True">
                                <Setter Property="Background" Value="#102E48" />
                                <Setter Property="BorderBrush" Value="#102E48" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="فاتورة تسليم وضمان (80 مم)" Margin="6,0,0,0" Command="{Binding SelectDeliveryReceiptModeCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                        <Setter Property="Padding" Value="12,6" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDeliveryReceiptMode}" Value="True">
                                <Setter Property="Background" Value="#102E48" />
                                <Setter Property="BorderBrush" Value="#102E48" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="ملصق أمر الصيانة (50 × 25 مم)" Margin="6,0,0,0" Command="{Binding SelectDeviceStickerModeCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                        <Setter Property="Padding" Value="12,6" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDeviceStickerMode}" Value="True">
                                <Setter Property="Background" Value="#102E48" />
                                <Setter Property="BorderBrush" Value="#102E48" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </WrapPanel>

        <!-- Paper caption -->
        <TextBlock Grid.Row="2"
                   Text="{Binding PaperCaption}"
                   Style="{StaticResource PosRtlTextStyle}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="2,0,2,6"
                   FontSize="11.5"
                   TextWrapping="Wrap"
                   Foreground="#475569" />

        <!-- Classic paper preview -->
        <Border Grid.Row="3"
                Padding="14"
                CornerRadius="12"
                Background="#E2E8F0"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                MinHeight="240">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding PaperPreview}" HorizontalAlignment="Center" VerticalAlignment="Top" />
            </ScrollViewer>
        </Border>

        <!-- Copies -->
        <Grid Grid.Row="4" Margin="0,10,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource PosNumericTextBoxStyle}"
                     TextAlignment="Center"
                     Text="{Binding CopiesText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Column="2"
                       Text="عدد النسخ المطلوب طباعتها:"
                       Style="{StaticResource PosRtlTextStyle}"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       FontWeight="SemiBold" />
        </Grid>

        <!-- Print Status: green after a successful print, red when the printer or the data refused -->
        <Border Grid.Row="5"
                Margin="0,8,0,0"
                Padding="10,7"
                CornerRadius="8"
                Background="#ECFDF5"
                BorderBrush="#A7F3D0"
                BorderThickness="1"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Foreground" Value="#065F46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="#B42318" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="6" Margin="0,10,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إغلاق"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="14,9"
                    IsCancel="True"
                    Command="{Binding CloseCommand}" />

            <Button Grid.Column="2"
                    Content="{Binding PrintButtonLabel}"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    MinWidth="190"
                    Padding="18,9"
                    IsDefault="True"
                    ToolTip="{Binding PrintHint}"
                    Command="{Binding PrintCommand}"  security:PermissionVisibility.Code="MAINTENANCE.PRINT" />
        </Grid>
    </Grid>
</Window>
