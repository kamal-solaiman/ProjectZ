<Window x:Class="ProjectZ.Views.MaintenanceReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | معاينة وطباعة إيصال استلام الصيانة'}"
        Width="760"
        Height="740"
        MinWidth="600"
        MinHeight="560"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/ProjectZ;component/Resources/PrintIsolation.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>

    <Grid Margin="18" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="16,12" CornerRadius="14" Background="#102E48">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="10,5" CornerRadius="8" Background="#147D92" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentModeLabel}" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="White" />
                </Border>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="معاينة طباعة إيصال استلام الصيانة وملصق الجهاز"
                               Style="{StaticResource PosRtlTextStyle}"
                               FontSize="16.5"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="{Binding Order.OrderNumber, StringFormat='أمر الصيانة رقم: {0}'}"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="#6EE7D8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mode Switcher -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    FlowDirection="RightToLeft"
                    Margin="0,0,0,10">
            <Button Content="إيصال استلام للعميل (80 مم)" Command="{Binding SelectCustomerReceiptModeCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                        <Setter Property="Padding" Value="14,7" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustomerReceiptMode}" Value="True">
                                <Setter Property="Background" Value="#102E48" />
                                <Setter Property="BorderBrush" Value="#102E48" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="ملصق تذكرة الجهاز للفني (Sticker)" Margin="8,0,0,0" Command="{Binding SelectDeviceStickerModeCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                        <Setter Property="Padding" Value="14,7" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDeviceStickerMode}" Value="True">
                                <Setter Property="Background" Value="#147D92" />
                                <Setter Property="BorderBrush" Value="#147D92" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="إيصال التسليم والضمان (80 مم)" Margin="8,0,0,0" Command="{Binding SelectDeliveryReceiptModeCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                        <Setter Property="Padding" Value="14,7" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDeliveryReceiptMode}" Value="True">
                                <Setter Property="Background" Value="#0F766E" />
                                <Setter Property="BorderBrush" Value="#0F766E" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Paper Preview Canvas -->
        <Border Grid.Row="2" Padding="18" CornerRadius="12" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Top">

                    <!-- Mode 1: 80mm Customer Intake Receipt -->
                    <Border Width="345"
                            Padding="16"
                            Background="White"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding IsCustomerReceiptMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel FlowDirection="RightToLeft">
                            <TextBlock Text="{Binding ServiceCenterHeader, Source={StaticResource StoreIdentity}, Mode=OneWay}"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       FontSize="15.5"
                                       FontWeight="Bold"
                                       Foreground="#102E48" />
                            <TextBlock Text="{Binding ContactLine, Source={StaticResource StoreIdentity}, Mode=OneWay}"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       Margin="0,2,0,0"
                                       FontSize="9.5"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasContactLine, Source={StaticResource StoreIdentity}, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="إيصال استلام جهاز صيانة"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       Margin="0,2,0,6"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#0F766E" />

                            <Border Padding="8,5" Margin="0,0,0,8" Background="#F1F5F9" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Order.OrderNumber}"
                                               Style="{StaticResource PosCenterTextStyle}"
                                               FontFamily="Consolas, Segoe UI"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#102E48" />
                                    <TextBlock Text="{Binding Order.PriorityTitle}"
                                               Style="{StaticResource PosCenterTextStyle}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#B42318" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#CBD5E1" BorderThickness="0,1,0,1" Padding="0,6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Order.ReceivedFullDisplay, StringFormat='تاريخ الاستلام: {0}'}" Style="{StaticResource PosRtlTextStyle}" FontSize="11" />
                                    <TextBlock Text="{Binding Order.ReceivedByName, StringFormat='المستلم: {0}'}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="11" />
                                    <TextBlock Text="{Binding Order.CustomerName, StringFormat='العميل: {0}'}" Style="{StaticResource PosRtlTextStyle}" Margin="0,4,0,0" FontSize="11.5" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Order.CustomerPhoneDisplay, StringFormat='هاتف التواصل: {0}'}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="بيانات الجهاز والفحص:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#102E48" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding Order.DeviceFullTitle}" Style="{StaticResource PosRtlTextStyle}" FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="{Binding Order.SerialOrImeiDisplay, StringFormat='S/N / IMEI: {0}'}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10.5" Foreground="#475569" Visibility="{Binding Order.HasSerialOrImei, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Order.ReportedFault, StringFormat='العطل: {0}'}" Style="{StaticResource PosRtlTextStyle}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Order.PhysicalConditionDisplay, StringFormat='الحالة عند الاستلام: {0}'}" Style="{StaticResource PosRtlTextStyle}" Margin="0,3,0,0" FontSize="10.5" Foreground="#475569" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Order.AccessoriesDisplay, StringFormat='الملحقات: {0}'}" Style="{StaticResource PosRtlTextStyle}" Margin="0,3,0,0" FontSize="10.5" Foreground="#475569" TextWrapping="Wrap" />

                            <Border Margin="0,8,0,8" Padding="0,6" BorderBrush="#0F172A" BorderThickness="0,1.5,0,1.5">
                                <StackPanel>
                                    <Grid FlowDirection="RightToLeft">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="التكلفة المبدئية:" Style="{StaticResource PosRtlTextStyle}" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.EstimatedCostDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11" FontWeight="Bold" />
                                    </Grid>
                                    <Grid Margin="0,3,0,0" FlowDirection="RightToLeft" Visibility="{Binding Order.HasDeposit, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="المدفوع مقدمًا (عربون):" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#0F766E" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.TotalDepositPaidDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11" Foreground="#0F766E" FontWeight="Bold" />
                                    </Grid>
                                    <TextBlock Text="{Binding Order.DepositSummaryText}"
                                               Style="{StaticResource PosRtlTextStyle}"
                                               Margin="0,2,0,0"
                                               FontSize="10"
                                               Foreground="#475569"
                                               Visibility="{Binding Order.HasDeposit, Converter={StaticResource BoolToVis}}" />
                                    <Grid Margin="0,3,0,0" FlowDirection="RightToLeft" Visibility="{Binding Order.HasEstimatedRemaining, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="المتبقي المتوقع عند التسليم:" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#B42318" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.EstimatedRemainingDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11" Foreground="#B42318" FontWeight="Bold" />
                                    </Grid>
                                    <TextBlock Text="{Binding Order.ExpectedDeliveryDisplay, StringFormat='موعد التسليم المتوقع: {0}'}"
                                               Style="{StaticResource PosRtlTextStyle}"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#102E48" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="• يُرجى إبراز هذا الإيصال عند استلام الجهاز." Style="{StaticResource PosRtlTextStyle}" FontSize="9.5" Foreground="#64748B" />
                            <TextBlock Text="• المركز غير مسؤول عن البيانات الشخصية ما لم يُطلب نسخ احتياطي." Style="{StaticResource PosRtlTextStyle}" Margin="0,1,0,0" FontSize="9.5" Foreground="#64748B" TextWrapping="Wrap" />
                            <TextBlock Text="• في حال رفض الصيانة بعد الفحص تُحتسب رسوم الفحص فقط إن وُجدت." Style="{StaticResource PosRtlTextStyle}" Margin="0,1,0,0" FontSize="9.5" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Mode 2: Compact Barcode-Style Device Sticker (Logo, Customer, Code, Received Date only) -->
                    <Border Padding="24,22"
                            CornerRadius="10"
                            Background="#CBD5E1"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsDeviceStickerMode, Converter={StaticResource BoolToVis}}">
                        <Border Width="180"
                                Height="90"
                                Padding="7,5"
                                Background="White"
                                BorderBrush="#64748B"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Logo + Received Date -->
                                <Grid Grid.Row="0" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Order.ReceivedDateDisplay}"
                                               Style="{StaticResource PosLtrTextStyle}"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas, Segoe UI"
                                               FontSize="8.5"
                                               FontWeight="SemiBold"
                                               Foreground="#475569" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay}"
                                                   Style="{StaticResource PosLtrTextStyle}"
                                                   VerticalAlignment="Center"
                                                   FontSize="9.5"
                                                   FontWeight="Bold"
                                                   Foreground="#102E48"
                                                   Margin="0,0,4,0" />
                                        <Border Width="14" Height="14" CornerRadius="3" Background="#102E48">
                                            <TextBlock Text="PZ"
                                                       Style="{StaticResource PosCenterTextStyle}"
                                                       VerticalAlignment="Center"
                                                       FontSize="7"
                                                       FontWeight="Bold"
                                                       Foreground="#6EE7D8" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Customer Name -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Order.CustomerName}"
                                           Style="{StaticResource PosCenterTextStyle}"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,2" />

                                <!-- Barcode Graphic -->
                                <Path Grid.Row="2"
                                      Data="M0,0 H3 V24 H0 Z M5,0 H6 V24 H5 Z M9,0 H13 V24 H9 Z M15,0 H17 V24 H15 Z M20,0 H21 V24 H20 Z M23,0 H27 V24 H23 Z M29,0 H30 V24 H29 Z M33,0 H35 V24 H33 Z M38,0 H42 V24 H38 Z M44,0 H45 V24 H44 Z M48,0 H50 V24 H48 Z M52,0 H55 V24 H52 Z M57,0 H59 V24 H57 Z M61,0 H64 V24 H61 Z M66,0 H68 V24 H66 Z M71,0 H74 V24 H71 Z M76,0 H78 V24 H76 Z M80,0 H83 V24 H80 Z M85,0 H86 V24 H85 Z M89,0 H92 V24 H89 Z"
                                      Fill="#0F172A"
                                      Stretch="Fill"
                                      Width="148"
                                      Height="24"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center" />

                                <!-- Ticket Code -->
                                <TextBlock Grid.Row="3"
                                           Text="{Binding Order.OrderNumber}"
                                           Style="{StaticResource PosLtrTextStyle}"
                                           HorizontalAlignment="Center"
                                           FontFamily="Consolas, Segoe UI"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,1,0,0" />
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Mode 3: 80mm Final Delivery, Parts & Warranty Receipt -->
                    <Border Width="345"
                            Padding="16"
                            Background="White"
                            BorderBrush="#0F766E"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Visibility="{Binding IsDeliveryReceiptMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel FlowDirection="RightToLeft">
                            <TextBlock Text="{Binding ServiceCenterHeader, Source={StaticResource StoreIdentity}, Mode=OneWay}"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       FontSize="15.5"
                                       FontWeight="Bold"
                                       Foreground="#102E48" />
                            <TextBlock Text="{Binding ContactLine, Source={StaticResource StoreIdentity}, Mode=OneWay}"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       Margin="0,2,0,0"
                                       FontSize="9.5"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasContactLine, Source={StaticResource StoreIdentity}, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="إيصال تسليم الصيانة والضمان"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       Margin="0,2,0,6"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#0F766E" />

                            <Border Padding="8,5" Margin="0,0,0,8" Background="#F0FDFA" CornerRadius="6" BorderBrush="#99F6E4" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Order.OrderNumber}"
                                               Style="{StaticResource PosCenterTextStyle}"
                                               FontFamily="Consolas, Segoe UI"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#102E48" />
                                    <TextBlock Text="{Binding Order.StatusTitle}"
                                               Style="{StaticResource PosCenterTextStyle}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#0F766E" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#CBD5E1" BorderThickness="0,1,0,1" Padding="0,6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Order.CustomerName, StringFormat='العميل: {0}'}" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Order.CustomerPhoneDisplay, StringFormat='هاتف: {0}'}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="11" />
                                    <TextBlock Text="{Binding Order.DeviceFullTitle, StringFormat='الجهاز: {0}'}" Style="{StaticResource PosRtlTextStyle}" Margin="0,3,0,0" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Order.AssignedTechnicianDisplay, StringFormat='الفني المسؤول: {0}'}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10.5" Foreground="#475569" />
                                    <TextBlock Text="{Binding Order.DeliveredAtDisplay, StringFormat='تاريخ التسليم: {0}'}" Style="{StaticResource PosRtlTextStyle}" Margin="0,2,0,0" FontSize="10.5" Foreground="#0F766E" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="تقرير ما تم تنفيذه:" Style="{StaticResource PosRtlTextStyle}" FontSize="11" FontWeight="Bold" Foreground="#102E48" />
                            <TextBlock Text="{Binding Order.DiagnosisNotes}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,2,0,6"
                                       FontSize="10.5"
                                       Foreground="#334155"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Order.HasDiagnosisNotes, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Visibility="{Binding Order.HasUsedParts, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                <TextBlock Text="قطع الغيار المستبدلة:" Style="{StaticResource PosRtlTextStyle}" FontSize="11" FontWeight="Bold" Foreground="#102E48" Margin="0,0,0,3" />
                                <ItemsControl ItemsSource="{Binding Order.UsedParts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ProductName}" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding LineTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="10.5" FontWeight="SemiBold" Margin="6,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Padding="0,6" Margin="0,2,0,8" BorderBrush="#0F172A" BorderThickness="0,1.5,0,1.5">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="قطع الغيار:" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.PartsTotalDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="10.5" />
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="أجرة الصيانة والمصنعية:" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.LaborCostDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="10.5" />
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="الإجمالي النهائي:" Style="{StaticResource PosRtlTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#102E48" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.EstimatedCostDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#102E48" />
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="إجمالي المسدد (عربون + تسليم):" Style="{StaticResource PosRtlTextStyle}" FontSize="10.5" Foreground="#0F766E" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.TotalCollectedAllDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="10.5" Foreground="#0F766E" FontWeight="Bold" />
                                    </Grid>
                                    <Grid Margin="0,2,0,0" Visibility="{Binding Order.HasEstimatedRemaining, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="المتبقي المستحق:" Style="{StaticResource PosRtlTextStyle}" FontSize="11" Foreground="#B42318" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Order.EstimatedRemainingDisplay}" Style="{StaticResource PosLtrTextStyle}" FontSize="11" Foreground="#B42318" FontWeight="Bold" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Padding="8,6" CornerRadius="6" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Order.WarrantySummaryDisplay}" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#0F766E" />
                            </Border>
                            <TextBlock Text="• يسري الضمان على العطل المُصلح فقط ولا يشمل الكسر أو السوائل." Style="{StaticResource PosRtlTextStyle}" FontSize="9.5" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Print Status -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="10,7"
                CornerRadius="8"
                Background="#ECFDF5"
                BorderBrush="#A7F3D0"
                BorderThickness="1"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource PosRtlTextStyle}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#065F46" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,12,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إغلاق"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="14,9"
                    IsCancel="True"
                    Command="{Binding CloseCommand}" />

            <Button Grid.Column="2"
