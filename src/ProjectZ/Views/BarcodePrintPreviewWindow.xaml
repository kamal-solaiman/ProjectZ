<Window x:Class="ProjectZ.Views.BarcodePrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | معاينة وطباعة الباركود'}"
        Width="440"
        Height="430"
        MinWidth="380"
        MinHeight="380"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/ProjectZ;component/Resources/PrintIsolation.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>

    <Grid Margin="20" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navy Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="16,12"
                CornerRadius="14"
                Background="#102E48"
                FlowDirection="LeftToRight">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="8,3" CornerRadius="8" Background="#1E3A5F" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="50 × 25 مم" Style="{StaticResource PosCenterTextStyle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#BAE6FD" />
                </Border>

                <TextBlock Grid.Column="1"
                           Text="طباعة ملصق الباركود"
                           Style="{StaticResource PosRtlTextStyle}"
                           VerticalAlignment="Center"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="White" />
            </Grid>
        </Border>

        <!-- Sticker Preview & Copies Input -->
        <Border Grid.Row="1"
                Padding="16"
                CornerRadius="14"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <StackPanel VerticalAlignment="Center">
                <!-- Label Print Tray -->
                <Border Padding="20,22"
                        CornerRadius="10"
                        Background="#E2E8F0"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Margin="0,0,0,14">
                    <!-- Standard Thermal Barcode Label (50mm x 25mm = 190 x 95 DIP) -->
                    <Border Width="190"
                            Height="95"
                            Padding="8,5"
                            CornerRadius="4"
                            Background="White"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding PreviewName}"
                                       Style="{StaticResource PosCenterTextStyle}"
                                       VerticalAlignment="Center"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="28" />

                            <Path Grid.Row="1"
                                  Data="M0,0 H3 V34 H0 Z M5,0 H6 V34 H5 Z M9,0 H13 V34 H9 Z M15,0 H17 V34 H15 Z M20,0 H21 V34 H20 Z M23,0 H27 V34 H23 Z M29,0 H30 V34 H29 Z M33,0 H35 V34 H33 Z M38,0 H42 V34 H38 Z M44,0 H45 V34 H44 Z M48,0 H50 V34 H48 Z M52,0 H55 V34 H52 Z M57,0 H59 V34 H57 Z M61,0 H64 V34 H61 Z M66,0 H68 V34 H66 Z M71,0 H74 V34 H71 Z M76,0 H78 V34 H76 Z M80,0 H83 V34 H80 Z M85,0 H86 V34 H85 Z M89,0 H92 V34 H89 Z"
                                  Fill="#0F172A"
                                  Stretch="Fill"
                                  Width="156"
                                  Height="34"
                                  Margin="0,2,0,2"
                                  HorizontalAlignment="Center" />

                            <TextBlock Grid.Row="2"
                                       Text="{Binding PreviewBarcode}"
                                       Style="{StaticResource PosLtrTextStyle}"
                                       HorizontalAlignment="Center"
                                       FontFamily="Consolas, Segoe UI"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="#0F172A" />
                        </Grid>
                    </Border>
                </Border>

                <!-- Copies Input -->
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="CopiesInput"
                             Grid.Column="0"
                             Style="{StaticResource PosNumericTextBoxStyle}"
                             TextAlignment="Center"
                             Text="{Binding CopiesText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Column="2"
                               Text="عدد الملصقات المطلوب طباعتها:"
                               Style="{StaticResource PosRtlTextStyle}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </Grid>

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="0,10,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#0F766E"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,14,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="إغلاق"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="105"
                    Padding="16,9"
                    IsCancel="True"
                    Command="{Binding CloseCommand}" />

            <Button Grid.Column="2"
                    Content="معاينة الطباعة"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    MinWidth="175"
                    Padding="20,9"
                    IsDefault="True"
                    Command="{Binding PrintPreviewCommand}" />
        </Grid>
    </Grid>
</Window>
