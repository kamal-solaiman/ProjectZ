<Window x:Class="ProjectZ.Views.VodafoneRecordDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | تفاصيل عملية فودافون كاش'}" Width="570" SizeToContent="Height" MaxHeight="780" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/PosStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
        <Border Padding="16" CornerRadius="12" Background="#102E48"><StackPanel><TextBlock Text="تفاصيل عملية فودافون كاش" Style="{StaticResource PosRtlTextStyle}" FontSize="20" FontWeight="Bold" Foreground="White" /></StackPanel></Border>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="الحالة" FontWeight="Bold" Margin="0,6" /><TextBlock Grid.Column="1" Text="{Binding StatusTitle}" Margin="0,6" />
            <TextBlock Grid.Row="1" Text="نوع العملية" FontWeight="Bold" Margin="0,6" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OperationTitle}" Margin="0,6" />
            <TextBlock Grid.Row="2" Text="الخط" FontWeight="Bold" Margin="0,6" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WalletAlias}" Margin="0,6" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Text="رقم الخط" FontWeight="Bold" Margin="0,6" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WalletNumber}" FlowDirection="LeftToRight" Margin="0,6" />
            <TextBlock Grid.Row="4" Text="رقم العميل" FontWeight="Bold" Margin="0,6" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CustomerNumber}" FlowDirection="LeftToRight" Margin="0,6" />
            <TextBlock Grid.Row="5" Text="المبلغ" FontWeight="Bold" Margin="0,6" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AmountDisplay}" Margin="0,6" />
            <TextBlock Grid.Row="6" Text="العمولة" FontWeight="Bold" Margin="0,6" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CommissionDisplay}" Margin="0,6" />
            <TextBlock Grid.Row="7" Text="أثر النقدي" FontWeight="Bold" Margin="0,6" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding TotalCashDisplay}" Margin="0,6" />
            <TextBlock Grid.Row="8" Text="رصيد الخط بعدها" FontWeight="Bold" Margin="0,6" /><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding WalletBalanceAfterDisplay}" Margin="0,6" />
            <TextBlock Grid.Row="9" Text="التاريخ والوقت" FontWeight="Bold" Margin="0,6" /><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Timestamp, StringFormat='dd/MM/yyyy hh:mm:ss tt'}" Margin="0,6" />
            <TextBlock Grid.Row="10" Text="المستخدم" FontWeight="Bold" Margin="0,6" /><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding ActorName}" Margin="0,6" />
            <TextBlock Grid.Row="11" Text="عكسها بواسطة" FontWeight="Bold" Margin="0,6" /><TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding ReversedBy}" Margin="0,6" />
            <TextBlock Grid.Row="12" Text="ملاحظات" FontWeight="Bold" Margin="0,6" /><TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,6" />
        </Grid>
        <Button Content="إغلاق" Style="{StaticResource PosSecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="22,9" Click="Close_Click" />
    </StackPanel></ScrollViewer>
</Window>
