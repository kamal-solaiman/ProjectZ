<Window x:Class="ProjectZ.Views.MaintenanceSparePartRestockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, Source={StaticResource StoreIdentity}, Mode=OneWay, StringFormat='{} | توريد قطعة غيار'}"
        Width="560"
        Height="620"
        MinWidth="500"
        MinHeight="540"
        FlowDirection="LeftToRight"
        Language="ar-EG"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,11" CornerRadius="12" Background="#0F766E">
            <StackPanel FlowDirection="RightToLeft">
                <TextBlock Text="توريد قطعة غيار من مورد"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="16.5"
                           FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="{Binding PartTitle}"
                           Style="{StaticResource PosRtlTextStyle}"
                           Margin="0,2,0,0"
                           FontSize="12"
                           Foreground="#CCFBF1" />
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel FlowDirection="RightToLeft">
                <Border Margin="0,0,0,10" Padding="12" CornerRadius="10" Background="#F8FAFC"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding AvailableStockDisplay}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="#102E48" />
                            <TextBlock Text="{Binding ReorderDisplay}"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       Margin="0,3,0,0"
                                       FontSize="11.5"
                                       Foreground="#64748B" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الرصيد بعد التوريد"
                                       Style="{StaticResource PosRtlTextStyle}"
                                       FontSize="11.5"
                                       Foreground="#64748B" />
                            <TextBlock Text="{Binding PreviewQuantityDisplay}"
                                       Style="{StaticResource PosLtrTextStyle}"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#0F766E" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="الكمية الموردة *"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5" />
                <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                         Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12" />

                <TextBlock Text="سعر الشراء للوحدة (ج.م) *"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5" />
                <TextBox Style="{StaticResource PosNumericTextBoxStyle}"
                         Text="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12" />

                <TextBlock Text="المورد"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5" />
                <ComboBox Style="{StaticResource PosComboBoxStyle}"
                          ItemsSource="{Binding SupplierOptions}"
                          SelectedItem="{Binding SelectedSupplier}"
                          DisplayMemberPath="DisplayName"
                          FlowDirection="RightToLeft"
                          Margin="0,0,0,4" />
                <TextBlock Text="{Binding SupplierHint}"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="11"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock Text="رقم فاتورة / مرجع المورد (اختياري)"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5" />
                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                         FlowDirection="RightToLeft"
                         TextAlignment="Left"
                         Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="100"
                         Margin="0,0,0,12" />

                <TextBlock Text="ملاحظات التوريد (اختياري)"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5" />
                <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                         MinHeight="64"
                         FlowDirection="RightToLeft"
                         TextAlignment="Left"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="500"
                         Margin="0,0,0,12" />

                <Border Padding="11,9" CornerRadius="9" Background="#ECFDF5"
                        BorderBrush="#A7F3D0" BorderThickness="1">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="إجمالي قيمة التوريد"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="#065F46" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalDisplay}"
                                   Style="{StaticResource PosLtrTextStyle}"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#065F46" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Error -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10,7"
                CornerRadius="8"
                Background="#FEF2F2"
                BorderBrush="#FECACA"
                BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource PosRtlTextStyle}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#B42318" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="تراجع"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="110"
                    Padding="14,9"
                    IsCancel="True"
                    Command="{Binding AbortCommand}" />

            <Button Grid.Column="2"
                    Content="تأكيد التوريد"
                    Style="{StaticResource PosPrimaryCompactButtonStyle}"
                    MinWidth="170"
                    Padding="16,9"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}" />
        </Grid>
    </Grid>
</Window>
