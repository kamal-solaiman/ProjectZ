<UserControl x:Class="ProjectZ.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Language="ar-EG">

    <UserControl.Resources>
        <Style x:Key="UserActionBtnBaseStyle" TargetType="Button">
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header strip -->
        <Grid Grid.Row="0" Margin="0,0,0,12" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="تحديث المستخدمين"
                    Style="{StaticResource PosOutlineTealButtonStyle}"
                    Padding="12,7"
                    FontSize="12.5"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshUsersCommand}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft">
                <TextBlock Text="المستخدمين"
                           Style="{StaticResource PosRtlTextStyle}"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#102E48"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        CornerRadius="12"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#DCFCE7" />
                            <Setter Property="BorderBrush" Value="#BBF7D0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDatabaseBacked}" Value="False">
                                    <Setter Property="Background" Value="#FEF3C7" />
                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ConnectionBadgeText}"
                               FontSize="11.5"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                <Setter Property="Foreground" Value="#15803D" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDatabaseBacked}" Value="False">
                                        <Setter Property="Foreground" Value="#B45309" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ROW 1: counters, search, filter and add -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="14"
                CornerRadius="14"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Counters -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom" FlowDirection="LeftToRight">
                    <Border Padding="12,8"
                            CornerRadius="9"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1">
                        <TextBlock Text="{Binding TotalCountDisplay}"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#1D4ED8" />
                    </Border>
                    <Border Margin="6,0,0,0"
                            Padding="12,8"
                            CornerRadius="9"
                            Background="#ECFDF5"
                            BorderBrush="#A7F3D0"
                            BorderThickness="1">
                        <TextBlock Text="{Binding ActiveCountDisplay}"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#047857" />
                    </Border>
                    <Border Margin="6,0,0,0"
                            Padding="12,8"
                            CornerRadius="9"
                            Background="#FFF7ED"
                            BorderBrush="#FED7AA"
                            BorderThickness="1">
                        <TextBlock Text="{Binding InactiveCountDisplay}"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#C2410C" />
                    </Border>
                </StackPanel>

                <!-- Search -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="بحث بالاسم أو اسم الدخول"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,5"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#475569" />
                    <Grid>
                        <TextBox Style="{StaticResource PosCompactTextBoxStyle}"
                                 Padding="10,7,30,7"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="ابحث عن مستخدم..."
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="30,0,10,0"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="#94A3B8"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}" />
                        <Button Content="×"
                                Width="22"
                                Height="22"
                                Margin="6,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource PosDangerIconButtonStyle}"
                                Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}"
                                Command="{Binding ClearSearchCommand}" />
                    </Grid>
                </StackPanel>

                <!-- Status filter -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="حالة الحساب"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,5"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#475569" />
                    <ComboBox Style="{StaticResource PosComboBoxStyle}"
                              MinHeight="36"
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding StatusFilter, Mode=TwoWay}" />
                </StackPanel>

                <!-- Quick filters + add -->
                <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                    <TextBlock Text="إضافة حساب دخول جديد إلى dbo.Users"
                               Style="{StaticResource PosRtlTextStyle}"
                               Margin="0,0,0,5"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#102E48" />
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                        <Button Content="+ إضافة مستخدم"
                                Style="{StaticResource PosPrimaryCompactButtonStyle}"
                                Padding="18,8"
                                MinHeight="36"
                                Command="{Binding AddUserCommand}" />
                        <Button Content="الكل"
                                Style="{StaticResource UserActionBtnBaseStyle}"
                                Background="#F8FAFC"
                                Foreground="#475569"
                                BorderBrush="#C7D2DE"
                                Command="{Binding ShowAllCommand}" />
                        <Button Content="النشطون"
                                Style="{StaticResource UserActionBtnBaseStyle}"
                                Background="#F8FAFC"
                                Foreground="#047857"
                                BorderBrush="#A7F3D0"
                                Command="{Binding ShowActiveCommand}" />
                        <Button Content="المعطّلون"
                                Style="{StaticResource UserActionBtnBaseStyle}"
                                Background="#F8FAFC"
                                Foreground="#C2410C"
                                BorderBrush="#FED7AA"
                                Command="{Binding ShowInactiveCommand}" />
                        <TextBlock Text="{Binding CurrentUserHint}"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: users table -->
        <Border Grid.Row="2"
                CornerRadius="14"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                FlowDirection="LeftToRight">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#102E48"
                        CornerRadius="13,13,0,0"
                        Padding="14,11"
                        FlowDirection="LeftToRight">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="م"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#B7CFDD" />
                        <TextBlock Grid.Column="1"
                                   Text="اسم الدخول (Username)"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="8,0"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Grid.Column="2"
                                   Text="الاسم الظاهر"
                                   Style="{StaticResource PosRtlTextStyle}"
                                   Margin="8,0"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Grid.Column="3"
                                   Text="الحالة"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#B7CFDD" />
                        <TextBlock Grid.Column="4"
                                   Text="السجلات المرتبطة"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#B7CFDD" />
                        <TextBlock Grid.Column="5"
                                   Text="آخر تحديث"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#B7CFDD" />
                        <TextBlock Grid.Column="6"
                                   Text="التحكم"
                                   Style="{StaticResource PosCenterTextStyle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#6EE7D8" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  FlowDirection="LeftToRight">
                        <ItemsControl ItemsSource="{Binding FilteredUsers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,9"
                                            BorderBrush="#F1F5F9"
                                            BorderThickness="0,0,0,1"
                                            Background="White">
                                        <Grid FlowDirection="RightToLeft">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="330" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding OrderDisplay}"
                                                       Style="{StaticResource PosCenterTextStyle}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       Foreground="#64748B" />

                                            <!-- Account names are identifiers: always LTR. -->
                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0"
                                                        VerticalAlignment="Center"
                                                        FlowDirection="LeftToRight"
                                                        HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Username}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#102E48"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Margin="0,2,0,0"
                                                        Padding="6,1"
                                                        CornerRadius="6"
                                                        Background="#F0FDFA"
                                                        BorderBrush="#99F6E4"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding IsCurrentUser, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="أنت"
                                                               Style="{StaticResource PosCenterTextStyle}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#0F766E" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DisplayNameOrUsername}"
                                                       Style="{StaticResource PosRtlTextStyle}"
                                                       Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       Foreground="#172B41"
                                                       TextTrimming="CharacterEllipsis" />

                                            <Border Grid.Column="3"
                                                    Padding="9,4"
                                                    CornerRadius="9"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#ECFDF5" />
                                                        <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="#FEF2F2" />
                                                                <Setter Property="BorderBrush" Value="#FECACA" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PosCenterTextStyle}">
                                                            <Setter Property="Foreground" Value="#047857" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Foreground" Value="#B42318" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Border Grid.Column="4"
                                                    Padding="9,4"
                                                    CornerRadius="9"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="#F1F5F9"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding LinkedRecordsDisplay}"
                                                           Style="{StaticResource PosCenterTextStyle}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334155" />
                                            </Border>

                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding UpdatedAtDisplay}"
                                                       Style="{StaticResource PosCenterTextStyle}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11.5"
                                                       FlowDirection="LeftToRight"
                                                       Foreground="#64748B" />

                                            <StackPanel Grid.Column="6"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FlowDirection="RightToLeft">
                                                <Button Content="تعديل"
                                                        Style="{StaticResource UserActionBtnBaseStyle}"
                                                        Background="#EFF6FF"
                                                        Foreground="#1D4ED8"
                                                        BorderBrush="#BFDBFE"
                                                        ToolTip="تعديل اسم الدخول والاسم الظاهر وحالة الحساب"
                                                        Command="{Binding EditCommand}" />
                                                <Button Content="كلمة المرور"
                                                        Style="{StaticResource UserActionBtnBaseStyle}"
                                                        Background="#F5F3FF"
                                                        Foreground="#6D28D9"
                                                        BorderBrush="#DDD6FE"
                                                        ToolTip="تعيين كلمة مرور جديدة للحساب دون عرض الكلمة القديمة"
                                                        Command="{Binding ChangePasswordCommand}" />
                                                <Button Command="{Binding ToggleActiveCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource UserActionBtnBaseStyle}">
                                                            <Setter Property="Content" Value="تعطيل" />
                                                            <Setter Property="Background" Value="#FFFBEB" />
                                                            <Setter Property="Foreground" Value="#B45309" />
                                                            <Setter Property="BorderBrush" Value="#FDE68A" />
                                                            <Setter Property="ToolTip" Value="إيقاف دخول الحساب مع الحفاظ على كل سجلاته" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Content" Value="تنشيط" />
                                                                    <Setter Property="Background" Value="#ECFDF5" />
                                                                    <Setter Property="Foreground" Value="#047857" />
                                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                                    <Setter Property="ToolTip" Value="السماح للحساب بتسجيل الدخول من جديد" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="حذف"
                                                        Style="{StaticResource UserActionBtnBaseStyle}"
                                                        Background="#FEF2F2"
                                                        Foreground="#B42318"
                                                        BorderBrush="#FECACA"
                                                        IsEnabled="{Binding CanDelete}"
                                                        ToolTip="{Binding DeleteToolTip}"
                                                        Command="{Binding DeleteCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding EmptyStateText}"
                               Style="{StaticResource PosCenterTextStyle}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               MaxWidth="620"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="#94A3B8"
                               Visibility="{Binding HasNoUsers, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ROW 3: status strip -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                FlowDirection="LeftToRight"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
                        <Setter Property="Foreground" Value="#065F46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                <Setter Property="Foreground" Value="#B42318" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
