<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:ProjectZ.Helpers"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <helpers:HexToBrushConverter x:Key="HexToBrush" />

    <!-- Existing screens use keyed POS styles; unstyled controls now follow the same palette too. -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource PosComboBoxStyle}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource PosCheckBoxStyle}" />
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}" />
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Subtle}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="6" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" Background="{TemplateBinding Background}">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" CornerRadius="3" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" />
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Theme.Brush.OnAccent}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Theme.Brush.Accent}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Theme.Brush.Accent}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Theme.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Input}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CalendarStyle">
            <Setter.Value>
                <Style TargetType="Calendar">
                    <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}" />
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.PanelBorder}" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Input}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Brush.Selection}" />
    </Style>
    <Style TargetType="CalendarDayButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="Day" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Margin="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsToday" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Day" Property="Background" Value="{DynamicResource Theme.Brush.Hover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Day" Property="Background" Value="{DynamicResource Theme.Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Muted}" /><Setter Property="Opacity" Value=".65" /></Trigger>
                        <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value=".3" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="Month" Background="{TemplateBinding Background}" CornerRadius="5" Padding="8,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Month" Property="Background" Value="{DynamicResource Theme.Brush.Hover}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}" />
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style TargetType="GridSplitter"><Setter Property="Background" Value="{DynamicResource Theme.Brush.Border}" /></Style>
    <Style TargetType="Separator"><Setter Property="Background" Value="{DynamicResource Theme.Brush.Border}" /></Style>

    <!-- Shared studio shells: the specular border and surface paint vary with the selected theme. -->
    <Style x:Key="ThemeCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.CornerRadius}" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="ThemeHeroCardStyle" TargetType="Border" BasedOn="{StaticResource ThemeCardStyle}">
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.PanelCornerRadius}" />
        <Setter Property="Padding" Value="22" />
    </Style>
    <Style x:Key="ThemeSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
        <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text}" />
    </Style>
    <Style x:Key="ThemeHintStyle" TargetType="TextBlock" BasedOn="{StaticResource PosRtlTextStyle}">
        <Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Muted}" />
    </Style>
    <Style x:Key="ThemeSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" /><Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style x:Key="ThemeGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemeSecondaryButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.AccentInk}" />
    </Style>
</ResourceDictionary>
