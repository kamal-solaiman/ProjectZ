<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 5. Holographic UI – التصميم الهولوجرافي -->
  <CornerRadius x:Key="CardCornerRadius">20</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>

  <LinearGradientBrush x:Key="WindowCanvasBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#160B2E" Offset="0.0"/>
    <GradientStop Color="#1E1442" Offset="0.45"/>
    <GradientStop Color="#0D223C" Offset="1.0"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="AmbientOrb1Brush" Color="#50EC4899"/>
  <SolidColorBrush x:Key="AmbientOrb2Brush" Color="#5022D3EE"/>
  <SolidColorBrush x:Key="AmbientOrb3Brush" Color="#48A855F7"/>

  <LinearGradientBrush x:Key="SidebarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#CC1D1138" Offset="0"/>
    <GradientStop Color="#BA101E38" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SidebarBorderBrush" Color="#55E879F9"/>
  <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#FAF5FF"/>
  <SolidColorBrush x:Key="SidebarMutedForegroundBrush" Color="#D8B4FE"/>
  <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#C81A1034"/>

  <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#C4251645" Offset="0"/>
    <GradientStop Color="#AA132442" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardElevatedBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#DC311D59" Offset="0"/>
    <GradientStop Color="#C4193056" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#AA22D3EE" Offset="0.0"/>
    <GradientStop Color="#AAE879F9" Offset="0.5"/>
    <GradientStop Color="#99FDE047" Offset="1.0"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#CC140B29"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#55C084FC"/>
  <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#22D3EE"/>

  <SolidColorBrush x:Key="NavItemHoverBrush" Color="#33E879F9"/>
  <LinearGradientBrush x:Key="NavItemSelectedBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#EC4899" Offset="0"/>
    <GradientStop Color="#8B5CF6" Offset="0.5"/>
    <GradientStop Color="#06B6D4" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="NavItemSelectedBorderBrush" Color="#67E8F9"/>
  <SolidColorBrush x:Key="NavItemSelectedForegroundBrush" Color="#FFFFFF"/>

  <SolidColorBrush x:Key="TableHeaderBackgroundBrush" Color="#AA2B194D"/>
  <SolidColorBrush x:Key="TableRowBackgroundBrush" Color="#77180E30"/>
  <SolidColorBrush x:Key="TableRowAltBackgroundBrush" Color="#991E153D"/>
  <SolidColorBrush x:Key="TableRowHoverBrush" Color="#35EC4899"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#40C084FC"/>

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAF5FF"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#E9D5FF"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#A5B4FC"/>
  <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="#FFFFFF"/>

  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#EC4899" Offset="0"/>
    <GradientStop Color="#8B5CF6" Offset="0.5"/>
    <GradientStop Color="#06B6D4" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Accent" Color="#EC4899"/>
  <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#22D3EE"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#33EC4899"/>

  <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#3010B981"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#FDE047"/>
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#30EAB308"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#FB7185"/>
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#30F43F5E"/>
  <SolidColorBrush x:Key="InfoBrush" Color="#67E8F9"/>
  <SolidColorBrush x:Key="InfoSoftBrush" Color="#3006B6D4"/>
  <SolidColorBrush x:Key="VodafoneBrush" Color="#FCA5A5"/>
  <SolidColorBrush x:Key="VodafoneSoftBrush" Color="#30EF4444"/>
  <SolidColorBrush x:Key="InstaPayBrush" Color="#F0ABFC"/>
  <SolidColorBrush x:Key="InstaPaySoftBrush" Color="#30D946EF"/>
</ResourceDictionary>
