    <GradientStop Color="#E0E7FF" Offset="0.38"/>
    <GradientStop Color="#F5D0FE" Offset="0.75"/>
    <GradientStop Color="#DBEAFE" Offset="1.0"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="AmbientOrb1Brush" Color="#7706B6D4"/>
  <SolidColorBrush x:Key="AmbientOrb2Brush" Color="#668B5CF6"/>
  <SolidColorBrush x:Key="AmbientOrb3Brush" Color="#66EC4899"/>

  <LinearGradientBrush x:Key="SidebarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#E5FFFFFF" Offset="0"/>
    <GradientStop Color="#9CF0F9FF" Offset="0.5"/>
    <GradientStop Color="#CCEEF2FF" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SidebarBorderBrush" Color="#FFFFFFFF"/>
