    <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
    <GradientStop Color="#BAE6FD" Offset="0.5"/>
    <GradientStop Color="#DDD6FE" Offset="1.0"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#EBFFFFFF"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#A5B4FC"/>
