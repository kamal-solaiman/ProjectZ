<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 7. Chrome / Liquid Metal – المعدن السائل والكروم -->
  <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

  <LinearGradientBrush x:Key="WindowCanvasBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#CBD5E1" Offset="0.0"/>
    <GradientStop Color="#F1F5F9" Offset="0.35"/>
    <GradientStop Color="#94A3B8" Offset="0.72"/>
    <GradientStop Color="#E2E8F0" Offset="1.0"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="AmbientOrb1Brush" Color="#66FFFFFF"/>
  <SolidColorBrush x:Key="AmbientOrb2Brush" Color="#4464748B"/>
  <SolidColorBrush x:Key="AmbientOrb3Brush" Color="#4438BDF8"/>

  <LinearGradientBrush x:Key="SidebarBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#1E293B" Offset="0"/>
    <GradientStop Color="#334155" Offset="0.5"/>
    <GradientStop Color="#0F172A" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SidebarBorderBrush" Color="#94A3B8"/>
  <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0"/>
    <GradientStop Color="#E2E8F0" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFFFFF" Offset="0.0"/>
    <GradientStop Color="#E2E8F0" Offset="0.45"/>
    <GradientStop Color="#F8FAFC" Offset="0.75"/>
    <GradientStop Color="#CBD5E1" Offset="1.0"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardElevatedBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0"/>
    <GradientStop Color="#F1F5F9" Offset="0.5"/>
    <GradientStop Color="#DBE3EC" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFFFFF" Offset="0.0"/>
    <GradientStop Color="#94A3B8" Offset="0.5"/>
    <GradientStop Color="#475569" Offset="1.0"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#94A3B8"/>
  <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#0F172A"/>

  <SolidColorBrush x:Key="NavItemHoverBrush" Color="#3394A3B8"/>
  <LinearGradientBrush x:Key="NavItemSelectedBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F8FAFC" Offset="0"/>
    <GradientStop Color="#CBD5E1" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="NavItemSelectedBorderBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="NavItemSelectedForegroundBrush" Color="#0F172A"/>

  <!-- Note: Chrome sidebar has metallic slate background; keep main text crisp dark -->
  <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#F1F5F9"/>
  <SolidColorBrush x:Key="SidebarMutedForegroundBrush" Color="#CBD5E1"/>

  <SolidColorBrush x:Key="TableHeaderBackgroundBrush" Color="#CBD5E1"/>
  <SolidColorBrush x:Key="TableRowBackgroundBrush" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="TableRowAltBackgroundBrush" Color="#E9EFF5"/>
  <SolidColorBrush x:Key="TableRowHoverBrush" Color="#DBEAFE"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#94A3B8"/>

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#475569"/>
  <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="#FFFFFF"/>

  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#334155" Offset="0"/>
    <GradientStop Color="#0F172A" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Accent" Color="#1E293B"/>
  <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#0284C7"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#24334155"/>

  <SolidColorBrush x:Key="SuccessBrush" Color="#047857"/>
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2410B981"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#24F59E0B"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#BE123C"/>
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#24F43F5E"/>
  <SolidColorBrush x:Key="InfoBrush" Color="#0369A1"/>
  <SolidColorBrush x:Key="InfoSoftBrush" Color="#240284C7"/>
  <SolidColorBrush x:Key="VodafoneBrush" Color="#DC2626"/>
  <SolidColorBrush x:Key="VodafoneSoftBrush" Color="#22E60000"/>
  <SolidColorBrush x:Key="InstaPayBrush" Color="#6D28D9"/>
  <SolidColorBrush x:Key="InstaPaySoftBrush" Color="#227C3AED"/>
</ResourceDictionary>
