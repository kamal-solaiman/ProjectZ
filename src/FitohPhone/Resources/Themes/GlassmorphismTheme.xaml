<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 1. Glassmorphism – الزجاج الشفاف -->
  <CornerRadius x:Key="CardCornerRadius">18</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>

  <LinearGradientBrush x:Key="WindowCanvasBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#DBEAFE" Offset="0.0"/>
    <GradientStop Color="#E0E7FF" Offset="0.45"/>
    <GradientStop Color="#CCFBF1" Offset="1.0"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="AmbientOrb1Brush" Color="#6638BDF8"/>
  <SolidColorBrush x:Key="AmbientOrb2Brush" Color="#55818CF8"/>
  <SolidColorBrush x:Key="AmbientOrb3Brush" Color="#552DD4BF"/>

  <LinearGradientBrush x:Key="SidebarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#CCFFFFFF" Offset="0"/>
    <GradientStop Color="#99F8FAFC" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SidebarBorderBrush" Color="#B0FFFFFF"/>
  <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#0F172A"/>
  <SolidColorBrush x:Key="SidebarMutedForegroundBrush" Color="#475569"/>
  <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#B8FFFFFF"/>

  <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#C8FFFFFF" Offset="0"/>
    <GradientStop Color="#96F8FAFC" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardElevatedBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#E6FFFFFF" Offset="0"/>
    <GradientStop Color="#B8F0F9FF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFFFFFFF" Offset="0"/>
    <GradientStop Color="#80CBD5E1" Offset="1"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#D8FFFFFF"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#94CBD5E1"/>
  <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#0284C7"/>

  <SolidColorBrush x:Key="NavItemHoverBrush" Color="#55BAE6FD"/>
  <LinearGradientBrush x:Key="NavItemSelectedBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#0284C7" Offset="0"/>
    <GradientStop Color="#0D9488" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="NavItemSelectedBorderBrush" Color="#38BDF8"/>
  <SolidColorBrush x:Key="NavItemSelectedForegroundBrush" Color="#FFFFFF"/>

  <SolidColorBrush x:Key="TableHeaderBackgroundBrush" Color="#88E2E8F0"/>
  <SolidColorBrush x:Key="TableRowBackgroundBrush" Color="#78FFFFFF"/>
  <SolidColorBrush x:Key="TableRowAltBackgroundBrush" Color="#A8F8FAFC"/>
  <SolidColorBrush x:Key="TableRowHoverBrush" Color="#66BAE6FD"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#66CBD5E1"/>

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
  <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="#FFFFFF"/>

  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#0284C7" Offset="0"/>
    <GradientStop Color="#0D9488" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Accent" Color="#0284C7"/>
  <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#4F46E5"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#280284C7"/>

  <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2610B981"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#26F59E0B"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#24EF4444"/>
  <SolidColorBrush x:Key="InfoBrush" Color="#2563EB"/>
  <SolidColorBrush x:Key="InfoSoftBrush" Color="#243B82F6"/>
  <SolidColorBrush x:Key="VodafoneBrush" Color="#DC2626"/>
  <SolidColorBrush x:Key="VodafoneSoftBrush" Color="#22E60000"/>
  <SolidColorBrush x:Key="InstaPayBrush" Color="#7C3AED"/>
  <SolidColorBrush x:Key="InstaPaySoftBrush" Color="#227C3AED"/>
</ResourceDictionary>
