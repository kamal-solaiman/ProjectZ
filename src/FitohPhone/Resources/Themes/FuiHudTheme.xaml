<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 6. FUI / HUD – واجهات الخيال العلمي -->
  <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>

  <LinearGradientBrush x:Key="WindowCanvasBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#020810" Offset="0.0"/>
    <GradientStop Color="#04111F" Offset="0.55"/>
    <GradientStop Color="#06192C" Offset="1.0"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="AmbientOrb1Brush" Color="#3000F0FF"/>
  <SolidColorBrush x:Key="AmbientOrb2Brush" Color="#2200A3FF"/>
  <SolidColorBrush x:Key="AmbientOrb3Brush" Color="#22FFB800"/>

  <LinearGradientBrush x:Key="SidebarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#E6040F1C" Offset="0"/>
    <GradientStop Color="#D6030B14" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SidebarBorderBrush" Color="#7700F0FF"/>
  <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#E0F7FA"/>
  <SolidColorBrush x:Key="SidebarMutedForegroundBrush" Color="#38BDF8"/>
  <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#E004101E"/>

  <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#D806182B" Offset="0"/>
    <GradientStop Color="#C404101D" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardElevatedBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#EB09233E" Offset="0"/>
    <GradientStop Color="#D606192D" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#CC00F0FF" Offset="0"/>
    <GradientStop Color="#3500F0FF" Offset="0.6"/>
    <GradientStop Color="#88FFB800" Offset="1"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#DD030C17"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#6600F0FF"/>
  <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#FFB800"/>

  <SolidColorBrush x:Key="NavItemHoverBrush" Color="#2800F0FF"/>
  <LinearGradientBrush x:Key="NavItemSelectedBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00D4FF" Offset="0"/>
    <GradientStop Color="#0095FF" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="NavItemSelectedBorderBrush" Color="#FFB800"/>
  <SolidColorBrush x:Key="NavItemSelectedForegroundBrush" Color="#02101A"/>

  <SolidColorBrush x:Key="TableHeaderBackgroundBrush" Color="#BB08233B"/>
  <SolidColorBrush x:Key="TableRowBackgroundBrush" Color="#88041220"/>
  <SolidColorBrush x:Key="TableRowAltBackgroundBrush" Color="#AA071B2E"/>
  <SolidColorBrush x:Key="TableRowHoverBrush" Color="#3000F0FF"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#4400F0FF"/>

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E0F7FA"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7DD3FC"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#38BDF8"/>
  <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="#02101A"/>

  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00F0FF" Offset="0"/>
    <GradientStop Color="#00A8FF" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Accent" Color="#00F0FF"/>
  <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#FFB800"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#2800F0FF"/>

  <SolidColorBrush x:Key="SuccessBrush" Color="#00FF9D"/>
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2800FF9D"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#FFB800"/>
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#28FFB800"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#FF3B5C"/>
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#28FF3B5C"/>
  <SolidColorBrush x:Key="InfoBrush" Color="#00F0FF"/>
  <SolidColorBrush x:Key="InfoSoftBrush" Color="#2800F0FF"/>
  <SolidColorBrush x:Key="VodafoneBrush" Color="#FF4D6D"/>
  <SolidColorBrush x:Key="VodafoneSoftBrush" Color="#28FF4D6D"/>
  <SolidColorBrush x:Key="InstaPayBrush" Color="#C77DFF"/>
  <SolidColorBrush x:Key="InstaPaySoftBrush" Color="#28C77DFF"/>
</ResourceDictionary>
