<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 3. Dark Glass – الزجاج الداكن -->
  <CornerRadius x:Key="CardCornerRadius">18</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>

  <LinearGradientBrush x:Key="WindowCanvasBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#060B16" Offset="0.0"/>
    <GradientStop Color="#0B1325" Offset="0.5"/>
    <GradientStop Color="#111C33" Offset="1.0"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="AmbientOrb1Brush" Color="#330EA5E9"/>
  <SolidColorBrush x:Key="AmbientOrb2Brush" Color="#2E6366F1"/>
  <SolidColorBrush x:Key="AmbientOrb3Brush" Color="#2814B8A6"/>

  <LinearGradientBrush x:Key="SidebarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#D80F172A" Offset="0"/>
    <GradientStop Color="#B80B1120" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SidebarBorderBrush" Color="#3394A3B8"/>
  <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#F1F5F9"/>
  <SolidColorBrush x:Key="SidebarMutedForegroundBrush" Color="#94A3B8"/>
  <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#CC0F172A"/>

  <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#CC162238" Offset="0"/>
    <GradientStop Color="#A80F1829" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardElevatedBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#E01E2E4A" Offset="0"/>
    <GradientStop Color="#C0152238" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#5594A3B8" Offset="0"/>
    <GradientStop Color="#1E64748B" Offset="1"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#CC0B1324"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#4464748B"/>
  <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#38BDF8"/>

  <SolidColorBrush x:Key="NavItemHoverBrush" Color="#2838BDF8"/>
  <LinearGradientBrush x:Key="NavItemSelectedBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#0284C7" Offset="0"/>
    <GradientStop Color="#2563EB" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="NavItemSelectedBorderBrush" Color="#38BDF8"/>
