  <SolidColorBrush x:Key="InfoSoftBrush" Color="#2E0EA5E9"/>
  <SolidColorBrush x:Key="VodafoneBrush" Color="#F87171"/>
  <SolidColorBrush x:Key="VodafoneSoftBrush" Color="#30EF4444"/>
  <SolidColorBrush x:Key="InstaPayBrush" Color="#C084FC"/>
  <SolidColorBrush x:Key="InstaPaySoftBrush" Color="#30A855F7"/>
</ResourceDictionary>
