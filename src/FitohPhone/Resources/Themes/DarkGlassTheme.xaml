  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
  <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="#FFFFFF"/>

  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#0EA5E9" Offset="0"/>
    <GradientStop Color="#3B82F6" Offset="1"/>
