<UserControl x:Class="FitohPhone.Views.Pages.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/microsoft-com/controls/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- مؤشرات المخزون والهالك (بيانات فعلية من قاعدة البيانات) -->
    <UniformGrid Columns="4" Margin="0,0,0,12">
      <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="14">
        <StackPanel>
          <TextBlock Text="إجمالي الأصناف المسجلة" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding TotalItems, StringFormat={}{0} صنف}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="14">
        <StackPanel>
          <TextBlock Text="قيمة البضاعة بسعر الشراء" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding TotalStockValue, StringFormat={}{0:N0} ج.م}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="14">
        <StackPanel>
          <TextBlock Text="أصناف قاربت على النفاد" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding LowStockCount, StringFormat={}{0} صنفًا}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource GlassCard}" Padding="14">
        <StackPanel>
          <TextBlock Text="إجمالي مخزون الهالك" Style="{StaticResource MutedText}"/>
          <TextBlock Text="{Binding DamagedCount, StringFormat={}{0} قطعة}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- التبويبات: البضاعة المسجلة (السليمة) / مخزون الهالك -->
    <TabControl Grid.Row="1" Style="{StaticResource SubTabControl}">
      <!-- التبويب 1: المخزون السليم -->
      <TabItem Header="البضاعة المسجلة (المخزون السليم) — تحكم كامل" Style="{StaticResource SubTabItem}">
        <Border Style="{StaticResource GlassCard}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- فلاتر البحث -->
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Tag="بحث بالاسم، الباركود، الكود، أو الموديل..."
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
              <ComboBox Grid.Column="2" SelectedIndex="0">
                <ComboBoxItem Content="كل التصنيفات"/>
                <ComboBoxItem Content="هواتف ذكية"/>
                <ComboBoxItem Content="شواحن وكابلات"/>
                <ComboBoxItem Content="جرابات واسكرينات"/>
                <ComboBoxItem Content="قطع غيار صيانة"/>
              </ComboBox>
              <ComboBox Grid.Column="4" SelectedIndex="0">
                <ComboBoxItem Content="كل الحالات المخزنية"/>
                <ComboBoxItem Content="متوفر بالمخزون"/>
                <ComboBoxItem Content="نواقص أقل من الحد الأدنى"/>
                <ComboBoxItem Content="رصيد صفر (نفد)"/>
              </ComboBox>
              <Button Grid.Column="6" Content="تصدير جرد المخزون" Style="{StaticResource SecondaryButton}"/>
            </Grid>

            <!-- جدول الأصناف المسجلة مع أزرار التحكم الكامل -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Style="{StaticResource TableHeaderBorder}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="115"/>
                      <ColumnDefinition Width="1.6*"/>
                      <ColumnDefinition Width="105"/>
                      <ColumnDefinition Width="70"/>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="265"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="الباركود" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="اسم الصنف" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="التصنيف" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="الكمية" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="شراء" FontWeight="Bold"/>
                    <TextBlock Grid.Column="5" Text="قطاعي" FontWeight="Bold"/>
                    <TextBlock Grid.Column="6" Text="مميز" FontWeight="Bold"/>
                    <TextBlock Grid.Column="7" Text="جملة" FontWeight="Bold"/>
                    <TextBlock Grid.Column="8" Text="إجراءات التحكم الكامل" FontWeight="Bold" HorizontalAlignment="Center"/>
                  </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding StockItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource TableRowBorder}">
                        <Grid VerticalAlignment="Center">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="265"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding Barcode}" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding NameAr}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding CategoryName}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="{Binding CurrentStock}" FontWeight="Bold" 
                                     Foreground="{Binding StockColor}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="4" Text="{Binding CostPrice, StringFormat={}{0:N0}}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="5" Text="{Binding PriceRetail, StringFormat={}{0:N0}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="6" Text="{Binding PriceSpecial, StringFormat={}{0:N0}}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="7" Text="{Binding PriceWholesale, StringFormat={}{0:N0}}" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="تعديل" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"
                                    Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Id}"/>
                            <Button Content="تسوية" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"
                                    Command="{Binding DataContext.StockAdjustCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Id}"/>
                            <Button Content="باركود" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                            <Button Content="للهالك" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                            <Button Content="حذف" Style="{StaticResource SmallDangerButton}"
                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Id}"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="تعديل أسعار جماعي" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
              <Button Content="طباعة ملصقات باركود للأصناف المحددة" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
              <Button Content="حذف المحدد" Style="{StaticResource DangerButton}"/>
            </StackPanel>
          </Grid>
        </Border>
      </TabItem>

      <!-- التبويب 2: مخزون الهالك -->
      <TabItem Header="مخزون الهالك والتالف (Damaged Stock)" Style="{StaticResource SubTabItem}">
        <Border Style="{StaticResource GlassCard}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Tag="ابحث في سجل الهالك بالصنف أو رقم فاتورة المرتجع..."/>
              <ComboBox Grid.Column="2" SelectedIndex="0">
                <ComboBoxItem Content="كل مصادر الهالك"/>
                <ComboBoxItem Content="مرتجع عميل هالك (لا يعمل)"/>
                <ComboBoxItem Content="تلف أثناء التركيب أو التخزين"/>
                <ComboBoxItem Content="بانتظار إرجاعه للمورد"/>
              </ComboBox>
              <Button Grid.Column="4" Content="+ تسجيل قطعة هالكة يدويًا"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Style="{StaticResource TableHeaderBorder}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.6*"/>
                      <ColumnDefinition Width="70"/>
                      <ColumnDefinition Width="1.2*"/>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="105"/>
                      <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="الصنف التالف" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="الكمية" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="سبب التلف / المصدر" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="التاريخ" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="تكلفة الخسارة" FontWeight="Bold"/>
                    <TextBlock Grid.Column="5" Text="إجراءات التحكم بالهالك" FontWeight="Bold" HorizontalAlignment="Center"/>
                  </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding DamagedItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource TableRowBorder}">
                        <Grid VerticalAlignment="Center">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="260"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="{Binding Quantity}" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold"/>
                          <TextBlock Grid.Column="2" Text="{Binding DamageReason}"/>
                          <TextBlock Grid.Column="3" Text="{Binding DamageDate, StringFormat={}{0:yyyy/MM/dd}}"/>
                          <TextBlock Grid.Column="4" Text="{Binding LossValue, StringFormat={}{0:N0} ج.م}"/>
                          <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="رد للمخزون السليم" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                            <Button Content="رد للمورد" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                            <Button Content="إعدام / حذف" Style="{StaticResource SmallDangerButton}"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
