<UserControl x:Class="FitohPhone.Views.Pages.PurchaseInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.65*"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- القسم الأيمن: بيانات التاجر + إدراج الأصناف المسجلة + جدول الفاتورة -->
    <Border Grid.Column="0" Style="{StaticResource GlassCard}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- بيانات التاجر وفاتورة المورد -->
        <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.5*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="اسم التاجر / المورد *" Style="{StaticResource FieldLabelText}"/>
              <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name"
                        SelectedValue="{Binding SelectedSupplierId}" SelectedValuePath="Id"/>
            </StackPanel>
            <Button Grid.Column="2" Content="+ تاجر جديد" VerticalAlignment="Bottom" Click="OpenAddSupplier_Click" Padding="12,8"/>
            <StackPanel Grid.Column="4">
              <TextBlock Text="رقم فاتورة التاجر" Style="{StaticResource FieldLabelText}"/>
              <TextBox Text="{Binding InvoiceNumber}" FlowDirection="LeftToRight"/>
            </StackPanel>
            <StackPanel Grid.Column="6">
              <TextBlock Text="تاريخ الفاتورة" Style="{StaticResource FieldLabelText}"/>
              <TextBox Text="{Binding DateTime.Now, StringFormat={}{0:yyyy/MM/dd}}" FlowDirection="LeftToRight" IsReadOnly="True"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- اختيار صنف مسجل بالفعل وإدخال الكمية وسعر الشراء -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.8*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="85"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="البحث في الأصناف المسجلة بالفعل (باركود أو اسم)" Style="{StaticResource FieldLabelText}"/>
            <ComboBox x:Name="ProductSearch" ItemsSource="{Binding Products}" DisplayMemberPath="NameAr" SelectedValuePath="Id"
                      Tag="امسح الباركود أو اختر منتجًا مسجلًا لإضافته لفاتورة الشراء..."/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="الكمية" Style="{StaticResource FieldLabelText}"/>
            <TextBox x:Name="PurchaseQty" Text="1" FlowDirection="LeftToRight"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="سعر الشراء" Style="{StaticResource FieldLabelText}"/>
            <TextBox x:Name="PurchaseCost" Text="0" FlowDirection="LeftToRight"/>
          </StackPanel>
          <Button Grid.Column="6" Content="+ إضافة للفاتورة" VerticalAlignment="Bottom" Padding="16,10" Click="AddProduct_Click"/>
        </Grid>

        <!-- جدول أصناف فاتورة الشراء -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource TableHeaderBorder}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.8*"/>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="85"/>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="110"/>
                  <ColumnDefinition Width="65"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="المنتج المسجل" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="رصيد سابق" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="كمية الشراء" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="سعر الشراء" FontWeight="Bold"/>
                <TextBlock Grid.Column="4" Text="إجمالي السطر" FontWeight="Bold"/>
                <TextBlock Grid.Column="5" Text="حذف" FontWeight="Bold" HorizontalAlignment="Center"/>
              </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource TableRowBorder}">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="65"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Barcode}" Style="{StaticResource MutedText}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Quantity}" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="2" Text="{Binding Quantity}" FlowDirection="LeftToRight" Margin="0,0,8,0" Padding="8,5"/>
                      <TextBox Grid.Column="3" Text="{Binding UnitCost, StringFormat={}{0:N0}}" FlowDirection="LeftToRight" Margin="0,0,8,0" Padding="8,5"/>
                      <TextBlock Grid.Column="4" Text="{Binding LineTotal, StringFormat={}{0:N0} ج.م}" FontWeight="Bold" VerticalAlignment="Center"/>
                      <Button Grid.Column="5" Content="✕" Style="{StaticResource SmallDangerButton}"
                              Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding Id}" HorizontalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- القسم الأيسر: الدفع أجزاء (نقدي - فودافون كاش - انستاباي - آجل) -->
    <Border Grid.Column="2" Style="{StaticResource GlassCard}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="سداد فاتورة الشراء (دفع مقسّم / أجزاء)" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>

          <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="توزيع المبالغ المسددة للتاجر" FontWeight="Bold" Margin="0,0,0,10"/>

              <TextBlock Text="1) مدفوع نقدًا من الخزينة (ج.م)" Style="{StaticResource FieldLabelText}"/>
              <TextBox Text="{Binding CashPayment, StringFormat={}{0:N0}}" FlowDirection="LeftToRight" Margin="0,0,0,10"/>

              <TextBlock Text="2) مدفوع فودافون كاش + الخط المسحوب منه" Style="{StaticResource FieldLabelText}"/>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="0.9*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding VodafonePayment, StringFormat={}{0:N0}}" FlowDirection="LeftToRight"/>
                <ComboBox Grid.Column="2" SelectedIndex="0">
                  <ComboBoxItem Content="01012345678"/>
                  <ComboBoxItem Content="01098765432"/>
                </ComboBox>
              </Grid>

              <TextBlock Text="3) مدفوع إنستاباي (InstaPay) + الحساب" Style="{StaticResource FieldLabelText}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="0.9*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding InstaPayPayment, StringFormat={}{0:N0}}" FlowDirection="LeftToRight"/>
                <ComboBox Grid.Column="2" SelectedIndex="0">
                  <ComboBoxItem Content="01100032165"/>
                  <ComboBoxItem Content="012985411111"/>
                </ComboBox>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,14">
            <StackPanel>
              <Grid Margin="0,0,0,6">
                <TextBlock Text="إجمالي قيمة المشتريات:" Style="{StaticResource MutedText}"/>
                <TextBlock Text="{Binding InvoiceTotal, StringFormat={}{0:N0} ج.م}" FontWeight="Bold" HorizontalAlignment="Left"/>
              </Grid>
              <Grid Margin="0,0,0,8">
                <TextBlock Text="خصم التاجر على الفاتورة:" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                <TextBox Text="0" Width="95" HorizontalAlignment="Left" FlowDirection="LeftToRight" Padding="8,4"/>
              </Grid>
              <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,8"/>
              <Grid Margin="0,0,0,6">
                <TextBlock Text="إجمالي المدفوع الآن (أجزاء):" Style="{StaticResource MutedText}"/>
                <TextBlock Text="{Binding TotalPaid, StringFormat={}{0:N0} ج.م}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Left"/>
              </Grid>
              <Grid>
                <TextBlock Text="المتبقي آجل لحساب التاجر:" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Remaining, StringFormat={}{0:N0} ج.م}" FontWeight="Bold" FontSize="17" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Left"/>
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="ملاحظات التوريد" Style="{StaticResource FieldLabelText}"/>
            <TextBox Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Tag="تفاصيل الشحن أو رقم إيصال التحويل للتاجر..."/>
          </StackPanel>

          <Button Content="اعتماد فاتورة الشراء وإضافة الكميات للمخزون" Style="{StaticResource SuccessButton}" Padding="16,13" Margin="0,0,0,8"
                  Command="{Binding SaveCommand}"/>
          <Button Content="حفظ كمسودة" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
