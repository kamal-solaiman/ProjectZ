<UserControl x:Class="FitohPhone.Views.Pages.PhoneRepairsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TabControl Style="{StaticResource SubTabControl}">

    <!-- التبويب 1: استلام جهاز من العميل وطباعة باركود -->
    <TabItem Header="1. استلام جهاز من العميل وطباعة باركود" Style="{StaticResource SubTabItem}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource GlassCard}">
            <StackPanel>
              <TextBlock Text="بيانات العميل والجهاز المستلم للصيانة" Style="{StaticResource SectionTitleText}" Margin="0,0,0,14"/>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.4*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="اسم العميل *" Style="{StaticResource FieldLabelText}"/>
                  <ComboBox SelectedIndex="0">
                    <ComboBoxItem Content="أحمد طارق محمود — 01065432198"/>
                    <ComboBoxItem Content="سارة حسن علي — 01229988776"/>
                    <ComboBoxItem Content="محمود عادل — 01122334455"/>
                  </ComboBox>
                </StackPanel>
                <Button Grid.Column="2" Content="+ عميل جديد" VerticalAlignment="Bottom" Click="OpenAddCustomer_Click"/>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="رقم هاتف التواصل *" Style="{StaticResource FieldLabelText}"/>
                  <TextBox Text="01065432198" FlowDirection="LeftToRight"/>
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="1.2*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="ماركة الهاتف *" Style="{StaticResource FieldLabelText}"/>
                  <ComboBox SelectedIndex="0">
                    <ComboBoxItem Content="Apple iPhone"/>
                    <ComboBoxItem Content="Samsung"/>
                    <ComboBoxItem Content="Xiaomi / Redmi"/>
                    <ComboBoxItem Content="Oppo / Realme"/>
                    <ComboBoxItem Content="Infinix / Vivo"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="موديل الجهاز *" Style="{StaticResource FieldLabelText}"/>
                  <TextBox Text="iPhone 13 Pro 256GB"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="اللون" Style="{StaticResource FieldLabelText}"/>
                  <TextBox Text="أزرق سييرا"/>
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.2*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="رقم السيريال / IMEI" Style="{StaticResource FieldLabelText}"/>
                  <TextBox Text="356789112345678" FlowDirection="LeftToRight"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="رمز القفل / الباسورد للفحص" Style="{StaticResource FieldLabelText}"/>
                  <TextBox Text="258000" FlowDirection="LeftToRight"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="الفني المستلم" Style="{StaticResource FieldLabelText}"/>
                  <ComboBox SelectedIndex="0">
                    <ComboBoxItem Content="م. مصطفى (هاردوير)"/>
                    <ComboBoxItem Content="م. كريم (سوفت وشاشات)"/>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="وصف العطل وشكوى العميل *" Style="{StaticResource FieldLabelText}"/>
                <TextBox Height="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="كسر في الشاشة الأمامية مع خطوط خضراء، والعميل يطلب فحص صحة البطارية والسماعة العلوية."/>
              </StackPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="الحالة الظاهرية عند الاستلام" Style="{StaticResource FieldLabelText}"/>
                  <TextBox Text="خدش بسيط في الإطار السفلي - الظهر سليم"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="الملحقات المستلمة مع الهاتف" Style="{StaticResource FieldLabelText}"/>
                  <TextBox Text="جراب فقط (بدون شريحة وبدون كرتونة)"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource GlassCard}">
            <StackPanel>
              <TextBlock Text="التكلفة المبدئية والباركود" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>

              <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="رقم إيصال / باركود الصيانة التلقائي" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="REP-2026-0842" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <TextBlock Text="التكلفة التقديرية المبدئية (ج.م)" Style="{StaticResource FieldLabelText}"/>
              <TextBox Text="4200" FlowDirection="LeftToRight" Margin="0,0,0,10"/>

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="العربون المدفوع" Style="{StaticResource FieldLabelText}"/>
                  <TextBox Text="1000" FlowDirection="LeftToRight"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="طريقة دفع العربون" Style="{StaticResource FieldLabelText}"/>
                  <ComboBox SelectedIndex="0">
                    <ComboBoxItem Content="نقدي"/>
                    <ComboBoxItem Content="فودافون كاش"/>
                    <ComboBoxItem Content="إنستاباي"/>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <TextBlock Text="موعد التسليم المتوقع" Style="{StaticResource FieldLabelText}"/>
              <TextBox Text="2026/11/07 — 07:00 م" Margin="0,0,0,14"/>

              <Button Content="حفظ الاستلام وطباعة باركود الجهاز" Style="{StaticResource SuccessButton}" Padding="16,13" Margin="0,0,0,8" Click="OpenBarcodePreview_Click"/>
              <Button Content="معاينة ملصق الباركود وإيصال الاستلام" Style="{StaticResource SecondaryButton}" Click="OpenBarcodePreview_Click"/>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </TabItem>

    <!-- التبويب 2: صيانة الجهاز والتكاليف (صيانة + قطع غيار) وتسليمه للعميل -->
    <TabItem Header="2. متابعة الصيانة والتكاليف وتسليم الجهاز" Style="{StaticResource SubTabItem}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.15*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="1.35*"/>
        </Grid.ColumnDefinitions>

        <!-- قائمة الأجهزة قيد الصيانة والجاهزة -->
        <Border Grid.Column="0" Style="{StaticResource GlassCard}">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Tag="امسح باركود الإيصال أو ابحث بالهاتف..."/>
              <ComboBox Grid.Column="2" SelectedIndex="0">
                <ComboBoxItem Content="كل الأجهزة الحالية"/>
                <ComboBoxItem Content="قيد الصيانة"/>
                <ComboBoxItem Content="جاهزة للتسليم"/>
                <ComboBoxItem Content="تم تسليمها"/>
              </ComboBox>
            </Grid>

            <Border Style="{StaticResource TableHeaderBorder}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="85"/>
                  <ColumnDefinition Width="1.4*"/>
                  <ColumnDefinition Width="105"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="الباركود" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="الجهاز والعميل" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="الحالة" FontWeight="Bold"/>
              </Grid>
            </Border>

            <Border Style="{StaticResource TableRowBorder}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="85"/>
                  <ColumnDefinition Width="1.4*"/>
                  <ColumnDefinition Width="105"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="REP-0842" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="iPhone 13 Pro — أحمد طارق" FontWeight="SemiBold"/>
                  <TextBlock Text="01065432198" Style="{StaticResource MutedText}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="قيد الصيانة" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold"/>
              </Grid>
            </Border>

            <Border Style="{StaticResource TableRowAltBorder}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="85"/>
                  <ColumnDefinition Width="1.4*"/>
                  <ColumnDefinition Width="105"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="REP-0839" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Samsung A54 — محمود عادل" FontWeight="SemiBold"/>
                  <TextBlock Text="01122334455" Style="{StaticResource MutedText}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="جاهز للتسليم" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- تفاصيل العمل في الصيانة وتكلفة قطع الغيار والمصنعية والتسليم -->
        <Border Grid.Column="2" Style="{StaticResource GlassCard}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Grid Margin="0,0,0,12">
                <TextBlock Text="تقرير الصيانة والتكاليف والتسليم — REP-0842" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                <ComboBox SelectedIndex="2" Width="175" HorizontalAlignment="Left">
                  <ComboBoxItem Content="قيد الفحص"/>
                  <ComboBoxItem Content="قيد الصيانة"/>
                  <ComboBoxItem Content="جاهز للتسليم للعميل"/>
                  <ComboBoxItem Content="تم التسليم والتحصيل"/>
                  <ComboBoxItem Content="مرفوض / تعذر الإصلاح"/>
                </ComboBox>
              </Grid>

              <TextBlock Text="ما تم إجراؤه في الصيانة وقطع الغيار المركّبة *" Style="{StaticResource FieldLabelText}"/>
              <TextBox Height="66" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,12"
                       Text="تم فك الجهاز وتركيب شاشة أصلية خلع وكالة مع نقل شريحة True Tone بنجاح، وتنظيف السماعة العلوية وتغيير لاصق الحماية المقاوم للأتربة."/>

              <!-- حساب التكاليف: قطع الغيار + مصنعية الصيانة -->
              <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="تفصيل التكاليف والأرباح (قطع الغيار + مصنعية الصيانة)" FontWeight="Bold" Margin="0,0,0,10"/>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="تكلفة قطع الغيار (ج.م)" Style="{StaticResource FieldLabelText}"/>
                      <TextBox Text="3100" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="أجر / مصنعية الصيانة" Style="{StaticResource FieldLabelText}"/>
                      <TextBox Text="1100" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="إجمالي الفاتورة للعميل" Style="{StaticResource FieldLabelText}"/>
                      <TextBox Text="4200" FlowDirection="LeftToRight" FontWeight="Bold"/>
                    </StackPanel>
                  </Grid>

                  <Grid>
                    <TextBlock Text="العربون المسدد مسبقًا: 1,000 ج.م  •  صافي ربح الصيانة: 1,100 ج.م" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="المتبقي للتحصيل عند التسليم: 3,200 ج.م" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="طريقة تحصيل المبلغ المتبقي" Style="{StaticResource FieldLabelText}"/>
                  <ComboBox SelectedIndex="0">
                    <ComboBoxItem Content="نقدي بالخزينة"/>
                    <ComboBoxItem Content="فودافون كاش (01012345678)"/>
                    <ComboBoxItem Content="إنستاباي (01100032165)"/>
                    <ComboBoxItem Content="دفع مقسّم"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="ضمان الصيانة الممنوح للعميل" Style="{StaticResource FieldLabelText}"/>
                  <ComboBox SelectedIndex="1">
                    <ComboBoxItem Content="بدون ضمان (سوفت / سوائل)"/>
                    <ComboBoxItem Content="ضمان شهر على القطعة المستبدلة"/>
                    <ComboBoxItem Content="ضمان 3 أشهر"/>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="حفظ تحديثات الصيانة" Style="{StaticResource SecondaryButton}" Padding="14,12"/>
                <Button Grid.Column="2" Content="تأكيد تسليم الجهاز للعميل وطباعة الفاتورة" Style="{StaticResource SuccessButton}" Padding="14,12"/>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </TabItem>

    <!-- التبويب 3: عرض بيانات كل عميل كاملة بتواريخ الصيانات -->
    <TabItem Header="3. أرشيف صيانات العملاء الكامل بالتواريخ" Style="{StaticResource SubTabItem}">
      <Border Style="{StaticResource GlassCard}">
        <StackPanel>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.6*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="أحمد طارق محمود — 01065432198" Tag="ابحث باسم العميل أو رقم هاتفه أو IMEI لعرض تاريخ صياناته بالكامل..."/>
            <Button Grid.Column="2" Content="عرض سجل صيانات العميل"/>
          </Grid>

          <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,12">
            <TextBlock Text="العميل: أحمد طارق محمود  |  موبايل: 01065432198  |  إجمالي الأجهزة المصانة: 3 أجهزة  |  إجمالي مدفوعات الصيانة: 6,150 ج.م" FontWeight="SemiBold"/>
          </Border>

          <Border Style="{StaticResource TableHeaderBorder}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="95"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="الإيصال" FontWeight="Bold"/>
              <TextBlock Grid.Column="1" Text="تاريخ الاستلام" FontWeight="Bold"/>
              <TextBlock Grid.Column="2" Text="تاريخ التسليم" FontWeight="Bold"/>
              <TextBlock Grid.Column="3" Text="الهاتف" FontWeight="Bold"/>
              <TextBlock Grid.Column="4" Text="العطل وما تم إجراؤه في الصيانة" FontWeight="Bold"/>
              <TextBlock Grid.Column="5" Text="قطع الغيار" FontWeight="Bold"/>
              <TextBlock Grid.Column="6" Text="الإجمالي" FontWeight="Bold"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource TableRowBorder}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="95"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="REP-0842" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="1" Text="2026/11/06"/>
              <TextBlock Grid.Column="2" Text="قيد التسليم"/>
              <TextBlock Grid.Column="3" Text="iPhone 13 Pro"/>
              <TextBlock Grid.Column="4" Text="تغيير شاشة أصلية + تنظيف سماعة"/>
              <TextBlock Grid.Column="5" Text="3,100 ج"/>
              <TextBlock Grid.Column="6" Text="4,200 ج" FontWeight="Bold"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource TableRowAltBorder}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="95"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="REP-0611" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="1" Text="2026/08/14"/>
              <TextBlock Grid.Column="2" Text="2026/08/15"/>
              <TextBlock Grid.Column="3" Text="iPhone 13 Pro"/>
              <TextBlock Grid.Column="4" Text="تغيير بطارية أصلية 100% وبرمجة"/>
              <TextBlock Grid.Column="5" Text="950 ج"/>
              <TextBlock Grid.Column="6" Text="1,450 ج" FontWeight="Bold"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource TableRowBorder}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="95"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="REP-0390" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="1" Text="2026/05/02"/>
              <TextBlock Grid.Column="2" Text="2026/05/02"/>
              <TextBlock Grid.Column="3" Text="Samsung A32"/>
              <TextBlock Grid.Column="4" Text="تغيير فلاتة شحن أصلية"/>
              <TextBlock Grid.Column="5" Text="250 ج"/>
              <TextBlock Grid.Column="6" Text="500 ج" FontWeight="Bold"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </TabItem>
  </TabControl>
</UserControl>
