<UserControl x:Class="FitohPhone.Views.Pages.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- شريط الفواتير المتعددة (إمكانية البيع لأكثر من فاتورة في نفس الوقت) -->
    <Border Style="{StaticResource GlassCard}" Padding="10,8" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton Content="فاتورة #1041 (نشطة - 3 أصناف)" IsChecked="True" FontWeight="Bold"/>
          <RadioButton Content="فاتورة #1042 (معلقة - عميل جملة)" Margin="10,4,14,4"/>
          <RadioButton Content="فاتورة #1043 (فارغة)" Margin="10,4,14,4"/>
          <Button Content="+ فتح فاتورة بيع جديدة" Style="{StaticResource SmallActionButton}" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="نوع تسعير الفاتورة بالكامل:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
          <ComboBox SelectedIndex="0" Width="170">
            <ComboBoxItem Content="سعر قطاعي (جمهور)"/>
            <ComboBoxItem Content="سعر مميز (خاص)"/>
            <ComboBoxItem Content="سعر جملة (تجار)"/>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <!-- جسم نقطة البيع -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.65*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- القسم الأيمن: الباركود + البحث + سلة الفاتورة -->
      <Border Grid.Column="0" Style="{StaticResource GlassCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- مسح الباركود والبحث بالاسم -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.1*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="1.4*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="مسح الباركود السريع (Scanner)" Style="{StaticResource FieldLabelText}"/>
              <TextBox FlowDirection="LeftToRight" Tag="|| |||| امسح الباركود هنا (Enter)..."/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="البحث باسم المنتج أو الكود" Style="{StaticResource FieldLabelText}"/>
              <TextBox Tag="ابحث عن جراب، شاحن، سماعة، هاتف..."/>
            </StackPanel>
            <Button Grid.Column="4" Content="+ إدراج الصنف" VerticalAlignment="Bottom" Padding="16,10"/>
          </Grid>

          <!-- أزرار سريعة للأصناف الشائعة -->
          <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="اسكرينة زجاج 5D (50 ج)" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"/>
            <Button Content="شاحن Anker 20W (480 ج)" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"/>
            <Button Content="كابل Type-C أصلي (150 ج)" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"/>
            <Button Content="سماعة AirPods Pro Copy (550 ج)" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"/>
            <Button Content="جراب MagSafe شفاف (120 ج)" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"/>
          </WrapPanel>

          <!-- جدول أصناف الفاتورة (مع اختيار نوع السعر لكل منتج مستقلًا) -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource TableHeaderBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="55"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="المنتج / الباركود" FontWeight="Bold"/>
                  <TextBlock Grid.Column="1" Text="نوع سعر الصنف" FontWeight="Bold"/>
                  <TextBlock Grid.Column="2" Text="سعر الوحدة" FontWeight="Bold"/>
                  <TextBlock Grid.Column="3" Text="الكمية" FontWeight="Bold"/>
                  <TextBlock Grid.Column="4" Text="خصم" FontWeight="Bold"/>
                  <TextBlock Grid.Column="5" Text="الإجمالي" FontWeight="Bold"/>
                  <TextBlock Grid.Column="6" Text="حذف" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
              </Border>

              <!-- صنف 1 -->
              <Border Style="{StaticResource TableRowBorder}">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="55"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="هاتف Samsung Galaxy A15 128GB" FontWeight="SemiBold"/>
                    <TextBlock Text="6223001458921 • متاح: 6" Style="{StaticResource MutedText}"/>
                  </StackPanel>
                  <ComboBox Grid.Column="1" SelectedIndex="0" Margin="0,0,6,0" Padding="8,5">
                    <ComboBoxItem Content="قطاعي"/>
                    <ComboBoxItem Content="مميز"/>
                    <ComboBoxItem Content="جملة"/>
                  </ComboBox>
                  <TextBox Grid.Column="2" Text="7200" FlowDirection="LeftToRight" Margin="0,0,6,0" Padding="8,5"/>
                  <TextBox Grid.Column="3" Text="1" FlowDirection="LeftToRight" Margin="0,0,6,0" Padding="8,5"/>
                  <TextBox Grid.Column="4" Text="0" FlowDirection="LeftToRight" Margin="0,0,6,0" Padding="8,5"/>
                  <TextBlock Grid.Column="5" Text="7,200 ج" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Button Grid.Column="6" Content="✕" Style="{StaticResource SmallDangerButton}" HorizontalAlignment="Center"/>
                </Grid>
              </Border>

              <!-- صنف 2 (بسعر مميز مختلف داخل نفس الفاتورة!) -->
              <Border Style="{StaticResource TableRowAltBorder}">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="55"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="شاحن Samsung 25W Super Fast أصلي" FontWeight="SemiBold"/>
                    <TextBlock Text="8806092123456 • متاح: 14" Style="{StaticResource MutedText}"/>
                  </StackPanel>
                  <ComboBox Grid.Column="1" SelectedIndex="1" Margin="0,0,6,0" Padding="8,5">
                    <ComboBoxItem Content="قطاعي"/>
                    <ComboBoxItem Content="مميز"/>
                    <ComboBoxItem Content="جملة"/>
                  </ComboBox>
                  <TextBox Grid.Column="2" Text="550" FlowDirection="LeftToRight" Margin="0,0,6,0" Padding="8,5"/>
                  <TextBox Grid.Column="3" Text="1" FlowDirection="LeftToRight" Margin="0,0,6,0" Padding="8,5"/>
                  <TextBox Grid.Column="4" Text="0" FlowDirection="LeftToRight" Margin="0,0,6,0" Padding="8,5"/>
                  <TextBlock Grid.Column="5" Text="550 ج" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Button Grid.Column="6" Content="✕" Style="{StaticResource SmallDangerButton}" HorizontalAlignment="Center"/>
                </Grid>
              </Border>

              <!-- صنف 3 (بسعر جملة) -->
              <Border Style="{StaticResource TableRowBorder}">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="55"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="جراب سيليكون + اسكرينة حماية 9H" FontWeight="SemiBold"/>
                    <TextBlock Text="1002003004005 • متاح: 42" Style="{StaticResource MutedText}"/>
                  </StackPanel>
                  <ComboBox Grid.Column="1" SelectedIndex="2" Margin="0,0,6,0" Padding="8,5">
                    <ComboBoxItem Content="قطاعي"/>
                    <ComboBoxItem Content="مميز"/>
                    <ComboBoxItem Content="جملة"/>
                  </ComboBox>
                  <TextBox Grid.Column="2" Text="125" FlowDirection="LeftToRight" Margin="0,0,6,0" Padding="8,5"/>
                  <TextBox Grid.Column="3" Text="2" FlowDirection="LeftToRight" Margin="0,0,6,0" Padding="8,5"/>
                  <TextBox Grid.Column="4" Text="0" FlowDirection="LeftToRight" Margin="0,0,6,0" Padding="8,5"/>
                  <TextBlock Grid.Column="5" Text="250 ج" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Button Grid.Column="6" Content="✕" Style="{StaticResource SmallDangerButton}" HorizontalAlignment="Center"/>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="عدد البنود: 3 أصناف (إجمالي 4 قطع) • يمكنك تخصيص السعر لكل سطر أو للفاتورة بالكامل" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <Button Content="تفريغ الفاتورة الحالية" Style="{StaticResource SmallDangerButton}" HorizontalAlignment="Left"/>
          </Grid>
        </Grid>
      </Border>

      <!-- القسم الأيسر: بيانات العميل + الدفع المتعدد والمختلط + الإجمالي -->
      <Border Grid.Column="2" Style="{StaticResource GlassCard}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- بيانات العميل + زر فتح نافذة إضافة عميل -->
            <TextBlock Text="بيانات العميل" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox Grid.Column="0" SelectedIndex="0">
                <ComboBoxItem Content="عميل نقدي مباشر"/>
                <ComboBoxItem Content="أحمد طارق — 01065432198 (مميز)"/>
                <ComboBoxItem Content="محل الهدى فون — 01011223344 (جملة)"/>
              </ComboBox>
              <Button Grid.Column="2" Content="+ عميل جديد" Click="OpenAddCustomer_Click" Padding="12,8"/>
            </Grid>

            <!-- طرق الدفع المتعددة والمشتركة (نقدي + فودافون كاش + انستاباي معًا) -->
            <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="توزيع السداد (يدعم الدفع المفرد أو المختلط معًا)" FontWeight="Bold" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,10">
                  <Button Content="الكل نقدي" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"/>
                  <Button Content="الكل فودافون كاش" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"/>
                  <Button Content="الكل إنستاباي" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"/>
                  <Button Content="دفع مختلط مقسّم" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"/>
                </WrapPanel>

                <!-- 1. نقدي -->
                <TextBlock Text="1) المسدد نقدًا بالخزينة (ج.م)" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="3000" FlowDirection="LeftToRight" Margin="0,0,0,10"/>

                <!-- 2. فودافون كاش -->
                <TextBlock Text="2) المسدد عبر فودافون كاش + الخط المستلم" Style="{StaticResource FieldLabelText}"/>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1.2*"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="2000" FlowDirection="LeftToRight"/>
                  <ComboBox Grid.Column="2" SelectedIndex="0">
                    <ComboBoxItem Content="01012345678"/>
                    <ComboBoxItem Content="01098765432"/>
                  </ComboBox>
                </Grid>

                <!-- 3. إنستاباي -->
                <TextBlock Text="3) المسدد عبر إنستاباي (InstaPay) + الحساب" Style="{StaticResource FieldLabelText}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1.2*"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="3000" FlowDirection="LeftToRight"/>
                  <ComboBox Grid.Column="2" SelectedIndex="0">
                    <ComboBoxItem Content="01100032165"/>
                    <ComboBoxItem Content="012985411111"/>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>

            <!-- ملخص الحساب النهائي -->
            <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,14">
              <StackPanel>
                <Grid Margin="0,0,0,6">
                  <TextBlock Text="إجمالي الفاتورة قبل الخصم:" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="8,000.00 ج.م" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                  <TextBlock Text="خصم إضافي على الفاتورة:" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                  <TextBox Text="0" Width="95" HorizontalAlignment="Left" FlowDirection="LeftToRight" Padding="8,4"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,8"/>
                <Grid Margin="0,0,0,6">
                  <TextBlock Text="الصافي المطلوب سداده:" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="8,000.00 ج.م" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                  <TextBlock Text="إجمالي المدفوع (نقدي + فودافون + إنستاباي):" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="8,000.00 ج.م" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid>
                  <TextBlock Text="المتبقي / الآجل على العميل:" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="0.00 ج.م" FontWeight="Bold" HorizontalAlignment="Left"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- أزرار إتمام البيع -->
            <Button Content="إتمام البيع وطباعة الفاتورة (F12)" Style="{StaticResource SuccessButton}" Padding="18,13" FontSize="15" Margin="0,0,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="حفظ بدون طباعة" Style="{StaticResource SecondaryButton}"/>
              <Button Grid.Column="2" Content="تعليق الفاتورة مؤقتًا" Style="{StaticResource SecondaryButton}"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
