<UserControl x:Class="FitohPhone.Views.Pages.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- شريط الفواتير المتعددة + نوع التسعير -->
    <Border Style="{StaticResource GlassCard}" Padding="10,8" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="فاتورة البيع الحالية" FontWeight="Bold" Margin="0,0,12,0"/>
          <Button Content="+ فتح فاتورة بيع جديدة" Style="{StaticResource SmallActionButton}" Margin="8,0,0,0"
                  Command="{Binding NewInvoiceCommand}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="نوع تسعير الفاتورة بالكامل:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
          <ComboBox x:Name="PriceTierCombo" SelectedItem="{Binding PriceTier}" Width="170"
                    ItemsSource="{Binding PriceTiers}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- جسم نقطة البيع -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.65*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- القسم الأيمن: الباركود + البحث + سلة الفاتورة -->
      <Border Grid.Column="0" Style="{StaticResource GlassCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- مسح الباركود والبحث بالاسم -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.1*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="1.4*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="مسح الباركود السريع (Scanner)" Style="{StaticResource FieldLabelText}"/>
              <TextBox x:Name="BarcodeInputBox" FlowDirection="LeftToRight"
                       Tag="|| |||| امسح الباركود هنا (Enter)..."
                       Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="البحث باسم المنتج أو الكود" Style="{StaticResource FieldLabelText}"/>
              <ComboBox x:Name="ProductSearch" ItemsSource="{Binding Products}" 
                        DisplayMemberPath="NameAr" SelectedValuePath="Id"
                        Tag="ابحث عن جراب، شاحن، سماعة، هاتف..."/>
            </StackPanel>
            <Button Grid.Column="4" Content="+ إدراج الصنف" VerticalAlignment="Bottom" Padding="16,10"
                    Command="{Binding AddItemCommand}"/>
          </Grid>

          <!-- أزرار سريعة للأصناف الشائعة (منتجات من قاعدة البيانات) -->
          <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Products}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding NameAr}" Style="{StaticResource SmallActionButton}"
                          Margin="0,0,6,6" Padding="10,6"
                          Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding Barcode}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </WrapPanel>

          <!-- جدول أصناف الفاتورة (مع اختيار نوع السعر لكل منتج مستقلًا) -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource TableHeaderBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="55"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="المنتج / الباركود" FontWeight="Bold"/>
                  <TextBlock Grid.Column="1" Text="نوع سعر الصنف" FontWeight="Bold"/>
                  <TextBlock Grid.Column="2" Text="سعر الوحدة" FontWeight="Bold"/>
                  <TextBlock Grid.Column="3" Text="الكمية" FontWeight="Bold"/>
                  <TextBlock Grid.Column="4" Text="خصم" FontWeight="Bold"/>
                  <TextBlock Grid.Column="5" Text="الإجمالي" FontWeight="Bold"/>
                  <TextBlock Grid.Column="6" Text="حذف" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
              </Border>

              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource TableRowBorder}">
                      <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="1.8*"/>
                          <ColumnDefinition Width="125"/>
                          <ColumnDefinition Width="85"/>
                          <ColumnDefinition Width="75"/>
                          <ColumnDefinition Width="85"/>
                          <ColumnDefinition Width="95"/>
                          <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Barcode}" Style="{StaticResource MutedText}" FlowDirection="LeftToRight"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.PriceTiers, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  SelectedItem="{Binding PriceTierUsed}" Margin="0,0,6,0" Padding="8,5"/>
                        <TextBox Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N0}}" FlowDirection="LeftToRight"
                                 Margin="0,0,6,0" Padding="8,5"/>
                        <TextBox Grid.Column="3" Text="{Binding Quantity}" FlowDirection="LeftToRight"
                                 Margin="0,0,6,0" Padding="8,5"/>
                        <TextBox Grid.Column="4" Text="{Binding DiscountAmount, StringFormat={}{0:N0}}" FlowDirection="LeftToRight"
                                 Margin="0,0,6,0" Padding="8,5"/>
                        <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat={}{0:N0} ج}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="6" Content="✕" Style="{StaticResource SmallDangerButton}"
                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Id}" HorizontalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding Lines.Count, StringFormat=عدد البنود: {0} أصناف}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding InvoiceTotal, StringFormat= • إجمالي: {0:N0} ج}" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontWeight="Bold"/>
            <Button Content="تفريغ الفاتورة الحالية" Style="{StaticResource SmallDangerButton}" HorizontalAlignment="Left"
                    Command="{Binding NewInvoiceCommand}"/>
          </Grid>
        </Grid>
      </Border>

      <!-- القسم الأيسر: بيانات العميل + الدفع المتعدد والمختلط + الإجمالي -->
      <Border Grid.Column="2" Style="{StaticResource GlassCard}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- بيانات العميل + زر فتح نافذة إضافة عميل -->
            <TextBlock Text="بيانات العميل" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox Grid.Column="0" ItemsSource="{Binding Customers}" DisplayMemberPath="Name"
                        SelectedValue="{Binding SelectedCustomerId}" SelectedValuePath="Id"/>
              <Button Grid.Column="2" Content="+ عميل جديد" Click="OpenAddCustomer_Click" Padding="12,8"/>
            </Grid>
            <TextBlock Text="{Binding SelectedCustomerName, StringFormat=العميل المحدد: {0}, TargetNullValue=عميل نقدي مباشر}"
                       Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding SelectedCustomerPhone, StringFormat='الهاتف: {0}'}"
                       Style="{StaticResource MutedText}" Margin="0,0,0,10"/>

            <!-- طرق الدفع المتعددة والمشتركة (نقدي + فودافون كاش + انستاباي معًا) -->
            <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="توزيع السداد (يدعم الدفع المفرد أو المختلط معًا)" FontWeight="Bold" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,10">
                  <Button Content="الكل نقدي" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6" Click="AllCash_Click"/>
                  <Button Content="الكل فودافون كاش" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6" Click="AllVodafone_Click"/>
                  <Button Content="الكل إنستاباي" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6" Click="AllInstaPay_Click"/>
                  <Button Content="دفع مختلط مقسّم" Style="{StaticResource SmallActionButton}" Margin="0,0,6,6"/>
                </WrapPanel>

                <!-- 1. نقدي -->
                <TextBlock Text="1) المسدد نقدًا بالخزينة (ج.م)" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="{Binding CashAmount, StringFormat={}{0:N0}}" FlowDirection="LeftToRight" Margin="0,0,0,10"/>

                <!-- 2. فودافون كاش -->
                <TextBlock Text="2) المسدد عبر فودافون كاش + الخط المستلم" Style="{StaticResource FieldLabelText}"/>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1.2*"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding VodafoneAmount, StringFormat={}{0:N0}}" FlowDirection="LeftToRight"/>
                  <ComboBox Grid.Column="2" SelectedIndex="0">
                    <ComboBoxItem Content="01012345678"/>
                    <ComboBoxItem Content="01098765432"/>
                  </ComboBox>
                </Grid>

                <!-- 3. إنستاباي -->
                <TextBlock Text="3) المسدد عبر إنستاباي (InstaPay) + الحساب" Style="{StaticResource FieldLabelText}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1.2*"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding InstaPayAmount, StringFormat={}{0:N0}}" FlowDirection="LeftToRight"/>
                  <ComboBox Grid.Column="2" SelectedIndex="0">
                    <ComboBoxItem Content="01100032165"/>
                    <ComboBoxItem Content="012985411111"/>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>

            <!-- ملخص الحساب النهائي -->
            <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,14">
              <StackPanel>
                <Grid Margin="0,0,0,6">
                  <TextBlock Text="إجمالي الفاتورة:" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="{Binding InvoiceTotal, StringFormat={}{0:N0} ج.م}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                  <TextBlock Text="خصم إضافي على الفاتورة:" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                  <TextBox Text="0" Width="95" HorizontalAlignment="Left" FlowDirection="LeftToRight" Padding="8,4"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,8"/>
                <Grid Margin="0,0,0,6">
                  <TextBlock Text="الصافي المطلوب سداده:" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="{Binding InvoiceTotal, StringFormat={}{0:N0} ج.م}" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                  <TextBlock Text="إجمالي المدفوع (نقدي + فودافون + إنستاباي):" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="{Binding PaymentTotal, StringFormat={}{0:N0} ج.م}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid>
                  <TextBlock Text="المتبقي / الآجل على العميل:" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="{Binding RemainingToPay, StringFormat={}{0:N0} ج.م}" FontWeight="Bold" HorizontalAlignment="Left"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- أزرار إتمام البيع -->
            <Button Content="إتمام البيع وطباعة الفاتورة (F12)" Style="{StaticResource SuccessButton}" Padding="18,13" FontSize="15"
                    Margin="0,0,0,8" Command="{Binding SaveInvoiceCommand}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="حفظ بدون طباعة" Style="{StaticResource SecondaryButton}"
                      Command="{Binding SaveInvoiceCommand}"/>
              <Button Grid.Column="2" Content="تعليق الفاتورة مؤقتًا" Style="{StaticResource SecondaryButton}"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
