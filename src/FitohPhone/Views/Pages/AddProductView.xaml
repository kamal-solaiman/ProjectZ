<UserControl x:Class="FitohPhone.Views.Pages.AddProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/microsoft-com/controls/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,4,18">
    <StackPanel>
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.45*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- بطاقة بيانات الصنف والباركود -->
        <Border Grid.Column="0" Style="{StaticResource GlassCard}">
          <StackPanel>
            <TextBlock Text="البيانات الأساسية للصنف والباركود" Style="{StaticResource SectionTitleText}" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="اسم الصنف بالكامل *" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="{Binding NameAr, UpdateSourceTrigger=PropertyChanged}" Tag="مثال: شاحن Anker 20W PowerPort III Type-C أصلي"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="التصنيف / القسم *" Style="{StaticResource FieldLabelText}"/>
                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="NameAr" SelectedValuePath="Id" SelectedValue="{Binding CategoryId, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="الماركة / الشركة المصنعة" Style="{StaticResource FieldLabelText}"/>
                <ComboBox ItemsSource="{Binding Brands}" DisplayMemberPath="NameAr" SelectedValuePath="Id" SelectedValue="{Binding BrandId, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="الموديل المتوافق / اللون" Style="{StaticResource FieldLabelText}"/>
                <TextBox Tag="مثال: iPhone 15 Pro Max - أسود"/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="وحدة القياس" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Tag="قطعة"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="الباركود الدولي أو الداخلي *" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Tag="امسح الباركود أو ولّد باركود تلقائي..."/>
              </StackPanel>
              <Button Grid.Column="2" Content="توليد باركود تلقائي" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Click="GenerateBarcode_Click"/>
              <StackPanel Grid.Column="4">
                <TextBlock Text="كود الصنف المختصر (SKU)" Style="{StaticResource FieldLabelText}"/>
                <TextBox FlowDirection="LeftToRight" Tag="PRD-0866"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="المورد / التاجر الافتراضي" Style="{StaticResource FieldLabelText}"/>
                <TextBox Tag="شركة النور للإكسسوارات..."/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="موقع التخزين (الرف / الدرج)" Style="{StaticResource FieldLabelText}"/>
                <TextBox Tag="مثال: فاترينة 2 - رف B"/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="فترة الضمان للعميل" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="{Binding WarrantyMonths, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Tag="أشهر الضمان..."/>
              </StackPanel>
            </Grid>

            <StackPanel Margin="0,6,0,0">
              <TextBlock Text="وصف وملاحظات الصنف" Style="{StaticResource FieldLabelText}"/>
              <TextBox Height="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Tag="مواصفات إضافية تظهر للكاشير عند البيع..."/>
            </StackPanel>

            <CheckBox Content="يتطلب إدخال سيريال / IMEI عند البيع (للهواتف)" IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>

            <Button Content="حفظ وتسجيل الصنف الجديد" Style="{StaticResource SuccessButton}" Padding="16,12" Margin="0,10,0,8" Click="SaveProduct_Click"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="حفظ + طباعة باركود" Style="{StaticResource SecondaryButton}" Click="SaveAndPrintBarcode_Click"/>
              <Button Grid.Column="2" Content="مسح الحقول" Style="{StaticResource SecondaryButton}" Click="ClearFields_Click"/>
            </Grid>

            <!-- عرض رسالة الخطأ أو النجاح -->
            <TextBlock Text="{Binding Error, TargetNullValue=}" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>

        <!-- بطاقة الأسعار الثلاثة والمخزون الافتتاحي -->
        <Border Grid.Column="2" Style="{StaticResource GlassCard}">
          <StackPanel>
            <TextBlock Text="سياسة الأسعار والرصيد الافتتاحي" Style="{StaticResource SectionTitleText}" Margin="0,0,0,14"/>

            <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="1. تكلفة الشراء" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="سعر الشراء للقطعة (ج.م) *" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" FlowDirection="LeftToRight" Tag="0.00"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="2. شرائح أسعار البيع الثلاثة" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="السعر القطاعي (الجمهور الافتراضي) *" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="{Binding PriceWholesale, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" FlowDirection="LeftToRight" Margin="0,0,0,10" Tag="0.00"/>

                <TextBlock Text="السعر المميز (عملاء خاص / VIP) *" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="{Binding PriceSpecial, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" FlowDirection="LeftToRight" Margin="0,0,0,10" Tag="0.00"/>

                <TextBlock Text="سعر الجملة (للتجار والمحلات) *" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="{Binding PriceRetail, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" FlowDirection="LeftToRight" Tag="0.00"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="الكمية الافتتاحية" Style="{StaticResource FieldLabelText}"/>
                  <TextBox Text="{Binding CurrentStock, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" FlowDirection="LeftToRight" Tag="0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="حد تنبيه النواقص" Style="{StaticResource FieldLabelText}"/>
                  <TextBox Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" FlowDirection="LeftToRight" Tag="0"/>
                </StackPanel>
              </Grid>
            </Border>

            <CheckBox Content="المنتج نشط ومتاح للبيع" IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding Error, TargetNullValue=}" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- جدول آخر الأصناف المسجلة حديثًا -->
      <Border Style="{StaticResource GlassCard}">
        <StackPanel>
          <TextBlock Text="آخر الأصناف المضافة حديثًا" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
          <Border Style="{StaticResource TableHeaderBorder}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="80"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="الباركود" FontWeight="Bold"/>
              <TextBlock Grid.Column="1" Text="اسم الصنف" FontWeight="Bold"/>
              <TextBlock Grid.Column="2" Text="التصنيف" FontWeight="Bold"/>
              <TextBlock Grid.Column="3" Text="سعر الشراء" FontWeight="Bold"/>
              <TextBlock Grid.Column="4" Text="قطاعي" FontWeight="Bold"/>
              <TextBlock Grid.Column="5" Text="مميز" FontWeight="Bold"/>
              <TextBlock Grid.Column="6" Text="جملة" FontWeight="Bold"/>
              <TextBlock Grid.Column="7" Text="الكمية" FontWeight="Bold"/>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding Products}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource TableRowBorder}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="1.8*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="95"/>
                      <ColumnDefinition Width="95"/>
                      <ColumnDefinition Width="95"/>
                      <ColumnDefinition Width="95"/>
                      <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Barcode}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="1" Text="{Binding NameAr}"/>
                    <TextBlock Grid.Column="2" Text="{Binding CategoryName, TargetNullValue=غير محدد}"/>
                    <TextBlock Grid.Column="3" Text="{Binding CostPrice, StringFormat={}{0:N0} ج}"/>
                    <TextBlock Grid.Column="4" Text="{Binding PriceWholesale, StringFormat={}{0:N0} ج}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="5" Text="{Binding PriceSpecial, StringFormat={}{0:N0} ج}"/>
                    <TextBlock Grid.Column="6" Text="{Binding PriceRetail, StringFormat={}{0:N0} ج}"/>
                    <TextBlock Grid.Column="7" Text="{Binding CurrentStock}" HorizontalAlignment="Right"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
