<UserControl x:Class="FitohPhone.Views.Pages.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/microsoft-com/controls/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.15*"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="1.35*"/>
    </Grid.ColumnDefinitions>

    <!-- القسم الأيمن: قائمة المستخدمين + نموذج إضافة وتعديل المستخدم -->
    <Border Grid.Column="0" Style="{StaticResource GlassCard}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="إدارة حسابات المستخدمين" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>

          <!-- بطاقة الإحصائيات -->
          <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
              <Border Padding="12,8" Background="{DynamicResource InfoSoftBrush}" CornerRadius="8" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="{Binding TotalUsers}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/>
                  <TextBlock Text="إجمالي المستخدمين" FontSize="11" Style="{StaticResource MutedText}"/>
                </StackPanel>
              </Border>
              <Border Padding="12,8" Background="{DynamicResource SuccessSoftBrush}" CornerRadius="8">
                <StackPanel>
                  <TextBlock Text="{Binding ActiveUsers}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                  <TextBlock Text="مستخدم نشط" FontSize="11" Style="{StaticResource MutedText}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- نموذج إضافة / تعديل مستخدم -->
          <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="إضافة / تعديل بيانات مستخدم" FontWeight="Bold" Margin="0,0,0,10"/>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="الاسم المعروض *" Style="{StaticResource FieldLabelText}"/>
                  <TextBox x:Name="DisplayNameBox" Tag="مثال: محمد علي (كاشير)"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="اسم الدخول (Username) *" Style="{StaticResource FieldLabelText}"/>
                  <TextBox x:Name="UsernameBox" FlowDirection="LeftToRight" Tag="cashier1"/>
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="كلمة المرور *" Style="{StaticResource FieldLabelText}"/>
                  <PasswordBox x:Name="PasswordBox" FlowDirection="LeftToRight"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="الدور الوظيفي" Style="{StaticResource FieldLabelText}"/>
                  <ComboBox x:Name="RoleCombo" ItemsSource="{Binding Roles}" DisplayMemberPath="RoleNameAr" SelectedValuePath="Id" Margin="0,0,0,10"/>
                </StackPanel>
              </Grid>

              <CheckBox x:Name="IsActiveCheck" Content="الحساب نشط ومسموح له بتسجيل الدخول" IsChecked="True" Margin="0,0,0,10"/>

              <WrapPanel>
                <Button Content="+ إضافة مستخدم جديد" Margin="0,0,8,6" Click="AddUser_Click"/>
                <Button Content="حفظ التعديلات" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Click="SaveUser_Click"/>
                <Button Content="حذف المستخدم" Style="{StaticResource DangerButton}" Margin="0,0,0,6" Click="DeleteUser_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- جدول المستخدمين المسجلين -->
          <TextBlock Text="قائمة المستخدمين المسجلين" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
          <Border Style="{StaticResource TableHeaderBorder}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="125"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="الاسم / اسم الدخول" FontWeight="Bold"/>
              <TextBlock Grid.Column="1" Text="الدور" FontWeight="Bold"/>
              <TextBlock Grid.Column="2" Text="الحالة" FontWeight="Bold"/>
              <TextBlock Grid.Column="3" Text="تحكم" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding Users}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource TableRowBorder}">
                  <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.4*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="75"/>
                      <ColumnDefinition Width="125"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                      <TextBlock Text="{Binding Username}" Style="{StaticResource MutedText}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding RoleNameAr}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="نشط" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                      <Button Content="تعديل" Style="{StaticResource SmallActionButton}" Tag="{Binding Id}" Margin="0,0,5,0" Click="EditUser_Click"/>
                      <Button Content="صلاحيات" Style="{StaticResource SmallActionButton}" Tag="{Binding Id}" Click="PermissionsUser_Click"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- القسم الأيسر: مصفوفة الصلاحيات التفصيلية للمستخدم المحدد -->
    <Border Grid.Column="2" Style="{StaticResource GlassCard}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <TextBlock x:Name="PermissionsTitle" Text="تعديل صلاحيات المستخدم المحدد" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
              <Button Content="تحديد الكل" Style="{StaticResource SmallActionButton}" Margin="0,0,6,0" Click="SelectAllPermissions_Click"/>
              <Button Content="إلغاء الكل" Style="{StaticResource SmallActionButton}" Click="SelectNonePermissions_Click"/>
            </StackPanel>
          </Grid>

          <ItemsControl ItemsSource="{Binding Permissions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ElevatedCard}" Margin="0,0,8,10">
                  <StackPanel>
                    <TextBlock Text="{Binding ModuleNameAr}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <CheckBox Content="عرض" IsChecked="{Binding CanView}" Margin="0,0,0,3"/>
                    <CheckBox Content="إضافة" IsChecked="{Binding CanAdd}" Margin="0,0,0,3"/>
                    <CheckBox Content="تعديل" IsChecked="{Binding CanEdit}" Margin="0,0,0,3"/>
                    <CheckBox Content="حذف" IsChecked="{Binding CanDelete}" Margin="0,0,0,3"/>
                    <CheckBox Content="طباعة" IsChecked="{Binding CanPrint}" Margin="0,0,0,3"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="حفظ واعتماد صلاحيات المستخدم" Style="{StaticResource SuccessButton}" Padding="18,12" Margin="0,6,0,0" Click="SavePermissions_Click"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
