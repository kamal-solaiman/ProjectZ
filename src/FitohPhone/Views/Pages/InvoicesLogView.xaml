<UserControl x:Class="FitohPhone.Views.Pages.InvoicesLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="1.35*"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- فلاتر البحث المتقدم في الفواتير -->
    <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.4*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Tag="بحث برقم الفاتورة، اسم العميل/التاجر، أو رقم الهاتف..."/>
        <ComboBox Grid.Column="2" SelectedIndex="0">
          <ComboBoxItem Content="كل أنواع الفواتير"/>
          <ComboBoxItem Content="فواتير المبيعات (POS)"/>
          <ComboBoxItem Content="فواتير المشتريات"/>
          <ComboBoxItem Content="فواتير بها مرتجع / تعديل"/>
        </ComboBox>
        <ComboBox Grid.Column="4" SelectedIndex="0">
          <ComboBoxItem Content="كل طرق السداد"/>
          <ComboBoxItem Content="نقدي فقط"/>
          <ComboBoxItem Content="فودافون كاش"/>
          <ComboBoxItem Content="إنستاباي"/>
          <ComboBoxItem Content="دفع مختلط (أجزاء)"/>
          <ComboBoxItem Content="آجل / متبقي"/>
        </ComboBox>
        <ComboBox Grid.Column="6" SelectedIndex="0">
          <ComboBoxItem Content="فواتير اليوم"/>
          <ComboBoxItem Content="أمس"/>
          <ComboBoxItem Content="هذا الأسبوع"/>
          <ComboBoxItem Content="هذا الشهر"/>
          <ComboBoxItem Content="كل الفترات"/>
        </ComboBox>
        <Button Grid.Column="8" Content="تحديث السجل" Padding="18,9"/>
      </Grid>
    </Border>

    <!-- جدول الفواتير الرئيسي مع تحكم كامل -->
    <Border Grid.Row="1" Style="{StaticResource GlassCard}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource TableHeaderBorder}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="115"/>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="270"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="رقم الفاتورة" FontWeight="Bold"/>
              <TextBlock Grid.Column="1" Text="النوع" FontWeight="Bold"/>
              <TextBlock Grid.Column="2" Text="التاريخ والوقت" FontWeight="Bold"/>
              <TextBlock Grid.Column="3" Text="العميل / التاجر" FontWeight="Bold"/>
              <TextBlock Grid.Column="4" Text="طريقة السداد" FontWeight="Bold"/>
              <TextBlock Grid.Column="5" Text="الإجمالي" FontWeight="Bold"/>
              <TextBlock Grid.Column="6" Text="الحالة" FontWeight="Bold"/>
              <TextBlock Grid.Column="7" Text="التحكم الكامل بالفاتورة" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource TableRowBorder}">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="115"/>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="270"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="INV-1041" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="بيع POS" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="اليوم 08:15 م" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="أحمد طارق — 01065432198" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="4" Text="دفع مختلط" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="5" Text="8,000 ج.م" FontWeight="Bold" VerticalAlignment="Center"/>
              <Border Grid.Column="6" Background="{DynamicResource SuccessSoftBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="مكتملة" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
              </Border>
              <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="عرض" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                <Button Content="تعديل" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                <Button Content="طباعة" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                <Button Content="مرتجع" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                <Button Content="حذف" Style="{StaticResource SmallDangerButton}"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource TableRowAltBorder}">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="115"/>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="270"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="PUR-0419" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="مشتريات" Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="اليوم 05:40 م" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="شركة النور لتجارة الهواتف" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="4" Text="أجزاء + آجل" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="5" Text="25,000 ج.م" FontWeight="Bold" VerticalAlignment="Center"/>
              <Border Grid.Column="6" Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="متبقي 2000" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
              </Border>
              <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="عرض" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                <Button Content="تعديل" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                <Button Content="طباعة" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                <Button Content="سداد" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                <Button Content="حذف" Style="{StaticResource SmallDangerButton}"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource TableRowBorder}">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="115"/>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="270"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="INV-1038" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="بيع جملة" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="اليوم 02:10 م" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="محل الهدى فون — 01011223344" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="4" Text="إنستاباي" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="5" Text="4,650 ج.م" FontWeight="Bold" VerticalAlignment="Center"/>
              <Border Grid.Column="6" Background="{DynamicResource InfoSoftBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="معدّلة" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/>
              </Border>
              <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="عرض" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                <Button Content="تعديل" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                <Button Content="طباعة" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                <Button Content="مرتجع" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0"/>
                <Button Content="حذف" Style="{StaticResource SmallDangerButton}"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- معاينة مشتملات وتفاصيل الفاتورة المحددة -->
    <Border Grid.Row="3" Style="{StaticResource GlassCard}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.6*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="مشتملات الفاتورة المحددة (INV-1041) — الكاشير: admin" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
          <Border Style="{StaticResource TableRowBorder}">
            <TextBlock Text="1× Samsung Galaxy A15 128GB (قطاعي: 7,200 ج)  |  1× شاحن Samsung 25W (مميز: 550 ج)  |  2× جراب سيليكون (جملة: 250 ج)"/>
          </Border>
          <TextBlock Text="سجل التعديلات: لا توجد تعديلات أو مرتجعات سابقة على هذه الفاتورة." Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource ElevatedCard}">
          <StackPanel>
            <TextBlock Text="تفصيل الدفع المسجّل بالفاتورة" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Text="• نقدي بالخزينة: 3,000 ج.م" Margin="0,2"/>
            <TextBlock Text="• فودافون كاش (01012345678): 2,000 ج.م" Margin="0,2"/>
            <TextBlock Text="• إنستاباي (01100032165): 3,000 ج.م" Margin="0,2"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
