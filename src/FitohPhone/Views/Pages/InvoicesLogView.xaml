<UserControl x:Class="FitohPhone.Views.Pages.InvoicesLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="1.35*"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- فلاتر البحث المتقدم في الفواتير -->
    <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.4*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Tag="بحث برقم الفاتورة، اسم العميل/التاجر، أو رقم الهاتف..."/>
        <ComboBox Grid.Column="2" SelectedIndex="0">
          <ComboBoxItem Content="كل أنواع الفواتير"/>
          <ComboBoxItem Content="فواتير المبيعات (POS)"/>
          <ComboBoxItem Content="فواتير المشتريات"/>
          <ComboBoxItem Content="فواتير بها مرتجع / تعديل"/>
        </ComboBox>
        <ComboBox Grid.Column="4" SelectedIndex="0">
          <ComboBoxItem Content="كل طرق السداد"/>
          <ComboBoxItem Content="نقدي فقط"/>
          <ComboBoxItem Content="فودافون كاش"/>
          <ComboBoxItem Content="إنستاباي"/>
          <ComboBoxItem Content="دفع مختلط (أجزاء)"/>
          <ComboBoxItem Content="آجل / متبقي"/>
        </ComboBox>
        <ComboBox Grid.Column="6" SelectedIndex="0">
          <ComboBoxItem Content="فواتير اليوم"/>
          <ComboBoxItem Content="أمس"/>
          <ComboBoxItem Content="هذا الأسبوع"/>
          <ComboBoxItem Content="هذا الشهر"/>
          <ComboBoxItem Content="كل الفترات"/>
        </ComboBox>
        <Button Grid.Column="8" Content="تحديث السجل" Padding="18,9" Click="Refresh_Click"/>
      </Grid>
    </Border>

    <!-- جدول الفواتير الرئيسي مع تحكم كامل -->
    <Border Grid.Row="1" Style="{StaticResource GlassCard}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource TableHeaderBorder}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="115"/>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="270"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="رقم الفاتورة" FontWeight="Bold"/>
              <TextBlock Grid.Column="1" Text="النوع" FontWeight="Bold"/>
              <TextBlock Grid.Column="2" Text="التاريخ والوقت" FontWeight="Bold"/>
              <TextBlock Grid.Column="3" Text="العميل / التاجر" FontWeight="Bold"/>
              <TextBlock Grid.Column="4" Text="طريقة السداد" FontWeight="Bold"/>
              <TextBlock Grid.Column="5" Text="الإجمالي" FontWeight="Bold"/>
              <TextBlock Grid.Column="6" Text="الحالة" FontWeight="Bold"/>
              <TextBlock Grid.Column="7" Text="التحكم الكامل بالفاتورة" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding Invoices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource TableRowBorder}">
                  <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="105"/>
                      <ColumnDefinition Width="95"/>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="1.4*"/>
                      <ColumnDefinition Width="115"/>
                      <ColumnDefinition Width="105"/>
                      <ColumnDefinition Width="95"/>
                      <ColumnDefinition Width="270"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding InvoiceNumber}" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="بيع POS" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding InvoiceDate, StringFormat={}{0:yyyy/MM/dd HH:mm}}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding CustomerName}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding PaymentStatus}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="{Binding GrandTotal, StringFormat={}{0:N0} ج.م}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Grid.Column="6" Background="{Binding PaymentStatus, Converter={x:Null}, TargetNullValue={StaticResource SuccessSoftBrush}}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="{Binding PaymentStatus}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center">
                      <Button Content="عرض" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0" Tag="{Binding Id}" Click="ViewInvoice_Click"/>
                      <Button Content="تعديل" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0" Tag="{Binding Id}" Click="EditInvoice_Click"/>
                      <Button Content="طباعة" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0" Tag="{Binding Id}" Click="PrintInvoice_Click"/>
                      <Button Content="مرتجع" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0" Tag="{Binding Id}" Click="ReturnInvoice_Click"/>
                      <Button Content="إلغاء" Style="{StaticResource SmallDangerButton}" Tag="{Binding Id}" Click="CancelInvoice_Click"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- معاينة مشتملات وتفاصيل الفاتورة المحددة -->
    <Border Grid.Row="3" Style="{StaticResource GlassCard}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.6*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="مشتملات الفاتورة المحددة" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding SelectedInvoiceItems, TargetNullValue=اختر فاتورة من القائمة أعلاه لعرض مشتملاتها}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
          <TextBlock Text="سجل التعديلات: لا توجد تعديلات أو مرتجعات سابقة على هذه الفاتورة." Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource ElevatedCard}">
          <StackPanel>
            <TextBlock Text="تفصيل الدفع المسجّل بالفاتورة" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding SelectedInvoicePayments, TargetNullValue=اختر فاتورة لعرض تفاصيل الدفع}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
