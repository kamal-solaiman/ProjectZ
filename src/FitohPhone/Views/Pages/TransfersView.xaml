<UserControl x:Class="FitohPhone.Views.Pages.TransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,4,18">
    <StackPanel>

      <!-- 1. بطاقات الخطوط والأرصدة والحدود اليومية والشهرية (Limits) -->
      <Grid Margin="0,0,0,10">
        <TextBlock Text="خطوط فودافون كاش وإنستاباي والحدود اليومية والشهرية (Limits)" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
        <Button Content="+ إضافة رقم / خط جديد وتحديد الـ Limit" HorizontalAlignment="Left" Click="OpenTransferLine_Click"/>
      </Grid>

      <UniformGrid Columns="4" Margin="0,0,0,16">
        <!-- خط فودافون 1 -->
        <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="14">
          <StackPanel>
            <Grid>
              <Border Background="{DynamicResource VodafoneSoftBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                <TextBlock Text="فودافون كاش #1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VodafoneBrush}"/>
              </Border>
              <Button Content="تعديل" Style="{StaticResource SmallActionButton}" HorizontalAlignment="Left" Click="OpenTransferLine_Click"/>
            </Grid>
            <TextBlock Text="01012345678" FontFamily="Consolas" FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,8,0,2"/>
            <TextBlock Text="الرصيد: 3,000 ج.م" FontWeight="Bold" Foreground="{DynamicResource VodafoneBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="الـ Limit اليومي: 18,000 / 60,000 ج" FontSize="11" Style="{StaticResource MutedText}"/>
            <ProgressBar Value="30" Maximum="100" Margin="0,4,0,6"/>
            <TextBlock Text="الـ Limit الشهري: 95,000 / 200,000 ج" FontSize="11" Style="{StaticResource MutedText}"/>
            <ProgressBar Value="47" Maximum="100" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- خط فودافون 2 -->
        <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="14">
          <StackPanel>
            <Grid>
              <Border Background="{DynamicResource VodafoneSoftBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                <TextBlock Text="فودافون كاش #2" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VodafoneBrush}"/>
              </Border>
              <Button Content="تعديل" Style="{StaticResource SmallActionButton}" HorizontalAlignment="Left" Click="OpenTransferLine_Click"/>
            </Grid>
            <TextBlock Text="01098765432" FontFamily="Consolas" FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,8,0,2"/>
            <TextBlock Text="الرصيد: 5,000 ج.م" FontWeight="Bold" Foreground="{DynamicResource VodafoneBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="الـ Limit اليومي: 52,000 / 60,000 ج" FontSize="11" Foreground="{DynamicResource WarningBrush}"/>
            <ProgressBar Value="86" Maximum="100" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,6"/>
            <TextBlock Text="الـ Limit الشهري: 164,000 / 200,000 ج" FontSize="11" Style="{StaticResource MutedText}"/>
            <ProgressBar Value="82" Maximum="100" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- خط إنستاباي 1 -->
        <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="14">
          <StackPanel>
            <Grid>
              <Border Background="{DynamicResource InstaPaySoftBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                <TextBlock Text="إنستاباي #1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InstaPayBrush}"/>
              </Border>
              <Button Content="تعديل" Style="{StaticResource SmallActionButton}" HorizontalAlignment="Left" Click="OpenTransferLine_Click"/>
            </Grid>
            <TextBlock Text="01100032165" FontFamily="Consolas" FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,8,0,2"/>
            <TextBlock Text="الرصيد: 10,000 ج.م" FontWeight="Bold" Foreground="{DynamicResource InstaPayBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="الـ Limit اليومي: 24,000 / 120,000 ج" FontSize="11" Style="{StaticResource MutedText}"/>
            <ProgressBar Value="20" Maximum="100" Margin="0,4,0,6"/>
            <TextBlock Text="الـ Limit الشهري: 140,000 / 400,000 ج" FontSize="11" Style="{StaticResource MutedText}"/>
            <ProgressBar Value="35" Maximum="100" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- خط إنستاباي 2 -->
        <Border Style="{StaticResource GlassCard}" Padding="14">
          <StackPanel>
            <Grid>
              <Border Background="{DynamicResource InstaPaySoftBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                <TextBlock Text="إنستاباي #2" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InstaPayBrush}"/>
              </Border>
              <Button Content="تعديل" Style="{StaticResource SmallActionButton}" HorizontalAlignment="Left" Click="OpenTransferLine_Click"/>
            </Grid>
            <TextBlock Text="012985411111" FontFamily="Consolas" FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,8,0,2"/>
            <TextBlock Text="الرصيد: 1,000 ج.م" FontWeight="Bold" Foreground="{DynamicResource InstaPayBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="الـ Limit اليومي: 5,000 / 70,000 ج" FontSize="11" Style="{StaticResource MutedText}"/>
            <ProgressBar Value="7" Maximum="100" Margin="0,4,0,6"/>
            <TextBlock Text="الـ Limit الشهري: 32,000 / 300,000 ج" FontSize="11" Style="{StaticResource MutedText}"/>
            <ProgressBar Value="11" Maximum="100" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- 2. نموذج إجراء عملية تحويل + سجل التحويلات لكل رقم -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.05*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="1.55*"/>
        </Grid.ColumnDefinitions>

        <!-- نموذج إجراء التحويل -->
        <Border Grid.Column="0" Style="{StaticResource GlassCard}">
          <StackPanel>
            <TextBlock Text="إجراء عملية تحويل جديدة" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>

            <TextBlock Text="نوع المحفظة / الخدمة *" Style="{StaticResource FieldLabelText}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <RadioButton Content="فودافون كاش" IsChecked="True" FontWeight="Bold"/>
              <RadioButton Content="إنستاباي (InstaPay)"/>
            </StackPanel>

            <TextBlock Text="اتجاه التحويل *" Style="{StaticResource FieldLabelText}"/>
            <ComboBox SelectedIndex="0" Margin="0,0,0,12">
              <ComboBoxItem Content="تحويل صادر (من رقمي إلى رقم عميل)"/>
              <ComboBoxItem Content="تحويل وارد / سحب (من رقم عميل إلى رقمي)"/>
              <ComboBoxItem Content="تحويل داخلي بين خطوط المحل"/>
            </ComboBox>

            <TextBlock Text="اختر رقم المحل المستخدم *" Style="{StaticResource FieldLabelText}"/>
            <ComboBox SelectedIndex="0" Margin="0,0,0,12">
              <ComboBoxItem Content="01012345678 — متاح: 3,000 ج (باقي يومي 42,000)"/>
              <ComboBoxItem Content="01098765432 — متاح: 5,000 ج (باقي يومي 8,000)"/>
              <ComboBoxItem Content="01100032165 — إنستاباي (متاح: 10,000 ج)"/>
              <ComboBoxItem Content="012985411111 — إنستاباي (متاح: 1,000 ج)"/>
            </ComboBox>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="رقم العميل (الطرف الآخر) *" Style="{StaticResource FieldLabelText}"/>
                <TextBox FlowDirection="LeftToRight" Tag="010XXXXXXXX"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="اسم العميل (اختياري)" Style="{StaticResource FieldLabelText}"/>
                <TextBox Tag="اسم العميل للسجل..."/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="مبلغ التحويل (ج.م) *" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="1500" FlowDirection="LeftToRight"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="عمولة / ربح المحل (ج.م)" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="20" FlowDirection="LeftToRight"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="طريقة تسوية النقدية مع العميل" Style="{StaticResource FieldLabelText}"/>
            <ComboBox SelectedIndex="0" Margin="0,0,0,14">
              <ComboBoxItem Content="نقدي بالخزينة فورًا (1,520 ج.م)"/>
              <ComboBoxItem Content="تسجيل على حساب العميل الآجل"/>
            </ComboBox>

            <Button Content="تنفيذ وحفظ عملية التحويل" Style="{StaticResource SuccessButton}" Padding="16,12"/>
          </StackPanel>
        </Border>

        <!-- سجل التحويلات لكل رقم -->
        <Border Grid.Column="2" Style="{StaticResource GlassCard}">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="130"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Tag="ابحث برقم العميل أو اسم العميل أو المرجع..."/>
              <ComboBox Grid.Column="2" SelectedIndex="0">
                <ComboBoxItem Content="كل خطوط المحل"/>
                <ComboBoxItem Content="01012345678 (فودافون)"/>
                <ComboBoxItem Content="01098765432 (فودافون)"/>
                <ComboBoxItem Content="01100032165 (إنستاباي)"/>
                <ComboBoxItem Content="012985411111 (إنستاباي)"/>
              </ComboBox>
              <ComboBox Grid.Column="4" SelectedIndex="0">
                <ComboBoxItem Content="تحويلات اليوم"/>
                <ComboBoxItem Content="هذا الشهر"/>
                <ComboBoxItem Content="الكل"/>
              </ComboBox>
            </Grid>

            <Border Style="{StaticResource TableHeaderBorder}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="85"/>
                  <ColumnDefinition Width="95"/>
                  <ColumnDefinition Width="115"/>
                  <ColumnDefinition Width="115"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="الوقت" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="الاتجاه" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="خط المحل" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="رقم العميل" FontWeight="Bold"/>
                <TextBlock Grid.Column="4" Text="المبلغ" FontWeight="Bold"/>
                <TextBlock Grid.Column="5" Text="العمولة" FontWeight="Bold"/>
                <TextBlock Grid.Column="6" Text="تحكم" FontWeight="Bold" HorizontalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Style="{StaticResource TableRowBorder}">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="85"/>
                  <ColumnDefinition Width="95"/>
                  <ColumnDefinition Width="115"/>
                  <ColumnDefinition Width="115"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="08:40 م"/>
                <TextBlock Grid.Column="1" Text="إرسال صادر" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="01012345678" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="01055667788" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="2,000 ج" FontWeight="Bold"/>
                <TextBlock Grid.Column="5" Text="+25 ج" Foreground="{DynamicResource SuccessBrush}"/>
                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Content="تعديل" Style="{StaticResource SmallActionButton}" Margin="0,0,4,0"/>
                  <Button Content="حذف" Style="{StaticResource SmallDangerButton}"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource TableRowAltBorder}">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="85"/>
                  <ColumnDefinition Width="95"/>
                  <ColumnDefinition Width="115"/>
                  <ColumnDefinition Width="115"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="07:15 م"/>
                <TextBlock Grid.Column="1" Text="استقبال وارد" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="01100032165" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="01144332211" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="5,000 ج" FontWeight="Bold"/>
                <TextBlock Grid.Column="5" Text="+50 ج" Foreground="{DynamicResource SuccessBrush}"/>
                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Content="تعديل" Style="{StaticResource SmallActionButton}" Margin="0,0,4,0"/>
                  <Button Content="حذف" Style="{StaticResource SmallDangerButton}"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource TableRowBorder}">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="85"/>
                  <ColumnDefinition Width="95"/>
                  <ColumnDefinition Width="115"/>
                  <ColumnDefinition Width="115"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="04:50 م"/>
                <TextBlock Grid.Column="1" Text="إرسال صادر" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="01098765432" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="01099112233" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="3,500 ج" FontWeight="Bold"/>
                <TextBlock Grid.Column="5" Text="+35 ج" Foreground="{DynamicResource SuccessBrush}"/>
                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Content="تعديل" Style="{StaticResource SmallActionButton}" Margin="0,0,4,0"/>
                  <Button Content="حذف" Style="{StaticResource SmallDangerButton}"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
