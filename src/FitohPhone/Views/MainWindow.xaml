<Window x:Class="FitohPhone.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فيتوه فون"
        Width="760"
        Height="480"
        MinWidth="540"
        MinHeight="360"
        FlowDirection="RightToLeft"
        Language="ar-EG"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32" FlowDirection="RightToLeft">
        <Border Padding="40" CornerRadius="20" Background="White">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="فيتوه فون"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource Accent}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,30" />
                <TextBlock Text="{Binding Welcome}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <!-- Keep account identifiers readable when they contain Latin characters. -->
                <TextBlock Text="{Binding Username}"
                           Margin="0,12,0,32"
                           FontSize="16"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           FlowDirection="LeftToRight"
                           TextAlignment="Center" />
                <Button Content="تسجيل الخروج"
                        Command="{Binding LogoutCommand}"
                        MinWidth="180" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
