<Window x:Class="FitohPhone.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FitohPhone" Width="760" Height="480" MinWidth="540" MinHeight="360" WindowStartupLocation="CenterScreen">
 <Grid Margin="32"><Border Background="White" CornerRadius="20" Padding="40"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
  <TextBlock Text="FitohPhone" FlowDirection="LeftToRight" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,30"/>
  <TextBlock Text="{Binding Welcome}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
  <TextBlock Text="{Binding Username}" FlowDirection="LeftToRight" Foreground="#64748B" FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,32"/>
  <Button Content="تسجيل الخروج" Command="{Binding LogoutCommand}" MinWidth="180"/>
 </StackPanel></Border></Grid>
</Window>
