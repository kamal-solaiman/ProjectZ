<Window x:Class="FitohPhone.Views.Dialogs.AddCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة عميل جديد | FitohPhone"
        Width="640" Height="610" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Border Style="{StaticResource GlassCard}" Padding="24">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="تسجيل عميل جديد" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="أدخل بيانات العميل لإضافته مباشرة إلى قاعدة العملاء أو ربطه بالفاتورة الحالية" Style="{StaticResource MutedText}"/>
          </StackPanel>
        </Grid>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="اسم العميل بالكامل *" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="NameInput" Tag="مثال: أحمد محمد عبد الرحمن"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="شريحة التسعير الافتراضية" Style="{StaticResource FieldLabelText}"/>
                <ComboBox SelectedIndex="0">
                  <ComboBoxItem Content="سعر قطاعي (جمهور)"/>
                  <ComboBoxItem Content="سعر مميز (عميل خاص)"/>
                  <ComboBoxItem Content="سعر جملة (تاجر فرعي)"/>
                </ComboBox>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="رقم الموبايل الأساسي *" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="PhoneInput" FlowDirection="LeftToRight" Tag="010XXXXXXXX"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="رقم موبايل بديل / واتساب" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="AltPhoneInput" FlowDirection="LeftToRight" Tag="011XXXXXXXX"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.5*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="المدينة / المنطقة" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="CityInput" Tag="مثال: كفر الشيخ - وسط البلد"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="العنوان التفصيلي" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="AddressInput" Tag="الشارع / العلامة المميزة..."/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="الرصيد الافتتاحي (ج.م)" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="0.00" FlowDirection="LeftToRight"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="حالة الرصيد" Style="{StaticResource FieldLabelText}"/>
                <ComboBox SelectedIndex="0">
                  <ComboBoxItem Content="بدون رصيد سابق"/>
                  <ComboBoxItem Content="عليه (مدين للمحل)"/>
                  <ComboBoxItem Content="له (دائن لدى المحل)"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="الحد الأقصى للآجل" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="5000" FlowDirection="LeftToRight"/>
              </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,8">
              <TextBlock Text="ملاحظات إضافية (أرقام محافظ العميل للتحويلات / تفضيلات التعامل)" Style="{StaticResource FieldLabelText}"/>
              <TextBox Height="68" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Tag="اكتب أي ملاحظات تخص العميل أو رقم محفظته المعتاد..."/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="* نافذة تصميم جاهزة للربط البرمجي" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" MinWidth="100" Click="CloseWindow_Click"/>
          <Button Grid.Column="2" Content="حفظ واختيار العميل" MinWidth="170" Click="Save_Click"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
