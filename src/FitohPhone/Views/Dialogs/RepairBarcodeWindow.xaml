<Window x:Class="FitohPhone.Views.Dialogs.RepairBarcodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معاينة ملصق الباركود وإيصال استلام الصيانة | FitohPhone"
        Width="680" Height="560" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Border Style="{StaticResource GlassCard}" Padding="24">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="معاينة طباعة باركود الجهاز وإيصال العميل" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="ملصق حراري للجهاز (50×25 مم) + إيصال استلام العميل (80 مم)" Style="{StaticResource MutedText}"/>
        </StackPanel>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="1.25*"/>
          </Grid.ColumnDefinitions>

          <!-- Sticker Preview -->
          <Border Grid.Column="0" Style="{StaticResource ElevatedCard}" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock Text="ملصق يوضع على ظهر الهاتف" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
              <Border Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="FITOH PHONE - REPAIR" Foreground="#0F172A" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                  <TextBlock Text="أحمد طارق • 01065432198" Foreground="#334155" FontSize="11" HorizontalAlignment="Center" Margin="0,4"/>
                  <TextBlock Text="iPhone 13 Pro - تغيير شاشة" Foreground="#0F172A" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                  <Border Height="38" Margin="0,8,0,4" Background="#0F172A" Padding="8,4" CornerRadius="2">
                    <TextBlock Text="||| || |||| | ||| |||| || | |||" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                  </Border>
                  <TextBlock Text="REP-2026-0842" Foreground="#0F172A" FontFamily="Consolas" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Customer Receipt Preview -->
          <Border Grid.Column="2" Style="{StaticResource ElevatedCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Border Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                  <TextBlock Text="فيتوح فون — FitohPhone" Foreground="#0F172A" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                  <TextBlock Text="إيصال استلام جهاز للصيانة" Foreground="#475569" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,10"/>
                  <Border Height="1" Background="#CBD5E1" Margin="0,0,0,10"/>
                  <TextBlock Text="رقم الإيصال: REP-2026-0842" Foreground="#0F172A" FontWeight="Bold" Margin="0,2"/>
                  <TextBlock Text="التاريخ: 2026/11/06 - 08:30 م" Foreground="#334155" FontSize="12" Margin="0,2"/>
                  <TextBlock Text="العميل: أحمد طارق محمود (01065432198)" Foreground="#0F172A" FontSize="12" Margin="0,2"/>
                  <TextBlock Text="الجهاز: iPhone 13 Pro - أزرق" Foreground="#0F172A" FontSize="12" Margin="0,2"/>
                  <TextBlock Text="العطل: كسر بالشاشة الأمامية + فحص البطارية" Foreground="#0F172A" FontSize="12" Margin="0,2"/>
                  <TextBlock Text="التكلفة التقديرية: 4,200 ج.م | العربون: 1,000 ج.م" Foreground="#0F172A" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,2"/>
                  <TextBlock Text="المتبقي عند الاستلام: 3,200 ج.م" Foreground="#DC2626" FontWeight="Bold" FontSize="13" Margin="0,2,0,10"/>
                  <Border Height="1" Background="#CBD5E1" Margin="0,0,0,8"/>
                  <TextBlock Text="المحل غير مسؤول عن الأجهزة التي يمر على موعد استلامها 30 يومًا." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="1" Content="إغلاق" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CloseWindow_Click"/>
          <Button Grid.Column="2" Content="طباعة ملصق الباركود فقط" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CloseWindow_Click"/>
          <Button Grid.Column="3" Content="طباعة الملصق + الإيصال" Click="CloseWindow_Click"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
