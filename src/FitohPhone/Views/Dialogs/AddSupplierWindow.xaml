<Window x:Class="FitohPhone.Views.Dialogs.AddSupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة مورد / تاجر جديد | FitohPhone"
        Width="640" Height="590" MinWidth="560" MinHeight="540"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Border Style="{StaticResource GlassCard}" Padding="24">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource InfoSoftBrush}" Margin="0,0,12,0">
            <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="تسجيل تاجر / مورد بضاعة" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="بيانات الشركة الموردة وأرقام المحافظ البنكية لربط فواتير المشتريات وكشف الحساب" Style="{StaticResource MutedText}"/>
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="اسم التاجر / الشركة الموردة *" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="NameInput" Tag="مثال: شركة النور لتجارة الهواتف والإكسسوارات"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="تصنيف التوريد" Style="{StaticResource FieldLabelText}"/>
                <ComboBox SelectedIndex="0">
                  <ComboBoxItem Content="هواتف وأجهزة ذكية"/>
                  <ComboBoxItem Content="إكسسوارات وشواحن وسماعات"/>
                  <ComboBoxItem Content="قطع غيار وشاشات صيانة"/>
                  <ComboBoxItem Content="توريد شامل متنوع"/>
                </ComboBox>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="اسم المندوب المسؤول" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="ContactPersonInput" Tag="اسم المندوب..."/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="رقم هاتف التاجر / المندوب *" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="PhoneInput" FlowDirection="LeftToRight" Tag="010XXXXXXXX"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="رقم فودافون كاش للتاجر" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="VodafonePhoneInput" FlowDirection="LeftToRight" Tag="010XXXXXXXX"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="حساب إنستاباي (InstaPay) للتاجر" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="InstaPayInput" FlowDirection="LeftToRight" Tag="011XXXXXXXX / username@instapay"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="عنوان المقر / المخزن" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="AddressInput" Tag="مثال: القاهرة - شارع عبد العزيز"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="الرصيد الافتتاحي للتاجر (له)" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="BalanceInput" Text="0.00" FlowDirection="LeftToRight"/>
              </StackPanel>
            </Grid>

            <StackPanel>
              <TextBlock Text="ملاحظات وشروط التعامل والاستبدال مع التاجر" Style="{StaticResource FieldLabelText}"/>
              <TextBox Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Tag="شروط الضمان ومواعيد التحصيل..."/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="* نافذة تصميم جاهزة للربط البرمجي" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" MinWidth="100" Click="CloseWindow_Click"/>
          <Button Grid.Column="2" Content="حفظ بيانات التاجر" MinWidth="160" Click="Save_Click"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
