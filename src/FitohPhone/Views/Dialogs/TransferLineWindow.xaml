<Window x:Class="FitohPhone.Views.Dialogs.TransferLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة / تعديل خط محفظة وحدود التحويل | FitohPhone"
        Width="620" Height="580" MinWidth="540" MinHeight="530"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Border Style="{StaticResource GlassCard}" Padding="24">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource VodafoneSoftBrush}" Margin="0,0,12,0">
            <TextBlock Text="&#xE8C7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource VodafoneBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="بيانات الخط وحدود التعامل (Daily &amp; Monthly Limits)" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="ضبط رقم المحفظة أو حساب إنستاباي والرصيد والحد الأقصى اليومي والشهري للتحويلات" Style="{StaticResource MutedText}"/>
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.2*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="نوع الخدمة / المحفظة *" Style="{StaticResource FieldLabelText}"/>
                <ComboBox SelectedIndex="0">
                  <ComboBoxItem Content="فودافون كاش (Vodafone Cash)"/>
                  <ComboBoxItem Content="إنستاباي (InstaPay)"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="رقم الخط / الحساب *" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="01012345678" FlowDirection="LeftToRight"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="اسم مالك الخط / التسمية التوضيحية" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="خط المحل الرئيسي رقم 1"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="الرصيد الحالي بالمحفظة (ج.م)" Style="{StaticResource FieldLabelText}"/>
                <TextBox Text="3000" FlowDirection="LeftToRight"/>
              </StackPanel>
            </Grid>

            <Border Style="{StaticResource ElevatedCard}" Margin="0,4,0,14">
              <StackPanel>
                <TextBlock Text="ضبط الحدود القصوى للخط (Limits)" FontWeight="Bold" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="الحد الأقصى اليومي (Daily Limit ج.م) *" Style="{StaticResource FieldLabelText}"/>
                    <TextBox Text="60000" FlowDirection="LeftToRight"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="الحد الأقصى الشهري (Monthly Limit ج.م) *" Style="{StaticResource FieldLabelText}"/>
                    <TextBox Text="200000" FlowDirection="LeftToRight"/>
                  </StackPanel>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="تنبيه عند وصول الاستهلاك إلى (%)" Style="{StaticResource FieldLabelText}"/>
                    <TextBox Text="85%" FlowDirection="LeftToRight"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="حالة الخط" Style="{StaticResource FieldLabelText}"/>
                    <ComboBox SelectedIndex="0">
                      <ComboBoxItem Content="نشط ومتاح للتحويل والتحصيل"/>
                      <ComboBoxItem Content="استقبال فقط (موقوف إرسال)"/>
                      <ComboBoxItem Content="موقوف مؤقتًا (وصل للحد الأقصى)"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <CheckBox Content="إظهار هذا الخط ضمن خيارات الدفع في نقطة البيع POS وفواتير الشراء" IsChecked="True"/>
            <CheckBox Content="إظهار رصيد هذا الخط في بطاقات الأرصدة الحالية بالقائمة الرئيسية" IsChecked="True"/>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="* يتم تحديث حساب الليمت اليومي والشهري تلقائيًا عند البرمجة" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" MinWidth="95" Click="CloseWindow_Click"/>
          <Button Grid.Column="2" Content="حفظ الرقم والحدود" MinWidth="160" Click="CloseWindow_Click"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
