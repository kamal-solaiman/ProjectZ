<Window x:Class="FitohPhone.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فيتوه فون | تسجيل الدخول"
        Width="960"
        Height="640"
        MinWidth="760"
        MinHeight="600"
        FlowDirection="RightToLeft"
        Language="ar-EG"
        WindowStartupLocation="CenterScreen">
    <!-- Keep the two physical columns predictable; each panel's content is RTL. -->
    <Grid Margin="32" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1.15*" />
        </Grid.ColumnDefinitions>

        <!-- Arabic brand panel on the left. -->
        <Border Grid.Column="0"
                Margin="0,0,20,0"
                Padding="32"
                CornerRadius="20"
                Background="#102E48"
                FlowDirection="RightToLeft">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <Border Width="72"
                            Height="72"
                            CornerRadius="20"
                            Background="#1D455F"
                            >
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="32"
                                   Foreground="#6EE7D8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="فيتوه فون"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"
                               />
                    <TextBlock Text="بوابتك إلى بيئة العمل"
                               Margin="0,18,0,12"
                               FontSize="23"
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text="واجهة بسيطة. اتصال موحّد.&#xA;بيانات المؤسسة في مكان واحد."
                               FontSize="16"
                               LineHeight="28"
                               Foreground="#B7CFDD"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="نظام الدخول المؤسسي"
                           VerticalAlignment="Bottom"
                           Foreground="#85AABC"
                           TextAlignment="Center"
                           FontSize="12" />
            </Grid>
        </Border>

        <!-- Login form on the right, with Arabic labels and layout. -->
        <Border Grid.Column="1"
                Padding="36"
                CornerRadius="20"
                Background="White"
                FlowDirection="RightToLeft">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="فيتوه فون"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Foreground="{StaticResource Accent}" />
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="تسجيل الدخول"
                               Margin="0,0,0,8"
                               FontSize="30"
                               FontWeight="Bold" 
                               TextAlignment="Center" />
                    <TextBlock Text="مرحبًا بعودتك، أدخل بيانات حسابك للمتابعة."
                               Margin="0,0,0,28"
                               Foreground="#64748B"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text="اسم المستخدم" Margin="0,0,0,8" TextAlignment="Center"/>
                    <!-- Account names and passwords are identifiers, so their input direction stays LTR. -->
                    <TextBox x:Name="UsernameInput"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             IsEnabled="{Binding IsIdle}"
                             FlowDirection="LeftToRight"
                             TextAlignment="Left"
                             AutomationProperties.Name="اسم المستخدم" />
                    <TextBlock Text="كلمة المرور" Margin="0,18,0,8" TextAlignment="Center" />
                    <PasswordBox x:Name="PasswordInput"
                                 MaxLength="1024"
                                 IsEnabled="{Binding IsIdle}"
                                 FlowDirection="LeftToRight"
                                 AutomationProperties.Name="كلمة المرور" />
                    <TextBlock Text="{Binding Error}"
                               MinHeight="42"
                               Margin="0,14,0,14"
                               Foreground="#B42318"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                    <Button Content="{Binding ButtonText}"
                            Command="{Binding LoginCommand}"
                            IsDefault="True" />
                </StackPanel>
                <TextBlock Grid.Row="2"
                           Text="اتصال مباشر وآمن بقاعدة بيانات المؤسسة"
                           FontSize="12"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
