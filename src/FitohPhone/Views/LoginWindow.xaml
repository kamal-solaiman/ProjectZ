<Window x:Class="FitohPhone.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FitohPhone | تسجيل الدخول"
        Width="980" Height="640" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <!-- Ambient Decorative Backdrop -->
    <Canvas IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Width="360" Height="360" Canvas.Left="-80" Canvas.Top="-80" Fill="{DynamicResource AmbientOrb1Brush}">
        <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
      </Ellipse>
      <Ellipse Width="320" Height="320" Canvas.Right="-60" Canvas.Bottom="-60" Fill="{DynamicResource AmbientOrb2Brush}">
        <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
      </Ellipse>
    </Canvas>

    <Grid Margin="32">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource GlassCard}" Padding="36">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="FITOH / PHONE ERP" FlowDirection="LeftToRight" HorizontalAlignment="Right" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
          <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="تسجيل الدخول" FontSize="30" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="مرحبًا بعودتك، أدخل بيانات حسابك للمتابعة إلى نظام إدارة المبيعات والصيانة." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,28"/>
            <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabelText}"/>
            <TextBox x:Name="UsernameInput" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Tag="أدخل اسم المستخدم..." MaxLength="100" IsEnabled="{Binding IsIdle}" FlowDirection="LeftToRight" AutomationProperties.Name="اسم المستخدم"/>
            <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabelText}" Margin="0,18,0,6"/>
            <PasswordBox x:Name="PasswordInput" MaxLength="1024" IsEnabled="{Binding IsIdle}" FlowDirection="LeftToRight" AutomationProperties.Name="كلمة المرور"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,14" MinHeight="42" AutomationProperties.LiveSetting="Assertive"/>
            <Button Content="{Binding ButtonText}" Command="{Binding LoginCommand}" IsDefault="True" Padding="20,12"/>
          </StackPanel>
          <TextBlock Grid.Row="2" Text="اتصال مباشر وآمن بقاعدة بيانات المؤسسة — SQL Server" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
        </Grid>
      </Border>

      <Border Grid.Column="1" CornerRadius="{DynamicResource CardCornerRadius}" Background="#102E48" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="20,0,0,0" Padding="32">
        <Grid>
          <StackPanel VerticalAlignment="Center">
            <Border Width="72" Height="72" CornerRadius="20" Background="#1D455F" HorizontalAlignment="Right" Margin="0,0,0,28">
              <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32" Foreground="#6EE7D8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="FitohPhone" FlowDirection="LeftToRight" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
            <TextBlock Text="منظومة المبيعات والصيانة والتحويلات" FontSize="22" Foreground="White" Margin="0,18,0,12" TextWrapping="Wrap"/>
            <TextBlock Text="نقطة بيع متعددة الفواتير • صيانة الهواتف والباركود • إدارة المخزون والهالك • فودافون كاش وإنستاباي." Foreground="#B7CFDD" FontSize="15" LineHeight="27" TextWrapping="Wrap"/>
          </StackPanel>
          <TextBlock Text="نظام الإدارة المتكامل لمحلات الهواتف" VerticalAlignment="Bottom" Foreground="#85AABC" FontSize="12"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
