<Window x:Class="FitohPhone.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FitohPhone | تسجيل الدخول" Width="960" Height="640" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterScreen">
 <Grid Margin="32"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="White" CornerRadius="20" Padding="36"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="FITOH / PHONE" FlowDirection="LeftToRight" HorizontalAlignment="Right" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
   <StackPanel Grid.Row="1" VerticalAlignment="Center">
    <TextBlock Text="تسجيل الدخول" FontSize="30" FontWeight="Bold" Margin="0,0,0,8"/>
    <TextBlock Text="مرحبًا بعودتك، أدخل بيانات حسابك للمتابعة." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,28"/>
    <TextBlock Text="اسم المستخدم" Margin="0,0,0,8"/>
    <TextBox x:Name="UsernameInput" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" IsEnabled="{Binding IsIdle}" FlowDirection="LeftToRight" AutomationProperties.Name="اسم المستخدم"/>
    <TextBlock Text="كلمة المرور" Margin="0,18,0,8"/>
    <PasswordBox x:Name="PasswordInput" MaxLength="1024" IsEnabled="{Binding IsIdle}" FlowDirection="LeftToRight" AutomationProperties.Name="كلمة المرور"/>
    <TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,14,0,14" MinHeight="42" AutomationProperties.LiveSetting="Assertive"
               Visibility="{Binding HasError, Converter={StaticResource VisibleWhenTrue}}"/>
    <Button Content="{Binding ButtonText}" Command="{Binding LoginCommand}" IsDefault="True"/>
   </StackPanel>
   <TextBlock Grid.Row="2" Text="اتصال مباشر وآمن بقاعدة بيانات المؤسسة" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
   <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
    <TextBlock Text="{Binding ConnectionSummary}" FontSize="11" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap"
               ToolTip="{Binding ConnectionSummary}" AutomationProperties.Name="هدف الاتصال"/>
   </Border>
  </Grid></Border>
  <Border Grid.Column="1" CornerRadius="20" Background="#102E48" Margin="20,0,0,0" Padding="32"><Grid><StackPanel VerticalAlignment="Center">
   <Border Width="72" Height="72" CornerRadius="20" Background="#1D455F" HorizontalAlignment="Right" Margin="0,0,0,28"><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32" Foreground="#6EE7D8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <TextBlock Text="FitohPhone" FlowDirection="LeftToRight" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
   <TextBlock Text="بوابتك إلى بيئة العمل" FontSize="23" Foreground="White" Margin="0,18,0,12" TextWrapping="Wrap"/>
   <TextBlock Text="واجهة بسيطة. اتصال موحّد.&#x0a;بيانات المؤسسة في مكان واحد." Foreground="#B7CFDD" FontSize="16" LineHeight="28" TextWrapping="Wrap"/>
  </StackPanel><TextBlock Text="نظام الدخول المؤسسي" VerticalAlignment="Bottom" Foreground="#85AABC" FontSize="12"/></Grid></Border>
 </Grid>
</Window>
