<Window x:Class="FitohPhone.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FitohPhone - تسجيل الدخول"
        Width="430" Height="560"
        MinWidth="400" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- Header band -->
        <Border Grid.Row="0" CornerRadius="0,0,28,28">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1F6FEB" Offset="0"/>
                    <GradientStop Color="#0EA5E9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FitohPhone"
                           FontSize="30" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="نظام إدارة الهواتف"
                           FontSize="14"
                           Foreground="#DBEAFE"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Login card -->
        <Border Grid.Row="1"
                Margin="28,24,28,12"
                Padding="26,10,26,22"
                Background="{StaticResource CardBrush}"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" Color="#334155"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="تسجيل الدخول"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,20"/>

                <!-- Username -->
                <TextBlock Text="اسم المستخدم" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Path Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C8.67,14 4,15.67 4,19 L4,20 L20,20 L20,19 C20,15.67 15.33,14 12,14 Z"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="UsernameTextBox"
                             Style="{StaticResource RoundedInput}"
                             Foreground="#FF1E293B"
                             CaretBrush="#FF1F6FEB"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <!-- Password -->
                <TextBlock Text="كلمة المرور" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Path Data="M12,2 C8.13,2 5,5.13 5,9 L5,11 L6,11 L6,9 C6,5.69 8.69,3 12,3 C15.31,3 18,5.69 18,9 L18,11 L19,11 L19,9 C19,5.13 15.87,2 12,2 Z M12,4 C15.31,4 18,6.69 18,10 L18,20 L6,20 L6,10 C6,6.69 8.69,4 12,4 Z M12,13 C10.34,13 9,14.34 9,16 L9,18 L15,18 L15,16 C15,14.34 13.66,13 12,13 Z"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource RoundedPasswordBox}"
                                 Foreground="#FF1E293B"
                                 CaretBrush="#FF1F6FEB"/>
                </Grid>

                <!-- Error message -->
                <TextBlock x:Name="ErrorTextBlock"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MinHeight="20"
                           Margin="0,2,0,12"/>

                <!-- Login button -->
                <Button x:Name="LoginButton"
                        Content="تسجيل الدخول"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="2"
                   Text="FitohPhone © 2026 - جميع الحقوق محفوظة"
                   FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
