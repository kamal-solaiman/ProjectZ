<Window x:Class="FitohPhone.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FitohPhone - النافذة الرئيسية"
        Width="640" Height="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}">

    <Grid>
        <!-- Header -->
        <Border Height="90" VerticalAlignment="Top" CornerRadius="0,0,28,28">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1F6FEB" Offset="0"/>
                    <GradientStop Color="#0EA5E9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FitohPhone"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="النافذة الرئيسية"
                           FontSize="13"
                           Foreground="#DBEAFE"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="84" Height="84" CornerRadius="42"
                    Background="{StaticResource AccentBrush}"
                    Margin="0,0,0,18">
                <Path Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C8.67,14 4,15.67 4,19 L4,20 L20,20 L20,19 C20,15.67 15.33,14 12,14 Z"
                      Fill="White"
                      Width="40" Height="40"
                      Stretch="Uniform"/>
            </Border>

            <TextBlock Text="مرحبًا بك،"
                       FontSize="16"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding DisplayName}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,30"/>

            <Button Content="تسجيل الخروج"
                    Style="{StaticResource DangerButton}"
                    Width="180"
                    Command="{Binding LogoutCommand}"/>
        </StackPanel>
    </Grid>
</Window>
